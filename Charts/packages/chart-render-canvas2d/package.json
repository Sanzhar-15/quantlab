{
  "name": "@charts-plus/chart-render-canvas2d",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@charts-plus/chart-core": "0.0.0"
  },
  "scripts": {
    "build": "npx tsc --build tsconfig.json && tsup src/index.ts src/worker.ts --format esm --sourcemap --minify --splitting false --tsconfig tsconfig.json --external '@charts-plus/*'"
  }
}
