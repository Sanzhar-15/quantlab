  4474	/// Map an [`ql_session::OperationState`] to its JS DTO. The `Failed` error is
  4475	/// rendered via the `[code] message` `Display` (the same wire convention the
  4476	/// napi error helpers use) so the IDE can `parseQuantbookError` it.
  4477	fn operation_state_json_from_session(s: ql_session::OperationState) -> OperationStateJson {
  4478	    use ql_session::OperationState;
  4479	    match s {
  4480	        OperationState::Running => OperationStateJson {
  4481	            state: "running".to_string(),
  4482	            error: None,
  4483	        },
  4484	        OperationState::Completed => OperationStateJson {
  4485	            state: "completed".to_string(),
  4486	            error: None,
  4487	        },
  4488	        OperationState::Canceled => OperationStateJson {
  4489	            state: "canceled".to_string(),
  4490	            error: None,
  4491	        },
  4492	        OperationState::Failed { error } => OperationStateJson {
  4493	            state: "failed".to_string(),
  4494	            error: Some(error.to_string()),
  4495	        },
  4496	    }
  4497	}
  4498	
  4499	fn event_json_from_session(e: ql_session::session::Event) -> EventJson {
  4500	    use ql_session::session::Event;
  4501	    // All-None base; each arm fills only its own variant's payload fields.
  4502	    let base = EventJson {
  4503	        kind: String::new(),
  4504	        op: None,
  4505	        done: None,
  4506	        total: None,
  4507	        diagnostic: None,
  4508	        state: None,
  4509	        addr: None,
  4510	        source: None,
  4511	        structure_kind: None,
  4512	        target: None,
  4513	    };
  4514	    match e {
  4515	        Event::RecalcProgress { op, done, total } => EventJson {
  4516	            kind: "recalc_progress".to_string(),
  4517	            op: Some(BigInt::from(op.0)),
  4518	            done: Some(BigInt::from(done)),
  4519	            total: Some(BigInt::from(total)),
  4520	            ..base
  4521	        },
  4522	        Event::CellDiagnostic { diagnostic } => EventJson {
  4523	            kind: "cell_diagnostic".to_string(),
  4524	            diagnostic: Some(diagnostic_json_from_session(diagnostic)),
  4525	            ..base
  4526	        },
  4527	        Event::OperationCompleted { op, state } => EventJson {
  4528	            kind: "operation_completed".to_string(),
  4529	            op: Some(BigInt::from(op.0)),
  4530	            state: Some(operation_state_json_from_session(state)),
  4531	            ..base
  4532	        },
  4533	        Event::Provenance { addr, source } => EventJson {
  4534	            kind: "provenance".to_string(),
  4535	            addr: Some(cell_addr_json_from_session(addr)),
  4536	            source: Some(source),
  4537	            ..base
  4538	        },
  4539	        Event::StructureChanged { kind, target } => EventJson {
  4540	            kind: "structure_changed".to_string(),
  4541	            structure_kind: Some(kind),
  4542	            target: Some(target),
  4543	            ..base
  4544	        },
  4545	        Event::FullResyncRequired => EventJson {
  4546	            kind: "full_resync_required".to_string(),
  4547	            ..base
  4548	        },
  4549	    }
  4550	}
  4551	
  4552	fn event_page_json_from_session(p: ql_session::session::EventPage) -> EventPageJson {
  4553	    EventPageJson {
  4554	        events: p.events.into_iter().map(event_json_from_session).collect(),
  4555	        next_cursor: BigInt::from(p.next_cursor.0),
  4556	        dropped: p.dropped,
  4557	    }
  4558	}
