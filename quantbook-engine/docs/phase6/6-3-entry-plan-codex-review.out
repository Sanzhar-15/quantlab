  4829	        arity: arity_to_json(m.arity),
  4830	        volatility: volatility_to_str(m.volatility).to_string(),
  4831	        determinism: m.determinism,
  4832	        dep_shape: dep_shape_to_str(m.dep_shape).to_string(),
  4833	        batch_shape: batch_shape_to_str(m.batch_shape).to_string(),
  4834	        arg_policy: arg_policy_to_str(m.arg_policy).to_string(),
  4835	        cancellation: cancellation_to_str(m.cancellation).to_string(),
  4836	        arg_context: arg_context_to_str(m.arg_context).to_string(),
  4837	        provenance_tags: m.provenance_tags,
  4838	    }
  4839	}
  4840	
  4841	/// JS-facing wrapper for the owning [`ql_exec::WorkbookSession`] (the product
  4842	/// single-writer session). Holds `Arc<Mutex<…>>` for the same `Send + Sync`
  4843	/// reason as [`CollabSession`] (positive proof at the bottom of this file): the
  4844	/// engine session is `Send + !Sync`, and `Arc<Mutex<Send>>` is `Send + Sync`.
  4845	///
  4846	/// **Scope (inc.2d + 6.4-2):** the minimal edit→recalc→snapshot smoke surface
  4847	/// (construct, single-cell edits, recalc, snapshot/read, close) PLUS the 6.4-2
  4848	/// function-registration surface (`registerFunction` / `unregisterFunction` /
  4849	/// `listFunctions`). The richer surface (batch/transaction/import/export/undo/
  4850	/// delta) is 6.3 Full Bindings. The 6.4-2 methods route through the substrate
  4851	/// shipped at 6.4-0 + 6.4-1: registry `register_udf` / `unregister_metadata` /
  4852	/// `sorted_metadata` + calcgraph `on_function_(un)registered` + the
  4853	/// `map_function_registry_err` mapper for the Appendix A `function_exists` /
  4854	/// `function_not_found` codes.
  4855	#[napi(js_name = "Session")]
  4856	pub struct Session {
  4857	    inner: Arc<Mutex<CoreWorkbookSession>>,
  4858	}
  4859	
  4860	#[napi]
  4861	impl Session {
  4862	    /// Construct a fresh, empty in-memory session (lifecycle `Ready`).
  4863	    #[napi(constructor)]
  4864	    #[allow(clippy::new_without_default)] // napi(constructor); Default would not be exposed to JS.
  4865	    pub fn new() -> Self {
  4866	        Self {
  4867	            inner: Arc::new(Mutex::new(CoreWorkbookSession::new())),
  4868	        }
  4869	    }
  4870	
  4871	    /// Add a sheet; returns its assigned `SheetId` (u16 widened to u32).
  4872	    /// `chunkRows` is the per-sheet row partition size (must be ≥ 1; the engine
  4873	    /// rejects 0 to prevent a `ColumnStore` panic).
  4874	    #[napi(js_name = "addSheet")]
  4875	    pub fn add_sheet(&self, name: String, chunk_rows: f64) -> Result<u32> {
  4876	        let chunk_rows = validate_u32_index("addSheet", "chunkRows", chunk_rows)?;
  4877	        if chunk_rows == 0 {
  4878	            return Err(bad_argument_error(
  4879	                "addSheet: chunkRows must be >= 1 (engine rejects chunk_rows == 0)".into(),
  4880	            ));
  4881	        }
  4882	        let id = self
  4883	            .inner
  4884	            .lock()
  4885	            .add_sheet(&name, chunk_rows)
  4886	            .map_err(engine_error_to_napi)?;
  4887	        Ok(u32::from(id))
  4888	    }
  4889	
  4890	    /// Set a cell's literal value (clears any formula). `value` is the
  4891	    /// discriminated-union [`CellValueJson`]; `blank` clears the value.
  4892	    #[napi(js_name = "setValue")]
  4893	    pub fn set_value(&self, sheet: f64, row: f64, col: f64, value: CellValueJson) -> Result<()> {
  4894	        let addr = session_addr_from_f64("setValue", sheet, row, col)?;
  4895	        let value = session_cell_value_from_json(value)?;
  4896	        self.inner
  4897	            .lock()
  4898	            .set_value(addr, value)
  4899	            .map_err(engine_error_to_napi)
  4900	    }
  4901	
  4902	    /// Set a cell's formula. `text` is the formula BODY **without** a leading
  4903	    /// `=` (e.g. `"A1+1"`) — matching `appendPutFormula` + the engine op-log
  4904	    /// convention; the IDE strips the `=` client-side. The engine canonicalizes
  4905	    /// the text (e.g. `"A1+1"` → `"A1 + 1"`). Lex/parse/bind failures surface as
  4906	    /// a structured engine error (`[formula_parse]`/`[bad_argument]`-class).
  4907	    #[napi(js_name = "setFormula")]
  4908	    pub fn set_formula(&self, sheet: f64, row: f64, col: f64, text: String) -> Result<()> {
  4909	        let addr = session_addr_from_f64("setFormula", sheet, row, col)?;
  4910	        self.inner
  4911	            .lock()
  4912	            .set_formula(addr, &text)
  4913	            .map_err(engine_error_to_napi)
  4914	    }
  4915	
  4916	    /// Clear a cell's formula — **convert-to-literal**: removes the formula but
  4917	    /// PRESERVES the last computed value (maps to `clear_formula` / the inc.2c-6
  4918	    /// contract; Excel "convert to value"). To also clear the value, call
  4919	    /// `setValue(.., { kind: "blank" })`. (A single "delete contents"
  4920	    /// value+formula command is a 6.1C contract decision — see handoff.)
  4921	    #[napi(js_name = "clear")]
  4922	    pub fn clear(&self, sheet: f64, row: f64, col: f64) -> Result<()> {
  4923	        let addr = session_addr_from_f64("clear", sheet, row, col)?;
  4924	        self.inner.lock().clear(addr).map_err(engine_error_to_napi)
  4925	    }
  4926	
  4927	    /// Recompute the dirty set (incremental). Returns the operation id (u64 as
  4928	    /// BigInt). In v1 a recalc is synchronous; cancel is honored pre-start only.
  4929	    #[napi(js_name = "recalcDirty")]
  4930	    pub fn recalc_dirty(&self) -> Result<BigInt> {
  4931	        let op = self
  4932	            .inner
  4933	            .lock()
  4934	            .recalc_dirty()
  4935	            .map_err(engine_error_to_napi)?;
  4936	        Ok(BigInt::from(op.0))
  4937	    }
  4938	
  4939	    /// Recompute everything. Returns the operation id (u64 as BigInt).
  4940	    #[napi(js_name = "recalcAll")]
  4941	    pub fn recalc_all(&self) -> Result<BigInt> {
  4942	        let op = self
  4943	            .inner
  4944	            .lock()
  4945	            .recalc_all()
  4946	            .map_err(engine_error_to_napi)?;
  4947	        Ok(BigInt::from(op.0))
  4948	    }
  4949	
  4950	    /// Full workbook snapshot (carries the opaque `version` token as a `Buffer`).
  4951	    #[napi(js_name = "snapshot")]
  4952	    pub fn snapshot(&self) -> Result<WorkbookSnapshotJson> {
  4953	        let snap = self.inner.lock().snapshot().map_err(engine_error_to_napi)?;
  4954	        Ok(workbook_snapshot_json_from_session(snap))
  4955	    }
  4956	
  4957	    /// Single-cell lookup. `null` if the cell is empty/absent.
  4958	    #[napi(js_name = "cell")]
  4959	    pub fn cell(&self, sheet: f64, row: f64, col: f64) -> Result<Option<CellSnapshotJson>> {
  4960	        let addr = session_addr_from_f64("cell", sheet, row, col)?;
  4961	        let cell = self.inner.lock().cell(addr).map_err(engine_error_to_napi)?;
  4962	        Ok(cell.map(cell_snapshot_json_from_session))
  4963	    }
  4964	
  4965	    /// List (non-tombstoned) sheets (id + name, no cells).
  4966	    #[napi(js_name = "listSheets")]
  4967	    pub fn list_sheets(&self) -> Result<Vec<SheetInfoJson>> {
  4968	        let sheets = self
  4969	            .inner
  4970	            .lock()
  4971	            .list_sheets()
  4972	            .map_err(engine_error_to_napi)?;
  4973	        Ok(sheets
  4974	            .into_iter()
  4975	            .map(|s| SheetInfoJson {
  4976	                id: u32::from(s.id),
  4977	                name: s.name,
  4978	            })
  4979	            .collect())
  4980	    }
  4981	
  4982	    /// Deterministically release the underlying [`ql_exec::WorkbookSession`]
  4983	    /// state — transitions the session to `Closed` (terminal). Subsequent
  4984	    /// command calls return a structured `[invalid_state]` engine error rather
  4985	    /// than panic. Any open transaction buffers are dropped (their handles
  4986	    /// become `[transaction_not_found]` if reused, never silent no-ops).
  4987	    ///
  4988	    /// **6.1C audit-fix M8 — closes the lifecycle hole.** Without this,
  4989	    /// JS-side the only way to free the workbook + op-log + plan cache + Loro
  4990	    /// substrate was to GC the JS handle — non-deterministic, can hold large
  4991	    /// workbooks in memory long after the IDE panel closes. Calling `close()`
  4992	    /// frees the engine state synchronously (engine `WorkbookSession::close`
  4993	    /// at `crates/ql-exec/src/session.rs`).
  4994	    #[napi(js_name = "close")]
  4995	    pub fn close(&self) -> Result<()> {
  4996	        self.inner.lock().close().map_err(engine_error_to_napi)
  4997	    }
  4998	
  4999	    // ============================================================================
  5000	    // 6.4-2 (2026-05-28) — function registration over napi.
  5001	    //
  5002	    // Wires the substrate shipped at 6.4-0 (function-metadata storage + hooks)
  5003	    // and 6.4-1 (binder ArgContext migration + PlanCache fn_gen invalidation +
  5004	    // M3 sorted_metadata + M5 mapper + I1 LazyShape) to the JS surface.
  5005	    // ============================================================================
  5006	
  5007	    /// **6.4-2:** Register a UDF — `metadata` is a `FunctionMetadataJson`
  5008	    /// describing the function's contract-§10.2 properties; `implHandle` is the
  5009	    /// opaque dispatch-pointer the worker dispatcher will consult at eval time
  5010	    /// (6.4-3). v1 stores the handle but does NOT yet dispatch to a Python
  5011	    /// worker — that lands at 6.4-3 (Arrow IPC + debugpy).
  5012	    ///
  5013	    /// **Behavior:**
  5014	    /// - Validates every enum string field at the napi boundary; unknown
  5015	    ///   strings surface a structured `[bad_argument]` engine error
  5016	    ///   (No-Fallbacks; never silent default).
  5017	    /// - Dirties + transitive-fans every formula that referenced the
  5018	    ///   (previously-unknown) `canonicalName` via the calcgraph hook.
  5019	    /// - Bumps the registry's `fn_gen` so the bind cache invalidates for
  5020	    ///   formulas needing re-extraction against the new metadata
  5021	    ///   (contract §10.3 "re-extract deps" half — option A from the 6.4-0
  5022	    ///   audit, shipped at 6.4-1 H3).
  5023	    /// - Lifecycle gate: rejects on Closed/Busy/New/Faulted with
  5024	    ///   `[invalid_state]` or `[session_busy]`.
  5025	    ///
  5026	    /// **Errors (Appendix A):**
  5027	    /// - `[function_exists]` — canonical name already registered (built-in
  5028	    ///   or existing UDF). `EngineError{Conflict, "function_exists"}`.
  5029	    /// - `[bad_argument]` — invalid enum string, OR empty/non-canonical
  5030	    ///   (lower-case) canonical_name. **6.4-2 cycle-2 audit-fix (H1):** the
  5031	    ///   trait method `WorkbookSession::register_function` VALIDATES the
  5032	    ///   canonical name before touching the registry and returns a structured
  5033	    ///   `[bad_argument]` for empty/lower-case names. (Pre-fix it forwarded the
  5034	    ///   name unchecked and the registry's `assert!` PANICKED across this
  5035	    ///   catch_unwind-free boundary, sealing the session — that path no longer
  5036	    ///   exists.) Callers should still pass ASCII-uppercase canonical names; the
  5037	    ///   IDE is expected to uppercase before the call.
  5038	    /// - `[invalid_state]` — session is not Ready.
  5039	    #[napi(js_name = "registerFunction")]
  5040	    pub fn register_function(
  5041	        &self,
  5042	        metadata: FunctionMetadataJson,
  5043	        impl_handle: BigInt,
  5044	    ) -> Result<()> {
  5045	        let meta = function_metadata_from_json(metadata)?;
  5046	        // BigInt → u64: the napi-rs `BigInt::get_u64()` returns `(sign_bit,
  5047	        // value, lossless)`. Reject negative (sign bit set) + lossy (anything
  5048	        // above u64::MAX) loud per No-Fallbacks. Matches the `peerId` validation
  5049	        // discipline at `CollabSession::new`.
  5050	        let (sign_bit, raw, lossless) = impl_handle.get_u64();
  5051	        if sign_bit {
  5052	            return Err(bad_argument_error(
  5053	                "registerFunction: implHandle must be a non-negative BigInt".into(),
  5054	            ));
  5055	        }
  5056	        if !lossless {
  5057	            return Err(bad_argument_error(
  5058	                "registerFunction: implHandle exceeds u64::MAX (lossy conversion rejected)".into(),
  5059	            ));
  5060	        }
  5061	        let handle = FunctionImplHandle(raw);
  5062	        self.inner
  5063	            .lock()
  5064	            .register_function(meta, handle)
  5065	            .map_err(engine_error_to_napi)
  5066	    }
  5067	
  5068	    /// **6.4-2:** Unregister a UDF. Symmetric to [`Self::register_function`].
  5069	    /// Removes BOTH the metadata and the dispatch handle atomically (via the
  5070	    /// registry's `unregister_metadata` extension that clears
  5071	    /// `udf_handles[name]` on success). Dirties + transitive-fans every
  5072	    /// dependent formula via the calcgraph hook; the next eval will surface
  5073	    /// `#NAME?` because dispatch is now missing.
  5074	    ///
  5075	    /// **Errors (Appendix A):**
  5076	    /// - `[function_not_found]` — no UDF registered under `canonicalName`.
  5077	    /// - `[function_exists]` — `canonicalName` is a built-in (dispatch entry
  5078	    ///   still present; the registry's builtin-guard refuses removal). The
  5079	    ///   `Conflict / function_exists` class is the same as duplicate-register;
  5080	    ///   the message disambiguates (`"is a registered built-in"`).
  5081	    /// - `[invalid_state]` — session is not Ready.
  5082	    #[napi(js_name = "unregisterFunction")]
  5083	    pub fn unregister_function(&self, canonical_name: String) -> Result<()> {
  5084	        self.inner
  5085	            .lock()
  5086	            .unregister_function(&canonical_name)
  5087	            .map_err(engine_error_to_napi)
  5088	    }
  5089	
  5090	    /// **6.4-2:** List every registered function (built-ins + UDFs) with full
  5091	    /// metadata. Returned sorted ascending by `canonical_name` (per the 6.4-1
  5092	    /// M3 `sorted_metadata` discipline + the 6.1C H2 deterministic-ordering
  5093	    /// rule for snapshot DTOs).
  5094	    ///
  5095	    /// Allocates the full metadata table (~260 entries at v1; cheap for an
  5096	    /// IDE poll). Use sparingly — this is not a per-keystroke surface.
  5097	    ///
  5098	    /// **Errors:** `[invalid_state]` if the session is Closed/New/Faulted
  5099	    /// (Busy is OK — this is a read).
  5100	    #[napi(js_name = "listFunctions")]
  5101	    pub fn list_functions(&self) -> Result<Vec<FunctionMetadataJson>> {
  5102	        let metas = self
  5103	            .inner
  5104	            .lock()
  5105	            .list_functions()
  5106	            .map_err(engine_error_to_napi)?;
  5107	        Ok(metas.into_iter().map(function_metadata_to_json).collect())
  5108	    }
  5109	
  5110	    /// **6.4-3d (2026-05-29):** attach an out-of-process Python-UDF worker to
  5111	    /// this session, built from `config` (a trusted-workspace `ProcessWorker`).
  5112	    /// The worker is spawned + handshaked EAGERLY here (fail-loud) so a missing
  5113	    /// interpreter / protocol mismatch surfaces NOW as a clear error, not later
  5114	    /// as a silent `#CALC!` on the first `=MYUDF(..)`. After injecting, the IDE
  5115	    /// should call `recalcAll` so existing UDF cells pick up the worker — a UDF
  5116	    /// cell computed before injection is a clean `#CALC!` that `recalcDirty`
  5117	    /// will NOT heal (see engine `WorkbookSession::set_udf_worker`). Calling
  5118	    /// again REPLACES the worker (the prior one is dropped → its child killed).
  5119	    ///
  5120	    /// **Errors (Appendix A):**
  5121	    /// - `[worker_spawn_failed]` — the interpreter could not be launched / the
  5122	    ///   worker died during startup (python not found, import error, …).
  5123	    /// - `[worker_handshake]` — the worker reported an incompatible protocol
  5124	    ///   version.
  5125	    /// - `[bad_argument]` — `handshakeTimeoutMs` is negative / non-finite / above
  5126	    ///   the 10-minute cap.
  5127	    /// - `[invalid_state]` — session is not `Ready` (New / Closed / Faulted); the
  5128	    ///   just-spawned worker is dropped (its child killed) without being attached.
  5129	    /// - `[session_busy]` — a long operation is in progress.
  5130	    ///
  5131	    /// **Trust:** the IDE MUST gate this call on workspace trust — spawning a
  5132	    /// worker runs arbitrary workspace Python. The engine has no workspace
  5133	    /// concept, so the trust gate lives in the IDE (`worker_untrusted_workspace`
  5134	    /// is an IDE-side code, never emitted here).
  5135	    #[napi(js_name = "setUdfWorker")]
  5136	    pub fn set_udf_worker(&self, config: PythonWorkerConfigJson) -> Result<()> {
  5137	        let mut cfg = ql_udf::PythonWorkerConfig::new(&config.python);
  5138	        if let Some(module) = config.module {
  5139	            cfg.module = module;
  5140	        }
  5141	        if let Some(paths) = config.pythonpath {
  5142	            for p in paths {
  5143	                cfg = cfg.with_pythonpath(p);
  5144	            }
  5145	        }
  5146	        if let Some(udf_module) = config.udf_module {
  5147	            cfg = cfg.with_udf_module(udf_module);
  5148	        }
  5149	        if let Some(ms) = config.handshake_timeout_ms {
  5150	            // **6.4-3d audit-fix (LOW):** require a non-negative finite value AND
  5151	            // cap it (10 min) so a huge `f64` cannot saturate `as u64` into an
  5152	            // effectively-unbounded handshake wait. The inclusive-range
  5153	            // `!contains` rejects NaN/Inf (neither is `>= 0.0`) as well as a
  5154	            // negative or above-cap value in one expression. Fractional ms
  5155	            // truncate (harmless).
  5156	            // (6.4-3d Step 5: rewritten from the `ms < 0.0 || ms > MAX` form to
  5157	            // satisfy clippy `manual_range_contains` under rust 1.95's stricter
  5158	            // `deny(clippy::all)`; behavior-identical.)
  5159	            const MAX_HANDSHAKE_MS: f64 = 600_000.0;
  5160	            if !(0.0..=MAX_HANDSHAKE_MS).contains(&ms) {
  5161	                return Err(bad_argument_error(format!(
  5162	                    "setUdfWorker: handshakeTimeoutMs must be a finite number in [0, {MAX_HANDSHAKE_MS}] ms"
  5163	                )));
  5164	            }
  5165	            cfg.handshake_timeout = std::time::Duration::from_millis(ms as u64);
  5166	        }
  5167	        // Spawn + handshake EAGERLY (outside the session lock — the spawn is a
  5168	        // process op) so a failure is reported here, not deferred to first call.
  5169	        // **NOTE (audit MED, filed for IDE Step 5):** this is a SYNCHRONOUS napi
  5170	        // method and blocks the calling JS thread for up to the handshake timeout
  5171	        // — the IDE MUST call it off the UI/main thread.
  5172	        let mut worker = ql_udf::ProcessWorker::new(cfg);
  5173	        worker.ensure_started().map_err(udf_spawn_error_to_napi)?;
  5174	        // **6.4-3d audit-fix (HIGH-3):** inject UNDER the lock via the
  5175	        // lifecycle-gated setter — a Closed/Faulted/New/Busy session rejects with
  5176	        // `[invalid_state]`/`[session_busy]` and the just-spawned `worker` drops
  5177	        // here (its child killed + reaped), closing the inject-vs-close race.
  5178	        self.inner
  5179	            .lock()
  5180	            .set_udf_worker_checked(Box::new(worker))
  5181	            .map_err(engine_error_to_napi)?;
  5182	        Ok(())
  5183	    }
  5184	
  5185	    /// **6.4-3d Step 5 (2026-05-29):** drain a page of structured events from the
  5186	    /// session's event ring (contract §9), starting at `cursor` (pass `0n` to read
  5187	    /// from the start, then the returned `nextCursor` on each subsequent call).
  5188	    /// Reading does NOT drain the ring, so independent pollers never starve each
  5189	    /// other. The IDE consumes this to surface `cell_diagnostic` events (the UDF
  5190	    /// no-worker / raised / timeout / died sink from 6.4-3d Steps 1-3) as cell
  5191	    /// tooltips, plus `recalc_progress` / `operation_completed` for long ops.
  5192	    ///
  5193	    /// If `dropped == true` (paired with a `full_resync_required` event) the
  5194	    /// consumer fell behind the retention horizon and MUST reseed via `snapshot()`
  5195	    /// (v1 uses an unbounded ring, so this never fires yet).
  5196	    ///
  5197	    /// **Lifecycle:** unlike the mutators, the engine `poll_events` does NOT gate
  5198	    /// on lifecycle (it is a pure read of the buffered ring) — polling a Closed
  5199	    /// session returns whatever was already buffered, never `[invalid_state]`.
  5200	    ///
  5201	    /// **Errors:** `[bad_argument]` if `cursor` is negative or exceeds `u64::MAX`.
  5202	    #[napi(js_name = "pollEvents")]
  5203	    pub fn poll_events(&self, cursor: BigInt) -> Result<EventPageJson> {
  5204	        // BigInt → u64, mirroring the `registerFunction` implHandle discipline:
  5205	        // reject a negative (sign bit) or lossy (> u64::MAX) cursor loud per
  5206	        // No-Fallbacks rather than silently truncating to a wrong ring position.
  5207	        let (sign_bit, raw, lossless) = cursor.get_u64();
  5208	        if sign_bit {
  5209	            return Err(bad_argument_error(
  5210	                "pollEvents: cursor must be a non-negative BigInt".into(),
  5211	            ));
  5212	        }
  5213	        if !lossless {
  5214	            return Err(bad_argument_error(
  5215	                "pollEvents: cursor exceeds u64::MAX (lossy conversion rejected)".into(),
  5216	            ));
  5217	        }
  5218	        let page = self
  5219	            .inner
  5220	            .lock()
  5221	            .poll_events(ql_session::session::EventCursor(raw))
  5222	            .map_err(engine_error_to_napi)?;
  5223	        Ok(event_page_json_from_session(page))
  5224	    }
  5225	}
  5226	
  5227	// **Phase 6.1B inc.2d (2026-05-27) — Send + Sync positive proof (audit Rule 4).**
  5228	//
  5229	// `Session { inner: Arc<Mutex<CoreWorkbookSession>> }` mirrors `CollabSession`:
  5230	//   - `CoreWorkbookSession` (`ql_exec::WorkbookSession`) is asserted `Send`
  5231	//     below. It owns the same Loro substrate (an `OpLog` + a `loro::UndoManager`,
  5232	//     each holding an internal `Arc<LoroDoc>`) as `CoreCollabSession` (documented
  5233	//     `Send + !Sync`), plus `Workbook` / `CalcgraphSession` / `PlanCache` /
  5234	//     `Arc<FunctionRegistry>` / plain collections.
  5235	//   - `parking_lot::Mutex<T>: Send + Sync` when `T: Send` (no poison flag).

