    85	/// A cell value — a **discriminated union** on `kind` (contract §4.2). Bindings
    86	/// narrow on `kind`; exactly one payload is present. Maps from
    87	/// [`ql_types::Value`]: `Number`/`Boolean`/`Text`/`Error`/`Blank` correspond 1:1;
    88	/// `Pending` is the extra binding-layer "being computed" state with no
    89	/// `ql_types::Value` analog.
    90	#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
    91	#[serde(tag = "kind", rename_all = "lowercase")]
    92	pub enum CellValue {
    93	    /// Numeric value.
    94	    Number {
    95	        /// The number.
    96	        number: f64,
    97	    },
    98	    /// Boolean value.
    99	    Boolean {
   100	        /// The boolean.
   101	        boolean: bool,
   102	    },
   103	    /// Text value.
   104	    Text {
   105	        /// The string.
   106	        text: String,
   107	    },
   108	    /// A spreadsheet error value (`#REF!`, `#DIV/0!`, …) — NOT an
   109	    /// [`crate::EngineError`] (contract §5.5).
   110	    Error {
   111	        /// The rendered error code.
   112	        error: String,
   113	    },
   114	    /// An empty cell — no committed value (maps from [`ql_types::Value::Blank`]).
   115	    /// Added in 6.1B inc.2c so a columnar `query_range` read can represent
   116	    /// empties in a fixed-size `Vec<CellValue>` (a deliberate, backward-compatible
   117	    /// contract addition; see `docs/api/workbook-session-impl-plan.md` §0). As a
   118	    /// `set_value` input it means "clear the cell's value". Snapshots omit blank
   119	    /// cells entirely (`CellSnapshot.value: None`) rather than emitting `Blank`.
   120	    Blank,
   121	    /// The cell is queued for recompute and has no committed value yet.
   122	    Pending,
   123	}
