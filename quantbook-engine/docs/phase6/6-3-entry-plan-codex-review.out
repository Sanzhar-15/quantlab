  2455	    fn snapshot_delta(&self, last_version: &SessionVersion) -> EngineResult<WorkbookSnapshotDelta> {
  2456	        // Design (a) — session change-log keyed by `state_seq` (impl-plan §0 item
  2457	        // 3, locked 2026-05-27). Keeps `&self`: the `&mut self` mutators + recalc
