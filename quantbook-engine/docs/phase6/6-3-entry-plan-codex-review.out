   108	
   109	/// Process-global epoch source. A fresh epoch is minted per session
   110	/// construction (and would be re-minted on reload / cache-clear / undo when
   111	/// those land). Monotonic within a process — sufficient for v1 single-writer
   112	/// token validity; cross-process epoch handling lands with persistence.
   113	static EPOCH_COUNTER: AtomicU64 = AtomicU64::new(1);
   114	
   115	fn mint_epoch() -> u128 {
   116	    EPOCH_COUNTER.fetch_add(1, Ordering::Relaxed) as u128
   117	}
   118	
   119	/// Retained `change_log` size before the oldest records are pruned and the
   120	/// horizon floor advances (a `last` token older than the floor gets
   121	/// `StaleHorizon`, never a silently-incomplete delta). Bounded so a long-lived
   122	/// session does not leak; generous enough that interactive deltas never hit it.
   123	const CHANGE_LOG_CAP: usize = 1 << 16;
   124	
   125	/// One delta-relevant change recorded against a [`WorkbookSession`] state-seq.
   126	/// The change-log is the source for [`WorkbookSession::snapshot_delta`]: it
   127	/// records *what* changed (cells/sheets/formats) at each `seq`, and the delta
   128	/// resolves those to the *current* committed state at read time. This is the
   129	/// (a) "session change-log keyed by version" design (impl-plan §0 item 3): it
   130	/// keeps `snapshot_delta(&self)` and captures changes that an op-walk misses —
   131	/// recompute-written dependents (`put_computed_at` appends no ops). (Pre-F2 a
   132	/// `set_value(Blank)` clear also appended no op; `Op::ClearValue` now closes
   133	/// that, but recompute dependents remain the load-bearing case.)
   134	#[derive(Clone, Copy, Debug)]
   135	enum SessionChange {
   136	    /// A cell whose value/formula/format may have changed (resolved at delta time).
   137	    Cell {
   138	        sheet: SheetId,
   139	        row: RowId,
   140	        col: ColId,
   141	    },
   142	    /// A sheet added / renamed (resolved to a full `SheetSnapshot` at delta time).
   143	    SheetChanged { id: SheetId },
   144	    /// A sheet tombstoned.
   145	    SheetRemoved { id: SheetId },
   146	    /// A format registered (resolved to a `FormatDef` at delta time).
   147	    FormatAdded { id: ql_storage::FormatId },
   148	}
   149	
   150	struct ChangeRecord {
   151	    seq: u64,
   152	    change: SessionChange,
   153	}
   154	
   155	/// RAII guard that transitions the session to [`LifecycleState::Faulted`] if
   156	/// dropped while still armed (i.e., the wrapped block panicked). Lifted to
   157	/// module scope from the two inline copies in [`WorkbookSession::with_runtime`]
   158	/// and [`WorkbookSession::with_runtime_no_oplog`] so the **6.1C audit-fix M3**
   159	/// non-runtime mutator paths (`delete_sheet`, `restore_sheet`, `move_sheet`,
   160	/// `mark_volatiles_dirty`, and `batch`'s Phase 2 op-log append) can reuse it
   161	/// without duplicating the pattern. Disarmed on the normal return path; the
   162	/// drop is a no-op when `armed == false`.
   163	struct FaultGuard<'g> {
   164	    state: &'g mut LifecycleState,
   165	    armed: bool,
   166	}
   167	
   168	impl Drop for FaultGuard<'_> {
   169	    fn drop(&mut self) {
   170	        if self.armed {
   171	            *self.state = LifecycleState::Faulted;
   172	        }
   173	    }
   174	}
   175	
   176	/// The owning, single-writer engine session (contract §2.1).
   177	///
   178	/// Bindings wrap this behind an opaque handle (Node: `#[napi]` over
   179	/// `Arc<Mutex<WorkbookSession>>`; C: an opaque pointer; etc.) — no borrowed
   180	/// engine reference ever crosses FFI (§2.2).
   181	pub struct WorkbookSession {
   182	    /// Live, single-writer cell/sheet/table/name/format storage.
   183	    workbook: Workbook,
   184	    /// **inc.2c-7 undo/redo baseline.** The workbook as it was at session
   185	    /// construction (the `from_workbook` argument), BEFORE any session edit. The
   186	    /// session's `oplog` records only edits made AFTER construction, so undo's
   187	    /// `rematerialize` replays the (post-undo) op-log onto a CLONE of this
   188	    /// baseline — NOT onto a fresh empty `Workbook`. For the wired `new()` path
   189	    /// the baseline is empty (clone is trivial), so behavior is unchanged; for a
   190	    /// session wrapping a populated workbook (the future `open`/`import` path)
   191	    /// this is what makes undo preserve the pre-loaded content instead of
   192	    /// silently dropping it (and makes "you cannot undo past the point the
   193	    /// workbook was opened" the correct, intended semantic). Audited 2026-05-27
   194	    /// (Codex HIGH / Opus M1: a fresh-`OpLog` + populated-workbook session would
   195	    /// otherwise lose its baseline on the first consumed undo).
   196	    baseline: Workbook,
   197	    /// Mandatory single-writer op-log — undo/save substrate + the `op_count`
   198	    /// half of the version token.
   199	    oplog: OpLog,
   200	    /// Dependency graph + dirty propagation.
   201	    graph: CalcgraphSession,
   202	    /// Session-owned bind-plan cache (threaded into the per-edit runtime via
   203	    /// `WorkbookRuntime::with_session_state` / `into_plan_cache`).
   204	    plan_cache: PlanCache,
   205	    /// Built-in + (future) custom function dispatch. `Arc` so a future
   206	    /// out-of-process UDF host can share it.
   207	    registry: Arc<FunctionRegistry>,
   208	    /// Lifecycle state; commands are gated on it (§2.3).
   209	    state: LifecycleState,
   210	    /// Version-token epoch (minted at construction; re-minted by [`bump_epoch`]
   211	    /// on changes the delta DTO cannot incrementally express — sheet reorder /
   212	    /// restore, table ops that rewrite arbitrary formula cells — and on
   213	    /// cache-clearing events). An old token whose epoch ≠ current →
   214	    /// `EpochMismatch` full rebuild.
   215	    ///
   216	    /// [`bump_epoch`]: WorkbookSession::bump_epoch
   217	    epoch: u128,
   218	    /// Monotonic logical state clock — the `op_count` half of the version token
   219	    /// (§4.0). **Replaces `oplog.len()`** (inc.2c-3): it advances on every
   220	    /// committed mutation AND every recompute that changed ≥1 cell, so — unlike
   221	    /// `oplog.len()`, which does NOT move on `put_computed_at` (recompute) nor on
   222	    /// a `set_value(Blank)` clear — two *distinct* visible states can never share
   223	    /// a token. The opaque 24-byte `{epoch, state_seq}` token shape is unchanged
   224	    /// (bindings round-trip it verbatim); only what the 8-byte counter *means*
   225	    /// changed. Closes audit F1 + the F2 token half.
   226	    state_seq: u64,
   227	    /// Bounded change-log keyed by `state_seq` — the source for `snapshot_delta`.
   228	    /// Records what changed; the delta resolves each to current committed state.
   229	    change_log: VecDeque<ChangeRecord>,
   230	    /// The highest `seq` that has been pruned from `change_log`. A `last` token
   231	    /// with `seq < change_log_floor` can no longer be served incrementally →
   232	    /// `StaleHorizon` full rebuild (never a silently-incomplete delta).
   233	    change_log_floor: u64,
   234	    /// Operation registry: op-id → terminal-or-running state (§6).
   235	    /// **v1 limitation:** grows unbounded (one entry per recalc, never pruned).
   236	    /// Bounded retention (drop terminal entries past a horizon) is a later
   237	    /// increment — acceptable for v1 session lifetimes.
   238	    ops: HashMap<OperationId, OperationState>,
   239	    /// Monotonic op-id source.
   240	    next_op_id: u64,
   241	    /// Append-only event ring; the cursor is an index into this vec (§9).
   242	    /// **v1 limitation:** unbounded, `dropped` always false (no retention horizon
   243	    /// yet); the §9 ring-with-drop semantics land with `subscribe_events`.
   244	    events: Vec<Event>,
   245	    /// Open multi-call transactions (§3.4): handle → buffered `SessionOp`s.
   246	    /// `begin_transaction` allocates an empty buffer, `txn_add` appends, `commit`
   247	    /// drains it through the SAME [`batch`] machinery, `rollback`/`close` drop it.
   248	    /// An open transaction holds **no engine lock** — it is a pure DTO buffer; the
   249	    /// workbook is untouched until commit, so interleaved single edits between
   250	    /// `begin` and `commit` are allowed and the buffer is validated against the
   251	    /// workbook state *at commit time* (the no-borrow-across-FFI contract §3.4).
   252	    /// **v1 limitation:** grows unbounded (one entry per open txn; dropped on
   253	    /// commit/rollback/close), same as `ops`/`events`.
   254	    ///
   255	    /// [`batch`]: WorkbookSession::batch
   256	    txns: HashMap<TransactionId, Vec<SessionOp>>,
   257	    /// Monotonic transaction-id source.
   258	    next_txn_id: u64,
   259	    /// Loro undo/redo manager (inc.2c-6), subscribed to `oplog`'s underlying
   260	    /// `LoroDoc` commit stream at construction (via `OpLog::new_undo_manager`).
   261	    /// It records every LOCAL commit made AFTER it is constructed — i.e. every
   262	    /// `oplog.append`, which `OpLog::append` follows with `doc.commit()`. It
   263	    /// holds an internal `Arc` to the doc, so it is `'static` and may be a
   264	    /// field (it does NOT borrow `self.oplog`).
   265	    ///
   266	    /// **Undo-unit granularity (HARD QUESTION 1).** `set_merge_interval(0)` is
   267	    /// set at construction → NO time-based merging, so each Loro commit is its
   268	    /// own undo unit. Every `WorkbookSession` mutating command produces EXACTLY
   269	    /// one commit: single-cell/structure/name/format/table edits each append
   270	    /// one op (one `append` = one `commit`), and `set_value`/`rename_sheet`/
   271	    /// `rename_table`/`rename_column` (the only commands whose underlying
   272	    /// producer can emit MULTIPLE ops) wrap them in a single `Op::BatchCommit`
   273	    /// (`cells.rs` `set_value` `match log_ops.len()`; `sheets.rs`/`tables.rs`
   274	    /// rename producers append one `BatchCommit`), and `batch`/`commit_transaction`
   275	    /// append one `Op::BatchCommit`. So one `undo()` reverts exactly one command
   276	    /// with NO explicit `group_start`/`group_end` needed. (Proven by
   277	    /// `undo_clear_of_formula_cell_is_one_unit` + `undo_batch_reverts_whole_batch`.)
   278	    ///
   279	    /// **Re-materialization model.** Unlike `ql_collab::CollabSession` (snapshot-
   280	    /// cache + on_push cell-meta partial invalidation), `WorkbookSession` owns a
   281	    /// LIVE workbook and re-materializes it WHOLESALE after a Loro undo/redo:
   282	    /// `replay_into` the (now-compacted) op-log into a fresh workbook, rebuild
   283	    /// the calcgraph, recompute, then `bump_epoch`. So no on_push meta encoding
   284	    /// is wired here — kept deliberately simpler. See [`rematerialize`].
   285	    ///
   286	    /// **v1 depth cap (audit L1).** Loro's `UndoManager::new` defaults to
   287	    /// `set_max_undo_steps(100)`; the session does not override it, so the undo
   288	    /// stack silently drops the oldest unit past 100 undoable commands. Bounded
   289	    /// retention is intentional for v1 (mirrors the `ops`/`events`/`change_log`
   290	    /// bounds); a configurable depth is a later increment.
   291	    ///
   292	    /// [`rematerialize`]: WorkbookSession::rematerialize
   293	    undo_manager: loro::UndoManager,
   294	    /// **6.4-3c (2026-05-29):** the out-of-process Python-UDF worker, if one is
   295	    /// configured (via [`set_udf_worker`]). `None` until the IDE/host injects
   296	    /// one. `RefCell` provides the interior mutability that bridges the shared-
   297	    /// `&` eval stack to [`ql_udf::UdfWorker::call`]'s `&mut self`: `with_runtime`
   298	    /// lends `&self.udf_worker` to the per-edit `WorkbookRuntime`, which threads
   299	    /// it into the eval env. Single-writer + single-threaded recompute, so the
   300	    /// `!Sync` `RefCell` is sound. A registered UDF with NO worker evaluates to
   301	    /// `#CALC!` at the dispatch site (No-Fallbacks-honest), never a panic. The
   302	    /// full napi/IDE injection bridge (+ `debugpy` / trusted-workspace gating) is
   303	    /// 6.4-3d; this field + [`set_udf_worker`] are the minimal in-engine surface.
   304	    ///
   305	    /// [`set_udf_worker`]: WorkbookSession::set_udf_worker
   306	    udf_worker: Option<RefCell<Box<dyn UdfWorker + Send>>>,
   307	    /// **6.4-3d (2026-05-29; megaudit blocker G):** per-recompute collector for
   308	    /// UDF-dispatch diagnostics. `with_runtime`/`with_runtime_no_oplog` lend
   309	    /// `&self.udf_diagnostics` into the runtime (alongside `udf_worker`); the
   310	    /// dispatch site pushes a [`crate::env::UdfCellDiagnostic`] on a failed (or
   311	    /// no-worker) `=MYUDF(..)`; the same helpers DRAIN it into
   312	    /// `Event::CellDiagnostic` after the runtime borrow ends. Always-present
   313	    /// (cheap empty `Vec`), unlike `udf_worker`. `!Sync` `RefCell` is sound
   314	    /// under single-threaded recompute. The cell VALUE is unchanged — this is
   315	    /// purely the "why did the UDF fail" channel (exit test 7).
   316	    udf_diagnostics: RefCell<Vec<UdfCellDiagnostic>>,
   317	    /// **6.4B (item H):** operation-level UDF time budget armed on each recalc pass
   318	    /// (see [`run_recalc`]). Default [`crate::scalar::UDF_OP_BUDGET`] (120s); bounds
   319	    /// a recompute touching N slow UDF cells to ~this instead of N × the per-call
   320	    /// deadline (the "N×30s stall"). Settable via [`set_udf_op_budget`] (used by
   321	    /// tests; a host-config / per-function-deadline surface is filed forward, not
   322	    /// yet bound over napi).
   323	    ///
   324	    /// [`run_recalc`]: WorkbookSession::run_recalc
   325	    /// [`set_udf_op_budget`]: WorkbookSession::set_udf_op_budget
   326	    udf_op_budget: std::time::Duration,
   327	}
   328	
   329	impl WorkbookSession {
   330	    /// Construct a fresh, empty in-memory session (→ `Ready`). The `new(options)`
   331	    /// product command (§3.1).
   332	    pub fn new() -> Self {
   333	        Self::from_workbook(Workbook::new())
   334	    }
   335	
   336	    /// Wrap an existing `Workbook` (e.g. a hand-built test workbook; later the
