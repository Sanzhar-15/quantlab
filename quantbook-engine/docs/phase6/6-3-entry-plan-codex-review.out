  4435	/// JS-facing page of events read from a cursor (mirrors
  4436	/// [`ql_session::session::EventPage`]). Reading does NOT drain the ring; pass
  4437	/// `nextCursor` to the next `pollEvents` call. `dropped == true` pairs with a
  4438	/// `full_resync_required` event — the consumer fell behind the retention
  4439	/// horizon and MUST reseed via `snapshot()` (v1 uses an unbounded ring, so this
  4440	/// never fires yet).
  4441	#[napi(object)]
  4442	pub struct EventPageJson {
  4443	    pub events: Vec<EventJson>,
  4444	    pub next_cursor: BigInt,
  4445	    pub dropped: bool,
  4446	}
