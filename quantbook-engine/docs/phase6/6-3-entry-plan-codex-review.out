  2326	    fn mark_volatiles_dirty(&mut self) -> EngineResult<()> {
  2327	        self.ensure_ready()?;
  2328	        // **6.1C audit-fix M3:** the graph mutator runs outside `with_runtime`
  2329	        // (no op-log append, no workbook mutation), but a panic here would still
  2330	        // leave the calcgraph in a half-marked state with `state = Ready`. Wrap
  2331	        // in a FaultGuard so any unwind seals the session → `Faulted` per the
  2332	        // contract §8 panic-safety promise.
  2333	        let mut guard = FaultGuard {
  2334	            state: &mut self.state,
  2335	            armed: true,
  2336	        };
  2337	        // **MEGAUDIT fix (2026-05-29; Codex-B HIGH):** call the graph's
  2338	        // `mark_volatile_dirty`, which marks each volatile node dirty AND fans
  2339	        // out the transitive reverse-dep graph from each volatile cell. The
  2340	        // previous code looped `self.graph.mark_dirty(node)` per volatile
  2341	        // formula — but `mark_dirty` (pub(crate), for coordinated recovery
  2342	        // only) inserts ONLY that node, with NO fanout. So a downstream
  2343	        // `C1 = B1 + 1` over a volatile `B1 = MYUDF(A1)` (or RAND/NOW) stayed
  2344	        // STALE after `mark_volatiles_dirty` + `recalc_dirty`, because
  2345	        // `recompute_dirty` re-dirties dependents only through spill writes,
  2346	        // not ordinary value changes — it relies on the dirty set being
  2347	        // pre-fanned-out (which is exactly what `mark_volatile_dirty` does).
  2348	        // Pre-dates 6.4-3c (affects all volatile fns); surfaced because UDFs
  2349	        // are the first host-declared-volatile functions with dependents.
  2350	        self.graph.mark_volatile_dirty();
  2351	        guard.armed = false;
  2352	        Ok(())
  2353	    }
