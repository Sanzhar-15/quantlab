   284	    /// dispatch via `simd::*` lives on the bench / FormulaRegion path
   285	    /// (Phase 4.7+); this counter proves the graph scheduler is aware
   286	    /// of region-eligible formulas. Always `0` for `recompute_all`.
   287	    pub simd_classified: usize,
