  3245	/// ASCII-upper-case canonical name (the IDE / any caller is expected to
  3246	/// upper-case before calling — the registry stores and `list_functions` returns
  3247	/// the name verbatim, so we VALIDATE rather than silently normalize, per
  3248	/// No-Fallbacks). This makes the two registry asserts genuine unreachable
  3249	/// invariants for the trait path.
  3250	///
  3251	/// **6.4B hardening (2026-05-29; closes the 6.4-4 megaudit FF-1 / Codex-2 MED):**
  3252	/// also reject a canonical name the formula language cannot CALL. Previously the
  3253	/// gate accepted any non-empty all-upper string, so `register_function("MY UDF")`
  3254	/// / `"MY-UDF"` / `"É"` succeeded and `list_functions` advertised a name no
  3255	/// formula could reference (an inert registration — `=MY UDF(..)` fails loud at
  3256	/// parse, never silently). We validate against the REAL lexer+parser (the single
  3257	/// source of truth) rather than a hand-rolled identifier grammar: a hand grammar
  3258	/// would drift from the parser and wrongly reject valid forms — dotted Excel
  3259	/// canon (`T.DIST.2T`, via the lexer's digit-leading segments) and names that lex
  3260	/// as a `CellRef` but the parser disambiguates as a function when followed by `(`
  3261	/// (`LOG10`, `ATAN2`; see `token.rs`). The probe `NAME(1)` must lex+parse to a
  3262	/// single `Expr::Function` whose name matches; anything else (whitespace,
  3263	/// punctuation, non-ASCII, trailing garbage) fails to parse as one and is
  3264	/// rejected. (The lower-level registry `register_metadata` keeps its own
  3265	/// upper-case asserts; this trait-boundary gate is where host/napi registrations
  3266	/// enter, so it is the right place to enforce callability without adding a
  3267	/// formula-syntax dependency to the `ql-functions` registry crate.)
  3268	fn validate_canonical_function_name(name: &str) -> EngineResult<()> {
  3269	    if name.is_empty() {
  3270	        return Err(EngineError::bad_argument(
  3271	            "register_function: canonical_name must not be empty".to_string(),
  3272	        ));
  3273	    }
  3274	    if name.bytes().any(|b| b.is_ascii_lowercase()) {
  3275	        return Err(EngineError::bad_argument(format!(
  3276	            "register_function: canonical_name {name:?} must be canonical upper-case \
  3277	             (caller must normalize before calling)"
  3278	        )));
  3279	    }
  3280	    // Callability gate: `NAME(1)` must parse to exactly a function call named
  3281	    // `NAME`. Uses the engine's own lexer+parser so the accepted set is exactly
  3282	    // what `=NAME(..)` can bind — no separate grammar to keep in sync.
  3283	    let probe = format!("{name}(1)");
  3284	    let is_callable = lex(&probe)
  3285	        .ok()
  3286	        .and_then(|tokens| parse(tokens).ok())
  3287	        .is_some_and(|expr| {
  3288	            matches!(&expr, ql_formula_syntax::Expr::Function { name: parsed, .. }
  3289	                if parsed.eq_ignore_ascii_case(name))
  3290	        });
  3291	    if !is_callable {
  3292	        return Err(EngineError::bad_argument(format!(
  3293	            "register_function: canonical_name {name:?} is not a callable formula \
  3294	             function name (must be usable as the head of `=NAME(..)`)"
  3295	        )));
  3296	    }
  3297	    Ok(())
  3298	}
