  3023	/// Map a `RuntimeError` to the contract `EngineError` (Appendix A). Every named
  3024	/// variant is mapped explicitly; the `#[non_exhaustive]` catch-all surfaces a
  3025	/// loud `Internal` (NOT a silent fallback) — any variant reaching it is an
  3026	/// unmapped-variant bug to fix, per contract §5.3.
  3027	fn map_runtime_err(e: RuntimeError) -> EngineError {
  3028	    use RuntimeError as R;
  3029	    let display = e.to_string();
  3030	    match e {
  3031	        // Formula structural errors → Compute (a formula that *evaluates* to an
  3032	        // error is a CellValue::Error, not an EngineError; §5.5).
  3033	        R::Lex(_) | R::Parse(_) | R::Print(_) => {
  3034	            EngineError::new(ErrorClass::Compute, "formula_parse", display)
  3035	        }
  3036	        R::Bind(_) => EngineError::new(ErrorClass::Compute, "formula_bind", display),
  3037	        // Target/coordinate problems.
  3038	        R::InvalidSheet { .. } => {
  3039	            EngineError::new(ErrorClass::NotFound, "sheet_not_found", display)
  3040	        }
  3041	        R::InvalidCell { .. } => EngineError::new(ErrorClass::BadArgument, "bad_cell", display),
  3042	        R::ConflictingOps { .. } => {
  3043	            EngineError::new(ErrorClass::Conflict, "conflicting_ops", display)
  3044	        }
  3045	        // Op-log append failure (the inner OpLogError distinguishes the cause).
  3046	        R::OpLog(inner) => map_oplog_err(inner, display),
  3047	        // Name / sheet-name validation.
  3048	        R::Name(_) => EngineError::new(ErrorClass::BadArgument, "name_reserved", display),
  3049	        R::SheetName(ql_storage::SheetNameError::Duplicate { .. }) => {
  3050	            EngineError::new(ErrorClass::Conflict, "sheet_name_duplicate", display)
  3051	        }
  3052	        R::SheetName(_) => EngineError::new(ErrorClass::BadArgument, "bad_sheet_name", display),
  3053	        R::InvalidChunkRows(_) => {
  3054	            EngineError::new(ErrorClass::BadArgument, "invalid_chunk_rows", display)
  3055	        }
  3056	        R::TooManySheets { .. } => {
  3057	            EngineError::new(ErrorClass::Conflict, "too_many_sheets", display)
  3058	        }
  3059	        R::UnknownFormatId(_) => {
  3060	            EngineError::new(ErrorClass::BadArgument, "unknown_format_id", display)
  3061	        }
  3062	        R::FormatCounterExhausted { .. } => {
  3063	            EngineError::new(ErrorClass::Internal, "format_counter_exhausted", display)
  3064	        }
  3065	        R::RecomputeIterationCap => {
  3066	            EngineError::new(ErrorClass::Internal, "recompute_iteration_cap", display)
  3067	        }
  3068	        // Table ops.
  3069	        R::TableCreateRejected { .. } => {
  3070	            EngineError::new(ErrorClass::Conflict, "table_create_rejected", display)
  3071	        }
  3072	        R::TableNotFound(_) => EngineError::new(ErrorClass::NotFound, "table_not_found", display),
  3073	        R::TableColumnNotFound { .. } => {
  3074	            EngineError::new(ErrorClass::NotFound, "table_column_not_found", display)
  3075	        }
  3076	        R::TableColumnRejected { .. } => {
  3077	            EngineError::new(ErrorClass::Conflict, "table_column_rejected", display)
  3078	        }
  3079	        R::TableResizeRejected { .. } => {
  3080	            EngineError::new(ErrorClass::BadArgument, "table_resize_rejected", display)
  3081	        } // NOTE: no wildcard arm. `RuntimeError` is `#[non_exhaustive]`, but
  3082	          // this match is in the SAME crate, so it must be exhaustive — which is
  3083	          // exactly the safety the contract wants (§5.3): a newly-added variant
  3084	          // becomes a COMPILE error here, forcing an explicit mapping rather than
  3085	          // silently leaking through a catch-all.
  3086	    }
  3087	}
