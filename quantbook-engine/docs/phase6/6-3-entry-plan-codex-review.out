  2369	            return Err(not_implemented(
  2370	                "query_range include_formulas/include_formats/include_rendered",
  2371	            ));
  2372	        }
  2373	        self.require_live_sheet(range.sheet, "query_range")?;
  2374	        let sheet = self
  2375	            .workbook
  2376	            .sheet(range.sheet)
  2377	            .expect("require_live_sheet verified the sheet exists");
  2378	        if range.end_row < range.start_row || range.end_col < range.start_col {
  2379	            return Err(EngineError::bad_argument(
  2380	                "range end coordinate is before its start",
  2381	            ));
  2382	        }
  2383	        // F4: reject out-of-grid corners (BadArgument). `Sheet::read` returns
  2384	        // `Blank` out-of-bounds, and an `end = u32::MAX` span would overflow the
  2385	        // `end - start + 1` arithmetic below before the cell-count cap.
