     1	//! Binding-neutral, versioned DTOs (contract §4.2).
     2	//!
     3	//! These are the shapes that cross the contract boundary. They are extracted
     4	//! from the proven napi `#[napi(object)]` structs (`ql-bindings-node`) but are
     5	//! transport-neutral plain `serde` types — bindings map their wire form to/from
     6	//! these. Where a stable engine type already exists (`ql_types::Address`,
     7	//! `ql_types::Range`), a `From` conversion is provided rather than re-deriving.
     8	
     9	use ql_types::{ColId, RowId, SheetId};
    10	use serde::{Deserialize, Serialize};
    11	
    12	/// Opaque session/version token (contract §4.0). In v1 this is an engine-owned
    13	/// `{session_epoch, op_count}` encoded as bytes. `op_count` is `OpLog::len()`
    14	/// (the simplest monotonic single-writer counter); `session_epoch` is minted at
    15	/// new/open/import and re-minted on cache-clear/undo — which is what keeps
    16	/// tokens sound, because `OpLog::len()` is NOT monotonic under undo-retraction
    17	/// (it reads the live Loro list). (`ql-oplog::OpLog` *does* expose a Loro
    18	/// `VersionVector` via `oplog_vv()` — an earlier doc claim that it had none was
    19	/// wrong — but that VV is reserved for the v1.5 `CollabSession` delta-sync path,
    20	/// not the single-writer token; `{epoch, op_count}` is chosen deliberately
    21	/// because index-walking ops for a semantic delta is simpler than decoding a VV
    22	/// delta blob.) Callers round-trip the bytes verbatim and MUST NOT interpret
    23	/// them; the engine is the sole producer/validator.
    24	#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
    25	pub struct SessionVersion(pub Vec<u8>);
    26	
