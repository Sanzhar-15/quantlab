  2614	    // --- Undo / redo (§3.8) ---
  2615	
  2616	    /// Undo the last command (inc.2c-6). Asks Loro to retract the last commit
  2617	    /// (one undo unit = one command, by `set_merge_interval(0)` + the
  2618	    /// one-commit-per-command invariant — see the `undo_manager` field doc), then
  2619	    /// re-materializes the live workbook + graph from the now-compacted op-log
  2620	    /// ([`rematerialize`]).
  2621	    ///
  2622	    /// Empty undo stack ⇒ `consumed: false` with the version token UNCHANGED —
  2623	    /// NOT an error (contract §3.8). A consumed undo advances the token (epoch
  2624	    /// bump in `rematerialize`). A Loro-internal failure is mapped loud
  2625	    /// (`map_loro_undo_err` → `Internal`), never swallowed.
  2626	    ///
  2627	    /// [`rematerialize`]: WorkbookSession::rematerialize
  2628	    fn undo(&mut self) -> EngineResult<UndoRedoResult> {
  2629	        self.ensure_ready()?;
  2630	        let consumed = self.undo_manager.undo().map_err(map_loro_undo_err)?;
  2631	        if consumed {
  2632	            self.rematerialize()?;
  2633	        }
  2634	        Ok(UndoRedoResult {
  2635	            consumed,
  2636	            version: self.current_version(),
  2637	        })
  2638	    }
