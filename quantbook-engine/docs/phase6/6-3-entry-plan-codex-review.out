   351	    /// recompute after the swap, so its graph stayed divergent.) Passing the
   352	    /// preserved registry into construction closes the divergence at the source
   353	    /// for ALL adoption sites and removes `open`'s wasteful double graph build.
   354	    /// This is the same divergence class the 6.4-0 H2 + 6.4-1 H1 audit-fixes
   355	    /// closed at `recompute_all` / `rematerialize`; the adoption-site variant
   356	    /// was the gap those sweeps missed.
   357	    pub fn from_workbook_with_registry(
   358	        workbook: Workbook,
   359	        registry: Arc<FunctionRegistry>,
   360	    ) -> Self {

