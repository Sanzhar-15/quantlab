   943	    /// a *designed* state (NOT an error — unlike a malformed token, which is the
   944	    /// fail-loud `invalid_version_token`).
   945	    fn full_rebuild_delta(&self, reason: FullRebuildReason) -> WorkbookSnapshotDelta {
   946	        WorkbookSnapshotDelta {
