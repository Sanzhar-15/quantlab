  2647	        let consumed = self.undo_manager.redo().map_err(map_loro_undo_err)?;
  2648	        if consumed {
  2649	            self.rematerialize()?;
  2650	        }
  2651	        Ok(UndoRedoResult {
  2652	            consumed,
  2653	            version: self.current_version(),
  2654	        })
  2655	    }
