   786	
   787	    /// Encode the current `{epoch, state_seq}` version token (§4.0). 16-byte
   788	    /// big-endian epoch followed by 8-byte big-endian `state_seq`. (inc.2c-3:
   789	    /// the counter is `state_seq`, not `oplog.len()` — see the `state_seq` field
   790	    /// doc; this is what makes the token a true *state* token for delta.)
   791	    fn current_version(&self) -> SessionVersion {
   792	        let mut bytes = Vec::with_capacity(24);
   793	        bytes.extend_from_slice(&self.epoch.to_be_bytes());
   794	        bytes.extend_from_slice(&self.state_seq.to_be_bytes());
   795	        SessionVersion(bytes)
   796	    }
   797	
   798	    /// Decode a 24-byte `{epoch(16, BE), state_seq(8, BE)}` token. A malformed
   799	    /// token (wrong length) is **fail-loud** `invalid_version_token` (`Protocol`)
   800	    /// — NEVER a silent full-rebuild (§4.3 / MED-2 / No-Fallbacks).
   801	    fn decode_version(v: &SessionVersion) -> EngineResult<(u128, u64)> {
   802	        if v.0.len() != 24 {
   803	            return Err(EngineError::new(
   804	                ErrorClass::Protocol,
   805	                "invalid_version_token",
   806	                format!(
   807	                    "version token must be 24 bytes ({{epoch:16, state_seq:8}}), got {}",
   808	                    v.0.len()
   809	                ),
   810	            ));
   811	        }
   812	        let mut epoch_bytes = [0u8; 16];
   813	        epoch_bytes.copy_from_slice(&v.0[0..16]);
   814	        let mut seq_bytes = [0u8; 8];
   815	        seq_bytes.copy_from_slice(&v.0[16..24]);
   816	        Ok((
   817	            u128::from_be_bytes(epoch_bytes),
   818	            u64::from_be_bytes(seq_bytes),
   819	        ))
   820	    }
   821	
   822	    /// Append change records for a just-committed command, bumping `state_seq`
   823	    /// once (all records of the command share the new seq). A no-op if `changes`
   824	    /// is empty — a command that changed nothing observable must NOT advance the
   825	    /// token. Prunes the oldest records past [`CHANGE_LOG_CAP`], advancing
   826	    /// `change_log_floor` so a token older than the retained window gets
   827	    /// `StaleHorizon` rather than an incomplete delta.
   828	    fn record_changes(&mut self, changes: impl IntoIterator<Item = SessionChange>) {
   829	        let mut iter = changes.into_iter().peekable();
   830	        if iter.peek().is_none() {
   831	            return;
   832	        }
   833	        self.state_seq += 1;
   834	        let seq = self.state_seq;
   835	        for change in iter {
   836	            self.change_log.push_back(ChangeRecord { seq, change });
   837	        }
   838	        while self.change_log.len() > CHANGE_LOG_CAP {
   839	            if let Some(dropped) = self.change_log.pop_front() {
   840	                self.change_log_floor = self.change_log_floor.max(dropped.seq);
   841	            }
   842	        }
   843	    }
   844	
   845	    /// Mint a fresh epoch → every outstanding version token becomes
   846	    /// `EpochMismatch` (full rebuild) on its next `snapshot_delta`. Used for
   847	    /// state changes the delta DTO cannot incrementally express — sheet reorder
   848	    /// (`move_sheet`) / restore (`restore_sheet`, reappears at a position the
   849	    /// delta can't convey) and table ops (`create/rename/rename_column/resize/
   850	    /// drop_table`, which rewrite arbitrary formula cells the session can't
   851	    /// enumerate) — and for cache-clearing events (undo/redo, future). The
   852	    /// change-log is keyed by the OLD epoch's seqs, so it is cleared (a new-epoch
   853	    /// token starts fresh from the current `state_seq`).
   854	    fn bump_epoch(&mut self) {
   855	        self.epoch = mint_epoch();
   856	        self.change_log.clear();
   857	        self.change_log_floor = self.state_seq;
   858	    }
   859	
   860	    /// Rebuild the live workbook + calcgraph from the (post-undo/redo) op-log,
   861	    /// recompute computed values, and bump the epoch (inc.2c-6 undo/redo).
   862	    ///
   863	    /// After a Loro `undo()`/`redo()`, the UndoManager retracts (or re-applies)
   864	    /// the commit(s) for the reverted command, so the op-log's visible list
   865	    /// (`OpLog::iter`) now yields the POST-undo op sequence. But the session's
   866	    /// LIVE `workbook` + `graph` still reflect the pre-undo state — Loro reverts
   867	    /// only its own op-list, not our derived workbook/graph (which are NOT Loro
   868	    /// containers). So we re-derive both from the op-log:
   869	    ///
   870	    /// 1. `replay_into` a FRESH `Workbook` from the op-log. Replay persists
   871	    ///    formula TEXT without evaluating (its doc contract), so computed values
   872	    ///    are not yet present.
   873	    /// 2. Rebuild the calcgraph from that workbook (mirrors `from_workbook`).
   874	    /// 3. `recompute_all` to fill computed values — run through a per-edit
   875	    ///    runtime WITH THE OP-LOG DETACHED (`with_runtime_no_oplog`) so the
   876	    ///    recompute appends NO ops (it must not pollute the log we just
   877	    ///    re-materialized FROM, nor feed the UndoManager a spurious commit).
   878	    ///    Structural recompute failures surface as `CellDiagnostic` events
   879	    ///    (never silently dropped), mirroring `run_recalc`. NOTE: this does NOT
   880	    ///    create an operation-registry entry / `Busy` transition — undo/redo are
   881	    ///    fast synchronous re-derivations, not user-cancellable long ops; the
   882	    ///    op-registry is the shape the out-of-process 6.4/6.5 paths reuse, and a
   883	    ///    re-materialization is internal bookkeeping, not a recalc command.
   884	    /// 4. `bump_epoch` so the next `snapshot_delta` from any pre-undo token
   885	    ///    returns `full_rebuild_required` (`EpochMismatch`) — the wholesale
   886	    ///    rebuild is not incrementally delta-expressible. The token thus changes
   887	    ///    after every consumed undo/redo.
   888	    ///
   889	    /// A replay error here is a torn-engine condition (the op-log is the source
   890	    /// of truth and must replay): map it loud (`map_replay_err`), never swallow.
   891	    fn rematerialize(&mut self) -> EngineResult<()> {
   892	        // Replay onto a clone of the construction-time baseline (NOT a fresh
   893	        // empty workbook): the op-log holds only post-construction edits, so
   894	        // `baseline + (post-undo log)` reconstructs the correct state and
   895	        // preserves any pre-loaded content. Empty/trivial for the `new()` path.
   896	        let mut wb = self.baseline.clone();
   897	        ql_oplog::replay_into(&self.oplog, &mut wb, &self.registry).map_err(map_replay_err)?;
   898	        self.workbook = wb;
   899	        // **6.4-1 cycle-2 audit-fix H1 (2026-05-28):** thread `self.registry`
   900	        // through the rebuild so the dep walker uses the session's live
   901	        // (potentially UDF-aware) registry rather than a fresh
   902	        // `default_registry()`. `rematerialize` runs on every undo/redo; the
   903	        // 6.4-0 H2 audit-fix closed the parallel `recompute_all` site but
   904	        // missed this one and `from_workbook` — both surfaced by the 6.4-1
   905	        // cycle-2 Opus lane. Behavior-preserving today; prevents future
   906	        // silent divergence once 6.4-2 wires `register_function`.
   907	        self.graph =
   908	            CalcgraphSession::rebuild_from_workbook_with_registry(&self.workbook, &self.registry)
   909	                .session;
   910	        // Recompute computed values with the op-log detached (no spurious ops /
   911	        // no UndoManager commit). The result's failures become diagnostics.
   912	        // **6.4B closure-audit (MED):** arm the op-budget — undo/redo can replay a
   913	        // workbook with many UDF cells; without this the pass is bounded only by the
   914	        // 30s per-call deadline (the N×30s aggregate stall item H exists to close).
   915	        let op_deadline = self.udf_op_deadline_for_pass();
   916	        let result = self.with_runtime_no_oplog(|rt| {
   917	            rt.arm_udf_op_deadline(op_deadline);
   918	            rt.recompute_all()
   919	        });
   920	        for failure in &result.failures {
   921	            self.events.push(Event::CellDiagnostic {
   922	                diagnostic: Diagnostic {
   923	                    addr: Some(CellAddr {
   924	                        sheet: failure.sheet,
   925	                        row: failure.row,
   926	                        col: failure.col,
   927	                    }),
   928	                    severity: Severity::Error,
   929	                    code: "formula_recompute_failed".to_string(),
   930	                    message: failure.error.to_string(),
   931	                },
   932	            });
   933	        }
   934	        // The wholesale rebuild cannot be conveyed incrementally → force a full
   935	        // rebuild for any outstanding token (and advance the state token).
   936	        self.bump_epoch();
   937	        self.state_seq += 1;
   938	        Ok(())
   939	    }
