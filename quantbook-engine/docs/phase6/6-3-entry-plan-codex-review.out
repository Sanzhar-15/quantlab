  4573	/// **6.4-2:** JS→Rust enum-string mapper. Free-fn rather than a method to keep
  4574	/// the DTO type itself a plain data carrier (no impl blocks on `#[napi(object)]`
  4575	/// types — napi-rs is happiest that way).
  4576	fn arity_from_json(a: ArityJson) -> Result<ql_session::function_meta::Arity> {
  4577	    use ql_session::function_meta::Arity;
  4578	    // **6.4-2 cycle-2 audit-fix (F3 — Codex / Opus L2):** strict tagged union.
  4579	    // Each `kind` admits ONLY its own payload fields; an extraneous field
  4580	    // (e.g. `{kind:"variadic", n:7}` or `{kind:"fixed", n:3, min:5}`) is a
  4581	    // malformed DTO and is REJECTED loudly, not silently ignored. This keeps the
  4582	    // JS→Rust mapper as strict as the enum-string mappers (No-Fallbacks: a
  4583	    // caller's malformed DTO surfaces, it is not normalized away).
  4584	    match a.kind.as_str() {
  4585	        "fixed" => {
  4586	            if a.min.is_some() || a.max.is_some() {
  4587	                return Err(bad_argument_error(
  4588	                    "ArityJson kind 'fixed' must carry only 'n' (got 'min'/'max')".into(),
  4589	                ));
  4590	            }
  4591	            let n = a.n.ok_or_else(|| {
  4592	                bad_argument_error("ArityJson kind 'fixed' requires field 'n'".into())
  4593	            })?;
  4594	            let n = u8::try_from(n).map_err(|_| {
  4595	                bad_argument_error(format!(
  4596	                    "ArityJson 'fixed': n={n} exceeds u8 range (0..=255)"
  4597	                ))
  4598	            })?;
  4599	            Ok(Arity::Fixed { n })
  4600	        }
  4601	        "range" => {
  4602	            if a.n.is_some() {
  4603	                return Err(bad_argument_error(
  4604	                    "ArityJson kind 'range' must carry 'min'/'max', not 'n'".into(),
  4605	                ));
  4606	            }
  4607	            let min = a.min.ok_or_else(|| {
  4608	                bad_argument_error("ArityJson kind 'range' requires field 'min'".into())
  4609	            })?;
  4610	            let min = u8::try_from(min).map_err(|_| {
  4611	                bad_argument_error(format!(
  4612	                    "ArityJson 'range': min={min} exceeds u8 range (0..=255)"
  4613	                ))
  4614	            })?;
  4615	            let max = a
  4616	                .max
  4617	                .map(|m| {
  4618	                    u8::try_from(m).map_err(|_| {
  4619	                        bad_argument_error(format!(
  4620	                            "ArityJson 'range': max={m} exceeds u8 range (0..=255)"
  4621	                        ))
  4622	                    })
  4623	                })
  4624	                .transpose()?;
  4625	            // Reject an inverted range loudly (max < min is not a valid arity).
  4626	            if let Some(mx) = max {
  4627	                if mx < min {
  4628	                    return Err(bad_argument_error(format!(
  4629	                        "ArityJson 'range': max ({mx}) must be >= min ({min})"
  4630	                    )));
  4631	                }
  4632	            }
  4633	            Ok(Arity::Range { min, max })
  4634	        }
  4635	        "variadic" => {
  4636	            if a.n.is_some() || a.min.is_some() || a.max.is_some() {
  4637	                return Err(bad_argument_error(
  4638	                    "ArityJson kind 'variadic' must carry no payload (got 'n'/'min'/'max')".into(),
  4639	                ));
  4640	            }
  4641	            Ok(Arity::Variadic)
  4642	        }
  4643	        other => Err(bad_argument_error(format!(
  4644	            "ArityJson: unknown kind {other:?} (expected 'fixed'|'range'|'variadic')"
  4645	        ))),
  4646	    }
  4647	}
  4648	
  4649	fn arity_to_json(a: ql_session::function_meta::Arity) -> ArityJson {
  4650	    use ql_session::function_meta::Arity;
  4651	    match a {
  4652	        Arity::Fixed { n } => ArityJson {
  4653	            kind: "fixed".to_string(),
  4654	            n: Some(u32::from(n)),
  4655	            min: None,
  4656	            max: None,
  4657	        },
  4658	        Arity::Range { min, max } => ArityJson {
  4659	            kind: "range".to_string(),
  4660	            n: None,
  4661	            min: Some(u32::from(min)),
  4662	            max: max.map(u32::from),
  4663	        },
  4664	        Arity::Variadic => ArityJson {
  4665	            kind: "variadic".to_string(),
  4666	            n: None,
  4667	            min: None,
  4668	            max: None,
  4669	        },
  4670	    }
  4671	}
