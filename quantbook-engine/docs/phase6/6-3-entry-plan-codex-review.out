  2988	        Value::Text(s) => CellValue::Text {
  2989	            text: s.to_string(),
  2990	        },
  2991	        Value::Error(e) => CellValue::Error {
  2992	            error: e.sigil().to_string(),
  2993	        },
  2994	    }
  2995	}
