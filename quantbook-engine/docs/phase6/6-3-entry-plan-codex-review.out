   959	    /// Build a full `SheetSnapshot` for one live sheet (shared by `snapshot` and
   960	    /// `snapshot_delta`'s `sheets_changed`). `None` if the sheet is gone.
   961	    fn build_sheet_snapshot(&self, sheet_id: SheetId) -> Option<SheetSnapshot> {
