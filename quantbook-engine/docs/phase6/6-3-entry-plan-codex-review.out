  2936	/// Map a `ql_types::Value` to the contract's `CellValue` (`None` for `Blank` —
  2937	/// a cell with no committed value). `Pending` has no `Value` analog.
  2938	fn value_to_cell_value(v: &Value) -> Option<CellValue> {
  2939	    match v {
  2940	        Value::Blank => None,
  2941	        Value::Number(n) => Some(CellValue::Number { number: *n }),
  2942	        Value::Boolean(b) => Some(CellValue::Boolean { boolean: *b }),
  2943	        Value::Text(s) => Some(CellValue::Text {
  2944	            text: s.to_string(),
  2945	        }),
  2946	        Value::Error(e) => Some(CellValue::Error {
  2947	            error: e.sigil().to_string(),
  2948	        }),
  2949	    }
  2950	}
  2951	
  2952	/// Map a contract `CellValue` to a `ql_types::Value` for use as a literal input.
  2953	/// `Pending` and `Error` are rejected as inputs (an error VALUE is a formula
  2954	/// *output*, not a literal you type); non-finite numbers are rejected.
  2955	fn cell_value_to_value(cv: CellValue) -> EngineResult<Value> {
  2956	    match cv {
  2957	        CellValue::Number { number } => {
  2958	            if number.is_finite() {
  2959	                Ok(Value::Number(number))
  2960	            } else {
  2961	                Err(EngineError::bad_argument(
  2962	                    "numeric value must be finite (NaN/Inf rejected)",
  2963	                ))
  2964	            }
  2965	        }
  2966	        CellValue::Boolean { boolean } => Ok(Value::Boolean(boolean)),
  2967	        CellValue::Text { text } => Ok(Value::Text(Arc::from(text.as_str()))),
  2968	        CellValue::Error { error } => Err(EngineError::bad_argument(format!(
  2969	            "cannot set a cell to a literal error value ({error}); error values are formula outputs"
  2970	        ))),
  2971	        // Blank as an input means "clear the cell's value".
  2972	        CellValue::Blank => Ok(Value::Blank),
  2973	        CellValue::Pending => Err(EngineError::bad_argument(
  2974	            "Pending is a computed-state marker, not a valid input value",
  2975	        )),
  2976	    }
  2977	}
