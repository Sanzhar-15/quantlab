  1065	    /// Collect the populated `(row, col)` coordinates of one sheet from the live
  1066	    /// workbook (overlay value cells ∪ formula cells ∪ format-overlay cells).
  1067	    /// See the module-level read-path enumeration note.
  1068	    fn populated_coords(&self, sheet_id: SheetId) -> Vec<(RowId, ColId)> {
  1069	        let mut set: HashSet<(RowId, ColId)> = HashSet::new();
  1070	        if let Some(sheet) = self.workbook.sheet(sheet_id) {
  1071	            // Value cells: union of user + computed overlay keys across columns.
  1072	            for col in 0..sheet.column_count() as ColId {
  1073	                if let Some(column) = sheet.column(col) {
  1074	                    let chunk_rows = column.chunk_rows();
  1075	                    for (chunk_idx, _base, user, computed) in column.iter_chunks() {
  1076	                        let base_row = chunk_idx as u32 * chunk_rows;
  1077	                        for (rel_row, _v) in user.iter() {
  1078	                            set.insert((base_row + rel_row, col));
  1079	                        }
  1080	                        for (rel_row, _v) in computed.iter() {
  1081	                            set.insert((base_row + rel_row, col));
  1082	                        }
  1083	                    }
  1084	                }
  1085	            }
  1086	            // Format-only cells.
  1087	            for ((row, c), _fmt) in sheet.format_overlay().iter() {
  1088	                set.insert((row, c));
  1089	            }
  1090	        }
  1091	        // Formula cells (a formula cell can be Blank-valued but still present).
  1092	        for (s, row, col, _text) in self.workbook.iter_formulas() {
  1093	            if s == sheet_id {
  1094	                set.insert((row, col));
  1095	            }

