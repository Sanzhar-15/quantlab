  2389	        let n_cols = range.end_col - range.start_col + 1;
  2390	        // Guard against an OOM on a pathological whole-sheet request (the read is
  2391	        // a deliberate caller request, but a fixed cap fails loud rather than
  2392	        // allocating gigabytes of Blanks).
  2393	        const MAX_CELLS: u64 = 1 << 20; // ~1M cells
  2394	        if (n_rows as u64) * (n_cols as u64) > MAX_CELLS {
  2395	            return Err(EngineError::bad_argument(format!(
  2396	                "range too large: {n_rows}x{n_cols} exceeds the {MAX_CELLS}-cell query cap"
  2397	            )));
  2398	        }
  2399	        let mut columns = Vec::with_capacity(n_cols as usize);
  2400	        for col in range.start_col..=range.end_col {
  2401	            let mut values = Vec::with_capacity(n_rows as usize);
  2402	            for row in range.start_row..=range.end_row {
  2403	                values.push(value_to_cell_value_dense(&sheet.read(row, col)));
  2404	            }
  2405	            columns.push(RangeColumn { values });
  2406	        }
  2407	        Ok(RangeResult {
  2408	            schema_version: SCHEMA_VERSION,
  2409	            range,
  2410	            n_rows,
  2411	            n_cols,
  2412	            columns,
  2413	        })
  2414	    }
