  4361	// ============================================================================
  4362	// 6.4-3d Step 5 (2026-05-29) — event-stream DTOs (`pollEvents`).
  4363	//
  4364	// The engine's `Event` ring (contract §9) is surfaced to JS so `CellDiagnostic`
  4365	// (the UDF no-worker / raised / timeout / died sink shipped in 6.4-3d Steps 1-3)
  4366	// reaches the IDE — without it the IDE can render `#CALC!` but not WHY. Every
  4367	// `Event` variant is modeled faithfully (No-Fallbacks: no variant is silently
  4368	// dropped). napi-rs camelCases the object field names (e.g. `next_cursor` →
  4369	// `nextCursor`, `structure_kind` → `structureKind`).
  4370	// ============================================================================
  4371	
  4372	/// JS-facing cell address (mirrors [`ql_session::CellAddr`]); `sheet` widened
  4373	/// u16→u32 (lossless), `row`/`col` are the 0-indexed u32 ids.
  4374	#[napi(object)]
  4375	pub struct CellAddrJson {
  4376	    pub sheet: u32,
  4377	    pub row: u32,
  4378	    pub col: u32,
  4379	}
  4380	
  4381	/// JS-facing per-cell diagnostic (mirrors [`ql_session::Diagnostic`]).
  4382	/// `severity` is `"info"` | `"warning"` | `"error"`; `addr` is absent for a
  4383	/// workbook-level diagnostic.
  4384	#[napi(object)]
  4385	pub struct DiagnosticJson {
  4386	    pub addr: Option<CellAddrJson>,
  4387	    pub severity: String,
  4388	    pub code: String,
  4389	    pub message: String,
  4390	}
  4391	
  4392	/// JS-facing operation state (mirrors [`ql_session::OperationState`]).
  4393	/// `state` is `"running"` | `"completed"` | `"canceled"` | `"failed"`; `error`
  4394	/// carries the `[code] message` display ONLY when `state == "failed"`.
  4395	#[napi(object)]
  4396	pub struct OperationStateJson {
  4397	    pub state: String,
  4398	    pub error: Option<String>,
  4399	}
  4400	
  4401	/// JS-facing event (mirrors [`ql_session::session::Event`]). A tagged union: the
  4402	/// `kind` discriminator selects which optional payload fields are populated —
  4403	/// the same shape discipline as [`CellValueJson`]. Variant → fields:
  4404	/// - `"recalc_progress"`: `op`, `done`, `total`
  4405	/// - `"cell_diagnostic"`: `diagnostic`
  4406	/// - `"operation_completed"`: `op`, `state`
  4407	/// - `"provenance"`: `addr`, `source`
  4408	/// - `"structure_changed"`: `structureKind`, `target`
  4409	/// - `"full_resync_required"`: (no payload — the consumer must reseed via
  4410	///   `snapshot()`, contract §9)
  4411	#[napi(object)]
  4412	pub struct EventJson {
  4413	    pub kind: String,
  4414	    /// `recalc_progress` / `operation_completed`: the operation id.
  4415	    pub op: Option<BigInt>,
  4416	    /// `recalc_progress`: nodes done so far.
  4417	    pub done: Option<BigInt>,
  4418	    /// `recalc_progress`: total nodes.
  4419	    pub total: Option<BigInt>,
  4420	    /// `cell_diagnostic`: the diagnostic.
  4421	    pub diagnostic: Option<DiagnosticJson>,
  4422	    /// `operation_completed`: the terminal state.
  4423	    pub state: Option<OperationStateJson>,
  4424	    /// `provenance`: the cell the provenance applies to.
  4425	    pub addr: Option<CellAddrJson>,
  4426	    /// `provenance`: the source descriptor.
  4427	    pub source: Option<String>,
  4428	    /// `structure_changed`: the structure kind (`"sheet"`/`"table"`/`"name"`).
  4429	    /// (`kind` is taken by the discriminator, hence `structureKind` in JS.)
  4430	    pub structure_kind: Option<String>,
  4431	    /// `structure_changed`: the affected target id/name.
  4432	    pub target: Option<String>,
  4433	}
