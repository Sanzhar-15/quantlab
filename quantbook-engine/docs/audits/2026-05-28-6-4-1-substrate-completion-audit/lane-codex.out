   633	
   634	fn bind_with_context_v2<L: NameLookup>(
   635	    expr: &Expr,
   636	    site: BindSite,
   637	    names: &L,
   638	    sheets: &dyn SheetResolver,
   639	    tables: &dyn TableLookup,
   640	    registry: &FunctionRegistry,
   641	    ctx: BindContext,
   642	) -> Result<ExprPlan, BindError> {
   643	    let owning_sheet = site.sheet;
   644	    match expr {
   645	        Expr::Number(n) => Ok(ExprPlan::Number(*n)),
   646	        Expr::Bool(b) => Ok(ExprPlan::Bool(*b)),
   647	        Expr::String(s) => Ok(ExprPlan::String(s.clone())),
   648	        Expr::CellRef(addr) => Ok(ExprPlan::CellRef {
   649	            sheet: resolve_sheet_ref(&addr.sheet, owning_sheet, sheets)?,
   650	            row: addr.row,
   651	            col: addr.col,
   652	            abs_col: addr.abs_col,
   653	            abs_row: addr.abs_row,
   654	        }),
   655	        Expr::Binary { op, lhs, rhs } => Ok(ExprPlan::Binary {
   656	            op: *op,
   657	            // Binary operands are always scalar context regardless of the
   658	            // outer context (Excel doesn't accept `=SUM(A1 + B1:B10)` —
   659	            // each operand to + is scalar).
   660	            lhs: Box::new(bind_with_context_v2(
   661	                lhs,
   662	                site,
   663	                names,
   664	                sheets,
   665	                tables,
   666	                registry,
   667	                BindContext::Scalar,
   668	            )?),
   669	            rhs: Box::new(bind_with_context_v2(
   670	                rhs,
   671	                site,
   672	                names,
   673	                sheets,
   674	                tables,
   675	                registry,
   676	                BindContext::Scalar,
   677	            )?),
   678	        }),
   679	        Expr::Unary { op, operand } => Ok(ExprPlan::Unary {
   680	            op: *op,
   681	            operand: Box::new(bind_with_context_v2(
   682	                operand,
   683	                site,
   684	                names,
   685	                sheets,
   686	                tables,
   687	                registry,
   688	                BindContext::Scalar,
   689	            )?),
   690	        }),
   691	        Expr::RangeRef(rr) => {
   692	            // **W5-RT-1 (RT-V1-01):** literal range args are accepted inside
   693	            // a reference-aware function arg list (`BindContext::ReferenceArg`)
   694	            // — they lower to `ExprPlan::RangeRef { range }`. Outside that
   695	            // context the rejection stands (W5-108 / Phase 4.7.O message
   696	            // preserved).
   697	            //
   698	            // AggregateArg-side enabling (which would let `SUM(A1:B3)` bind)
   699	            // is deferred: every Scalar/RangeAware/Unified dispatcher arm
   700	            // would also need new `ExprPlan::RangeRef` handling, which is
   701	            // out of scope for the reference-tier mini-phase. Tracked as a
   702	            // follow-up in the design doc § 5.4.
   703	            if ctx == BindContext::ReferenceArg {
   704	                let range = resolve_range_ref_to_range(rr, owning_sheet, sheets)?;
   705	                Ok(ExprPlan::RangeRef { range })
   706	            } else {
   707	                Err(BindError::UnsupportedVariant(
   708	                    "literal RangeRef in non-Function context is unsupported in v1; \
   709	                     use a named range (Phase 2B.4 AggregateNameRef) or wrap in an \
   710	                     aggregate function. (Updated W5-108 / Phase 4.7.O; original \
   711	                     Phase 0 W4-1 message referenced \"no function dispatch yet\" \
   712	                     which has been in place since Phase 2A. W5-RT-1 added literal \
   713	                     RangeRef support inside reference-aware fn arg lists only.)",
   714	                ))
   715	            }
   716	        }
   717	        Expr::Function { name, args } => {
   718	            // **W5-RT-1 (RT-V1-01):** reference-aware fns take args under
   719	            // `ReferenceArg` context (literal RangeRef + range NameRef both
   720	            // accepted; CellRef passes through). Aggregate/range-aware/
   721	            // unified-tier fns keep the existing `AggregateArg` context.
   722	            // Plain scalar fns get `Scalar` (rejects range args).
   723	            let arg_ctx = if is_reference_aware_function(registry, name) {
   724	                BindContext::ReferenceArg
   725	            } else if is_aggregate_function(registry, name) {
   726	                BindContext::AggregateArg
   727	            } else {
   728	                BindContext::Scalar
   729	            };
   730	            let mut bound_args = Vec::with_capacity(args.len());
   731	            for a in args {
   732	                bound_args.push(bind_with_context_v2(
   733	                    a, site, names, sheets, tables, registry, arg_ctx,
   734	                )?);
   735	            }
   736	            Ok(ExprPlan::Function {
   737	                name: name.clone(),
   738	                args: bound_args,
   739	            })
   740	        }
   741	        // **W5-99 (Phase 4.7.F):** lower `Expr::Array` to
   742	        // `ExprPlan::Array`. Per design § 5, this is element-wise +
   743	        // enforces uniform row arity AND the restricted cell-kind subset
   744	        // (Number / Bool / String / Error). The parser already validates
   745	        // both; this is defense in depth against direct AST construction.
   746	        Expr::Array(rows) => {
   747	            // **W5-99 closure (Codex MEDIUM-7 / Sonnet L-1):** reject
   748	            // degenerate shapes — zero rows OR zero cells in row 0.
   749	            // The parser rejects `{}` via `ParseError::EmptyArrayLiteral`,
   750	            // but `Expr::Array(vec![])` and `Expr::Array(vec![vec![]])`
   751	            // are directly-constructible; the latter would otherwise
   752	            // bind with `expected_arity = 0` and produce a degenerate
   753	            // ExprPlan::Array(vec![vec![]]) that downstream code would
   754	            // need a special case for.
   755	            if rows.is_empty() || rows[0].is_empty() {
   756	                return Err(BindError::EmptyArrayLiteral);
   757	            }
   758	            let expected_arity = rows[0].len() as u32;
   759	            let mut bound_rows: Vec<Vec<ExprPlan>> = Vec::with_capacity(rows.len());
   760	            for (row_idx, row) in rows.iter().enumerate() {
   761	                let found_arity = row.len() as u32;
   762	                if found_arity != expected_arity {
   763	                    return Err(BindError::ArrayRowArityMismatch {
   764	                        expected: expected_arity,
   765	                        found: found_arity,
   766	                        row: row_idx as u32,
   767	                    });
   768	                }
   769	                let mut bound_row: Vec<ExprPlan> = Vec::with_capacity(row.len());
   770	                for (col_idx, cell) in row.iter().enumerate() {
   771	                    let bound_cell = match cell {
   772	                        Expr::Number(n) => ExprPlan::Number(*n),
   773	                        Expr::Bool(b) => ExprPlan::Bool(*b),
   774	                        Expr::String(s) => ExprPlan::String(s.clone()),
   775	                        Expr::Error(ev) => ExprPlan::Error(*ev),
