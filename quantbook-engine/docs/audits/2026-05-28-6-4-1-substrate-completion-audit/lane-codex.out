  2159	            assert!(
  2160	                is_address_only_reference_fn(&registry, name),
  2161	                "design § 5.3 lists {name:?} as address-only but matcher returns false"
  2162	            );
  2163	        }
  2164	        // 6.4-1 I1: ISREF is LazyShape now, NOT AddressOnly.
  2165	        assert!(
  2166	            !is_address_only_reference_fn(&registry, "ISREF"),
  2167	            "6.4-1 I1: ISREF moved to DepShape::LazyShape; address-only matcher \
  2168	             must return false"
  2169	        );
  2170	        assert!(
  2171	            is_lazy_shape_reference_fn(&registry, "ISREF"),
