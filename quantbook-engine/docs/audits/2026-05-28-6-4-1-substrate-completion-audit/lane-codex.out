   940	/// **W5-144 (Phase 4.9.H):** narrow `@expr` at bind time per design
   941	/// § 3.3. Returns an `ExprPlan` with the wrapper dropped (every
   942	/// reachable case collapses to an existing ExprPlan shape).
   943	#[allow(clippy::too_many_arguments)]
   944	fn bind_implicit_intersection<L: NameLookup>(
   945	    inner: &Expr,
   946	    owning_sheet: SheetId,
   947	    site: BindSite,
   948	    names: &L,
   949	    sheets: &dyn SheetResolver,
   950	    tables: &dyn TableLookup,
   951	    registry: &FunctionRegistry,
   952	    ctx: BindContext,
   953	) -> Result<ExprPlan, BindError> {
   954	    match inner {
   955	        // Rule 1 / 5: scalar inputs pass through unchanged. CellRef
   956	        // is already a single cell (rule 5 — idempotent).
   957	        Expr::Number(_)
   958	        | Expr::Bool(_)
   959	        | Expr::String(_)
   960	        | Expr::Error(_)
   961	        | Expr::CellRef(_)
   962	        | Expr::R1C1Ref { .. }
   963	        | Expr::Unary { .. }
   964	        | Expr::Binary { .. }
   965	        | Expr::NameRef(_) => bind_with_context_v2(inner, site, names, sheets, tables, registry, ctx),
   966	
   967	        // Rule 8: function inner. The `@` is semantically a no-op for
   968	        // scalar function returns (most common case). Array returns
   969	        // currently surface as `#CALC!` in scalar context per existing
   970	        // 4.7.G limit; the design § 3.3 rule 7 "array → top-left" is
   971	        // a known v1 gap (deferred to cell-boundary spill rewiring).
   972	        Expr::Function { .. } => bind_with_context_v2(inner, site, names, sheets, tables, registry, ctx),
   973	
   974	        // Rule 7: array literal → top-left.
   975	        Expr::Array(rows) => {
   976	            if rows.is_empty() || rows[0].is_empty() {
   977	                return Err(BindError::EmptyArrayLiteral);
   978	            }
   979	            // Bind the top-left cell as a standalone scalar.
   980	            bind_with_context_v2(
   981	                &rows[0][0],
   982	                site,
   983	                names,
   984	                sheets,
   985	                tables,
   986	                registry,
   987	                BindContext::Scalar,
   988	            )
   989	        }
   990	
   991	        // Rules 2 / 3 / 4 / 5 / 6: range narrowing using site.cell.
   992	        Expr::RangeRef(rr) => {
   993	            narrow_range_for_implicit_intersection(rr, owning_sheet, site, sheets)
   994	        }
   995	
   996	        // Rule 9: structured ref. Bind via the normal path, then
