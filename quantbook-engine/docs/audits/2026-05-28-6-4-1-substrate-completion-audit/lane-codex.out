   179	
   180	/// **6.4-0 substrate (2026-05-28):** registry-driven replacement for the
   181	/// prior hardcoded whitelist. Returns true iff the function name carries
   182	/// `Volatility::Volatile` (NOW/TODAY/RAND/RANDBETWEEN/RANDARRAY —
   183	/// recompute every recalc) OR `Volatility::Dynamic` (INDIRECT/OFFSET/
   184	/// INFO/CELL — workbook-structure sensitive). Today's volatile-pass
   185	/// machinery (`volatile_formulas: HashSet<NodeId>` set + Phase 3.7
   186	/// invalidation) treats both classes the same — include in the pass —
   187	/// so the migration is behavior-preserving even though the DTO splits
   188	/// the axes. 6.4 may refine `Dynamic` to a structure-change trigger
   189	/// rather than every-recalc.
   190	///
   191	/// **Unknown-function policy (substrate v1):** returns `false`. Today's
   192	/// hardcoded whitelist had the same effect (`matches!` returns false on
   193	/// unknown). Contract §10.3 specifies "Unknown = graph-visible / treated
   194	/// Volatile-or-Dynamic"; the substrate keeps today's behavior because
   195	/// the call site only registers volatility (the formula stays graph-
   196	/// visible regardless via the normal cell-dep + name-dep paths). 6.4
   197	/// will tighten this when UDF metadata becomes session-scoped.
   198	///
   199	/// Names are case-insensitive on lookup (the registry canonicalizes the
   200	/// query), so `Expr::Function::name` not being normalized at the call
   201	/// site is OK — but the parser already canonicalizes (per AST docs).
   202	pub(crate) fn is_volatile_function(registry: &FunctionRegistry, name: &str) -> bool {
   203	    matches!(
   204	        registry.metadata(name).map(|m| m.volatility),
   205	        Some(Volatility::Volatile) | Some(Volatility::Dynamic)
   206	    )
   207	}
   208	
   209	/// **W5-RT-1 (RT-V1-01) — Step 1.1 / S1-HIGH-D rename:** reference-aware
   210	/// functions whose result depends only on the **address or syntactic shape**
   211	/// of their argument — NOT on the referenced cell's value. The dep walker
   212	/// routes their arg lists through [`walk_plan_for_address_only_deps`]
   213	/// instead of the normal walker.
   214	///
   215	/// - `ROW(A1)` / `COLUMN(A1)`: result = A1's address indices; A1's value
   216	///   is irrelevant.
   217	/// - `ROWS(A1:B3)` / `COLUMNS(A1:B3)`: result = range dimensions; cell
   218	///   values inside are irrelevant.
   219	/// - `ISREF(arg)`: result = syntactic shape of `arg`; no evaluation at all.
   220	///
   221	/// `ISFORMULA` and `FORMULATEXT` are NOT in this list — their result
   222	/// depends on storage metadata (formula-vs-literal, formula source text)
   223	/// of the referenced cell. They keep value-deps as a v1 cost (the right
   224	/// fix is a `formula_status_deps` dep kind that fires only on
   225	/// `on_set_formula` / `on_clear_formula`, not on `set_value` — out of v1
   226	/// scope per design § 8 R8).
   227	///
   228	/// **Audit context (S1-HIGH-A from `2026-05-17-rt-step-1-codex.md`):** the
   229	/// initial Step 1 implementation suppressed *all* arg walking by fn name,
   230	/// which dropped value-deps for non-reference arg shapes too — e.g.,
   231	/// `ROW(A1+1)` lost A1's dep because the walker never descended into the
   232	/// `Binary` arm even though the eager materializer evaluated A1+1 at
   233	/// dispatch time. This pinned a false invariant ("ref-aware fn result
   234	/// depends only on its arg's address") that the materializer doesn't
   235	/// honor for non-reference shapes. The Step 1.1 closure switches to
   236	/// **shape-aware** suppression — only direct `CellRef` / `RangeRef` args
   237	/// skip value-deps; everything else (Binary / Unary / Function / etc.)
   238	/// walks normally. See [`walk_plan_for_address_only_deps`] for the
   239	/// per-shape rules.
   240	///
   241	/// **Invariant pin:** the `dep_suppressed_reference_fns_match_design`
   242	/// test (S1-MED-ζ closure) asserts the list contents against the design's
   243	/// explicit enumeration; spelling drift will surface there.
   244	///
   245	/// **6.4-0 substrate (2026-05-28):** consults `FunctionRegistry` metadata
   246	/// (`DepShape::AddressOnly`) rather than a hardcoded match. The set is
   247	/// identical for built-ins today (ROW/COLUMN/ROWS/COLUMNS/ISREF) — they
   248	/// register that variant in `register_builtin_metadata`. Unknown name
   249	/// returns `false`, matching today's `matches!`-default behavior; this
   250	/// keeps the walker's address-only routing decision stable for typos
   251	/// and future-but-unregistered names.
   252	pub(crate) fn is_address_only_reference_fn(registry: &FunctionRegistry, name: &str) -> bool {
   253	    matches!(
   254	        registry.metadata(name).map(|m| m.dep_shape),
   255	        Some(DepShape::AddressOnly)
   256	    )
   257	}
   258	
   259	/// **6.4-1 (2026-05-28; I1):** registry-driven check for the LazyShape
   260	/// dep contract — ISREF today, any future UDF declaring
   261	/// `DepShape::LazyShape` tomorrow. LazyShape semantics: the function
   262	/// inspects the syntactic shape of its arg via `materialize_ref_arg_lazy`
   263	/// without ever evaluating it, so the walker MUST skip arg walking
   264	/// entirely (no value-deps, no volatility propagation, no nested-function
   265	/// recording).
   266	///
   267	/// Pre-6.4-1 the walker carried a hardcoded `name.as_ref() == "ISREF"`
   268	/// short-circuit in its `Function` arm; the I1 closure moves that decision
   269	/// to metadata so user-supplied UDFs participate uniformly. The walker's
   270	/// routing is now:
   271	/// 1. LazyShape → skip all arg walking.
   272	/// 2. AddressOnly → walk_plan_for_address_only_deps.
   273	/// 3. Otherwise → walk_plan_for_deps.
   274	///
   275	/// Unknown name returns `false` — the conservative routing falls through
   276	/// to the normal walker, matching pre-6.4-1's `false` default.
   277	pub(crate) fn is_lazy_shape_reference_fn(registry: &FunctionRegistry, name: &str) -> bool {
   278	    matches!(
   279	        registry.metadata(name).map(|m| m.dep_shape),
   280	        Some(DepShape::LazyShape)
   281	    )
   282	}
   283	
   284	/// Phase 3.2 — direct-dep collection extracted from walking a bound
   285	/// `ExprPlan`. Fields are owned (no borrows) so the caller can pass
   286	/// the collection around or store it without lifetime ceremony.
   287	///
   288	/// `cells`, `named_ranges`, and `names` are deduplicated by the
   289	/// `extract_and_register_deps` orchestrator (the walker emits
   290	/// duplicates; the orchestrator collapses).
   291	#[derive(Clone, Debug, Default, PartialEq)]
   292	pub struct FormulaDeps {
   293	    /// Direct cell references (`ExprPlan::CellRef`). Resolved sheet
   294	    /// is included.
   295	    pub cells: Vec<(SheetId, RowId, ColId)>,
   296	    /// Named-range references (`ExprPlan::AggregateNameRef`). Each
   297	    /// entry pairs the canonical (uppercase) name with the resolved
   298	    /// `Range` payload.
   299	    pub named_ranges: Vec<(Arc<str>, Range)>,
   300	    /// Names referenced by the formula. Currently only names that
   301	    /// resolve to ranges populate this (via `AggregateNameRef`); see
   302	    /// module docs for the limitation around scalar-resolved names.
   303	    pub names: Vec<Arc<str>>,
   304	    /// **W5-154 (Phase 4.8.G.3 foundation):** table names referenced by
   305	    /// the formula (via `ExprPlan::StructuredRef.table_name`). Used by
   330	    /// volatility is itself a graph-meaningful "dep" on the volatile-pass
   331	    /// machinery). Useful for summary metrics; Phase 3.10 megaudit /
   332	    /// ql-profile will surface per-formula dep counts in the graph-
   333	    /// profile JSON.
   334	    ///
   335	    /// Pre-6.4-1 this only summed `cells + named_ranges` (2 of 6 fields),
   336	    /// silently understating the dep count for formulas that touched a
   337	    /// `Name` (without resolving to a Range), a `Table` (structured-ref
   338	    /// `Sales[Qty]`), or a function (any formula calling a function had
   339	    /// `functions_used >= 1` but `len() == 0` if no cells/named-ranges).
   340	    /// The substrate's `extract_and_register_deps` orchestrator papered
   341	    /// over this with a 5-clause `||`-chain at the storage gate; the M1
   342	    /// fix moves the truth back to a single canonical method.
   343	    pub fn len(&self) -> usize {
   344	        self.cells.len()
   345	            + self.named_ranges.len()
   346	            + self.names.len()
   347	            + self.tables.len()
   348	            + self.functions_used.len()
   349	            + usize::from(self.is_volatile)
   350	    }
   351	
   352	    /// **6.4-1 (2026-05-28; M1):** true iff no tracked-dep field has any
   353	    /// entry AND the formula is not volatile. The substrate's storage gate
   354	    /// at `extract_and_register_deps` is now a single `!deps.is_empty()`
   355	    /// check instead of the 5-clause `||`-chain the substrate audit-fix
   356	    /// added (which the M1 disposition flagged as papering over this
   357	    /// method's lie).
   358	    pub fn is_empty(&self) -> bool {
   359	        self.cells.is_empty()
   360	            && self.named_ranges.is_empty()
   361	            && self.names.is_empty()
   362	            && self.tables.is_empty()
   363	            && self.functions_used.is_empty()
   364	            && !self.is_volatile
   365	    }
   366	}
   367	
   368	/// Phase 3.2 — recursive walker. Accumulates dependencies + volatile-
   369	/// function presence by descending the `ExprPlan` tree. Does not
   370	/// allocate any nodes or touch any graph state; pure read.
   371	pub(crate) fn walk_plan_for_deps(
   372	    plan: &ExprPlan,
   373	    deps: &mut FormulaDeps,
   374	    registry: &FunctionRegistry,
   375	) {
   376	    match plan {
   377	        ExprPlan::Number(_) | ExprPlan::Bool(_) | ExprPlan::String(_) => {
   378	            // Leaf literals carry no dependencies.
   379	        }
   380	        ExprPlan::CellRef {
   381	            sheet, row, col, ..
   382	        } => {
   383	            deps.cells.push((*sheet, *row, *col));
   384	        }
   385	        ExprPlan::Binary { lhs, rhs, .. } => {
   386	            walk_plan_for_deps(lhs, deps, registry);
   387	            walk_plan_for_deps(rhs, deps, registry);
   388	        }
   389	        ExprPlan::Unary { operand, .. } => {
   390	            walk_plan_for_deps(operand, deps, registry);
   391	        }
   392	        ExprPlan::Function { name, args } => {
   393	            // **6.4-0 substrate (2026-05-28):** record the function name
   394	            // in `functions_used` BEFORE any routing decision so every
   395	            // path through the arm (volatile / address-only / ISREF
   396	            // short-circuit / normal) participates uniformly. The arm
   397	            // RE-ENTERS the walker for non-ref arg subtrees via either
   398	            // `walk_plan_for_address_only_deps` (which delegates back to
   399	            // `walk_plan_for_deps` for nested functions) or the normal
   400	            // for-loop below, so nested calls like `ROW(NOW())` record
   401	            // both `ROW` and `NOW` in walk order. Duplicates are
   402	            // collapsed by the `extract_and_register_deps` orchestrator
   403	            // when folding into the session reverse index.
   404	            deps.functions_used.push(Arc::clone(name));
   405	            if is_volatile_function(registry, name) {
   406	                deps.is_volatile = true;
   407	            }
   408	            // **W5-RT-3.1 (S3-HIGH-2 closure — Codex MEDIUM-1 + Opus
   409	            // HIGH-S3-O-2 convergent):** the dep walker now distinguishes
   410	            // THREE policies per fn-name:
   411	            //
   412	            // 1. **ISREF** (LazyShape contract): NO arg walking at all.
   413	            //    ISREF inspects the syntactic shape of its arg via
   414	            //    `materialize_ref_arg_lazy` — it never evaluates Binary
   415	            //    / Unary / Function subtrees, so registering their inner
   416	            //    value-deps / volatility is pure waste. `ISREF(NOW())`
   417	            //    must NOT mark the formula volatile; `ISREF(A1+1)` must
   418	            //    NOT register A1's dep.
   419	            //
   420	            // 2. **ROW / COLUMN / ROWS / COLUMNS** (Eager + address-only):
   421	            //    `walk_plan_for_address_only_deps` — skips value-deps on
   422	            //    direct CellRef/RangeRef (their address is the input,
   423	            //    addresses don't change without structural events), but
   424	            //    recurses normally on Binary/Unary/Function subtrees
   425	            //    because the eager materializer DOES evaluate those.
   426	            //    `ROW(A1+1)` must keep A1's dep.
   427	            //
   428	            // 3. **ISFORMULA / FORMULATEXT** (Eager + workbook query):
   429	            //    normal walker — value-deps as v1 cost per design § 8
   430	            //    R8. A future `formula_status_deps` kind would
   431	            //    differentiate; out of v1 scope.
   432	            //
   433	            // The previous Step 1.1 design routed ISREF through path 2,
   434	            // which produced wrong behavior under LazyShape (Step 3
   435	            // audit caught this).
   436	            if is_lazy_shape_reference_fn(registry, name) {
   437	                // **6.4-1 (2026-05-28; I1):** LazyShape contract — NO arg
   438	                // walking. Pre-6.4-1 this was a hardcoded
   439	                // `name.as_ref() == "ISREF"` check; the I1 closure routes
   440	                // through metadata so any UDF declaring
   441	                // `dep_shape: LazyShape` participates uniformly. ISREF
   442	                // remains the only built-in with this contract today (its
   443	                // Phase-1 override in `register_builtin_metadata` sets
   444	                // `DepShape::LazyShape`).
   445	                //
   446	                // The args' inner value-deps / volatility / structural
   447	                // deps don't affect a LazyShape function's result.
   448	            } else if is_address_only_reference_fn(registry, name) {
   449	                for arg in args {
   450	                    walk_plan_for_address_only_deps(arg, deps, registry);
   451	                }
   452	            } else {
   453	                for arg in args {
   454	                    walk_plan_for_deps(arg, deps, registry);
   455	                }
   456	            }
   457	        }
   458	        ExprPlan::AggregateNameRef { name, range } => {
   459	            deps.named_ranges.push((Arc::clone(name), *range));
   460	            deps.names.push(Arc::clone(name));
   461	        }
   462	        // **W5-RT-3.1 (S3-HIGH-3 / Codex Step 3 HIGH-2 closure):**
   463	        // literal range refs bind to `ExprPlan::RangeRef { range }`
   464	        // inside reference-aware fn arg lists. Consumers:
   465	        //   - ROW/COLUMN/ROWS/COLUMNS: route through
   466	        //     `walk_plan_for_address_only_deps`, which has its own
   467	        //     `RangeRef` arm (no-op — addresses don't change without
   468	        //     structural events). This arm is NOT reached for those.
   469	        //   - ISREF (LazyShape): the `ExprPlan::Function` arm's
   470	        //     `name == "ISREF"` branch SHORT-CIRCUITS all arg walking.
   471	        //     This arm is NOT reached for ISREF either.
   472	        //   - **ISFORMULA / FORMULATEXT (W5-RT-3 / W5-RT-4):** route
   473	        //     through the normal walker AND can take 1×1-range args
   474	        //     (treated as single-cell per design § 2.4). When the range
   475	        //     is 1×1, push a cell-dep so the formula correctly dirties
   540	///   rename / retarget invalidates this formula, but do NOT push to
   541	///   `named_ranges` (no cell-stripe registration; range values don't
   542	///   affect the result).
   543	/// - `StructuredRef { table_name, resolved }` — register the TABLE name
   544	///   dep so `on_table_*` mutation hooks fire, but no value-dep on the
   545	///   resolved range.
   546	/// - Everything else (Binary / Unary / Function / Array / Error / Number
   547	///   / Bool / String) — walk normally via [`walk_plan_for_deps`]. The
   548	///   eager materializer evaluates these args at dispatch time, so their
   549	///   inner inputs DO affect the (typically `#VALUE!`) result class and
   550	///   any error propagation. `ROW(A1+1)` MUST keep A1's dep; `ROW(NOW())`
   551	///   MUST mark the formula volatile.
   552	///
   553	/// **Audit context (Codex S1-HIGH-1 / Opus S1-HIGH-3):** the initial
   554	/// Step 1 implementation suppressed *all* arg walking by fn name, which
   555	/// broke this invariant for non-reference arg shapes — `ROW(A1+1)` lost
   556	/// A1's dep entirely. The Codex audit caught the asymmetry between
   557	/// materializer eager-eval and walker suppression; the Opus audit
   558	/// documented the resulting volatile re-firing under suppressed deps.
   559	/// Step 1.1 closes both by making the walker shape-aware.
   560	fn walk_plan_for_address_only_deps(
   561	    plan: &ExprPlan,
   562	    deps: &mut FormulaDeps,
   563	    registry: &FunctionRegistry,
   564	) {
   565	    match plan {
   566	        // Direct reference shapes: skip value-deps. Address is the input.
   567	        ExprPlan::CellRef { .. } | ExprPlan::RangeRef { .. } => {}
   568	        // Structural-dep only: rename / retarget invalidates this
   569	        // formula, but cell-stripe values inside the range don't.
   570	        ExprPlan::AggregateNameRef { name, .. } => {
   571	            deps.names.push(Arc::clone(name));
   572	        }
   573	        ExprPlan::StructuredRef { table_name, .. } => {
   574	            deps.tables.push(Arc::clone(table_name));
   575	        }
   576	        // Non-reference shapes: walk normally. The eager materializer
   577	        // evaluates them; their inputs affect the result class and
   578	        // error propagation. Wasted CPU under volatile / nested calls
   579	        // is acceptable v1 cost (see S1-HIGH-E doc note). The
   580	        // delegation passes `registry` through so a nested
   581	        // `ExprPlan::Function` arg can consult metadata (6.4-0
   582	        // substrate).
   583	        _ => walk_plan_for_deps(plan, deps, registry),
   584	    }
   585	}
