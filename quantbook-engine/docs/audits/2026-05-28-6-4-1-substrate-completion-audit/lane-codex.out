  1687	
  1688	    // A trivial test fixture: a context-aware fn that returns the
  1689	    // workbook's date-system as a Number (1900→1900.0, 1904→1904.0).
  1690	    // Lets us verify dispatch + arg-shape without depending on any
  1691	    // not-yet-implemented date function.
  1692	    fn echo_date_system_year(args: &[Value], ctx: &ql_types::EvalContext) -> Value {
  1693	        if !args.is_empty() {
  1694	            return Value::Error(ql_types::ErrorValue::Value);
  1695	        }
  1696	        let n = match ctx.date_system {
  1697	            ql_types::DateSystem::Excel1900 => 1900.0,
  1698	            ql_types::DateSystem::Excel1904 => 1904.0,
  1699	        };
  1700	        Value::Number(n)
  1701	    }
