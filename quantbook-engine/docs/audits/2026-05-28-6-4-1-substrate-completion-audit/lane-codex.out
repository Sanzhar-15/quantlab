   390	/// Phase 2B.4 (2026-05-12): hardcoded list of functions whose arguments
   391	/// accept aggregate-range / named-range inputs. The function name is
   392	/// historical — this list is now better understood as "names for which
   393	/// the binder allows `AggregateNameRef` in arg positions"; both scalar
   394	/// aggregates (SUM, AVERAGE) AND range-aware functions (SUMIF, VLOOKUP,
   395	/// LARGE, ...) live here.
   396	///
   397	/// **6.4-1 (2026-05-28; H1):** the prior ~66-entry `matches!` whitelist
   398	/// is now a thin migration shim that reads
   399	/// `FunctionRegistry::metadata(name).arg_context == ArgContext::Aggregate`.
   400	/// The Phase 1.5 override pass in
   401	/// `ql_functions::register_builtin_metadata` mirrors the prior list
   402	/// byte-for-byte; the shim is behavior-preserving against the prior
   403	/// `matches!`. The `is_aggregate_function_lists_only_registered_aggregates`
   404	/// invariant test (`workbook_runtime/validate.rs`) now also flows
   405	/// through metadata — same direction, derived from one source.
   406	///
   407	/// **Unknown name policy:** returns `false` — matches the pre-6.4-1
   408	/// `matches!` default (any name not in the list) and ensures unknown
   409	/// functions (including UDFs that haven't registered yet) get
   410	/// `BindContext::Scalar`. UDFs that need range args MUST register
   411	/// `ArgContext::Aggregate` via `register_metadata` before binding any
   412	/// formula that uses them with a range arg — same contract as the
   413	/// pre-6.4-1 hardcoded list (where adding a new aggregate required a
   414	/// source edit + recompile).
   415	///
   416	/// Aggregate detection is binary in V0 (all args are aggregate or no args
   417	/// are). Per-arg-position decisions (e.g. IF's then/else accept arrays in
   418	/// some contexts) land alongside Engine Phase 4.7 array formulas.
   419	pub(crate) fn is_aggregate_function(registry: &FunctionRegistry, name: &str) -> bool {
   420	    matches!(
   421	        registry.metadata(name).map(|m| m.arg_context),
   422	        Some(ArgContext::Aggregate)
   423	    )
   424	}
   425	
   426	/// **W5-RT-1 (RT-V1-01):** classifier for the reference-aware dispatch tier.
   427	/// These functions take their args under `BindContext::ReferenceArg` rather
   428	/// than `Scalar` or `AggregateArg`. ReferenceArg context accepts:
   429	///
   430	/// - `Expr::CellRef` → `ExprPlan::CellRef` (unchanged).
   431	/// - `Expr::RangeRef` → `ExprPlan::RangeRef { range }` (NEW; the only context
   432	///   that accepts literal ranges at bind time today).
   433	/// - `Expr::NameRef` resolving to a `NamedTarget::Range` →
   434	///   `ExprPlan::AggregateNameRef` (same as `AggregateArg` semantics).
   435	/// - `Expr::Array(_)` → `ExprPlan::Array(_)` for `ROWS({1,2,3;4,5,6})`.
   436	/// - Everything else → bound as Scalar sub-expression (the per-fn impl
   437	///   surfaces `#VALUE!` / `#N/A` for non-reference args per Excel canon).
   438	///
   439	/// **Step 2.1 (S2-MED-α closure):** pinned by two invariant tests:
   440	///
   441	/// - `accepts_special_arg_lists_only_registered_reference_aware_matcher_pin`
   442	///   (this module's test mod) — every name the matcher returns true for
   443	///   must be in the design's enumeration; typo guard. Direction:
   444	///   matcher → list-of-7.
   445	/// - `step_2_reference_aware_names_registered_in_reference_tier` —
   446	///   registry-side: every Step 2 / 3 / 4 currently-registered
   447	///   reference-aware fn must be recognized by the matcher AND
   448	///   disjointly NOT resolve in any other tier. Direction: registry →
   449	///   matcher. Currently covers 4 of 7 (ROW/COLUMN/ROWS/COLUMNS via
   450	///   W5-RT-2 Step 2); extends as Step 3 (ISREF/ISFORMULA) and Step 4
   451	///   (FORMULATEXT) ship. The matcher pre-lists all 7 by design so the
   452	///   binder routing is stable as registrations land.
   453	pub(crate) fn is_reference_aware_function(registry: &FunctionRegistry, name: &str) -> bool {
   454	    // **6.4-1 (2026-05-28; H1):** the prior 7-entry `matches!` whitelist
   455	    // (ROW / COLUMN / ROWS / COLUMNS / ISREF / ISFORMULA / FORMULATEXT)
   456	    // now derives from `metadata.arg_context == ArgContext::Reference`.
   457	    // The Phase 1 + Phase 1.5 overrides in
   458	    // `ql_functions::register_builtin_metadata` carry the same 7 names —
   459	    // see the `step_2_reference_aware_names_registered_in_reference_tier`
   460	    // invariant test for the cross-table sync.
   461	    //
   462	    // Unknown name returns `false`, matching the prior `matches!`
   463	    // default. UDFs that want `BindContext::ReferenceArg` (e.g., a UDF
   464	    // that takes a literal `RangeRef`) MUST register
   465	    // `ArgContext::Reference` before binding.
   466	    matches!(
   467	        registry.metadata(name).map(|m| m.arg_context),
   468	        Some(ArgContext::Reference)
   469	    )
   470	}
