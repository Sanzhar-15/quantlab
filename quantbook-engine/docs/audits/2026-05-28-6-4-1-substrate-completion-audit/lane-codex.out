   287	    // ===== 6.4-0 metadata substrate (contract §10.2/§10.3) ==================
   288	
   289	    /// Case-insensitive metadata lookup. Returns `None` if no metadata is
   290	    /// registered under the canonicalized name — the **conservative
   291	    /// caller policy (contract §10.3)** is to treat an unknown function
   292	    /// as `Volatility::Dynamic` (graph-visible, never silently `Pure`)
   293	    /// at the engine layer rather than have the registry pretend to know.
   294	    /// The current `is_volatile_function` / `is_address_only_reference_fn`
   295	    /// callers preserve today's behavior (unknown = NOT volatile / NOT
   296	    /// address-only) for backward compat; 6.4 will tighten the engine-
   297	    /// side conservative default once UDFs land.
   298	    pub fn metadata(&self, name: &str) -> Option<&FunctionMetadata> {
   299	        let upper = name.to_ascii_uppercase();
