  1201	
  1202	/// **6.4-0 substrate (2026-05-28):** the builtin-metadata population
  1203	/// pass invoked at the tail of [`default_registry`]. Two phases:
  1204	///
  1205	/// 1. **Explicit overrides** for the small set of names whose volatility
  1206	///    / dep-shape diverges from the `Pure + ValueDeps` default. These
  1207	///    mirror the prior whitelists in `ql-exec::calcgraph_session`
  1208	///    (`is_volatile_function` for NOW/TODAY/RAND/.../INDIRECT/OFFSET/
  1209	///    INFO/CELL; `is_address_only_reference_fn` for ROW/COLUMN/ROWS/
  1210	///    COLUMNS/ISREF) so today's behavior carries over byte-for-byte.
  1211	///    INDIRECT/OFFSET/INFO/CELL are tagged `Volatility::Dynamic` rather
  1212	///    than `Volatile` (their result depends on workbook structure, not
  1213	///    on recalc cadence — closer to the DTO's variant rationale at
  1214	///    `crates/ql-session/src/function_meta.rs:40-43`). The engine's
  1215	///    `is_volatile_function` migration shim treats both `Volatile` and
  1216	///    `Dynamic` as "include in the volatile-pass set" to preserve today's
  1217	///    over-conservative-but-correct re-eval; 6.4 may refine.
  1218	///
  1219	/// 2. **Defaults** for every other dispatched function — `Pure +
  1220	///    ValueDeps + Scalar + Coercing + Cooperative`. Built off the
  1221	///    iteration of `r.fns.keys()` so adding a new built-in
  1222	///    auto-acquires metadata with no parallel-list maintenance burden.
  1223	///    Arity is left as `Variadic` for v1 (we don't track per-function
  1224	///    arity in the dispatch tables today; 6.4 may carry richer metadata
  1225	///    on `RegisteredFn` directly).
  1226	///
  1227	/// The two passes are **idempotent** — phase 2 inserts only when the
  1228	/// name isn't already in `metadata` (so the phase-1 overrides win).
  1229	fn register_builtin_metadata(r: &mut FunctionRegistry) {
  1230	    /// Construct the standard "pure scalar built-in" metadata for `name`
  1231	    /// — used as the default and as the base for the small set of
  1232	    /// overrides. Centralized so adding a new field to `FunctionMetadata`
  1233	    /// only touches one site.
  1234	    fn pure_scalar(name: &str) -> FunctionMetadata {
  1235	        FunctionMetadata {
  1236	            canonical_name: name.to_string(),
  1237	            display_name: None,
  1238	            aliases: Vec::new(),
  1239	            arity: Arity::Variadic,
  1240	            volatility: Volatility::Pure,
  1241	            determinism: true,
  1242	            dep_shape: DepShape::ValueDeps,
  1243	            batch_shape: BatchShape::Scalar,
  1244	            arg_policy: ArgPolicy::Coercing,
  1245	            cancellation: CancelPolicy::Cooperative,
  1246	            // **6.4-1 (2026-05-28; H1):** the conservative default. The
  1247	            // binder rejects range args under `BindContext::Scalar`, so any
  1248	            // pure-scalar built-in (ABS / SQRT / IF / …) and any unknown
  1249	            // function lands here. Phase 1.5 below explicitly overrides
  1250	            // the ~66 aggregate / range-aware / array-tier names; Phase 1
  1251	            // explicitly sets the 7 reference-aware names.
  1252	            arg_context: ArgContext::Scalar,
  1253	            provenance_tags: Vec::new(),
  1254	        }
  1255	    }
  1256	
  1257	    // ---- Phase 1: explicit overrides for the prior whitelists ----------
  1258	    //
  1259	    // Time / pseudo-random — recompute every recalc (Volatility::Volatile
  1260	    // is the natural fit). `NOW`/`TODAY` are ContextAware in the dispatch
  1261	    // tier but their VOLATILITY (axis) is independent of their dispatch
  1262	    // ABI; both are still graph-volatile.
  1263	    for name in ["NOW", "TODAY", "RAND", "RANDBETWEEN", "RANDARRAY"] {
  1264	        let mut m = pure_scalar(name);
  1265	        m.volatility = Volatility::Volatile;
  1266	        m.determinism = false;
  1267	        // `register_metadata` enforces canonical-uppercase + dup loud;
  1268	        // we built the metadata above so insertion can't conflict here
  1269	        // unless someone added a duplicate to the override list.
  1270	        r.register_metadata(m)
  1271	            .expect("phase-1 volatile override must not collide with prior phase-1 entry");
  1272	    }
  1273	    // Address-by-string / structural / environment introspection —
  1274	    // result depends on workbook structure, not just args. Tagged
  1275	    // `Dynamic` (per DTO variant rationale); the migration shim in
  1276	    // `calcgraph_session::is_volatile_function` treats Dynamic as
  1277	    // "include in the volatile-pass set" so today's behavior carries.
  1278	    for name in ["INDIRECT", "OFFSET", "INFO", "CELL"] {
  1279	        let mut m = pure_scalar(name);
  1280	        m.volatility = Volatility::Dynamic;
  1281	        m.determinism = false;
  1282	        r.register_metadata(m)
  1283	            .expect("phase-1 dynamic override must not collide with prior phase-1 entry");
  1284	    }
  1285	    // Address-only reference fns: ROW / COLUMN / ROWS / COLUMNS. The
  1286	    // walker `walk_plan_for_address_only_deps` routes their args away
  1287	    // from value-deps.
  1288	    //
  1289	    // **6.4-1 (2026-05-28; H1):** all four also gain `ArgContext::Reference`
  1290	    // so `ql-exec::plan`'s `is_reference_aware_function` derives from
  1291	    // metadata. The binder routes their args under `BindContext::ReferenceArg`
  1292	    // (accepts literal CellRef / RangeRef / NameRef).
  1293	    for name in ["ROW", "COLUMN", "ROWS", "COLUMNS"] {
  1294	        let mut m = pure_scalar(name);
  1295	        m.dep_shape = DepShape::AddressOnly;
  1296	        m.arg_context = ArgContext::Reference;
  1297	        r.register_metadata(m)
  1298	            .expect("phase-1 address-only override must not collide with prior phase-1 entry");
  1299	    }
  1300	
  1301	    // **6.4-1 (2026-05-28; I1):** ISREF gets `DepShape::LazyShape` (not
  1302	    // `AddressOnly`). LazyShape semantics: the walker never recurses,
  1303	    // never registers value-deps, never propagates volatility — `ISREF(NOW())`
  1304	    // does NOT mark the formula volatile; `ISREF(A1+1)` does NOT register
  1305	    // A1's dep. Pre-6.4-1 this was a hardcoded `name == "ISREF"` short-
  1306	    // circuit in the walker's `Function` arm; the I1 closure moves the
  1307	    // decision to metadata so 6.4 UDFs declaring `dep_shape: LazyShape`
  1308	    // get the same treatment without engine-side name special-casing. The
  1309	    // engine's `is_address_only_reference_fn` migration shim accepts BOTH
  1310	    // `AddressOnly` and `LazyShape` so the binder's reference-arg routing
  1311	    // is preserved.
  1312	    {
  1313	        let mut m = pure_scalar("ISREF");
  1314	        m.dep_shape = DepShape::LazyShape;
  1315	        m.arg_context = ArgContext::Reference;
  1316	        r.register_metadata(m)
  1317	            .expect("phase-1 ISREF override must not collide with prior phase-1 entry");
  1318	    }
  1319	
  1320	    // **6.4-1 (2026-05-28; H1):** the remaining two reference-aware
  1321	    // names — ISFORMULA and FORMULATEXT — that the binder admits under
  1322	    // `BindContext::ReferenceArg` but whose walker treats with normal
  1323	    // `ValueDeps` semantics (Eager + workbook query — design § 8 R8). They
  1324	    // need `ArgContext::Reference` from metadata; their `DepShape` stays
  1325	    // `ValueDeps` (the `pure_scalar` default).
  1326	    for name in ["ISFORMULA", "FORMULATEXT"] {
  1327	        let mut m = pure_scalar(name);
  1328	        m.arg_context = ArgContext::Reference;
  1329	        r.register_metadata(m)
  1330	            .expect("phase-1 reference-arg override must not collide with prior phase-1 entry");
  1331	    }
  1332	
  1333	    // ---- Phase 1.5: ArgContext::Aggregate overrides (H1 source) -----------
  1334	    //
  1335	    // **6.4-1 (2026-05-28; H1):** the binder-admission category for the
  1336	    // names that pre-6.4-1 lived as the ~66-entry `matches!` whitelist in
  1337	    // `ql-exec::plan::is_aggregate_function`. These names accept range
  1338	    // args (named ranges, literal ranges in some tiers, range-aware
  1339	    // dispatch) — the binder must route them under
  1340	    // `BindContext::AggregateArg` rather than `BindContext::Scalar` so
  1341	    // `=SUM(SalesRange)` etc. bind correctly. The list is mirrored from
  1342	    // the pre-6.4-1 source at `plan.rs:422-536`. Adding a name here is
  1343	    // equivalent to adding it to the pre-6.4-1 `matches!` list — the
  1344	    // `plan.rs::is_aggregate_function` shim now reads
  1345	    // `metadata.arg_context == ArgContext::Aggregate`.
  1346	    //
  1347	    // The list straddles three dispatch tiers (scalar aggregates,
  1348	    // range-aware, unified array) — `ArgContext` is orthogonal to the
  1349	    // dispatch tier and to `BatchShape` (builtin aggregates remain
  1350	    // `BatchShape::Scalar` because their eval ABI is `fn(&[Value]) -> Value`
  1351	    // per cell after the named-range cache hit; UDFs declaring
  1352	    // `BatchShape::ArrayBatch` register their own `ArgContext::Aggregate`).
  1353	    for name in [
  1354	        // Scalar aggregates (W4-4, W5-58 stats family extras).
  1355	        "SUM",
  1356	        "AVERAGE",
  1357	        "AVG",
  1358	        "COUNT",
  1359	        "COUNTA",
  1360	        "MIN",
  1361	        "MAX",
  1362	        "PRODUCT",
  1363	        "VAR",
  1364	        "VAR.S",
  1365	        "VAR.P",
  1366	        "STDEV",
  1367	        "STDEV.S",
  1368	        "STDEV.P",
  1369	        // Range-aware conditional aggregates (W5-53).
  1370	        "SUMIF",
  1371	        "COUNTIF",
  1372	        // Range-aware lookup family (W5-54).
  1373	        "MATCH",
  1374	        "INDEX",
  1375	        "VLOOKUP",
  1376	        "HLOOKUP",
  1377	        "CHOOSE",
  1378	        // Range-aware conditional-aggregate completion (W5-55).
  1379	        "AVERAGEIF",
  1380	        "SUMIFS",
  1381	        "COUNTIFS",
  1382	        "AVERAGEIFS",
  1383	        "SUMPRODUCT",
  1384	        // Range-aware stats family (W5-58).
  1385	        "LARGE",
  1386	        "SMALL",
  1387	        "RANK",
  1388	        "RANK.EQ",
  1389	        "RANK.AVG",
  1390	        "MEDIAN",
  1391	        "MODE",
  1392	        "MODE.SNGL",
  1393	        // Range-aware text completion (W5-61 polish).
  1394	        "CONCAT",
  1395	        // Unified-ABI array-returning fns (W5-107 / Phase 4.7.N).
  1396	        "TRANSPOSE",
  1397	        "FILTER",
  1398	        // Range-aware conditional-aggregate dispatcher (W5-D-12).
  1399	        "SUBTOTAL",
  1400	        // Phase 4.10 statistical paired-array fns (W5-177, W5-178,
  1401	        // W5-179, W5-D-6).
  1402	        "CORREL",
  1403	        "PEARSON",
  1404	        "RSQ",
  1405	        "STEYX",
  1406	        "SLOPE",
  1407	        "INTERCEPT",
  1408	        "COVARIANCE.P",
  1409	        "COVARIANCE.S",
  1410	        "SUMX2MY2",
  1411	        "SUMX2PY2",
  1412	        "SUMXMY2",
  1413	        // Phase 4.10 financial cash-flow fns (W5-168, W5-174, W5-D-7).
  1414	        "NPV",
  1415	        "IRR",
  1416	        "MIRR",
  1417	        "XNPV",
  1418	        "XIRR",
  1419	        // Phase 4.10 modern lookup fns (W5-169).
