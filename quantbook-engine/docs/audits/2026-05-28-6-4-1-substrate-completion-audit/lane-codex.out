  2498	    /// **6.4-1 (2026-05-28; H3):** `fn_generation()` ticks monotonically
  2499	    /// on `register_metadata` / `unregister_metadata` success only. The
  2500	    /// `PlanCache` reads this value into `PlanCacheKey::fn_gen`; a tick
  2501	    /// invalidates every plan bound before the tick → next eval re-binds
  2502	    /// against current metadata. Closes the contract §10.3
  2503	    /// "re-extract deps" half.
  2504	    #[test]
  2505	    fn fn_gen_ticks_on_successful_register_and_unregister() {
  2506	        let mut r = default_registry();
  2507	        let initial = r.fn_generation();
  2508	        assert!(initial > 0, "default_registry runs ~260+ register_metadata calls at boot");
  2509	
  2510	        // Successful register bumps once.
  2511	        let meta = FunctionMetadata {
  2512	            canonical_name: "MYUDF1".to_string(),
  2513	            display_name: None,
  2514	            aliases: vec![],
  2515	            arity: Arity::Variadic,
  2516	            volatility: Volatility::Pure,
  2517	            determinism: true,
  2518	            dep_shape: DepShape::ValueDeps,
  2519	            batch_shape: BatchShape::ArrayBatch,
  2520	            arg_policy: ArgPolicy::Coercing,
  2521	            cancellation: CancelPolicy::WorkerKill,
  2522	            arg_context: ArgContext::Aggregate,
  2523	            provenance_tags: vec![],
  2524	        };
  2525	        r.register_metadata(meta).unwrap();
  2526	        assert_eq!(r.fn_generation(), initial + 1, "register_metadata MUST bump fn_gen");
  2527	
  2528	        // Successful unregister bumps again.
  2529	        r.unregister_metadata("MYUDF1").unwrap();
  2530	        assert_eq!(r.fn_generation(), initial + 2, "unregister_metadata MUST bump fn_gen");
  2531	
  2532	        // Failed register (Conflict) MUST NOT bump.
  2533	        let snapshot = r.fn_generation();
  2534	        let dup = FunctionMetadata {
  2535	            canonical_name: "SUM".to_string(),
  2536	            display_name: None,
  2537	            aliases: vec![],
  2538	            arity: Arity::Variadic,
  2539	            volatility: Volatility::Pure,
  2540	            determinism: true,
  2541	            dep_shape: DepShape::ValueDeps,
  2542	            batch_shape: BatchShape::Scalar,
  2543	            arg_policy: ArgPolicy::Coercing,
  2544	            cancellation: CancelPolicy::Cooperative,
  2545	            arg_context: ArgContext::Aggregate,
  2546	            provenance_tags: vec![],
  2547	        };
  2548	        assert!(r.register_metadata(dup).is_err());
  2549	        assert_eq!(
  2550	            r.fn_generation(),
  2551	            snapshot,
  2552	            "failed register_metadata (Conflict) MUST leave fn_gen untouched"
  2553	        );
  2554	
  2555	        // Failed unregister (NotFound) MUST NOT bump.
  2556	        let snapshot = r.fn_generation();
  2557	        assert!(r.unregister_metadata("DOES_NOT_EXIST").is_err());
  2558	        assert_eq!(
  2559	            r.fn_generation(),
  2560	            snapshot,
  2561	            "failed unregister_metadata (NotFound) MUST leave fn_gen untouched"
  2562	        );
  2563	
  2564	        // Failed unregister (Conflict — builtin guard) MUST NOT bump either.
  2565	        let snapshot = r.fn_generation();
  2566	        assert!(r.unregister_metadata("SUM").is_err());
  2567	        assert_eq!(
  2568	            r.fn_generation(),
  2569	            snapshot,
  2570	            "failed unregister_metadata (builtin Conflict) MUST leave fn_gen untouched"
  2571	        );
  2572	    }
  2573	}

