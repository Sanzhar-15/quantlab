   121	/// Whether a function is called per-cell (scalar) or batch-shaped.
   122	#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
   123	#[serde(rename_all = "snake_case")]
   124	pub enum BatchShape {
   125	    /// One call per cell.
   126	    Scalar,
   127	    /// Arrow/array batch — UDFs use this from day one (contract §3.7 / decision-lock).
   128	    ArrayBatch,
   129	}
   130	
   131	/// Argument strictness/coercion policy.
   132	#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
   133	#[serde(rename_all = "snake_case")]
   134	pub enum ArgPolicy {
   135	    /// Reject type mismatches.
   136	    Strict,
   137	    /// Coerce per the engine's coercion rules.
   138	    Coercing,
   139	}
   140	
   141	/// **6.4-1 (2026-05-28; H1):** the binder's arg-admission category for this
   142	/// function. Mirrors the engine-internal `BindContext` enum at
   143	/// `ql-exec::plan` — kept as a separate DTO axis because:
   144	///
   145	/// 1. `BindContext` is internal to `ql-exec` and not part of the binding-
   146	///    neutral wire contract; the metadata DTO must own its own taxonomy.
   147	/// 2. The distinction is orthogonal to [`BatchShape`] (the eval-time call
   148	///    ABI). A scalar aggregate like `SUM` is `ArgContext::Aggregate`
   149	///    (binder admits range args) AND `BatchShape::Scalar` (eval calls
   150	///    `fn(&[Value]) -> Value` per cell after the named-range cache hit).
   151	///    Conflating the two would force Python UDFs that want range args to
   152	///    declare `BatchShape::ArrayBatch`, which has separate semantics
   153	///    around the Arrow IPC ABI.
   154	///
   155	/// Pre-6.4-1 this lived as two parallel `matches!` whitelists in
   156	/// `ql-exec::plan` (`is_aggregate_function`, `is_reference_aware_function`);
   157	/// 6.4-1 moves the decision to metadata so UDFs participating in the
   158	/// binder follow the same lookup path as builtins.
   159	///
   160	/// The default is [`ArgContext::Scalar`] — matches the binder's
   161	/// `else` arm before 6.4-1, and matches the conservative behavior for an
   162	/// unknown function (range args are rejected with
   163	/// `BindError::NamedRangeInScalarContext` rather than silently accepted).
   164	#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
   165	#[serde(rename_all = "snake_case")]
   166	pub enum ArgContext {
   167	    /// Rejects range args — `BindContext::Scalar`. The vast majority of
   168	    /// builtins (ABS, SQRT, IF, …) and the binder's `else` arm for
   169	    /// unknown names live here.
   170	    #[default]
   171	    Scalar,
   172	    /// Admits named-range / range-aware args — `BindContext::AggregateArg`.
   173	    /// Pre-6.4-1 list at `ql-exec::plan::is_aggregate_function`
   174	    /// (~100 names: scalar aggregates SUM/AVERAGE/COUNT/MIN/MAX/…,
   175	    /// range-aware lookups VLOOKUP/INDEX/MATCH/…, conditional aggregates
   176	    /// SUMIF/AVERAGEIFS/…, array-tier TRANSPOSE/FILTER, range-aware text
   177	    /// CONCAT/TEXTJOIN, financial NPV/IRR/XIRR, statistical CORREL/
   178	    /// COVARIANCE.P/SLOPE/…, order statistics PERCENTILE.*/QUARTILE.*,
   179	    /// SUBTOTAL).
   180	    Aggregate,
   181	    /// Admits literal references (CellRef / RangeRef / NameRef) —
   182	    /// `BindContext::ReferenceArg`. Pre-6.4-1 list at
   183	    /// `ql-exec::plan::is_reference_aware_function` (ROW / COLUMN / ROWS /
   184	    /// COLUMNS / ISREF / ISFORMULA / FORMULATEXT).
   185	    Reference,
   186	}
