   587	/// Phase 3.1 runtime ↔ calcgraph integration container. Owns the
   588	/// `Graph` plus an O(1) cell index. Construct via `new()` for empty,
   589	/// or `rebuild_from_workbook` to build from an existing workbook's
   590	/// formulas.
   840	    /// claimed stripe-side stale entries accumulated on re-bind; that
   841	    /// was the Phase 0 append-only trade-off and is now fixed. The
   842	    /// revocation is the documented exception to the append-only
   843	    /// invariant — see `docs/architecture/2026-05-13-graph-storage-decision.md`.
   844	    ///
   845	    /// Internal — public callers go through `on_set_formula` or
   846	    /// rebuild. `formula_node` MUST already exist in the graph (call
   847	    /// `or_insert_cell_node` first if necessary). `formula_sheet` is
   848	    /// the owning sheet of the formula cell; it's the fallback the
   849	    /// `StripeIndex` uses when a range's own `sheet` is `None` (today
   850	    /// every named-range conversion sets `Some(_)` so the fallback is
   851	    /// inert, but the parameter is part of the stable graph API).
   852	    fn extract_and_register_deps(
   853	        &mut self,
   854	        formula_node: NodeId,
   855	        formula_sheet: SheetId,
   856	        plan: &ExprPlan,
   857	        workbook: &Workbook,
   858	        registry: &FunctionRegistry,
   859	    ) {
   860	        // First, evict any prior deps for this formula. Required so
   861	        // re-binding a formula whose text changed (e.g. `=A1` → `=B1`)
   862	        // doesn't leave the old cell-dep stamped on the session.
   863	        self.remove_formula_deps(formula_node);
   864	        // W5-50 (GAP-G-01 closure): also revoke prior graph edges +
   865	        // stripe registrations. Without this, stale forward edges
   866	        // create false `#CIRC!` cycles (megaudit H3) and stale stripe
   867	        // entries falsely dirty the formula on writes to the OLD range
   868	        // (megaudit H4). Idempotent on first-time bind.
   869	        self.graph.clear_outgoing(formula_node);
   870	        self.graph.clear_range_deps_for_formula(formula_node);
   871	
   872	        // Walk and collect. `registry` threads through for the 6.4-0
   873	        // metadata substrate (volatility + address-only routing).
   874	        let mut deps = FormulaDeps::default();
   875	        walk_plan_for_deps(plan, &mut deps, registry);
   876	
   877	        // **W5-102 (Phase 4.7.I) — PRODUCER-ALIAS REWRITE.** Per design
   878	        // § 10.1: if a CellRef points to a spill TARGET, reroute the
   879	        // dependency to the ANCHOR's formula node. The anchor's
   880	        // formula owns the computed value at the target cell; when
   881	        // the anchor recomputes, every downstream reader of any
   882	        // target cell must dirty. By rewriting the dep BEFORE
   883	        // dedupe + register, the existing cell-dep machinery
   884	        // (cell_to_formulas reverse index + graph.add_edge) handles
   885	        // spill-target writes uniformly with regular cell writes.
   886	        //
   887	        // No new node types. Multiple targets of the same anchor
   888	        // collapse to one dep via the dedupe step that follows.
   889	        //
   890	        // Hot-path note: this loop runs one `spill_target_anchor`

