   580	    /// Iterator over names registered as `RegisteredFn::Scalar(_)`.
   581	    /// **W5-96 (Phase 4.7.B):** previously was "names registered in the
   582	    /// scalar HashMap"; the unified storage means we filter by variant.
   583	    ///
   584	    /// **Ordering is UNSTABLE.** Pre-W5-96 each tier had its own
   585	    /// `HashMap` with non-deterministic iteration order; post-W5-96
   586	    /// the order can also shift as entries in other tiers are added
   587	    /// (single combined HashMap). Callers that need a stable order
   588	    /// (e.g. coverage reports, snapshot tests) must collect + sort.
   589	    pub fn names(&self) -> impl Iterator<Item = &&'static str> + '_ {
   590	        self.fns
   591	            .iter()
   592	            .filter(|(_, v)| matches!(v, RegisteredFn::Scalar(_)))
   593	            .map(|(k, _)| k)
   594	    }
