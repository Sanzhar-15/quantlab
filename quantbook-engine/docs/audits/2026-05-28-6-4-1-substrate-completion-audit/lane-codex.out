  2403	    /// **6.4-1 (2026-05-28; M3):** `sorted_metadata` returns entries in
  2404	    /// ascending `canonical_name` order across multiple calls — the
  2405	    /// determinism property the (forthcoming) `list_functions` mapper
  2406	    /// relies on. HashMap iteration order is not stable across runs;
  2407	    /// `sorted_metadata` is the seam the DTO layer reads from.
  2408	    #[test]
  2409	    fn sorted_metadata_is_deterministic_across_calls() {
  2410	        let r = default_registry();
  2411	        let first: Vec<&str> = r.sorted_metadata().iter().map(|m| m.canonical_name.as_str()).collect();
  2412	        let second: Vec<&str> = r.sorted_metadata().iter().map(|m| m.canonical_name.as_str()).collect();
  2413	        assert_eq!(first, second, "sorted_metadata MUST be call-stable");
  2414	        // Strictly ascending.
  2415	        for w in first.windows(2) {
  2416	            assert!(w[0] < w[1], "sorted_metadata violated ordering at {:?} -> {:?}", w[0], w[1]);
  2417	        }
  2418	        // Covers every metadata entry — same len as iter_metadata.
  2419	        assert_eq!(first.len(), r.metadata_count());
  2420	    }
