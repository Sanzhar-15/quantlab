  1941	
  1942	    /// Fixture: a unified-tier function that returns a fixed 1×3
  1943	    /// `ArrayValue` so we can verify the array-returning path
  1944	    /// end-to-end through `register_unified` + `lookup_unified`.
  1945	    fn fixed_sequence_3(_args: &[FunctionArg], _ctx: &FunctionContext) -> FunctionReturn {
  1946	        FunctionReturn::Array(ArrayValue::row(vec![
