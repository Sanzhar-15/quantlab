  2298	    /// **Unregister happy path + NotFound + builtin-guard
  2299	    /// (6.4-0 audit-fix; Codex A LOW):** removing UDF-style metadata
  2300	    /// (no dispatch entry) yields `Ok(())` and removes the entry;
  2301	    /// removing an unknown name returns `NotFound`; attempting to
  2302	    /// remove a built-in (dispatch entry still present) returns
  2303	    /// `Conflict` — never silent removal of a built-in's metadata,
  2304	    /// which would silently regress the dep walker for that name.
  2305	    #[test]
  2306	    fn unregister_metadata_removes_udf_returns_not_found_for_unknown_and_blocks_builtins() {
  2307	        let mut r = default_registry();
  2308	        // UDF-style: register metadata for a name with NO dispatch
  2309	        // entry, then unregister it — round-trip OK.
  2310	        let meta = FunctionMetadata {
  2311	            canonical_name: "MYUDF".to_string(),
  2312	            display_name: None,
  2313	            aliases: vec![],
  2314	            arity: Arity::Variadic,
  2315	            volatility: Volatility::Pure,
  2316	            determinism: true,
  2317	            dep_shape: DepShape::ValueDeps,
  2318	            batch_shape: BatchShape::Scalar,
  2319	            arg_policy: ArgPolicy::Coercing,
  2320	            cancellation: CancelPolicy::Cooperative,
  2321	            arg_context: ArgContext::Scalar,
  2322	            provenance_tags: vec![],
  2323	        };
  2324	        r.register_metadata(meta).expect("UDF metadata registers");
  2325	        assert!(r.metadata("MYUDF").is_some());
  2326	        r.unregister_metadata("MYUDF").expect("UDF unregister OK");
  2327	        assert!(r.metadata("MYUDF").is_none());
  2328	
  2329	        // Second unregister of the same name → NotFound (never silent
  2330	        // no-op).
  2331	        let err = r
  2332	            .unregister_metadata("MYUDF")
  2333	            .expect_err("second remove must fail loud");
  2334	        assert!(matches!(
  2335	            err,
  2336	            FunctionRegistryError::NotFound { ref name } if name == "MYUDF"
  2337	        ));
  2338	
  2339	        // Case-insensitive: unknown name → NotFound.
  2340	        let err = r
  2341	            .unregister_metadata("does_not_exist")
  2342	            .expect_err("unknown name must fail loud");
  2343	        assert!(matches!(err, FunctionRegistryError::NotFound { .. }));
  2344	
  2345	        // Builtin-guard: SUM has a dispatch entry → unregister must
  2346	        // refuse with Conflict. This preserves the migration-shim
  2347	        // invariant (every dispatched fn has metadata).
  2348	        let err = r
  2349	            .unregister_metadata("SUM")
  2350	            .expect_err("must refuse to unregister a built-in's metadata");
  2351	        assert!(
  2352	            matches!(err, FunctionRegistryError::Conflict { .. }),
  2353	            "removing a built-in's metadata must surface as Conflict, not NotFound"
  2354	        );
  2355	        // SUM's metadata is untouched.
  2356	        assert!(
  2357	            r.metadata("SUM").is_some(),
  2358	            "builtin guard must preserve SUM's metadata"
  2359	        );
