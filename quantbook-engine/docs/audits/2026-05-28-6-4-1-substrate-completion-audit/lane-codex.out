    45	/// **6.4-0 (2026-05-28):** registry-level error type for the new
    46	/// metadata-only registration methods (`register_metadata` /
    47	/// `unregister_metadata`). Dispatch-side registration (`register`,
    48	/// `register_range_aware`, …) still panics on collision because the
    49	/// builtin-population path has no recoverable failure mode — a duplicate
    50	/// `r.register("SUM", …)` is a programming bug, not a runtime condition.
    51	///
    52	/// The metadata side is different: UDFs register at runtime under the
    53	/// `EngineSession::register_function` trait method (6.4) which must
    54	/// translate this enum into the contract-specified `EngineError`
    55	/// (`Conflict / function_exists`, `NotFound / function_not_found`) per
    56	/// `docs/api/session-api.md` §10.3. Returning errors here keeps the
    57	/// fail-loud contract (No-Fallbacks rule) without panicking the host.
    58	#[derive(Clone, Debug, PartialEq, Eq)]
    59	pub enum FunctionRegistryError {
    60	    /// `register_metadata` saw a canonical name that is already present
    61	    /// (built-in or existing UDF). Carries the offending name verbatim.
    62	    Conflict { name: String },
    63	    /// `unregister_metadata` was called for a name with no metadata
    64	    /// entry — never a silent no-op (would mask a typo that becomes
    65	    /// "leaked stale metadata" once 6.4 lands UDFs).
    66	    NotFound { name: String },
    67	}
    68	
    69	impl std::fmt::Display for FunctionRegistryError {
    70	    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
    71	        match self {
    72	            Self::Conflict { name } => {
    73	                write!(f, "function metadata already registered for {name:?}")
    74	            }
    75	            Self::NotFound { name } => {
    76	                write!(f, "no function metadata registered for {name:?}")
    77	            }
    78	        }
    79	    }
    80	}
    81	
    82	impl std::error::Error for FunctionRegistryError {}
