   535	    /// Callers should check this AFTER `lookup_range_aware` but BEFORE
   536	    /// `lookup`. Dispatch order: `range_aware` → `context_aware` → `scalar`.
   537	    pub fn lookup_context_aware(&self, name: &str) -> Option<ContextAwareFn> {
   538	        let upper = name.to_ascii_uppercase();
   539	        match self.fns.get(upper.as_str()) {
   540	            Some(RegisteredFn::ContextAware(f)) => Some(*f),
   541	            _ => None,
   542	        }
   543	    }
   544	
   545	    /// **W5-96 (Phase 4.7.B):** case-insensitive lookup for the unified
   546	    /// ABI. Returns `Some(f)` iff the registered entry is
   547	    /// `RegisteredFn::Unified(_)`. Used by the eval-site array-dispatch
   548	    /// path (W5-101 / Phase 4.7.G).
   549	    pub fn lookup_unified(&self, name: &str) -> Option<FunctionFn> {
   550	        let upper = name.to_ascii_uppercase();
   551	        match self.fns.get(upper.as_str()) {
   552	            Some(RegisteredFn::Unified(f)) => Some(*f),
   553	            _ => None,
   554	        }
   555	    }
   556	
   557	    /// **W5-RT-1 (RT-V1-01):** case-insensitive lookup for the
   558	    /// reference-aware tier. Returns `Some((f, contract))` iff the
   559	    /// registered entry is `RegisteredFn::ReferenceAware(_, _)`. The
   560	    /// `ArgContract` lets the dispatcher pick eager-vs-lazy
   561	    /// materialization without a second lookup.
   562	    pub fn lookup_reference_aware(&self, name: &str) -> Option<(ReferenceAwareFn, ArgContract)> {
   563	        let upper = name.to_ascii_uppercase();
   564	        match self.fns.get(upper.as_str()) {
   565	            Some(RegisteredFn::ReferenceAware(f, c)) => Some((*f, *c)),
   566	            _ => None,
   567	        }
   568	    }
   569	
   570	    /// **W5-96 (Phase 4.7.B):** case-insensitive lookup returning the
   571	    /// `RegisteredFn` enum directly. Lets the eval site perform a
   572	    /// single match-on-tier rather than four sequential `lookup_*`
   573	    /// calls. Migrated callers (W5-101+) use this; pre-W5-96 callers
   574	    /// keep working through the tier-specific filter views above.
   575	    pub fn lookup_any(&self, name: &str) -> Option<&RegisteredFn> {
   576	        let upper = name.to_ascii_uppercase();
   577	        self.fns.get(upper.as_str())
   578	    }
