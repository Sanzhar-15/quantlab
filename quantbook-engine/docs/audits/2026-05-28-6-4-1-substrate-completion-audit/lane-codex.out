    84	/// Function signature: pre-evaluated args → result Value.
    85	pub type ScalarFn = fn(&[Value]) -> Value;
    86	
    87	/// **W5-96 (Phase 4.7.B):** unified function-dispatch arg, used by the
    88	/// new array-returning function tier (`FunctionFn`). Covers all three
    89	/// shapes the eval site can produce:
    90	///
    91	/// - `Scalar(Value)` — single pre-evaluated value (analogous to a single
    92	///   slot in `&[Value]` for the legacy `ScalarFn`).
    93	/// - `Range { values, rows, cols }` — flat row-major iteration over a
    94	///   workbook range, with 2D shape preserved (matches `FnArg::Range`
    95	///   from the legacy `RangeAwareFn` contract).
    96	/// - `Array(ArrayValue)` — an explicit array value from `Expr::Array`
    97	///   literal or another function's return. Distinct from `Range`
    98	///   because `Range` carries workbook-range provenance (used by
    99	///   VLOOKUP/INDEX shape addressing) while `Array` is a free-floating
   100	///   2D value.
   101	///
   102	/// Conversion `FnArg → FunctionArg`:
   103	/// - `FnArg::Scalar(v)` → `FunctionArg::Scalar(v)`.
   104	/// - `FnArg::Range { values, rows, cols }` → `FunctionArg::Range { ... }`.
   105	///
   106	/// The eval site (W5-101 / Phase 4.7.G) materializes `FunctionArg` from
   107	/// `ExprPlan` arg positions before dispatching through `FunctionFn`.
   108	#[derive(Clone, Debug, PartialEq)]
   109	pub enum FunctionArg {
   110	    /// Single scalar value.
   111	    Scalar(Value),
   112	    /// 2D range with explicit shape; `values.len() == rows * cols`,
   113	    /// row-major iteration. Matches the existing `FnArg::Range` shape.
   114	    Range {
   115	        values: Vec<Value>,
   116	        rows: usize,
   117	        cols: usize,
   118	    },
   119	    /// Array value (from `Expr::Array` literal or another function's
   120	    /// `FunctionReturn::Array`).
   121	    Array(ArrayValue),
   122	}
   123	
   124	/// **W5-96 (Phase 4.7.B):** unified function return — either a scalar or
   125	/// an array. Arrays returned at the cell-boundary context spill; arrays
   126	/// returned in scalar context produce `Value::Error(ErrorValue::Calc)`
   127	/// (Phase 4.7.G enforces this at the eval site per design § 6.3).
   128	#[derive(Clone, Debug, PartialEq)]
   129	pub enum FunctionReturn {
   130	    Scalar(Value),
   131	    Array(ArrayValue),
   132	}
   133	
   134	impl FunctionReturn {
   135	    /// True if this is `Array(_)`. Helper for the eval-site spill check.
   136	    pub fn is_array(&self) -> bool {
   137	        matches!(self, FunctionReturn::Array(_))
   138	    }
   139	}
   140	
   141	/// **W5-96 (Phase 4.7.B):** unified function call context. Carries the
   142	/// `EvalContext` (date_system / locale / now_provider) that the legacy
   143	/// `ContextAwareFn` received as a bare reference. Struct-of-fields shape
   144	/// lets us add workbook-level state later (W5-101+) without changing the
   145	/// function ABI.
   146	pub struct FunctionContext<'a> {
   147	    pub eval_ctx: &'a EvalContext,
   148	}
   149	
   150	impl<'a> FunctionContext<'a> {
   151	    pub fn new(eval_ctx: &'a EvalContext) -> Self {
   152	        Self { eval_ctx }
   153	    }
   154	}
   155	
   156	/// **W5-96 (Phase 4.7.B):** unified function ABI. New array-returning
   157	/// functions (SEQUENCE, FILTER, TRANSPOSE — Phase 4.7.M/N) register
   158	/// through this signature.
   159	pub type FunctionFn = fn(&[FunctionArg], &FunctionContext) -> FunctionReturn;
   160	
   161	/// **W5-96 (Phase 4.7.B):** tagged-union of all four function-dispatch
   162	/// tiers, stored as the value in the unified `FunctionRegistry` HashMap.
   163	/// Pre-W5-96 the registry held three parallel HashMaps; this enum
   164	/// collapses them and adds the `Unified` variant for array fns.
   165	///
   166	/// Eval-site code in `ql-exec::scalar` currently routes through the
   167	/// legacy filter-views (`lookup_scalar` / `lookup_range_aware` /
   168	/// `lookup_context_aware`); W5-101 (Phase 4.7.G) migrates that site
   169	/// to a single `match` on `RegisteredFn`.
   170	#[derive(Clone, Debug)]
   171	pub enum RegisteredFn {
   172	    /// Legacy `fn(&[Value]) -> Value`. Most functions register here.
   173	    Scalar(ScalarFn),
   174	    /// Range-aware: `fn(&[FnArg]) -> Value`. Used by SUMIF / VLOOKUP /
   175	    /// INDEX etc. that need per-arg range-vs-scalar metadata.
   176	    RangeAware(RangeAwareFn),
   177	    /// Context-aware: `fn(&[Value], &EvalContext) -> Value`. Used by
   178	    /// DATE / NOW / TODAY / WEEKDAY etc. that need workbook EvalContext.
   179	    ContextAware(ContextAwareFn),
   180	    /// Unified ABI (W5-96+). New array-returning functions (Phase
   181	    /// 4.7.M/N) register here.
   182	    Unified(FunctionFn),
   183	    /// **W5-RT-1 (RT-V1-01):** reference-aware tier. The dispatcher passes
   184	    /// `RefArg`s materialized per the fn's [`ArgContract`] — eager
   185	    /// evaluation with address preservation for ROW/COLUMN/ROWS/COLUMNS/
   186	    /// ISFORMULA/FORMULATEXT, or lazy syntactic-shape inspection for ISREF.
   187	    /// See `reference_aware_fns` module for the type definitions and
   188	    /// `docs/architecture/2026-05-17-reference-tier-design.md` for the
   189	    /// design rationale.
   190	    ReferenceAware(ReferenceAwareFn, ArgContract),
   191	}
   192	
   193	/// Phase 0 function registry. Built by `default_registry()` with the
   194	/// full built-in set (~130 entries by W5-93).
   195	///
   196	/// **W5-96 (Phase 4.7.B):** internal storage unified into one HashMap
   197	/// keyed by name, valued by `RegisteredFn`. Legacy `register_*` /
   198	/// `lookup_*` methods preserved as filters on the enum variant for
   199	/// backwards-compat (zero diff on the ~130 existing
   200	/// `r.register("SUM", scalar_fns::sum)` lines in `default_registry`).
   201	///
   202	/// **Disjointness:** a single name maps to ONE `RegisteredFn` (the
   203	/// HashMap enforces this naturally). The pre-W5-96 "cross-table
   204	/// disjointness" assertions become "name already registered" — same
   205	/// semantics, simpler implementation.
   206	#[derive(Clone, Debug)]
   207	pub struct FunctionRegistry {
   208	    fns: HashMap<&'static str, RegisteredFn>,
   209	    /// **6.4-0 (2026-05-28):** per-function metadata, indexed by canonical
   210	    /// (ASCII-uppercase) name — the same keying as `fns`. Built-ins
   211	    /// populate this in [`default_registry`] via [`register_builtin_metadata`];
   212	    /// UDFs (6.4) populate it via [`Self::register_metadata`]. Keys are
   213	    /// `String` (not `&'static str` like `fns`) so UDF metadata can carry
   214	    /// owned names without lifetime ceremony at the binding boundary.
   215	    ///
   216	    /// **Migration shim discipline (contract §10.2):** every entry in
   217	    /// `fns` SHOULD have a matching entry here; the
   218	    /// `default_registry_metadata_is_complete_for_every_dispatch_entry`
   219	    /// debug-build invariant test catches drift.
   220	    metadata: HashMap<String, FunctionMetadata>,
   221	    /// **6.4-1 (2026-05-28; H3):** monotonic generation counter that ticks
   222	    /// on every metadata mutation ([`Self::register_metadata`] /
   223	    /// [`Self::unregister_metadata`]). Mirrors `NameTable::generation()` at
   224	    /// `ql-storage`; `PlanCacheKey` (`ql-exec::plan_cache:69-74`) reads it
   225	    /// alongside `name_gen` so the bind cache invalidates on UDF
   226	    /// register / unregister. Closes contract §10.3's "re-extract deps"
   227	    /// half — the 6.4-0 substrate dirties + reschedules; the 6.4-1
   228	    /// `fn_gen` invalidates the bind cache, forcing the next eval to
   229	    /// re-bind through `walk_plan_for_deps` against the current metadata.
   230	    ///
   231	    /// `saturating_add(1)` (rather than `+= 1` / `wrapping_add`) on bump:
   232	    /// `u64::MAX` would require ~10^19 mutations in one session, so
   233	    /// saturation is fine; the alternative (`checked_add` + `expect`) would
   234	    /// surface a panic the user can't act on, and `wrapping_add` would
   235	    /// re-collide with prior cache keys (the failure mode H3 closes!).
   236	    fn_gen: u64,
   237	}
   238	
   239	impl Default for FunctionRegistry {
   240	    fn default() -> Self {
   241	        Self::new()
   242	    }
   243	}
   244	
   245	impl FunctionRegistry {
   246	    /// Empty registry — caller adds functions via `register`. Use `default_registry()`
   247	    /// for the Phase 0 built-in set.
   248	    pub fn new() -> Self {
   249	        Self {
   250	            fns: HashMap::new(),
   251	            metadata: HashMap::new(),
   252	            // **6.4-1 (2026-05-28; H3):** starts at 0. The very first
   253	            // `register_metadata` call bumps to 1; `PlanCacheKey` carries
   254	            // the value at bind time so a cache hit only happens if the
   255	            // metadata snapshot is unchanged since the bind.
   256	            fn_gen: 0,
   257	        }
   258	    }
