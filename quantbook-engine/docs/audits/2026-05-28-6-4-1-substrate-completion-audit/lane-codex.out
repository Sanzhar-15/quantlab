  2737	
  2738	    /// **The substrate's core promise:** binding a formula that calls
  2739	    /// `NOW()` (built-in function) populates the calcgraph session's
  2740	    /// `functions_used` reverse index — the same way `name_to_formulas`
  2741	    /// is populated for `AggregateNameRef`. Without this, contract
  2742	    /// §10.3 invalidation can't fire (register/unregister has nothing
  2743	    /// to dirty).
  2744	    #[test]
  2745	    fn functions_used_reverse_index_populated_on_rebuild() {
  2746	        // Workbook with one formula that calls a builtin.
  2747	        let wb = workbook_with_formulas(&[(0, 0, 0, "NOW()")]);
  2748	        let r = CalcgraphSession::rebuild_from_workbook(&wb);
  2749	        assert!(r.is_complete());
  2750	        let s = r.session;
  2751	        let node = s.cell_node_for(0, 0, 0).unwrap();
  2752	
  2753	        let nodes = s
  2754	            .functions_used_for("NOW")
  2755	            .expect("functions_used must record NOW() callers");
  2756	        assert!(
  2757	            nodes.contains(&node),
  2758	            "the formula calling NOW must appear in functions_used[NOW]"
  2759	        );
  2760	        // Lookup is case-insensitive (matches registry convention).
  2910	    /// register-time invalidation for any UDF whose name happened to
  2911	    /// be in the address-only list. (None today, but the substrate
  2912	    /// must hold under future contract evolution.)
  2913	    #[test]
  2914	    fn functions_used_records_address_only_fns() {
  2915	        // ROW(A1) routes through walk_plan_for_address_only_deps; the
  2916	        // outer ROW arm's push runs BEFORE the route. Same for ISREF.
  2917	        let wb = workbook_with_formulas(&[(0, 0, 0, "ROW(A1)"), (0, 1, 0, "ISREF(A1)")]);
  2918	        let r = CalcgraphSession::rebuild_from_workbook(&wb);
  2919	        assert!(r.is_complete(), "ROW(A1) and ISREF(A1) must bind");
  2920	        let s = r.session;
  2921	        let row_caller = s.cell_node_for(0, 0, 0).unwrap();
  2922	        let isref_caller = s.cell_node_for(0, 1, 0).unwrap();
  2923	        assert!(
  2924	            s.functions_used_for("ROW").unwrap().contains(&row_caller),
  2925	            "the walker MUST record ROW into functions_used even though args route through address-only walker"
  2926	        );
  2927	        assert!(
  2928	            s.functions_used_for("ISREF").unwrap().contains(&isref_caller),
  2929	            "the walker MUST record ISREF even though its arm short-circuits arg walking"
  2930	        );
  2931	    }
  2932	
  2933	    /// **6.4-0 audit-fix (Opus M4):** nested function calls record
  2934	    /// BOTH names. `ROW(NOW())` is the smallest test of the
  2935	    /// address-only walker's `_ => walk_plan_for_deps(plan, deps,
  2936	    /// registry)` delegation — when the address-only walker hits a
  2937	    /// nested `ExprPlan::Function`, it delegates back to the normal
  2938	    /// walker which records the inner function name. Without the
  2939	    /// delegation passing `registry` through, the nested arm would
  2940	    /// either fail to compile (current safety) or silently lose the
  2941	    /// volatile mark on the outer formula. Pins both halves.
  2942	    #[test]
  2943	    fn functions_used_records_nested_functions_through_address_only_delegation() {
  2944	        let wb = workbook_with_formulas(&[(0, 0, 0, "ROW(NOW())")]);
  2945	        let r = CalcgraphSession::rebuild_from_workbook(&wb);
  2946	        assert!(r.is_complete(), "ROW(NOW()) must bind");
  2947	        let s = r.session;
  2948	        let node = s.cell_node_for(0, 0, 0).unwrap();
  2949	        // Both names land in the reverse index.
  2950	        assert!(s.functions_used_for("ROW").unwrap().contains(&node));
  2951	        assert!(
  2952	            s.functions_used_for("NOW").unwrap().contains(&node),
  2953	            "the address-only walker's `_ => walk_plan_for_deps(... , registry)` \
  2954	             delegation MUST record nested function names"
  2955	        );
  2956	        // The formula is volatile because NOW lives somewhere in the
  2957	        // tree — the metadata lookup at NOW's arm sets is_volatile.
  2958	        let deps = s.formula_deps(node).expect("formula must store deps");
  2959	        assert!(
  2960	            deps.is_volatile,
  2961	            "ROW(NOW()) must be volatile because NOW propagates through the delegation"
  2962	        );
  2963	    }
  2964	
  2965	    /// **6.4-0 audit-fix (Codex D LOW):** the function-registration
  2966	    /// hook fires transitive BFS-fanout via
  2967	    /// `mark_dirty_from_cell_write` — a chain `A1=NOW()` →
  2968	    /// `B1 = A1+1` → `C1 = B1+1` must dirty ALL three when NOW is
  2969	    /// (re-)registered. Mirrors the Phase 3.10 H2 set_name fix.
  2970	    #[test]
  3068	    /// RAND/RANDBETWEEN/RANDARRAY` carry `Volatility::Volatile`;
  3069	    /// `INDIRECT/OFFSET/INFO/CELL` carry `Volatility::Dynamic` (workbook-
  3070	    /// structure sensitive). The migration shim treats both as
  3071	    /// volatile-pass-eligible so the existing volatile-formulas set
  3072	    /// behavior is preserved byte-for-byte. The parser canonicalizes
  3073	    /// names to uppercase before binding so the walker only ever sees
  3074	    /// uppercase; the registry's `metadata()` is case-insensitive
  3075	    /// anyway, but the lowercase / unknown assertions still hold via
  3076	    /// the matcher returning false on `None` metadata.
  3077	    #[test]
  3078	    fn volatile_function_set_is_canonical() {
  3079	        let registry = ql_functions::default_registry();
  3080	        for f in [
  3081	            "NOW",
  3082	            "TODAY",
  3083	            "RAND",
  3084	            "RANDBETWEEN",
  3085	            "RANDARRAY",
  3086	            "INDIRECT",
  3087	            "OFFSET",
  3088	            "INFO",
  3089	            "CELL",
  3090	        ] {
  3091	            assert!(is_volatile_function(&registry, f), "{f} must be volatile");
  3092	        }
  3093	        // `metadata()` is case-insensitive (uppercases the query), so
  3094	        // "now" lookups `NOW`'s metadata. The migration shim therefore
  3095	        // returns true for lowercase — DIFFERENT from the old
  3096	        // hardcoded matcher. Document the change here so a future
  3097	        // change to case-sensitive matching surfaces.
  3098	        assert!(
  3099	            is_volatile_function(&registry, "now"),
  3100	            "metadata-derived lookup is case-insensitive (registry uppercases the query)"
  3101	        );
  3102	        assert!(!is_volatile_function(&registry, "Sum"));
  3103	        // Sanity: non-volatile arithmetic functions are not in the set.
  3104	        assert!(!is_volatile_function(&registry, "SUM"));
  3105	        assert!(!is_volatile_function(&registry, "AVERAGE"));
  3106	        assert!(!is_volatile_function(&registry, "IF"));
  3107	    }
  3108	
