    58	use serde::{Deserialize, Serialize};
    59	
    60	/// How many arguments a function takes.
    61	#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
    62	#[serde(tag = "kind", rename_all = "snake_case")]
    63	pub enum Arity {
    64	    /// Exactly `n` arguments.
    65	    Fixed {
    66	        /// The arity.
    67	        n: u8,
    68	    },
    69	    /// Between `min` and (optional) `max` arguments.
    70	    Range {
    71	        /// Minimum.
    72	        min: u8,
    73	        /// Maximum (None = unbounded).
    74	        max: Option<u8>,
    75	    },
    76	    /// Any number of arguments.
    77	    Variadic,
    78	}
    79	
    80	/// Whether a function's result can change independently of its arguments.
    81	#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
    82	#[serde(rename_all = "snake_case")]
    83	pub enum Volatility {
    84	    /// Same args ⇒ same result; recomputes only on input change.
    85	    Pure,
    86	    /// Recomputes on every recalc / volatile pass (NOW, RAND, …).
    87	    Volatile,
    88	    /// Result depends on workbook structure, not just args (INDIRECT, OFFSET);
    89	    /// the conservative default for an unregistered/unknown function so it stays
    90	    /// graph-visible and never silently Pure (contract §10.3).
    91	    Dynamic,
    92	}
    93	
    94	/// How a function's arguments map to graph dependencies.
    95	#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
    96	#[serde(rename_all = "snake_case")]
    97	pub enum DepShape {
    98	    /// Normal value-deps (the default): referenced cells/ranges are deps.
    99	    ValueDeps,
   100	    /// Address-only (ROW / COLUMN / ROWS / COLUMNS): depends on address /
   101	    /// shape, not value. The walker recurses for Binary / Unary / Function
   102	    /// sub-trees because the eager materializer DOES evaluate those (so
   103	    /// `ROW(A1+1)` must keep A1's value-dep), but skips value-deps on
   104	    /// direct CellRef / RangeRef arguments.
   105	    AddressOnly,
   106	    /// **6.4-1 (2026-05-28; I1):** lazy syntactic-shape inspection (ISREF).
   107	    /// The function never evaluates its arg — it inspects the syntactic
   108	    /// shape via `materialize_ref_arg_lazy`. The walker MUST NOT recurse:
   109	    /// `ISREF(NOW())` must not mark the formula volatile; `ISREF(A1+1)`
   110	    /// must not register `A1` as a dep. Pre-6.4-1 this was a hardcoded
   111	    /// `name == "ISREF"` short-circuit at the walker's `Function` arm; the
   112	    /// I1 closure moves the decision to metadata so 6.4 UDFs declaring
   113	    /// `dep_shape: LazyShape` get the same treatment without engine-side
   114	    /// name special-casing.
   115	    LazyShape,
   116	    /// Caller supplies explicit deps at registration (`register_formula_function(
   117	    /// ..., deps=[...])`).
   118	    Custom,
   119	}
