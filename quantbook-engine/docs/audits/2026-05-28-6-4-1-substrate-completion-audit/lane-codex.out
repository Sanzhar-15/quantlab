   642	/// **W5-RT-1 (RT-V1-01):** lazy materializer for reference-aware fns
   643	/// using `ArgContract::LazyShape`. The arg's `ExprPlan` shape is
   644	/// translated to a `PlanKind` without any evaluation — no
   645	/// `eval_scalar_with_cache` call, no aggregate cache touch, no
   646	/// volatile-fn re-firing. ISREF uses this path (HIGH-B closure).
   647	fn materialize_ref_arg_lazy(plan: &ExprPlan) -> ql_functions::RefArg {
   648	    use ql_functions::{PlanKind, RefArg};
   649	    let kind = match plan {
   650	        ExprPlan::CellRef { .. } => PlanKind::CellRef,
   651	        ExprPlan::AggregateNameRef { .. }
   652	        | ExprPlan::RangeRef { .. }
   653	        | ExprPlan::StructuredRef { .. } => PlanKind::RangeRef,
   654	        // No reference-returning fns in v1 — see design § 1 out-of-scope
   655	        // ("Reference-returning fns (OFFSET-class)"). `returns_reference`
   656	        // stays false; ISREF on a function call returns FALSE accordingly.
   657	        ExprPlan::Function { .. } => PlanKind::Function {
   658	            returns_reference: false,
   659	        },
   660	        ExprPlan::Number(_)
   661	        | ExprPlan::Bool(_)
   662	        | ExprPlan::String(_)
   663	        | ExprPlan::Array(_)
   664	        | ExprPlan::Binary { .. }
   665	        | ExprPlan::Unary { .. } => PlanKind::Literal,
   666	        ExprPlan::Error(_) => PlanKind::Error,
   667	    };
   668	    RefArg::Shape(kind)
   669	}
