   358	    /// Remove metadata for `canonical_name`. Returns
   359	    /// [`FunctionRegistryError::NotFound`] if no entry exists — never a
   360	    /// silent no-op (per No-Fallbacks: a quiet remove would mask a typo
   361	    /// that leaves stale metadata associated with a since-renamed name).
   362	    /// Lookup uppercases the query for symmetry with [`Self::metadata`].
   363	    ///
   364	    /// **6.4-0 audit-fix (2026-05-28; Codex A LOW):** REFUSES to
   365	    /// remove metadata for any name that still has a dispatch entry
   366	    /// in [`Self::fns`]. Without this guard, an unregister-builtin
   367	    /// call would leave dispatch present + metadata absent — a state
   368	    /// the migration-shim invariant (every dispatched fn has metadata)
   369	    /// forbids, and which would silently regress the dep walker for
   370	    /// the affected built-in (unknown-fn semantics). The (6.4)
   371	    /// `WorkbookSession::unregister_function` trait method should
   372	    /// only ever target UDF names (no dispatch entry by construction);
   373	    /// this guard catches a programmer error at the registry layer
   374	    /// rather than silently corrupting the metadata invariant.
   375	    /// Returns [`FunctionRegistryError::Conflict`] (re-using the
   376	    /// existing variant — the conflict is between "remove" and
   377	    /// "dispatch-still-present").
   378	    pub fn unregister_metadata(
   379	        &mut self,
   380	        canonical_name: &str,
   381	    ) -> Result<(), FunctionRegistryError> {
   382	        let upper = canonical_name.to_ascii_uppercase();
   383	        // Guard: refuse to break the dispatch-has-metadata invariant.
   384	        if self.fns.contains_key(upper.as_str()) {
   385	            return Err(FunctionRegistryError::Conflict {
   386	                name: format!(
   387	                    "{canonical_name} is a registered built-in (dispatch entry present); \
   388	                     unregister_metadata must only target UDF metadata"
   389	                ),
   390	            });
   391	        }
   392	        if self.metadata.remove(&upper).is_some() {
   393	            // **6.4-1 (2026-05-28; H3):** symmetric `fn_gen` bump on
   394	            // successful removal. A `NotFound` returned below leaves the
   395	            // counter alone (metadata table unchanged → cache stays
   396	            // valid).
   397	            self.fn_gen = self.fn_gen.saturating_add(1);
   398	            Ok(())
   399	        } else {
   400	            Err(FunctionRegistryError::NotFound {
   401	                name: canonical_name.to_string(),
   402	            })
   403	        }
   404	    }
