   362	#[derive(Clone, Copy, Debug, PartialEq, Eq)]
   363	enum BindContext {
   364	    /// Default. NameRefs resolving to ranges or formulas are rejected with
   365	    /// precise errors.
   366	    Scalar,
   367	    /// Inside the argument list of an aggregate function (SUM, AVERAGE,
   368	    /// MIN, MAX, COUNT, etc. — see `is_aggregate_function`). NameRefs
   369	    /// resolving to ranges bind to `ExprPlan::AggregateNameRef`; named
   370	    /// formulas still error (Engine Phase 4 work). Step 1.1 closure
   371	    /// (S1-LOW-2): the design v2 proposed renaming the matcher to
   372	    /// `accepts_special_arg_at_bind`; that rename did not ship (see
   373	    /// S1-HIGH-D — parallel-matcher approach kept instead). Doc-comment
   374	    /// reverted to reference the actual matcher.
   375	    AggregateArg,
   376	    /// **W5-RT-1 (RT-V1-01):** inside the argument list of a reference-aware
   377	    /// function (ROW, COLUMN, ROWS, COLUMNS, ISREF, ISFORMULA, FORMULATEXT).
   378	    /// Same shape as `AggregateArg` for NameRef-resolves-to-range AND
   379	    /// (NEW) accepts literal `Expr::RangeRef` lowering to
   380	    /// `ExprPlan::RangeRef { range }`. CellRef args bind as
   381	    /// `ExprPlan::CellRef` unchanged. The scope of the `RangeRef`
   382	    /// lowering is intentionally narrow in v1: only this context accepts
   383	    /// literal ranges. `AggregateArg`-side enabling (which would make
   384	    /// `SUM(A1:B3)` work — currently a `BindError::UnsupportedVariant`)
   385	    /// is a separate follow-up since the multi-tier dispatcher (scalar /
   386	    /// range-aware / unified) would also need new `RangeRef` arms.
   387	    ReferenceArg,
   388	}
