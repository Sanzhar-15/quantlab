  2147	        // `register_builtin_metadata`; ISFORMULA/FORMULATEXT default to
  2148	        // ValueDeps; unknown names default to None (the matcher returns
  2149	        // false). Behavior is identical to the prior hardcoded
  2150	        // whitelist — this test pins the metadata-derived view at the
  2151	        // engine layer in addition to the registry-level pin at
  2152	        // `ql_functions::registry::builtin_metadata_pins_prior_address_only_whitelist`.
  2153	        //
  2154	        // 6.4-1 (I1): ISREF moves to LazyShape; it'\''s pinned separately
  2155	        // below.
  2156	        let registry = ql_functions::default_registry();
  2157	        // Address-only — value-deps suppressed for these.
