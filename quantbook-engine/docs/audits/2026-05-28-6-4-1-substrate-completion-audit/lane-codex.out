  1729	                 returns false"
  1730	            );
  1731	        }
  1732	        // Sentinel non-reference-aware names (typo guard).
  1733	        for name in &[
  1734	            "RAW",
  1735	            "COLUM",
  1736	            "ISFOMULA",
  1737	            "FORMULATXT",
  1738	            "SUM",
  1739	            "IF",
  1740	            "VLOOKUP",
  1741	        ] {
  1742	            assert!(
