  2698	    /// `walk_plan_for_deps` is pure — calling it twice on the same
  2699	    /// plan with two fresh `FormulaDeps` produces equal collections.
  2700	    /// **6.4-0:** the walker now takes `&FunctionRegistry`; passing the
  2701	    /// same registry twice still produces identical output (the
  2702	    /// registry's metadata lookup is read-only).
  2703	    #[test]
  2704	    fn walk_plan_for_deps_is_pure() {
  2705	        use ql_formula_syntax::Operator;
  2706	        let plan = ExprPlan::Binary {
  2707	            op: Operator::Plus,
  2708	            lhs: Box::new(ExprPlan::CellRef {
  2709	                sheet: 0,
  2710	                row: 0,
  2711	                col: 0,
  2712	                abs_col: false,
  2713	                abs_row: false,
  2714	            }),
  2715	            rhs: Box::new(ExprPlan::Function {
  2716	                name: "NOW".into(),
  2717	                args: Vec::new(),
  2718	            }),
  2719	        };
  2720	        let registry = ql_functions::default_registry();
  2721	        let mut a = FormulaDeps::default();
  2722	        let mut b = FormulaDeps::default();
  2723	        walk_plan_for_deps(&plan, &mut a, &registry);
  2724	        walk_plan_for_deps(&plan, &mut b, &registry);
  2725	        assert_eq!(a, b);
  2726	        assert!(a.is_volatile);
  2727	        assert_eq!(a.cells.len(), 1);
  2728	        // 6.4-0: `functions_used` records every Function arm walked.
  2729	        assert_eq!(a.functions_used.len(), 1);
