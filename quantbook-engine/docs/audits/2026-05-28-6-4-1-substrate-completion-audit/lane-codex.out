  2203	            assert_eq!(
  2204	                m.dep_shape,
  2205	                DepShape::AddressOnly,
  2206	                "{name} must be AddressOnly per design § 5.3"
  2207	            );
  2208	        }
  2209	        // 6.4-1 I1: ISREF is LazyShape now.
  2210	        let isref = r.metadata("ISREF").expect("ISREF must have metadata");
  2211	        assert_eq!(
  2212	            isref.dep_shape,
  2213	            DepShape::LazyShape,
