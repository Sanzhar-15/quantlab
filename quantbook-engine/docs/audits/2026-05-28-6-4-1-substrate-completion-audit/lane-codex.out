  2104	    // =====================================================================
  2105	    // 6.4-0 substrate — metadata tests (2026-05-28)
  2106	    // =====================================================================
  2107	
  2108	    /// **The migration-shim invariant (contract §10.2):** every dispatched
  2109	    /// built-in in the default registry has a matching metadata entry —
  2110	    /// a `r.register*` call without a Phase 1 / Phase 2 override would
  2111	    /// fall back to unknown-fn semantics at the walker. The converse is
  2112	    /// NOT required (metadata may carry extra entries — see
  2113	    /// `register_builtin_metadata`'s Phase-1 RANDARRAY/INDIRECT/OFFSET/
  2114	    /// INFO/CELL block; those names are graph-volatile but not yet
  2115	    /// dispatchable). `default_registry()` debug-asserts the same;
  2116	    /// asserting it here too gives a release-build green-light and a
  2117	    /// clearer failure message.
  2118	    #[test]
  2119	    fn default_registry_metadata_covers_every_dispatched_builtin() {
  2120	        let r = default_registry();
  2121	        let dispatch_keys: Vec<&'static str> = r.fns.keys().copied().collect();
  2122	        for name in &dispatch_keys {
  2123	            assert!(
  2124	                r.metadata(name).is_some(),
  2125	                "default_registry missing metadata for dispatched fn {name:?}"
  2126	            );
  2127	        }
  2128	        // Metadata may exceed dispatch — RANDARRAY/INDIRECT/OFFSET/INFO/
  2129	        // CELL are Volatility-tagged but their dispatch is deferred
  2130	        // (registry.rs:~647-648). Assert the documented superset
  2131	        // relationship explicitly so a future drift is visible.
  2132	        assert!(
  2133	            r.metadata_count() >= r.fns.len(),
  2134	            "metadata table must cover at least every dispatched fn"
  2135	        );
  2136	        // Spot-check a handful, including the dispatch-deferred ones.
  2137	        for name in &["SUM", "IF", "VLOOKUP", "NOW", "ROW", "INDIRECT"] {
  2138	            assert!(
  2139	                r.metadata(name).is_some(),
  2140	                "default_registry missing metadata for {name:?}"
  2141	            );
  2142	        }
  2143	    }
  2144	
  2145	    /// **Prior `is_volatile_function` whitelist pin** (was at
  2146	    /// `ql-exec::calcgraph_session:149-164`). The substrate puts these
  2147	    /// names on the registry as `Volatility::Volatile`
  2148	    /// (NOW/TODAY/RAND/RANDBETWEEN/RANDARRAY — recompute every recalc)
  2149	    /// or `Volatility::Dynamic` (INDIRECT/OFFSET/INFO/CELL — workbook-
  2150	    /// structure sensitive). Both classes are graph-volatile; the
  2151	    /// migration shim in `calcgraph_session::is_volatile_function`
  2152	    /// returns true for either. This test pins each name to the right
  2153	    /// variant so a future shuffle that mis-classifies (e.g. demotes
  2154	    /// INDIRECT to `Pure`) surfaces here.
  2155	    #[test]
  2156	    fn builtin_metadata_pins_prior_volatile_whitelist() {
  2157	        let r = default_registry();
  2158	        for name in &["NOW", "TODAY", "RAND", "RANDBETWEEN", "RANDARRAY"] {
  2159	            let m = r
  2160	                .metadata(name)
  2161	                .unwrap_or_else(|| panic!("{name} must have metadata"));
  2162	            assert_eq!(
  2163	                m.volatility,
  2164	                Volatility::Volatile,
  2165	                "{name} must be Volatile (recompute every recalc)"
  2166	            );
  2167	            assert!(
  2168	                !m.determinism,
  2169	                "{name} is non-deterministic (different result on same args at different times)"
  2170	            );
  2171	        }
  2172	        for name in &["INDIRECT", "OFFSET", "INFO", "CELL"] {
  2173	            let m = r
  2174	                .metadata(name)
  2175	                .unwrap_or_else(|| panic!("{name} must have metadata"));
  2176	            assert_eq!(
  2177	                m.volatility,
  2178	                Volatility::Dynamic,
  2179	                "{name} must be Dynamic (workbook-structure sensitive)"
  2180	            );
  2181	            assert!(!m.determinism, "{name} result depends on workbook structure");
  2182	        }
  2183	    }
  2184	
  2185	    /// **Prior `is_address_only_reference_fn` whitelist pin** (was at
