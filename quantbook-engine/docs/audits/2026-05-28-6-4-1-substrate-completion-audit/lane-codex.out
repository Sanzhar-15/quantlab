  1952	
  1953	    /// Fixture: a unified-tier function that echoes its first arg.
  1954	    fn echo_first(args: &[FunctionArg], _ctx: &FunctionContext) -> FunctionReturn {
  1955	        match args.first() {
  1956	            Some(FunctionArg::Scalar(v)) => FunctionReturn::Scalar(v.clone()),
  1957	            Some(FunctionArg::Array(a)) => FunctionReturn::Array(a.clone()),
  1958	            _ => FunctionReturn::Scalar(Value::Error(ql_types::ErrorValue::Value)),
  1959	        }
  1960	    }
  1961	
  1962	    #[test]
  1963	    fn register_unified_and_lookup_unified_round_trip() {
  1964	        let mut r = FunctionRegistry::new();
  1965	        r.register_unified("FIXED_SEQ", fixed_sequence_3);
  1966	        let f = r.lookup_unified("FIXED_SEQ").expect("registered");
  1967	        let ctx = ql_types::EvalContext::default();
  1968	        let fctx = FunctionContext::new(&ctx);
  1969	        let ret = f(&[], &fctx);
  1970	        match ret {
  1971	            FunctionReturn::Array(a) => {
  1972	                assert_eq!(a.rows(), 1);
  1973	                assert_eq!(a.cols(), 3);
  1974	            }
  1975	            FunctionReturn::Scalar(_) => panic!("expected array return"),
  1976	        }
  1977	    }
