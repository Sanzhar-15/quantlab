   308	
   309	    /// Register first-class metadata for a function. The `canonical_name`
   310	    /// **must** be ASCII-uppercase (matches the parser's canonicalization);
   311	    /// rejecting a non-uppercase name with `Conflict` would be wrong
   312	    /// (that's bad input, not collision), so this asserts loud — the
   313	    /// caller is expected to pass already-canonical names per contract
   314	    /// §10.3 ("`register_function` normalizes + validates").
   315	    ///
   316	    /// Returns [`FunctionRegistryError::Conflict`] if a metadata entry
   317	    /// already exists for this name (built-in or prior UDF), per the
   318	    /// fail-loud collision rule in contract §10.3. This is the
   319	    /// non-panicking counterpart to [`Self::insert_or_panic`]'s
   320	    /// dispatch-side duplicate panic — UDFs register at runtime where
   321	    /// a panic would abort the host.
   322	    pub fn register_metadata(
   323	        &mut self,
   324	        meta: FunctionMetadata,
   325	    ) -> Result<(), FunctionRegistryError> {
   326	        assert!(
   327	            !meta.canonical_name.is_empty(),
   328	            "FunctionRegistry::register_metadata: canonical_name must not be empty"
   329	        );
   330	        assert!(
   331	            meta.canonical_name
   332	                .bytes()
   333	                .all(|b| !b.is_ascii_lowercase()),
   334	            "FunctionRegistry::register_metadata: canonical_name {:?} must be \
   335	             canonical upper-case (caller must normalize before calling)",
   336	            meta.canonical_name
   337	        );
   338	        if self.metadata.contains_key(&meta.canonical_name) {
   339	            return Err(FunctionRegistryError::Conflict {
   340	                name: meta.canonical_name,
   341	            });
   342	        }
   343	        self.metadata.insert(meta.canonical_name.clone(), meta);
   344	        // **6.4-1 (2026-05-28; H3):** bump the metadata generation counter
   345	        // so any `PlanCacheKey` minted before this call misses on next
   346	        // lookup. The bind cache invalidation is what closes contract
   347	        // §10.3's "re-extract deps" half — `CalcgraphSession`'s hooks
   348	        // already dirty + reschedule; the cache miss forces re-binding
   349	        // through `walk_plan_for_deps` against the current metadata so
   350	        // `FormulaDeps::is_volatile` / `functions_used` / `is_volatile`
   351	        // / `dep_shape`-driven routing all reflect the new entry. Only
   352	        // bumped on success — a `Conflict` returned above leaves the
   353	        // metadata table state and `fn_gen` both untouched.
   354	        self.fn_gen = self.fn_gen.saturating_add(1);
   355	        Ok(())
   356	    }
