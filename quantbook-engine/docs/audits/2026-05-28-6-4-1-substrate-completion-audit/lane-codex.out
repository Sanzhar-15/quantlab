   168	// =====================================================================
   169	//
   170	// ISREF uses `ArgContract::LazyShape` (the FIRST user-facing fn through
   171	// that contract — Step 1's tests validated the path via placeholders).
   172	// The dispatcher's `materialize_ref_arg_lazy` produces `RefArg::Shape(_)`
   173	// without evaluating the arg, so `ISREF(1/0) = FALSE` does NOT surface
   174	// `#DIV/0!` (HIGH-B closure from pre-review).
   175	//
   176	// ISFORMULA uses `ArgContract::Eager` + queries the workbook via
   177	// `RefContext::workbook.is_formula_at` (the `ReferenceQuery` trait the
   178	// Step 1 infrastructure wired). Single-cell Reference / 1×1 Range arg
   179	// → call the workbook query; multi-cell range / Array / Scalar /
   180	// Shape → `#N/A` per Microsoft canon (HIGH-D / S1-MEDIUM-1 closures
   181	// in the design).
   182	//
   183	// FORMULATEXT (Step 4) follows the same Eager-contract pattern.
   184	
   185	/// **ISREF(arg)** — TRUE iff `arg`'s expression shape is a reference
   186	/// (single-cell or range) OR a reference-returning function. Does NOT
   187	/// evaluate `arg` (HIGH-B closure: `ISREF(1/0)` returns FALSE without
   188	/// surfacing `#DIV/0!`).
   189	///
   190	/// - `ISREF(A1)` → TRUE.
   191	/// - `ISREF(A1:B3)` → TRUE.
   192	/// - `ISREF(NamedCell)` → TRUE (resolves to AggregateNameRef → RangeRef).
   193	/// - `ISREF(SUM(NamedRange))` → FALSE (SUM does not return a reference).
   194	///   Note: `ISREF(SUM(A1:A3))` literal-range form bind-fails per
   195	///   S1-MED-γ AggregateArg defer (pinned by `isref_of_sum_literal_range_bind_fails_v1_scope`).
   196	/// - `ISREF(1+2)` → FALSE.
   197	/// - `ISREF(123)` / `ISREF("text")` → FALSE.
   198	/// - `ISREF(1/0)` → FALSE (no eval; div-by-zero not surfaced).
   199	/// - `ISREF(#REF!)` → FALSE (`#REF!` literal is not a reference).
   200	/// - `ISREF()` / `ISREF(a, b)` → `#N/A` (arity).
   201	///
   202	/// v1 has no reference-returning fns (OFFSET / INDIRECT deferred), so
   203	/// `ISREF(<any function call>)` always returns FALSE. When reference-
   204	/// returning fns ship in a follow-up, `PlanKind::Function { returns_reference }`
   205	/// will distinguish; the v1 dispatcher emits `returns_reference: false`
   206	/// unconditionally.
   207	pub fn isref(args: &[RefArg], _ctx: &RefContext) -> Value {
   208	    match args {
   209	        [RefArg::Shape(PlanKind::CellRef | PlanKind::RangeRef)] => Value::Boolean(true),
   210	        [RefArg::Shape(PlanKind::Function {
   211	            returns_reference: true,
   212	        })] => Value::Boolean(true),
   213	        [RefArg::Shape(_)] => Value::Boolean(false),
   214	        // Defensive: Eager-contract args would surface as Reference /
   215	        // Range / Scalar / Array / Error. ISREF uses LazyShape so the
   216	        // dispatcher emits only `RefArg::Shape(_)` for the arg slot;
   217	        // these arms are unreachable under the contract but kept for
   218	        // defense-in-depth.
   219	        [RefArg::Reference { .. } | RefArg::Range { .. }] => Value::Boolean(true),
   220	        [RefArg::Scalar(_) | RefArg::Array(_) | RefArg::Error(_)] => Value::Boolean(false),
   221	        _ => Value::Error(ErrorValue::NA),
   222	    }
   223	}
