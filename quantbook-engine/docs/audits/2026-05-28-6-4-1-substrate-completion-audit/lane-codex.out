   551	        // currently needs admission. If a future scalar-only RangeAwareFn
   552	        // ships, it must be explicitly listed here with rationale.
   553	        let exceptions: &[&str] = &[];
   554	
   555	        let mut missing: Vec<&str> = Vec::new();
   556	        for &name in reg.range_aware_names() {
   557	            if exceptions.contains(&name) {
   558	                continue;
   559	            }
   560	            if !is_aggregate_function(&TEST_REGISTRY, name) {
   561	                missing.push(name);
   562	            }
   563	        }
   564	        assert!(
   565	            missing.is_empty(),
   566	            "W5-D-13.1 invariant: every range-aware fn must be admitted to \
   567	             is_aggregate_function (binder admission gate for named-range \
   568	             args). Missing {} fns: {:?}. Fix: add them to the matcher in \
   569	             plan.rs::is_aggregate_function, OR add to the exceptions \
   570	             allowlist above with rationale.",
   571	            missing.len(),
   572	            missing
   573	        );
   574	    }
