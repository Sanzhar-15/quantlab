   472	/// Resolve an Expr against an owning sheet, producing an ExprPlan. **No name
   473	/// resolution + no sheet resolution** — any `Expr::NameRef` produces
   474	/// `BindError::UnresolvedName`; any cross-sheet ref (`SheetRef::Name`)
   475	/// produces `BindError::UnknownSheet`.
   476	///
   477	/// `owning_sheet` is the sheet the formula lives on.
   478	pub fn bind(
   479	    expr: &Expr,
   480	    owning_sheet: SheetId,
   481	    registry: &FunctionRegistry,
   482	) -> Result<ExprPlan, BindError> {
   483	    bind_with_names_and_sheets(
   484	        expr,
   485	        owning_sheet,
   486	        &EmptyNameLookup,
   487	        &EmptySheetResolver,
   488	        registry,
   489	    )
