  2245	            determinism: true,
  2246	            dep_shape: DepShape::ValueDeps,
  2247	            batch_shape: BatchShape::ArrayBatch,
  2248	            arg_policy: ArgPolicy::Strict,
  2249	            cancellation: CancelPolicy::WorkerKill,
  2250	            // **6.4-1:** UDFs taking range args declare Aggregate so the
