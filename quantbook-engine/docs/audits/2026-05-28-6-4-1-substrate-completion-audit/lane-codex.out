 succeeded in 0ms:
     1	//! Phase 2B.3 (2026-05-12) — bind-plan cache V0.
     2	//!
     3	//! Caches parsed + bound [`ExprPlan`] values keyed by the formula text, the
     4	//! owning sheet, and the workbook's NameTable generation. Lives on
     5	//! [`crate::WorkbookRuntime`] and is shared into spawned
     6	//! [`crate::WorkbookTransaction`] instances through forwarding.
     7	//!
     8	//! ## Invalidation contract
     9	//!
    10	//! Cache entries are NOT explicitly removed on workbook mutation. Instead,
    11	//! the cache key is `(formula_text, sheet_id, name_table_generation)`. When
    12	//! the workbook mutates state that would change a bind result:
    13	//!
    14	//! - User edits formula text → new text, new key, automatic miss.
    15	//! - Caller registers/removes a name → `NameTable::generation()` advances
    16	//!   (per Phase 2B.3 workbook.rs), so plans bound against the prior
    17	//!   generation no longer match.
    18	//!
    19	//! Stale entries accumulate over time; Phase 3 calcgraph integration adds
    20	//! explicit eviction tied to dirty propagation. For Phase 2B.3 the cache
    21	//! is small enough that drift is acceptable — typical workbook formula
    22	//! cardinality is in the thousands, not millions.
    23	//!
    24	//! ## What the cache stores
    25	//!
    26	//! `Arc<ExprPlan>` so cache hits hand back a refcount-bump without cloning
    27	//! the plan tree. `ExprPlan` is `Clone + Debug + PartialEq` per
    28	//! `ql-exec::plan` but the plan tree is non-trivial; sharing via `Arc`
    29	//! keeps the cache cheap.
    30	//!
    31	//! ## References
    32	//!
    33	//! - `.references/hyperformula/src/parser/ParserWithCaching.ts` — HF caches
    34	//!   parsed ASTs keyed by formula text + sheet metadata for the same
    35	//!   reason. They evict on text change; we additionally include
    36	//!   `NameTable::generation` so the bind result (not just the parse) stays
    37	//!   consistent.
    38	//! - `.references/hyperformula/src/parser/Cache.ts` — the size-bounded LRU
    39	//!   wrapper. V0 here is unbounded; a bounded eviction policy lands when
    40	//!   workbook size makes it necessary.
    41	
    42	use std::collections::HashMap;
    43	use std::sync::Arc;
    44	
    45	use ql_types::{ColId, RowId, SheetId};
    46	
    47	use crate::plan::ExprPlan;
    48	
    49	/// Composite cache key. Reflects everything that, if changed, would change
    50	/// the bind result for a given formula text:
    51	///
    52	/// - `text` — the raw formula source (without leading `=`). Different text
    53	///   yields a different parse tree, so plans don't share.
    54	/// - `sheet` — owning sheet for the binding. Same text in different sheets
    55	///   binds to different cell references (relative refs resolve against the
    56	///   owning sheet).
    57	/// - `name_gen` — `NameTable::generation()` at the moment of bind. A
    58	///   subsequent name registration / removal bumps this, so old plans
    59	///   become unreachable.
    60	/// - `fn_gen` (6.4-1 H3) — `FunctionRegistry::fn_generation()` at the
    61	///   moment of bind. The 6.4-0 substrate moved volatility / dep-shape /
    62	///   arg-context routing to first-class metadata; a UDF
    63	///   `register_metadata` / `unregister_metadata` call at runtime would
    64	///   change the bind result for any formula referencing that function
    65	///   name (volatility flag, dep walker routing, binder arg-ctx).
    66	///   Bumping `fn_gen` on every metadata mutation forces a cache miss on
    67	///   next lookup → re-bind → fresh `FormulaDeps` against the current
    68	///   metadata. Closes the `re-extract deps` half of contract §10.3 (the
    69	///   6.4-0 substrate hooks dirty + reschedule; `fn_gen` invalidates the
    70	///   bind cache). Mirrors the `name_gen` pattern byte-for-byte.
    71	/// - `cell_anchor` (W5-150) — `Some((row, col))` when the bind result is
    72	///   cell-anchor-dependent, `None` otherwise. Set by callers when the
    73	///   canonical text contains `@` (implicit intersection narrows
    74	///   `@<range>` at bind time using the formula's own cell — same
    75	///   canonical text at different cells produces different ExprPlans).
    76	///   For non-`@` formulas (`SUM(A1:A10)` shared across rows etc.) this
    77	///   stays `None` so the cache shares plans across cells, preserving
    78	///   the pre-4.9.O hit-rate. Closes 4.9.O HIGH-1.
    79	#[derive(Clone, Debug, Hash, Eq, PartialEq)]
    80	pub struct PlanCacheKey {
    81	    pub text: Arc<str>,
    82	    pub sheet: SheetId,
    83	    pub name_gen: u64,
    84	    /// **6.4-1 (2026-05-28; H3):** metadata-table generation; see the
    85	    /// type-level docstring for the contract §10.3 closure rationale.
    86	    pub fn_gen: u64,
    87	    pub cell_anchor: Option<(RowId, ColId)>,
    88	}
    89	
    90	/// Snapshot of cache observability data — exposed via
    91	/// `WorkbookRuntime::cache_stats()` and surfaced through `ql-profile`.
    92	#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
    93	pub struct PlanCacheStats {
    94	    pub hits: u64,
    95	    pub misses: u64,
    96	    pub entries: usize,
    97	}
    98	
    99	impl PlanCacheStats {
   100	    /// Hit rate as a fraction in `[0.0, 1.0]`. Returns `None` when no
   101	    /// lookups have happened yet so callers don't divide by zero or
   102	    /// display "0.0%" for an unused cache.
   103	    pub fn hit_rate(&self) -> Option<f64> {
   104	        let total = self.hits + self.misses;
   105	        if total == 0 {
   106	            None
   107	        } else {
   108	            Some(self.hits as f64 / total as f64)
   109	        }
   110	    }
   111	}
   112	
   113	/// Phase 2B.3 bind-plan cache.
   114	///
   115	/// Stores `Arc<ExprPlan>` per `(text, sheet, name_gen)` key. Hits return
   116	/// the cached plan (refcount-bump only); misses run the caller-supplied
   117	/// build closure. Accumulates hit/miss counters for observability.
   118	///
   119	/// `Default` constructs an empty cache. The cache is opt-in via
   120	/// `WorkbookRuntime::with_plan_cache_disabled` — not yet implemented; the
   121	/// default runtime constructor builds an empty cache that gets populated
   122	/// on first lookup.
   123	#[derive(Debug, Default)]
   124	pub struct PlanCache {
   125	    entries: HashMap<PlanCacheKey, Arc<ExprPlan>>,
   126	    hits: u64,
   127	    misses: u64,
   128	}
   129	
   130	impl PlanCache {
   131	    /// Empty cache. Same as `Default::default`.
   132	    pub fn new() -> Self {
   133	        Self::default()
   134	    }
   135	
   136	    /// Look up the plan for `key`. On hit, returns the cached `Arc<ExprPlan>`
   137	    /// and increments the hit counter. On miss, runs `build()` (which does
   138	    /// the lex/parse/bind), stores the result, and returns it. Errors from
   139	    /// `build()` are passed through without caching — failed binds aren't
   140	    /// memoized, so a fix to the formula text gets a clean retry.
   141	    pub fn get_or_insert<F, E>(&mut self, key: PlanCacheKey, build: F) -> Result<Arc<ExprPlan>, E>
   142	    where
   143	        F: FnOnce() -> Result<ExprPlan, E>,
   144	    {
   145	        if let Some(plan) = self.entries.get(&key) {
   146	            self.hits += 1;
   147	            return Ok(Arc::clone(plan));
   148	        }
   149	        self.misses += 1;
   150	        let plan = Arc::new(build()?);
   151	        self.entries.insert(key, Arc::clone(&plan));
   152	        Ok(plan)
   153	    }
   154	
   155	    /// Insert a plan unconditionally (overwriting any existing entry for
   156	    /// the same key). Available for callers that already bound the plan
   157	    /// out-of-band and want to pre-warm the cache.
   158	    ///
   159	    /// Phase 2B.7 audit (correctness L1 / D4): the prior doc-comment
   160	    /// claimed `WorkbookRuntime::set_formula` uses this method — it
   161	    /// doesn't (set_formula uses `get_or_insert`). No production caller
   162	    /// uses `insert` today; the method stays for tests and future pre-
   163	    /// warming callers (Phase 3 calcgraph integration may need it).
   164	    pub fn insert(&mut self, key: PlanCacheKey, plan: Arc<ExprPlan>) {
   165	        self.entries.insert(key, plan);
   166	    }
   167	
   168	    /// Cumulative cache observability since construction.
   169	    pub fn stats(&self) -> PlanCacheStats {
   170	        PlanCacheStats {
   171	            hits: self.hits,
   172	            misses: self.misses,
   173	            entries: self.entries.len(),
   174	        }
   175	    }
   176	
   177	    /// Number of cached plans. Some are likely stale (keyed by old
   178	    /// generations) — V0 doesn't garbage-collect.
   179	    pub fn len(&self) -> usize {
   180	        self.entries.len()
   181	    }
   182	
   183	    /// True iff the cache holds no entries.
   184	    pub fn is_empty(&self) -> bool {
   185	        self.entries.is_empty()
   186	    }
   187	
   188	    /// Drop every cached plan and reset counters. Intended for tests and
   189	    /// explicit "clean slate" callers; routine cache pressure handling
   190	    /// belongs in Phase 3 calcgraph integration.
   191	    pub fn clear(&mut self) {
   192	        self.entries.clear();
   193	        self.hits = 0;
   194	        self.misses = 0;
   195	    }
   196	}
   197	
   198	#[cfg(test)]
   199	mod tests {
   200	    use super::*;
   201	
   202	    fn key(text: &str, sheet: SheetId, name_gen: u64) -> PlanCacheKey {
   203	        PlanCacheKey {
   204	            text: Arc::from(text),
   205	            sheet,
   206	            name_gen,
   207	            // **6.4-1 (2026-05-28; H3):** test helper pins `fn_gen = 0`
   208	            // because the plan_cache unit tests don'\''t mutate function
   209	            // metadata; the cross-tier integration tests at
   210	            // `WorkbookSession::register_function` (6.4) exercise the
   211	            // cache-invalidation pathway end-to-end.
   212	            fn_gen: 0,
   213	            cell_anchor: None,
   214	        }
   215	    }
   216	
   217	    fn dummy_plan() -> ExprPlan {
   218	        // ExprPlan::Number is the simplest concrete variant.
   219	        ExprPlan::Number(1.0)
   220	    }

