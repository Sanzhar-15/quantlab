  2474	        // financial, statistical, lookup, order stats — one from each subgroup).
  2475	        for name in [
  2476	            "SUM", "AVERAGE", "VLOOKUP", "SUMIFS", "TRANSPOSE", "FILTER", "SUBTOTAL",
  2477	            "CORREL", "XIRR", "XLOOKUP", "PERCENTILE.INC", "MINIFS", "TEXTJOIN",
