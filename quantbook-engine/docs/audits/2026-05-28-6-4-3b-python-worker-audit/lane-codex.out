     1	"""UDF wire envelope — the Python mirror of `ql-udf/src/frame.rs`.
     2	
     3	Frame layout: ``[u32 LE total_len][u8 frame_type][payload...]`` where
     4	``total_len == 1 + len(payload)`` (the type byte counts). All integers are
     5	little-endian. 3.9-compatible.
     6	
     7	This is the worker side of the protocol the Rust engine (`ql-udf::ProcessWorker`)
     8	speaks over stdio. Every malformed frame raises loudly — never a silent skip.
     9	"""
    10	
    11	import struct
    12	
    13	# Frame type tags — MUST match `ql-udf/src/frame.rs::FrameType` exactly.
    14	HELLO = 1
    15	HELLO_ACK = 2
    16	CALL = 3
    17	RETURN = 4
    18	RAISE = 5
    19	CANCEL = 6
    20	LOG = 7
    21	
    22	# Sanity cap, mirroring `ql-udf::frame::MAX_FRAME_LEN` (64 MiB).
    23	MAX_FRAME_LEN = 64 * 1024 * 1024
    24	
    25	
    26	def _read_n(stream, n):
    27	    """Read exactly ``n`` bytes from ``stream``.
    28	
    29	    Returns the bytes, or ``None`` if EOF occurs *before any byte* (a clean
    30	    shutdown between frames). Raises ``EOFError`` on a partial read (torn frame).
    31	    """
    32	    buf = bytearray()
    33	    while len(buf) < n:
    34	        chunk = stream.read(n - len(buf))
    35	        if not chunk:
    36	            if not buf:
    37	                return None
    38	            raise EOFError("torn frame: read %d of %d bytes" % (len(buf), n))
    39	        buf.extend(chunk)
    40	    return bytes(buf)
    41	
    42	
    43	def read_frame(stream):
    44	    """Read one frame. Returns ``(frame_type, payload_bytes)`` or ``None`` on a
    45	    clean EOF between frames. Raises on a torn / zero-length / oversized frame."""
    46	    head = _read_n(stream, 4)
    47	    if head is None:
    48	        return None  # clean EOF between frames
    49	    total = struct.unpack("<I", head)[0]
    50	    if total == 0:
    51	        raise ValueError("zero-length frame (need at least the 1-byte type tag)")
    52	    if total > MAX_FRAME_LEN:
    53	        raise ValueError("frame length %d exceeds the %d-byte cap" % (total, MAX_FRAME_LEN))
    54	    body = _read_n(stream, total)
    55	    if body is None:
    56	        raise EOFError("torn frame: EOF before the %d-byte body" % total)
    57	    frame_type = body[0]
    58	    payload = body[1:]
    59	    return (frame_type, payload)
    60	
    61	
    62	def write_frame(stream, frame_type, payload):
    63	    """Write one frame and flush. ``payload`` is ``bytes``."""
    64	    total = 1 + len(payload)
    65	    if total > MAX_FRAME_LEN:
    66	        raise ValueError("frame length %d exceeds the %d-byte cap" % (total, MAX_FRAME_LEN))
    67	    stream.write(struct.pack("<I", total))
    68	    stream.write(bytes([frame_type]))
    69	    if payload:
    70	        stream.write(payload)
    71	    stream.flush()

