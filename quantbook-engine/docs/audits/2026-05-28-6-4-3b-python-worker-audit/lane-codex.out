    18	def register_formula_function(fn, *, handle, name=None):
    19	    """Register ``fn`` as a Quantbook formula function under ``handle``.
    20	
    21	    ``fn`` receives a :class:`quantbook.Grid` of evaluated arguments and returns a
    22	    ``Grid`` or a scalar cell value (``float``/``int``/``bool``/``str``/``None``/
    23	    :class:`quantbook.Err`). ``handle`` is an explicit ``u64`` for now (the IDE mints
    24	    it at 6.4-3c/3d); ``name`` is informational. Returns ``handle``.
    25	    """
    26	    _register(int(handle), fn)
