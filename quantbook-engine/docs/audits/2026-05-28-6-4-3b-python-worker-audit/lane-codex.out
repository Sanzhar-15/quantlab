     1	//! The UDF wire envelope: `[u32 LE total_len][u8 frame_type][payload…]`.
     2	//!
     3	//! **6.4-3a.** `total_len` counts the type byte + payload (so a frame with an
     4	//! empty payload is `total_len == 1`). The payload bytes are **opaque at this
     5	//! layer**: for [`FrameType::Call`] / [`FrameType::Return`] they are the Arrow
     6	//! IPC stream from [`crate::codec`]; for the control frames
     7	//! ([`FrameType::Hello`] / `HelloAck` / `Raise` / `Cancel` / `Log`) the internal
     8	//! field encoding is intentionally deferred to 6.4-3b (where the real worker
     9	//! handshake pins it). This module owns only the framing + the type tag, so the
    10	//! transport is exercisable and round-trip-tested now.
    11	
    12	use std::io::{Read, Write};
    13	
    14	/// Discriminates the kind of a [`Frame`]. The `u8` tag is stable wire identity.
    15	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    16	#[repr(u8)]
    17	pub enum FrameType {
    18	    /// Worker→? handshake request (protocol version, capabilities).
    19	    Hello = 1,
    20	    /// ?→worker handshake ack (worker pid for debugpy, accepted version).
    21	    HelloAck = 2,
    22	    /// Engine→worker: one UDF invocation. Payload = Arrow IPC args grid.
    23	    Call = 3,
    24	    /// Worker→engine: success. Payload = Arrow IPC result grid.
    25	    Return = 4,
    26	    /// Worker→engine: the Python callable raised. Payload = error detail.
    27	    Raise = 5,
    28	    /// Engine→worker: cooperative cancel of an in-flight call.
    29	    Cancel = 6,
    30	    /// Worker→engine: a log line (stdout/stderr passthrough), surfaced as a diagnostic.
    31	    Log = 7,
    32	}
    33	
    34	impl FrameType {
    35	    fn from_u8(b: u8) -> Option<Self> {
    36	        match b {
    37	            1 => Some(FrameType::Hello),
    38	            2 => Some(FrameType::HelloAck),
    39	            3 => Some(FrameType::Call),
    40	            4 => Some(FrameType::Return),
    41	            5 => Some(FrameType::Raise),
    42	            6 => Some(FrameType::Cancel),
    43	            7 => Some(FrameType::Log),
    44	            _ => None,
    45	        }
    46	    }
    47	}
    48	
    49	/// A single framed message: a [`FrameType`] tag plus an opaque payload.
    50	#[derive(Debug, Clone, PartialEq, Eq)]
    51	pub struct Frame {
    52	    pub frame_type: FrameType,
    53	    pub payload: Vec<u8>,
    54	}
    55	
    56	impl Frame {
    57	    pub fn new(frame_type: FrameType, payload: Vec<u8>) -> Self {
    58	        Self {
    59	            frame_type,
    60	            payload,
    61	        }
    62	    }
    63	}
    64	
    65	/// Errors framing/deframing can produce. Loud — a malformed frame is never
    66	/// silently skipped (No-Fallbacks).
    67	#[derive(Debug, thiserror::Error)]
    68	pub enum FrameError {
    69	    #[error("frame io: {0}")]
    70	    Io(#[from] std::io::Error),
    71	    /// The declared length was zero — there is no room even for the type byte.
    72	    #[error("frame: zero-length frame (need at least the 1-byte type tag)")]
    73	    ZeroLength,
    74	    /// The type byte was not a known [`FrameType`].
    75	    #[error("frame: unknown frame type tag {0}")]
    76	    UnknownType(u8),
    77	    /// A frame payload exceeded the sanity cap. Carries the ACTUAL declared/total
    78	    /// length (`u64`, since the write side computes `1 + payload.len()` before the
    79	    /// `u32` narrowing) — not the cap — so the diagnostic is symmetric across the
    80	    /// read and write sides (6.4-3a audit-fix: `write-too-large-report`).
    81	    #[error("frame: length {0} exceeds the {MAX_FRAME_LEN}-byte cap")]
    82	    TooLarge(u64),
    83	}
    84	
    85	/// Sanity cap on a single frame (64 MiB). A larger declared length is rejected
    86	/// rather than used to allocate — defends the reader against a corrupt/hostile
    87	/// length prefix.
    88	pub const MAX_FRAME_LEN: u32 = 64 * 1024 * 1024;
    89	
    90	/// Write one frame: `[u32 LE (1 + payload.len())][type][payload]`.
    91	pub fn write_frame<W: Write>(w: &mut W, frame: &Frame) -> Result<(), FrameError> {
    92	    let total = 1u64 + frame.payload.len() as u64;
    93	    if total > u64::from(MAX_FRAME_LEN) {
    94	        return Err(FrameError::TooLarge(total));
    95	    }
    96	    let total = total as u32;
    97	    w.write_all(&total.to_le_bytes())?;
    98	    w.write_all(&[frame.frame_type as u8])?;
    99	    w.write_all(&frame.payload)?;
   100	    Ok(())
   101	}
   102	
   103	/// Read one frame. Returns `Ok(None)` on a clean EOF *before any bytes of the
   104	/// length prefix* (the stream ended between frames); any other short read is a
   105	/// loud error.
   106	pub fn read_frame<R: Read>(r: &mut R) -> Result<Option<Frame>, FrameError> {
   107	    let mut len_buf = [0u8; 4];
   108	    match read_exact_or_eof(r, &mut len_buf)? {
   109	        ReadOutcome::Eof => return Ok(None),
   110	        ReadOutcome::Filled => {}
   111	    }
   112	    let total = u32::from_le_bytes(len_buf);
   113	    if total == 0 {
   114	        return Err(FrameError::ZeroLength);
   115	    }
   116	    if total > MAX_FRAME_LEN {
   117	        return Err(FrameError::TooLarge(u64::from(total)));
   118	    }
   119	    let mut type_buf = [0u8; 1];
   120	    r.read_exact(&mut type_buf)?;
   121	    let frame_type = FrameType::from_u8(type_buf[0]).ok_or(FrameError::UnknownType(type_buf[0]))?;
   122	    let payload_len = (total - 1) as usize;
   123	    let mut payload = vec![0u8; payload_len];
   124	    r.read_exact(&mut payload)?;
   125	    Ok(Some(Frame {
   126	        frame_type,
   127	        payload,
   128	    }))
   129	}
   130	
   131	enum ReadOutcome {
   132	    Filled,
   133	    Eof,
   134	}
   135	
   136	/// Like `read_exact`, but distinguishes a clean EOF *before the first byte* (the
   137	/// stream ended between frames — a normal shutdown) from a partial read (a torn
   138	/// frame — an error).
   139	fn read_exact_or_eof<R: Read>(r: &mut R, buf: &mut [u8]) -> Result<ReadOutcome, FrameError> {
   140	    let mut filled = 0;
   141	    while filled < buf.len() {
   142	        match r.read(&mut buf[filled..]) {
   143	            Ok(0) => {
   144	                if filled == 0 {
   145	                    return Ok(ReadOutcome::Eof);
   146	                }
   147	                return Err(FrameError::Io(std::io::Error::new(
   148	                    std::io::ErrorKind::UnexpectedEof,
   149	                    "torn length prefix",
   150	                )));
   151	            }
   152	            Ok(n) => filled += n,
   153	            Err(ref e) if e.kind() == std::io::ErrorKind::Interrupted => continue,
   154	            Err(e) => return Err(FrameError::Io(e)),
   155	        }
   156	    }
   157	    Ok(ReadOutcome::Filled)
   158	}
   159	
   160	#[cfg(test)]
   161	mod tests {
   162	    use super::*;
   163	
   164	    #[test]
   165	    fn frame_round_trips_through_a_byte_buffer() {
   166	        let frames = vec![
   167	            Frame::new(FrameType::Hello, vec![1, 2, 3]),
   168	            Frame::new(FrameType::Call, vec![0u8; 1000]),
   169	            Frame::new(FrameType::Cancel, vec![]), // empty payload → total_len == 1
   170	            Frame::new(FrameType::Return, vec![255, 0, 128]),
   171	            Frame::new(FrameType::Log, b"a warning".to_vec()),
   172	        ];
   173	        let mut buf = Vec::new();
   174	        for f in &frames {
   175	            write_frame(&mut buf, f).unwrap();
   176	        }
   177	        let mut cursor = std::io::Cursor::new(buf);
   178	        let mut got = Vec::new();
   179	        while let Some(f) = read_frame(&mut cursor).unwrap() {
   180	            got.push(f);
   181	        }
   182	        assert_eq!(got, frames);
   183	    }
   184	
   185	    #[test]
   186	    fn read_returns_none_on_clean_eof_between_frames() {
   187	        let mut cursor = std::io::Cursor::new(Vec::<u8>::new());
   188	        assert_eq!(read_frame(&mut cursor).unwrap(), None);
   189	    }
   190	
   191	    #[test]
   192	    fn read_rejects_unknown_type_tag() {
   193	        // total_len = 1 (just the type byte), type = 99 (unknown).
   194	        let mut bytes = Vec::new();
   195	        bytes.extend_from_slice(&1u32.to_le_bytes());
   196	        bytes.push(99);
   197	        let mut cursor = std::io::Cursor::new(bytes);
   198	        let e = read_frame(&mut cursor).unwrap_err();
   199	        assert!(matches!(e, FrameError::UnknownType(99)), "got {e:?}");
   200	    }
   201	
   202	    #[test]
   203	    fn read_rejects_zero_length_frame() {
   204	        let mut cursor = std::io::Cursor::new(0u32.to_le_bytes().to_vec());
   205	        let e = read_frame(&mut cursor).unwrap_err();
   206	        assert!(matches!(e, FrameError::ZeroLength), "got {e:?}");
   207	    }
   208	
   209	    #[test]
   210	    fn read_rejects_oversized_length_without_allocating() {
   211	        let mut bytes = Vec::new();
   212	        bytes.extend_from_slice(&(MAX_FRAME_LEN + 1).to_le_bytes());
   213	        let mut cursor = std::io::Cursor::new(bytes);
   214	        let e = read_frame(&mut cursor).unwrap_err();
   215	        // 6.4-3a audit-fix (write-too-large-report): the carried length is the
   216	        // ACTUAL declared length, not the cap.
   217	        assert!(
   218	            matches!(e, FrameError::TooLarge(n) if n == u64::from(MAX_FRAME_LEN) + 1),
   219	            "got {e:?}"
   220	        );
   221	    }
   222	
   223	    #[test]
   224	    fn torn_length_prefix_is_an_error_not_eof() {
   225	        // Two bytes then EOF — a partial length prefix is a torn frame, not a
   226	        // clean between-frames shutdown.
   227	        let mut cursor = std::io::Cursor::new(vec![1u8, 0u8]);
   228	        let e = read_frame(&mut cursor).unwrap_err();
   229	        assert!(matches!(e, FrameError::Io(_)), "got {e:?}");
   230	    }
   231	}

