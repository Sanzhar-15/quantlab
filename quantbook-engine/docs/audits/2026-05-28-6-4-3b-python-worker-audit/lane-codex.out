   370	mod tests {
   371	    use super::*;
   372	    use ql_types::Value;
   373	
   374	    #[test]
   375	    fn config_defaults_and_builders() {
   376	        let c = PythonWorkerConfig::new("/usr/bin/python3")
   377	            .with_pythonpath("/some/dir")
   378	            .with_udf_module("my.udfs");
   379	        assert_eq!(c.module, "quantbook.worker");
   380	        assert_eq!(c.protocol_version, PROTOCOL_VERSION);
   381	        assert_eq!(c.pythonpath, vec![PathBuf::from("/some/dir")]);
   382	        assert_eq!(c.udf_module.as_deref(), Some("my.udfs"));
   383	    }
   384	
   385	    /// A non-existent interpreter must surface a loud `WorkerDied` (No-Fallbacks),
   386	    /// NOT a panic — and the worker stays usable as a handle (next call retries).
   387	    #[test]
   388	    fn missing_interpreter_is_worker_died_not_panic() {
   389	        let cfg = PythonWorkerConfig::new("/definitely/not/a/real/python-xyzzy");
   390	        let mut w = ProcessWorker::new(cfg);
   391	        let err = w
   392	            .call(1, &ArrayValue::singleton(Value::Number(1.0)), Duration::from_secs(1))
   393	            .unwrap_err();
   394	        assert!(
   395	            matches!(err, UdfError::WorkerDied(_)),
   396	            "missing interpreter must be WorkerDied, got {err:?}"
   397	        );
   398	        // No live process was created.
   399	        assert_eq!(w.pid(), None);
   400	    }
   401	}

