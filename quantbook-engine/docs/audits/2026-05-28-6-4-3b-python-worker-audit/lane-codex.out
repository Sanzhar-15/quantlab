     1	"""Standalone Python-side codec sanity check: ``python3 -m quantbook._self_test``.
     2	
     3	Round-trips grids + the CALL/RETURN payload headers through the codec WITHOUT the
     4	Rust engine — confirms the Python mirror is internally consistent (the Rust↔Python
     5	cross-check is the `ql-udf` `process_smoke` integration test). Prints ``PASS`` and
     6	exits 0 on success; raises (non-zero exit) on any mismatch.
     7	"""
     8	
     9	import struct
    10	import sys
    11	
    12	from . import _codec
    13	from ._codec import Err, Grid
    14	
    15	
    16	def _check(cond, msg):
    17	    if not cond:
    18	        raise AssertionError(msg)
    19	
    20	
    21	def main():
    22	    grids = [
    23	        Grid(1, 1, [42.5]),
    24	        Grid(1, 1, [True]),
    25	        Grid(1, 1, [False]),
    26	        Grid(1, 1, ["hello"]),
    27	        Grid(1, 1, [""]),
    28	        Grid(1, 1, [None]),
    29	        Grid(1, 1, [Err("#DIV/0!")]),
    30	        Grid(2, 3, [None, 1.0, True, "x", Err("#N/A"), -2.5]),
    31	        Grid(3, 0, []),  # degenerate: rows>0, cols==0
    32	        Grid(0, 0, []),  # fully empty
    33	        Grid(0, 4, []),  # degenerate: rows==0, cols>0
    34	    ]
    35	    for g in grids:
    36	        back = _codec.decode_grid(_codec.encode_grid(g))
    37	        _check(back == g, "grid round-trip failed: %r != %r" % (back, g))
    38	
    39	    # CALL payload: build [u64 handle][u64 call_id][grid] and decode it.
    40	    g = Grid(1, 2, [10.0, "x"])
    41	    call_bytes = struct.pack("<Q", 7) + struct.pack("<Q", 99) + _codec.encode_grid(g)
    42	    handle, call_id, args = _codec.decode_call(call_bytes)
    43	    _check(handle == 7 and call_id == 99, "decode_call header mismatch")
    44	    _check(args == g, "decode_call args grid mismatch")
    45	
    46	    # RETURN payload: [u64 call_id][grid] — verify the header + the grid tail decodes.
    47	    ret = _codec.encode_return(99, g)
    48	    _check(struct.unpack("<Q", ret[0:8])[0] == 99, "encode_return call_id mismatch")
    49	    _check(_codec.decode_grid(ret[8:]) == g, "encode_return grid tail mismatch")
    50	
    51	    # CALL truncated-header is loud, not an IndexError.
    52	    try:
    53	        _codec.decode_call(b"\x00" * 15)
    54	        _check(False, "decode_call should reject a 15-byte payload")
    55	    except ValueError:
    56	        pass
    57	
    58	    print("PASS")
    59	    return 0
    60	
    61	
    62	if __name__ == "__main__":
    63	    sys.exit(main())

