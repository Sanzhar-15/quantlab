    66	/// worker surfaces [`UdfError::WorkerDied`] rather than hanging. A scalar result
    67	/// is a 1×1 [`ArrayValue`].
    68	pub trait UdfWorker {
    69	    fn call(
    70	        &mut self,
    71	        handle: u64,
    72	        args: &ArrayValue,
    73	        deadline: Duration,
    74	    ) -> Result<ArrayValue, UdfError>;
    75	}
