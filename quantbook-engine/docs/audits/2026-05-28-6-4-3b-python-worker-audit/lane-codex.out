     1	//! Control-frame payload codecs: `HELLO` / `HELLO_ACK` / `RAISE` / `LOG` / `CANCEL`.
     2	//!
     3	//! **6.4-3b.** 6.4-3a defined the [`crate::frame`] envelope + the data-frame
     4	//! ([`crate::payload`]) `CALL`/`RETURN` payloads, and left the CONTROL-frame payload
     5	//! internals deliberately opaque `Vec<u8>` until a real worker pinned the handshake.
     6	//! This module pins them. On-wire layouts (the [`crate::frame`] envelope wraps each
     7	//! as the `payload`):
     8	//!
     9	//! - `HELLO`     (engine→worker): `[u32 LE protocol_version]`
    10	//! - `HELLO_ACK` (worker→engine): `[u32 LE protocol_version][u32 LE worker_pid]`
    11	//! - `RAISE`     (worker→engine): `[u64 LE call_id][u32 LE exc_type_len][exc_type utf8][message utf8…]`
    12	//! - `LOG`       (worker→engine): `[u8 level][message utf8…]`
    13	//! - `CANCEL`    (engine→worker): `[u64 LE call_id]`
    14	//!
    15	//! Every short/garbage payload is a loud [`CodecError`] — never a panic, never a
    16	//! silent default (No-Fallbacks; design §5). All multi-byte integers are
    17	//! little-endian, matching [`crate::frame`] + [`crate::payload`]. Strings are raw
    18	//! UTF-8 (no length prefix on the trailing string, which runs to the payload end).
    19	//!
    20	//! The protocol version the engine speaks. Bumped on any breaking wire change.
    21	//! The worker echoes it in `HELLO_ACK`; a mismatch is a handshake failure.
    22	
    23	use crate::codec::CodecError;
    24	
    25	/// The wire protocol version the engine and worker must agree on at handshake.
    26	pub const PROTOCOL_VERSION: u32 = 1;
    27	
    28	const U32: usize = 4;
    29	const U64: usize = 8;
    30	
    31	fn need(bytes: &[u8], n: usize) -> Result<(), CodecError> {
    32	    if bytes.len() < n {
    33	        return Err(CodecError::ShortHeader {
    34	            need: n,
    35	            got: bytes.len(),
    36	        });
    37	    }
    38	    Ok(())
    39	}
    40	
    41	fn read_u32_le(bytes: &[u8], at: usize) -> u32 {
    42	    u32::from_le_bytes(bytes[at..at + U32].try_into().expect("4 bytes"))
    43	}
    44	
    45	// ---- HELLO ----------------------------------------------------------------
    46	
    47	/// Encode a `HELLO` payload (engine→worker): the engine's protocol version.
    48	pub fn encode_hello(protocol_version: u32) -> Vec<u8> {
    49	    protocol_version.to_le_bytes().to_vec()
    50	}
    51	
    52	/// Decode a `HELLO` payload → the protocol version.
    53	pub fn decode_hello(bytes: &[u8]) -> Result<u32, CodecError> {
    54	    need(bytes, U32)?;
