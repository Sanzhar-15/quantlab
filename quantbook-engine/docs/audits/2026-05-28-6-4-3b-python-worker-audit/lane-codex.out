   197	        assert_eq!(decoded_call.handle, 7, "handle survives the wire");
   198	        assert_eq!(decoded_call.call_id, 99, "call_id survives the wire");
   199	        // The worker echoes its args back as the result (identity UDF), correlating
   200	        // the RETURN to the originating call_id.
   201	        let ret = ReturnPayload {
   202	            call_id: decoded_call.call_id,
   203	            result: decoded_call.args.clone(),
   204	        };
   205	        let return_frame = Frame::new(FrameType::Return, encode_return(&ret).unwrap());
   206	        let mut back = Vec::new();
   207	        write_frame(&mut back, &return_frame).unwrap();
