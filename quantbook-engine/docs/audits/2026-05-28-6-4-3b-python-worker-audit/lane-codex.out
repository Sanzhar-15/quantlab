   161	    /// The load-bearing composition test: push a CALL (handle + call_id + args) and
   162	    /// its RETURN (call_id + result) through the FULL wire pipeline
   163	    /// (payload → frame → … → frame → payload) with the mock standing in for the
   164	    /// worker process. Proves [`crate::payload`] + [`crate::frame`] + [`crate::codec`]
   165	    /// compose into a faithful round-trip — the thing the real 6.4-3b worker relies
   166	    /// on across the actual pipe — AND that the dispatch `handle` + correlation
   167	    /// `call_id` survive the trip (6.4-3a audit-fix: `call-return-missing-ids`).
   168	    #[test]
   169	    fn call_round_trips_through_frame_and_codec() {
   170	        // Engine-side args grid (a 1×3 row of mixed values).
   171	        let args = ArrayValue::new(
   172	            1,
   173	            3,
   174	            vec![
   175	                Value::Number(10.0),
   176	                Value::Text(Arc::from("x")),
   177	                Value::Error(ql_types::ErrorValue::NA),
   178	            ],
   179	        )
   180	        .unwrap();
   181	        let call = CallPayload {
   182	            handle: 7,
   183	            call_id: 99,
   184	            args,
   185	        };
   186	
   187	        // --- engine → wire: typed CALL payload inside a Call frame ---
   188	        let call_frame = Frame::new(FrameType::Call, encode_call(&call).unwrap());
   189	        let mut pipe = Vec::new();
   190	        write_frame(&mut pipe, &call_frame).unwrap();
   191	
   192	        // --- worker side: read the CALL, decode handle/call_id/args, "run" the UDF, encode RETURN ---
   193	        let mut cursor = std::io::Cursor::new(pipe);
