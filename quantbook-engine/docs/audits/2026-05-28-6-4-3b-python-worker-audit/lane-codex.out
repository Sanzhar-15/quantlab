   385	    use super::*;
   386	
   387	    fn roundtrip(grid: &ArrayValue) -> ArrayValue {
   388	        let bytes = encode_grid(grid).expect("encode");
   389	        decode_grid(&bytes).expect("decode")
   390	    }
   391	
   392	    fn assert_roundtrip(grid: ArrayValue) {
   393	        let back = roundtrip(&grid);
   394	        assert_eq!(back.rows(), grid.rows(), "rows");
   395	        assert_eq!(back.cols(), grid.cols(), "cols");
   396	        for r in 0..grid.rows() {
   397	            for c in 0..grid.cols() {
   398	                assert_eq!(back.get(r, c), grid.get(r, c), "cell ({r},{c})");
   399	            }
   400	        }
   401	    }
   402	
   403	    /// Write a hand-built (schema, columns) pair to IPC stream bytes — for the
   404	    /// adversarial decode tests that fabricate malformed worker output.
   405	    fn write_ipc(schema: &Arc<Schema>, columns: Vec<ArrayRef>) -> Vec<u8> {
   406	        let batch = RecordBatch::try_new(schema.clone(), columns).unwrap();
   407	        let mut buf = Vec::new();
   408	        let mut w = StreamWriter::try_new(&mut buf, schema).unwrap();
   409	        w.write(&batch).unwrap();
   410	        w.finish().unwrap();
   411	        buf
   412	    }
