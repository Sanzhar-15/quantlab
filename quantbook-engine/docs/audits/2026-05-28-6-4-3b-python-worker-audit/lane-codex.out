   107	/// Decode a `RAISE` payload. The `exc_type` length-prefix must not exceed the
   108	/// remaining bytes (a lying length is a loud error, not an OOB panic).
   109	pub fn decode_raise(bytes: &[u8]) -> Result<Raise, CodecError> {
   110	    need(bytes, U64 + U32)?;
