     1	//! Real-Python end-to-end smoke for [`ql_udf::ProcessWorker`] (Phase 6.4-3b).
     2	//!
     3	//! Spawns the actual `python -m quantbook.worker` and drives the full
     4	//! engine → Arrow → stdio → pyarrow → dispatch → Arrow → stdio → engine round trip,
     5	//! plus the raise / timeout-kill / respawn paths. If `python3` (or `python`) with
     6	//! `pyarrow` is not available, the test prints a LOUD skip and returns — this is
     7	//! test-environment gating, not a production fallback (the engine itself fails loud
     8	//! on a missing interpreter; see `process::tests::missing_interpreter_*`).
     9	
    10	use std::path::PathBuf;
    11	use std::process::Command;
    12	use std::sync::Arc;
    13	use std::time::Duration;
    14	
    15	use ql_types::{ArrayValue, Value};
    16	use ql_udf::{ProcessWorker, PythonWorkerConfig, UdfError, UdfWorker};
    17	
    18	/// Find an interpreter that can `import pyarrow`, or `None`.
    19	fn python_with_pyarrow() -> Option<String> {
    20	    for py in ["python3", "python"] {
    21	        let ok = Command::new(py)
    22	            .args(["-c", "import pyarrow"])
    23	            .output()
    24	            .map(|o| o.status.success())
    25	            .unwrap_or(false);
    26	        if ok {
    27	            return Some(py.to_string());
    28	        }
    29	    }
    30	    None
    31	}
    32	
    33	fn smoke_config(py: &str) -> PythonWorkerConfig {
    34	    let pythonpath = PathBuf::from(env!("CARGO_MANIFEST_DIR"))
    35	        .join("../quantbook-py/python")
    36	        .canonicalize()
    37	        .expect("quantbook-py/python directory should exist");
    38	    PythonWorkerConfig::new(py)
    39	        .with_pythonpath(pythonpath)
    40	        .with_udf_module("quantbook._smoke_udfs")
    41	}
    42	
    43	#[test]
    44	fn process_worker_round_trips_against_real_python() {
    45	    let py = match python_with_pyarrow() {
    46	        Some(p) => p,
    47	        None => {
    48	            eprintln!(
    49	                "SKIP process_worker_round_trips_against_real_python: \
    50	                 no `python3`/`python` with `pyarrow` on PATH"
    51	            );
    52	            return;
    53	        }
    54	    };
    55	    let mut w = ProcessWorker::new(smoke_config(&py));
    56	
    57	    // (1) handle 7 — double a number: full engine↔pyarrow round trip.
    58	    let out = w
    59	        .call(7, &ArrayValue::singleton(Value::Number(21.0)), Duration::from_secs(10))
    60	        .expect("call handle 7");
    61	    assert_eq!(out.rows(), 1);
    62	    assert_eq!(out.cols(), 1);
    63	    assert_eq!(out.get(0, 0), Some(&Value::Number(42.0)));
    64	    let pid_before = w.pid();
    65	    assert!(pid_before.is_some(), "worker should be live after a successful call");
    66	
    67	    // (2) handle 8 — identity over a mixed 1x3 grid: faithful round-trip of
    68	    //     number / text / boolean across the Arrow tagged columns.
    69	    let grid = ArrayValue::new(
    70	        1,
    71	        3,
    72	        vec![
    73	            Value::Number(1.5),
    74	            Value::Text(Arc::from("hi")),
    75	            Value::Boolean(true),
    76	        ],
    77	    )
    78	    .unwrap();
    79	    let back = w.call(8, &grid, Duration::from_secs(10)).expect("call handle 8");
    80	    assert_eq!(back.rows(), 1);
    81	    assert_eq!(back.cols(), 3);
    82	    assert_eq!(back.get(0, 0), Some(&Value::Number(1.5)));
    83	    assert_eq!(back.get(0, 1), Some(&Value::Text(Arc::from("hi"))));
    84	    assert_eq!(back.get(0, 2), Some(&Value::Boolean(true)));
    85	
    86	    // (3) handle 9 — the Python callable raises → deterministic Raised + diagnostic.
    87	    let err = w
    88	        .call(9, &ArrayValue::singleton(Value::Blank), Duration::from_secs(10))
    89	        .unwrap_err();
    90	    match err {
    91	        UdfError::Raised { exc_type, message } => {
    92	            assert_eq!(exc_type, "ValueError");
    93	            assert!(
    94	                message.contains("intentional smoke failure"),
    95	                "raise message: {message}"
    96	            );
    97	        }
    98	        other => panic!("expected UdfError::Raised, got {other:?}"),
    99	    }
   100	
   101	    // (4) handle 11 — sleeps 60s, deadline 300ms → Timeout + the worker is killed.
   102	    let timed_out = w
   103	        .call(11, &ArrayValue::singleton(Value::Blank), Duration::from_millis(300))
   104	        .unwrap_err();
   105	    assert!(
   106	        matches!(timed_out, UdfError::Timeout(_)),
   107	        "expected UdfError::Timeout, got {timed_out:?}"
   108	    );
   109	    assert_eq!(w.pid(), None, "the worker must be dead after a timeout-kill");
   110	
   111	    // (5) Respawn: a subsequent call lazily re-spawns + re-handshakes and succeeds.
   112	    let out2 = w
   113	        .call(7, &ArrayValue::singleton(Value::Number(4.0)), Duration::from_secs(10))
   114	        .expect("respawn + call handle 7");
   115	    assert_eq!(out2.get(0, 0), Some(&Value::Number(8.0)));
   116	    assert!(w.pid().is_some(), "a fresh worker should be live after respawn");
   117	    assert_ne!(
   118	        w.pid(),
   119	        pid_before,
   120	        "respawn must be a NEW process (different pid)"
   121	    );
   122	}

