     1	//! [`ProcessWorker`] — a managed Python worker process implementing [`UdfWorker`].
     2	//!
     3	//! **6.4-3b.** This is the real, process-backed worker the 6.4-3a `MockWorker`
     4	//! stood in for. It spawns `python -m quantbook.worker`, performs the
     5	//! `HELLO`/`HELLO_ACK` handshake, sends one `CALL` per UDF invocation, and reads
     6	//! the `RETURN`/`RAISE`/`LOG` response — subject to a deadline. On a deadline
     7	//! breach (or any transport break) it KILLS the worker (hard cancel, design §5)
     8	//! and marks itself dead; the next [`UdfWorker::call`] lazily re-spawns +
     9	//! re-handshakes. A late `RETURN` arriving after a kill is dropped because the
    10	//! reader thread dies with the process (contract §10.4 exit test 6).
    11	//!
    12	//! **Threading model (single-in-flight, matching the SYNC recalc):** a per-worker
    13	//! reader thread reads frames off the child's stdout and forwards them on an
    14	//! `mpsc` channel; `call()` writes the `CALL`, then `recv_timeout`s for the
    15	//! correlated `RETURN`/`RAISE` (skipping `LOG` and stale `call_id`s). The engine's
    16	//! recalc evaluates one UDF cell at a time, so there is at most one outstanding
    17	//! call; `call_id` correlation is still enforced defensively.
    18	//!
    19	//! **No new dependencies** — only `std::process` / `std::thread` / `std::sync::mpsc`.
    20	//! Every failure is a deterministic [`UdfError`] (No-Fallbacks): a missing
    21	//! interpreter, a failed handshake, a dead worker, a protocol violation, or a codec
    22	//! error never panics the caller.
    23	//!
    24	//! Production interpreter discovery + trusted-workspace gating + debugpy attach are
    25	//! 6.4-3d; [`PythonWorkerConfig`] takes the interpreter + module path explicitly.
    26	
    27	use std::io::BufReader;
    28	use std::path::PathBuf;
    29	use std::process::{Child, ChildStdin, Command, Stdio};
    30	use std::sync::mpsc::{self, Receiver, RecvTimeoutError};
    31	use std::thread::JoinHandle;
    32	use std::time::{Duration, Instant};
    33	
    34	use ql_types::ArrayValue;
    35	
    36	use crate::control::{decode_hello_ack, decode_log, decode_raise, encode_hello, PROTOCOL_VERSION};
    37	use crate::frame::{read_frame, write_frame, Frame, FrameError, FrameType};
    38	use crate::payload::{decode_return, encode_call, CallPayload};
    39	use crate::worker::{UdfError, UdfWorker};
    40	
    41	/// How the engine launches + talks to a Python worker. Interpreter + module path
    42	/// are explicit (production trusted-workspace discovery is 6.4-3d).
    43	#[derive(Debug, Clone)]
    44	pub struct PythonWorkerConfig {
    45	    /// The Python interpreter to launch (e.g. a workspace venv's `python3`).
    46	    pub python: PathBuf,
    47	    /// The `-m` module that runs the worker loop. Default `"quantbook.worker"`.
    48	    pub module: String,
    49	    /// Directories prepended to `PYTHONPATH` (so the worker module + the
    50	    /// `quantbook` package resolve). The inherited `PYTHONPATH` is appended.
    51	    pub pythonpath: Vec<PathBuf>,
    52	    /// The trusted user module the worker imports to register UDFs by handle
    53	    /// (passed as `QUANTBOOK_UDF_MODULE`). `None` = the worker registers nothing
    54	    /// (every `CALL` then surfaces a `[function_not_found]`-style raise).
    55	    pub udf_module: Option<String>,
    56	    /// The wire protocol version the engine speaks (checked at handshake).
    57	    pub protocol_version: u32,
    58	    /// How long to wait for `HELLO_ACK` after spawning before declaring the
    59	    /// worker dead.
    60	    pub handshake_timeout: Duration,
    61	}
    62	
    63	impl PythonWorkerConfig {
    64	    /// Config with defaults: module `quantbook.worker`, current [`PROTOCOL_VERSION`],
    65	    /// a 5s handshake timeout, no extra `PYTHONPATH` / udf module.
    66	    pub fn new(python: impl Into<PathBuf>) -> Self {
    67	        Self {
    68	            python: python.into(),
    69	            module: "quantbook.worker".to_string(),
    70	            pythonpath: Vec::new(),
    71	            udf_module: None,
    72	            protocol_version: PROTOCOL_VERSION,
    73	            handshake_timeout: Duration::from_secs(5),
    74	        }
    75	    }
    76	
    77	    /// Builder: prepend a directory to `PYTHONPATH`.
    78	    pub fn with_pythonpath(mut self, dir: impl Into<PathBuf>) -> Self {
    79	        self.pythonpath.push(dir.into());
    80	        self
    81	    }
    82	
    83	    /// Builder: set the trusted user module the worker imports.
    84	    pub fn with_udf_module(mut self, module: impl Into<String>) -> Self {
    85	        self.udf_module = Some(module.into());
    86	        self
    87	    }
    88	}
    89	
    90	/// A message from the reader thread to `call()`. A clean stdout EOF disconnects the
    91	/// channel (no message); a frame-decode failure is forwarded as `Error` so the
    92	/// caller can distinguish a torn stream from a clean shutdown.
    93	enum ReaderMsg {
    94	    Frame(Frame),
    95	    Error(String),
    96	}
    97	
    98	/// A live worker process + its stdin writer + the reader-thread channel.
    99	struct WorkerProcess {
   100	    child: Child,
   101	    stdin: ChildStdin,
   102	    rx: Receiver<ReaderMsg>,
   103	    reader: Option<JoinHandle<()>>,
   104	    /// The OS pid (also surfaced to the IDE for debugpy attach at 6.4-3d).
   105	    pid: u32,
   106	}
   107	
   108	impl Drop for WorkerProcess {
   109	    fn drop(&mut self) {
   110	        // Hard-stop the child and REAP it (no zombies), then let the reader thread
   111	        // wind down on the resulting stdout EOF. Errors are ignored — the process
   112	        // may already be dead.
   113	        let _ = self.child.kill();
   114	        let _ = self.child.wait();
   115	        if let Some(h) = self.reader.take() {
   116	            // The child is reaped, so its stdout is closed → the reader's
   117	            // `read_frame` returns EOF and the thread exits promptly; this join
   118	            // does not block.
   119	            let _ = h.join();
   120	        }
   121	    }
   122	}
   123	
   124	/// A managed Python worker process implementing [`UdfWorker`].
   125	pub struct ProcessWorker {
   126	    config: PythonWorkerConfig,
   127	    proc: Option<WorkerProcess>,
   128	    next_call_id: u64,
   129	}
   130	
   131	impl ProcessWorker {
   132	    /// Create a worker handle. The process is spawned lazily on the first
   133	    /// [`UdfWorker::call`] (or via [`ProcessWorker::ensure_started`]).
   134	    pub fn new(config: PythonWorkerConfig) -> Self {
   135	        Self {
   136	            config,
   137	            proc: None,
   138	            next_call_id: 1,
   139	        }
   140	    }
   141	
   142	    /// The live worker's OS pid, if spawned.
   143	    pub fn pid(&self) -> Option<u32> {
   144	        self.proc.as_ref().map(|p| p.pid)
   145	    }
   146	
   147	    /// Eagerly spawn + handshake (otherwise the first `call()` does it lazily).
   148	    pub fn ensure_started(&mut self) -> Result<(), UdfError> {
   149	        if self.proc.is_none() {
   150	            self.proc = Some(self.spawn()?);
   151	        }
   152	        Ok(())
   153	    }
   154	
   155	    /// Kill + reap the worker and mark dead so the next call re-spawns.
   156	    pub fn shutdown(&mut self) {
   157	        self.proc = None; // `WorkerProcess::drop` kills + reaps.
   158	    }
   159	
   160	    fn spawn(&self) -> Result<WorkerProcess, UdfError> {
   161	        let mut cmd = Command::new(&self.config.python);
   162	        cmd.arg("-m")
   163	            .arg(&self.config.module)
   164	            .stdin(Stdio::piped())
   165	            .stdout(Stdio::piped())
   166	            .stderr(Stdio::inherit()); // worker stderr (stray prints / tracebacks) → our stderr
   167	
   168	        // PYTHONPATH = configured dirs ++ inherited (so site-packages stays reachable
   169	        // via the normal interpreter config; pyarrow lives there).
   170	        let mut paths = self.config.pythonpath.clone();
   171	        if let Some(existing) = std::env::var_os("PYTHONPATH") {
   172	            paths.extend(std::env::split_paths(&existing));
   173	        }
   174	        if !paths.is_empty() {
   175	            let joined = std::env::join_paths(paths)
   176	                .map_err(|e| UdfError::WorkerDied(format!("invalid PYTHONPATH: {e}")))?;
   177	            cmd.env("PYTHONPATH", joined);
   178	        }
   179	        if let Some(m) = &self.config.udf_module {
   180	            cmd.env("QUANTBOOK_UDF_MODULE", m);
   181	        }
   182	
   183	        let mut child = cmd.spawn().map_err(|e| {
   184	            UdfError::WorkerDied(format!(
   185	                "spawn {} -m {}: {e}",
   186	                self.config.python.display(),
   187	                self.config.module
   188	            ))
   189	        })?;
   190	        let stdin = child
   191	            .stdin
   192	            .take()
   193	            .ok_or_else(|| UdfError::WorkerDied("worker stdin pipe missing".to_string()))?;
   194	        let stdout = child
   195	            .stdout
   196	            .take()
   197	            .ok_or_else(|| UdfError::WorkerDied("worker stdout pipe missing".to_string()))?;
   198	        let pid = child.id();
   199	
   200	        let (tx, rx) = mpsc::channel();
   201	        let reader = std::thread::spawn(move || {
   202	            let mut r = BufReader::new(stdout);
   203	            loop {
   204	                match read_frame(&mut r) {
   205	                    Ok(Some(f)) => {
   206	                        if tx.send(ReaderMsg::Frame(f)).is_err() {
   207	                            break; // receiver dropped (worker being torn down)
   208	                        }
   209	                    }
   210	                    Ok(None) => break, // clean EOF — worker closed stdout
   211	                    Err(e) => {
   212	                        let _ = tx.send(ReaderMsg::Error(e.to_string()));
   213	                        break;
   214	                    }
   215	                }
   216	            }
   217	        });
   218	
   219	        let mut wp = WorkerProcess {
   220	            child,
   221	            stdin,
   222	            rx,
   223	            reader: Some(reader),
   224	            pid,
   225	        };
   226	        self.handshake(&mut wp)?;
   227	        Ok(wp)
   228	    }
   229	
   230	    fn handshake(&self, wp: &mut WorkerProcess) -> Result<(), UdfError> {
   231	        let hello = Frame::new(FrameType::Hello, encode_hello(self.config.protocol_version));
   232	        write_frame(&mut wp.stdin, &hello)
   233	            .map_err(|e| UdfError::WorkerDied(format!("write HELLO: {e}")))?;
   234	        // (write_frame writes the whole frame; ChildStdin is unbuffered, no flush needed,
   235	        // but flushing is harmless and explicit.)
   236	        use std::io::Write;
   237	        wp.stdin
   238	            .flush()
   239	            .map_err(|e| UdfError::WorkerDied(format!("flush HELLO: {e}")))?;
   240	
   241	        match wp.rx.recv_timeout(self.config.handshake_timeout) {
   242	            Ok(ReaderMsg::Frame(f)) => {
   243	                if f.frame_type != FrameType::HelloAck {
   244	                    return Err(UdfError::Protocol(format!(
   245	                        "expected HELLO_ACK, got {:?}",
   246	                        f.frame_type
   247	                    )));
   248	                }
   249	                let ack = decode_hello_ack(&f.payload)?;
   250	                if ack.protocol_version != self.config.protocol_version {
   251	                    return Err(UdfError::Handshake {
   252	                        expected: self.config.protocol_version,
   253	                        got: ack.protocol_version,
   254	                    });
   255	                }
   256	                Ok(())
   257	            }
   258	            Ok(ReaderMsg::Error(e)) => {
   259	                Err(UdfError::WorkerDied(format!("reader during handshake: {e}")))
   260	            }
   261	            Err(RecvTimeoutError::Timeout) => {
   262	                Err(UdfError::WorkerDied("handshake timed out (no HELLO_ACK)".to_string()))
   263	            }
   264	            Err(RecvTimeoutError::Disconnected) => {
   265	                Err(UdfError::WorkerDied("worker exited before handshake".to_string()))
   266	            }
   267	        }
   268	    }
   269	
   270	    fn kill_worker(&mut self) {
   271	        // Dropping the `WorkerProcess` kills + reaps the child and winds down the
   272	        // reader thread; setting `None` marks dead so the next call re-spawns.
   273	        self.proc = None;
   274	    }
   275	}
   276	
   277	impl UdfWorker for ProcessWorker {
   278	    fn call(
   279	        &mut self,
   280	        handle: u64,
   281	        args: &ArrayValue,
   282	        deadline: Duration,
   283	    ) -> Result<ArrayValue, UdfError> {
   284	        let call_id = self.next_call_id;
   285	        self.next_call_id = self.next_call_id.wrapping_add(1);
   286	
   287	        // (Re)spawn if dead. A spawn/handshake failure is the caller's error.
   288	        self.ensure_started()?;
   289	
   290	        // Encode + send the CALL.
   291	        let payload = encode_call(&CallPayload {
   292	            handle,
   293	            call_id,
   294	            args: args.clone(),
   295	        })?;
   296	        let frame = Frame::new(FrameType::Call, payload);
   297	        let write_res: Result<(), FrameError> = {
   298	            let wp = self.proc.as_mut().expect("spawned above");
   299	            use std::io::Write;
   300	            write_frame(&mut wp.stdin, &frame).and_then(|()| wp.stdin.flush().map_err(FrameError::from))
   301	        };
   302	        if let Err(e) = write_res {
   303	            self.kill_worker();
   304	            return Err(UdfError::WorkerDied(format!("write CALL: {e}")));
   305	        }
   306	
   307	        // Await the correlated RETURN/RAISE, honoring the deadline.
   308	        let deadline_at = Instant::now() + deadline;
   309	        loop {
   310	            let remaining = deadline_at.saturating_duration_since(Instant::now());
   311	            let msg = {
   312	                let wp = self.proc.as_mut().expect("spawned above");
   313	                wp.rx.recv_timeout(remaining)
   314	            };
   315	            match msg {
   316	                Ok(ReaderMsg::Frame(f)) => match f.frame_type {
   317	                    FrameType::Return => {
   318	                        let ret = decode_return(&f.payload)?;
   319	                        if ret.call_id != call_id {
   320	                            continue; // stale response from a prior call — skip
   321	                        }
   322	                        return Ok(ret.result);
   323	                    }
   324	                    FrameType::Raise => {
   325	                        let r = decode_raise(&f.payload)?;
   326	                        if r.call_id != call_id {
   327	                            continue;
   328	                        }
   329	                        return Err(UdfError::Raised {
   330	                            exc_type: r.exc_type,
   331	                            message: r.message,
   332	                        });
   333	                    }
   334	                    FrameType::Log => {
   335	                        let log = decode_log(&f.payload)?;
   336	                        // Surfaced visibly (NOT silently dropped). 6.4-3c routes worker
   337	                        // logs to `CellDiagnostic`s; until then they go to stderr.
   338	                        eprintln!(
   339	                            "[quantbook-udf worker log lvl={}] {}",
   340	                            log.level, log.message
   341	                        );
   342	                        continue;
   343	                    }
   344	                    other => {
   345	                        self.kill_worker();
   346	                        return Err(UdfError::Protocol(format!(
   347	                            "unexpected {other:?} frame while awaiting RETURN/RAISE for call_id {call_id}"
   348	                        )));
   349	                    }
   350	                },
   351	                Ok(ReaderMsg::Error(e)) => {
   352	                    self.kill_worker();
   353	                    return Err(UdfError::WorkerDied(format!("reader: {e}")));
   354	                }
   355	                Err(RecvTimeoutError::Timeout) => {
   356	                    // Hard cancel: kill the worker so a late RETURN is dropped (exit test 6).
   357	                    self.kill_worker();
   358	                    return Err(UdfError::Timeout(deadline));
   359	                }
   360	                Err(RecvTimeoutError::Disconnected) => {
   361	                    self.kill_worker();
   362	                    return Err(UdfError::WorkerDied("worker exited mid-call".to_string()));
   363	                }
   364	            }
   365	        }
   366	    }
   367	}
   368	
