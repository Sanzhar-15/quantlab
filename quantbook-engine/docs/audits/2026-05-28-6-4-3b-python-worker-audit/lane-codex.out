   121	        .map_err(|_| CodecError::BadUtf8 { field: "exc_type" })?
   122	        .to_string();
   123	    let message = std::str::from_utf8(&after_len[et_len..])
   124	        .map_err(|_| CodecError::BadUtf8 { field: "message" })?
   125	        .to_string();
   126	    Ok(Raise {
   127	        call_id,
   128	        exc_type,
   129	        message,
   130	    })
   131	}
