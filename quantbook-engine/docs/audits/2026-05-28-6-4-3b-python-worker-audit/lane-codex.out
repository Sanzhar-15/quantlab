    22	
    23	def _import_udf_module():
    24	    """Import the trusted user module (registers UDFs by handle) if configured."""
    25	    mod = os.environ.get("QUANTBOOK_UDF_MODULE")
    26	    if mod:
    27	        importlib.import_module(mod)
