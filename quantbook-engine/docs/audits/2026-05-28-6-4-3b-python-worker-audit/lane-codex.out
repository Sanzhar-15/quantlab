   209	        // --- wire → engine: read the RETURN, decode, check correlation + grid ---
   210	        let mut rcursor = std::io::Cursor::new(back);
   211	        let rframe = read_frame(&mut rcursor).unwrap().expect("a frame");
   212	        assert_eq!(rframe.frame_type, FrameType::Return);
   213	        let decoded_return = decode_return(&rframe.payload).unwrap();
   214	        assert_eq!(decoded_return.call_id, 99, "RETURN correlates to the CALL");
