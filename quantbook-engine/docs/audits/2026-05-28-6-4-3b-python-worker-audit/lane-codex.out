    84	    responder: F,
    85	}
    86	
    87	impl<F> MockWorker<F>
    88	where
    89	    F: FnMut(u64, &ArrayValue) -> Result<ArrayValue, UdfError>,
    90	{
    91	    pub fn new(responder: F) -> Self {
    92	        Self { responder }
    93	    }
    94	}
    95	
    96	impl<F> UdfWorker for MockWorker<F>
    97	where
    98	    F: FnMut(u64, &ArrayValue) -> Result<ArrayValue, UdfError>,
    99	{
   100	    fn call(
   101	        &mut self,
   102	        handle: u64,
   103	        args: &ArrayValue,
   104	        _deadline: Duration,
   105	    ) -> Result<ArrayValue, UdfError> {
   106	        (self.responder)(handle, args)
   107	    }
   108	}
