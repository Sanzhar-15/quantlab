     1	//! Typed `CALL` / `RETURN` frame payloads — the correlation + dispatch header that
     2	//! rides in front of the Arrow grid.
     3	//!
     4	//! **6.4-3a audit-fix (`call-return-missing-ids`).** The wire protocol (design §3)
     5	//! specifies `CALL { handle, call_id, args }` and `RETURN { call_id, result }` —
     6	//! NOT a bare Arrow grid. Without `handle` the worker cannot know which registered
     7	//! Python callable to invoke; without `call_id` the engine cannot correlate a
     8	//! response, drop a late result after a deadline/kill, or address a `CANCEL`
     9	//! (contract §6.2 / §10.4 exit test 6). This module defines those payload structures
    10	//! so the contract a real Python worker speaks is pinned NOW, at the protocol layer,
    11	//! rather than retrofitted under the 6.4-3c eval-wiring audit.
    12	//!
    13	//! **On-wire layout** (the [`crate::frame`] envelope wraps these as the `payload`):
    14	//! - `CALL`   payload = `[u64 LE handle][u64 LE call_id][Arrow IPC args grid]`
    15	//! - `RETURN` payload = `[u64 LE call_id][Arrow IPC result grid]`
    16	//!
    17	//! The fixed `u64`-LE header is deliberately trivial (no Arrow, no length prefix —
    18	//! the [`crate::frame`] layer already delimits the whole payload). The grid bytes
    19	//! are produced/consumed by [`crate::codec`], which validates them as a trust
    20	//! boundary. A payload shorter than its header is a loud [`CodecError::ShortHeader`]
    21	//! — never a panic (No-Fallbacks; design §5).
    22	//!
    23	//! The actual correlation MECHANICS (minting `call_id`s, the in-flight table,
    24	//! dropping late results) live in the process-backed worker handle (6.4-3b); this
    25	//! module owns only the on-wire structure + its codec.
    26	
    27	use ql_types::ArrayValue;
    28	
    29	use crate::codec::{decode_grid, encode_grid, CodecError};
    30	
    31	/// Width of a `u64`-LE header field.
    32	const U64: usize = 8;
    33	
    34	/// A `CALL` frame's payload: which UDF (`handle`), correlation id (`call_id`), and
    35	/// the evaluated argument grid.
    36	#[derive(Debug, Clone, PartialEq)]
    37	pub struct CallPayload {
    38	    /// Opaque worker-side function id (the `FunctionImplHandle` minted IDE-side).
    39	    pub handle: u64,
    40	    /// Correlates the [`ReturnPayload`] / a `CANCEL`; lets the engine drop a result
    41	    /// that arrives after the deadline (exit test 6).
    42	    pub call_id: u64,
    43	    /// The evaluated UDF arguments as a grid (a scalar is a 1×1 grid).
    44	    pub args: ArrayValue,
    45	}
    46	
    47	/// A `RETURN` frame's payload: the `call_id` it answers + the result grid.
    48	#[derive(Debug, Clone, PartialEq)]
    49	pub struct ReturnPayload {
    50	    /// Echoes the originating [`CallPayload::call_id`].
    51	    pub call_id: u64,
    52	    /// The UDF result as a grid (a scalar is a 1×1 grid).
    53	    pub result: ArrayValue,
    54	}
    55	
    56	/// Encode a [`CallPayload`] to `CALL`-frame payload bytes.
    57	pub fn encode_call(p: &CallPayload) -> Result<Vec<u8>, CodecError> {
    58	    let grid = encode_grid(&p.args)?;
    59	    let mut buf = Vec::with_capacity(2 * U64 + grid.len());
    60	    buf.extend_from_slice(&p.handle.to_le_bytes());
    61	    buf.extend_from_slice(&p.call_id.to_le_bytes());
    62	    buf.extend_from_slice(&grid);
    63	    Ok(buf)
    64	}
    65	
    66	/// Decode `CALL`-frame payload bytes back to a [`CallPayload`].
    67	pub fn decode_call(bytes: &[u8]) -> Result<CallPayload, CodecError> {
    68	    let need = 2 * U64;
    69	    if bytes.len() < need {
    70	        return Err(CodecError::ShortHeader {
    71	            need,
    72	            got: bytes.len(),
    73	        });
    74	    }
    75	    let handle = u64::from_le_bytes(bytes[0..U64].try_into().expect("8 bytes"));
    76	    let call_id = u64::from_le_bytes(bytes[U64..2 * U64].try_into().expect("8 bytes"));
    77	    let args = decode_grid(&bytes[2 * U64..])?;
    78	    Ok(CallPayload {
    79	        handle,
    80	        call_id,
    81	        args,
    82	    })
    83	}
    84	
    85	/// Encode a [`ReturnPayload`] to `RETURN`-frame payload bytes.
    86	pub fn encode_return(p: &ReturnPayload) -> Result<Vec<u8>, CodecError> {
    87	    let grid = encode_grid(&p.result)?;
    88	    let mut buf = Vec::with_capacity(U64 + grid.len());
    89	    buf.extend_from_slice(&p.call_id.to_le_bytes());
    90	    buf.extend_from_slice(&grid);
    91	    Ok(buf)
    92	}
    93	
    94	/// Decode `RETURN`-frame payload bytes back to a [`ReturnPayload`].
    95	pub fn decode_return(bytes: &[u8]) -> Result<ReturnPayload, CodecError> {
    96	    let need = U64;
    97	    if bytes.len() < need {
    98	        return Err(CodecError::ShortHeader {
    99	            need,
   100	            got: bytes.len(),
   101	        });
   102	    }
   103	    let call_id = u64::from_le_bytes(bytes[0..U64].try_into().expect("8 bytes"));
   104	    let result = decode_grid(&bytes[U64..])?;
   105	    Ok(ReturnPayload { call_id, result })
   106	}
