     1	//! Arrow ⇄ engine-`Value` codec — the wire payload for `CALL` / `RETURN` frames.
     2	//!
     3	//! **6.4-3a.** A UDF call's arguments and result are 2-D grids of spreadsheet
     4	//! values ([`ql_types::ArrayValue`]); a scalar is just a 1×1 grid. This module
     5	//! encodes a grid to Arrow IPC stream bytes and back.
     6	//!
     7	//! **Encoding (design §3 — the tagged columns).** Arrow has no native
     8	//! spreadsheet-error type, so a value is encoded across five parallel columns of
     9	//! length `rows*cols` (row-major), discriminated by `kind`:
    10	//!
    11	//! | kind     | populated column | engine `Value`            |
    12	//! |----------|------------------|---------------------------|
    13	//! | `blank`  | (none)           | `Value::Blank`            |
    14	//! | `number` | `num: f64`       | `Value::Number`           |
    15	//! | `bool`   | `bool: bool`     | `Value::Boolean`          |
    16	//! | `text`   | `str: Utf8`      | `Value::Text`             |
    17	//! | `error`  | `err: Utf8`      | `Value::Error` (by sigil) |
    18	//!
    19	//! The grid shape (`rows`, `cols`) rides in the Arrow schema metadata so degenerate
    20	//! shapes (`rows==0` or `cols==0`, zero cells) round-trip faithfully. The encoding
    21	//! is deliberately verbose-but-unambiguous; a compact layout is a later optimization
    22	//! behind this same boundary.
    23	//!
    24	//! **Decode is a trust boundary (6.4-3a cycle-1 audit-fix).** The bytes a `RETURN`
    25	//! frame carries are produced by an out-of-process Python worker — possibly buggy
    26	//! or hostile. `decode_grid` therefore validates the batch BEFORE trusting it:
    27	//! - the schema must be EXACTLY the 5 expected fields, by name + Arrow type +
    28	//!   nullability, in order ([`validate_grid_schema`]) — so a `pyarrow` worker that
    29	//!   reorders/renames columns is rejected loudly rather than silently mis-read (the
    30	//!   two `Utf8` columns `str`/`err` are otherwise type-interchangeable);
    31	//! - the active payload column for each `kind` must be non-null (a null active slot
    32	//!   is a malformed response, not a silent `0.0`/`false`/`""`);
    33	//! - a decoded `number` must be finite (`NaN`/`Inf` from the worker is a malformed
    34	//!   result — the engine's `Value::Number` invariant is "always finite");
    35	//! - the stream must contain EXACTLY one record batch (trailing data is rejected).
    36	//!
    37	//! No code path reachable from worker-controlled bytes may panic — every failure is
    38	//! a loud [`CodecError`] (No-Fallbacks; design §5 / contract §10.4 exit tests 6+7).
    39	//! `encode_grid` trusts its input (engine-resident `Value`s already satisfy the
    40	//! finite-`Number` invariant); the validation above guards the untrusted *decode*
    41	//! direction.
    42	
    43	use std::collections::HashMap;
    44	use std::str::FromStr;
    45	use std::sync::Arc;
    46	
    47	use arrow::array::{
    48	    Array, ArrayRef, BooleanArray, BooleanBuilder, Float64Array, Float64Builder, StringArray,
    49	    StringBuilder,
    50	};
    51	use arrow::datatypes::{DataType, Field, Schema};
    52	use arrow::ipc::reader::StreamReader;
    53	use arrow::ipc::writer::StreamWriter;
    54	use arrow::record_batch::RecordBatch;
    55	
    56	use ql_types::{ArrayValue, ErrorValue, Value};
    57	
    58	/// Failure to encode/decode a grid on the UDF wire. Every variant is loud — no
    59	/// silent normalization (No-Fallbacks).
    60	#[derive(Debug, thiserror::Error)]
    61	pub enum CodecError {
    62	    /// Underlying Arrow IPC read/write error.
    63	    #[error("arrow ipc: {0}")]
    64	    Arrow(#[from] arrow::error::ArrowError),
    65	    /// The IPC stream contained no record batch.
    66	    #[error("decode: empty IPC stream (expected exactly one record batch)")]
    67	    Empty,
    68	    /// The IPC stream contained MORE than one record batch (expected exactly one).
    69	    #[error("decode: trailing data after the first record batch (expected exactly one)")]
    70	    TrailingBatch,
    71	    /// The batch schema was not the exact expected 5-field grid schema.
    72	    #[error("decode: bad grid schema ({0})")]
    73	    BadSchema(String),
    74	    /// The schema metadata was missing the `rows`/`cols` shape keys.
    75	    #[error("decode: missing '{0}' in schema metadata")]
    76	    MissingShape(&'static str),
    77	    /// A shape metadata value did not parse as a u32.
    78	    #[error("decode: shape '{key}' = {value:?} is not a u32")]
    79	    BadShape { key: &'static str, value: String },
    80	    /// `rows * cols` overflowed `usize` (a hostile/garbage shape).
    81	    #[error("decode: shape rows={rows} * cols={cols} overflows usize")]
    82	    ShapeOverflow { rows: u32, cols: u32 },
    83	    /// A column was absent or had the wrong Arrow type.
    84	    #[error("decode: column {0} missing or wrong type")]
    85	    BadColumn(&'static str),
    86	    /// A `kind` discriminant was not one of the five known tags.
    87	    #[error("decode: unknown kind {0:?}")]
    88	    BadKind(String),
    89	    /// The active payload column for a cell's `kind` was NULL (malformed response —
    90	    /// reading it would silently coerce to `0.0`/`false`/`""`).
    91	    #[error("decode: cell {row} has kind {kind:?} but its payload column is null")]
    92	    NullPayload { row: usize, kind: String },
    93	    /// A decoded `number` was non-finite (`NaN`/`Inf`) — out of the engine's
    94	    /// `Value::Number` finite invariant; a malformed worker result.
    95	    #[error("decode: cell {row} is a non-finite number ({value})")]
    96	    NonFinite { row: usize, value: f64 },
    97	    /// An `error` cell carried a sigil that is not a known `ErrorValue`.
    98	    #[error("decode: unknown error sigil {0:?}")]
    99	    BadErrorSigil(String),
   100	    /// The decoded cells did not match the declared shape.
   101	    #[error("decode: shape mismatch ({0})")]
   102	    ShapeMismatch(String),
   103	    /// A `CALL`/`RETURN` payload was shorter than its fixed `handle`/`call_id`
   104	    /// header (6.4-3a audit-fix: typed payload framing — see [`crate::payload`]).
   105	    #[error("decode: payload header truncated (need {need} bytes, got {got})")]
   106	    ShortHeader { need: usize, got: usize },
   107	    /// A control-frame string field ([`crate::control`]) was not valid UTF-8.
   108	    #[error("decode: {field} field is not valid UTF-8")]
   109	    BadUtf8 { field: &'static str },
   110	}
   111	
   112	const COL_KIND: usize = 0;
   113	const COL_NUM: usize = 1;
   114	const COL_STR: usize = 2;
   115	const COL_BOOL: usize = 3;
   116	const COL_ERR: usize = 4;
   117	
   118	/// The exact field layout (name, type, nullability) the decoder requires. `kind`
   119	/// is the non-null discriminant; the four payload columns are nullable (only the
   120	/// one matching `kind` is populated per cell).
   121	const EXPECTED_FIELDS: [(&str, DataType, bool); 5] = [
   122	    ("kind", DataType::Utf8, false),
   123	    ("num", DataType::Float64, true),
   124	    ("str", DataType::Utf8, true),
   125	    ("bool", DataType::Boolean, true),
   126	    ("err", DataType::Utf8, true),
   127	];
   128	
   129	fn grid_schema(rows: u32, cols: u32) -> Schema {
   130	    let fields: Vec<Field> = EXPECTED_FIELDS
   131	        .iter()
   132	        .map(|(name, dt, nullable)| Field::new(*name, dt.clone(), *nullable))
   133	        .collect();
   134	    let metadata = HashMap::from([
   135	        ("rows".to_string(), rows.to_string()),
   136	        ("cols".to_string(), cols.to_string()),
   137	    ]);
   138	    Schema::new(fields).with_metadata(metadata)
   139	}
   140	
   141	/// Encode a grid to Arrow IPC stream bytes (the `CALL`/`RETURN` frame payload).
   142	pub fn encode_grid(grid: &ArrayValue) -> Result<Vec<u8>, CodecError> {
   143	    let rows = grid.rows();
   144	    let cols = grid.cols();
   145	
   146	    let mut kind = StringBuilder::new();
   147	    let mut num = Float64Builder::new();
   148	    let mut text = StringBuilder::new();
   149	    let mut boolean = BooleanBuilder::new();
   150	    let mut err = StringBuilder::new();
   151	
   152	    // Row-major, matching `ArrayValue`'s own cell ordering.
   153	    for r in 0..rows {
   154	        for c in 0..cols {
   155	            let v = grid
   156	                .get(r, c)
   157	                .ok_or_else(|| CodecError::ShapeMismatch(format!("get({r},{c}) out of bounds")))?;
   158	            match v {
   159	                Value::Blank => {
   160	                    kind.append_value("blank");
   161	                    num.append_null();
   162	                    text.append_null();
   163	                    boolean.append_null();
   164	                    err.append_null();
   165	                }
   166	                Value::Number(x) => {
   167	                    kind.append_value("number");
   168	                    num.append_value(*x);
   169	                    text.append_null();
   170	                    boolean.append_null();
   171	                    err.append_null();
   172	                }
   173	                Value::Boolean(x) => {
   174	                    kind.append_value("bool");
   175	                    num.append_null();
   176	                    text.append_null();
   177	                    boolean.append_value(*x);
   178	                    err.append_null();
   179	                }
   180	                Value::Text(t) => {
   181	                    kind.append_value("text");
   182	                    num.append_null();
   183	                    text.append_value(t.as_ref());
   184	                    boolean.append_null();
   185	                    err.append_null();
   186	                }
   187	                Value::Error(e) => {
   188	                    kind.append_value("error");
   189	                    num.append_null();
   190	                    text.append_null();
   191	                    boolean.append_null();
   192	                    err.append_value(e.sigil());
   193	                }
   194	            }
   195	        }
   196	    }
   197	
   198	    let columns: Vec<ArrayRef> = vec![
   199	        Arc::new(kind.finish()),
   200	        Arc::new(num.finish()),
   201	        Arc::new(text.finish()),
   202	        Arc::new(boolean.finish()),
   203	        Arc::new(err.finish()),
   204	    ];
   205	    let schema = Arc::new(grid_schema(rows, cols));
   206	    let batch = RecordBatch::try_new(schema.clone(), columns)?;
   207	
   208	    let mut buf = Vec::new();
   209	    {
   210	        let mut writer = StreamWriter::try_new(&mut buf, &schema)?;
   211	        writer.write(&batch)?;
   212	        writer.finish()?;
   213	    }
   214	    Ok(buf)
   215	}
   216	
   217	/// Validate that `schema` is EXACTLY the expected 5-field grid schema (each field's
   218	/// name, type, and nullability, in order). Worker-controlled bytes are not trusted
   219	/// to honor the column order/identity; a mismatch (reordered, renamed, retyped,
   220	/// wrong count) is rejected loudly so positional column access below is sound and
   221	/// the two `Utf8` columns (`str`/`err`) can never be silently swapped.
   222	fn validate_grid_schema(schema: &Schema) -> Result<(), CodecError> {
   223	    let fields = schema.fields();
   224	    if fields.len() != EXPECTED_FIELDS.len() {
   225	        return Err(CodecError::BadSchema(format!(
   226	            "expected {} columns, got {}",
   227	            EXPECTED_FIELDS.len(),
   228	            fields.len()
   229	        )));
   230	    }
   231	    for (idx, (name, dt, nullable)) in EXPECTED_FIELDS.iter().enumerate() {
   232	        let f = &fields[idx];
   233	        if f.name() != *name {
   234	            return Err(CodecError::BadSchema(format!(
   235	                "column {idx}: expected name {name:?}, got {:?}",
   236	                f.name()
   237	            )));
   238	        }
   239	        if f.data_type() != dt {
   240	            return Err(CodecError::BadSchema(format!(
   241	                "column {idx} ({name:?}): expected type {dt:?}, got {:?}",
   242	                f.data_type()
   243	            )));
   244	        }
   245	        if f.is_nullable() != *nullable {
   246	            return Err(CodecError::BadSchema(format!(
   247	                "column {idx} ({name:?}): expected nullable={nullable}, got {}",
   248	                f.is_nullable()
   249	            )));
   250	        }
   251	    }
   252	    Ok(())
   253	}
   254	
   255	fn shape_from_metadata(md: &HashMap<String, String>, key: &'static str) -> Result<u32, CodecError> {
   256	    let raw = md.get(key).ok_or(CodecError::MissingShape(key))?;
   257	    raw.parse::<u32>().map_err(|_| CodecError::BadShape {
   258	        key,
   259	        value: raw.clone(),
   260	    })
   261	}
   262	
   263	fn col<'a, T: Array + 'static>(
   264	    batch: &'a RecordBatch,
   265	    idx: usize,
   266	    name: &'static str,
   267	) -> Result<&'a T, CodecError> {
   268	    // `idx` is in-bounds: `validate_grid_schema` has already asserted exactly 5
   269	    // columns, so `batch.column(idx)` for idx in 0..5 cannot panic.
   270	    batch
   271	        .column(idx)
   272	        .as_any()
   273	        .downcast_ref::<T>()
   274	        .ok_or(CodecError::BadColumn(name))
   275	}
   276	
   277	/// Decode Arrow IPC stream bytes (a `CALL`/`RETURN` frame payload) back to a grid.
   278	///
   279	/// Every failure mode for worker-controlled bytes is a loud [`CodecError`] — no
   280	/// reachable panic, no silent coercion (No-Fallbacks; design §5).
   281	pub fn decode_grid(bytes: &[u8]) -> Result<ArrayValue, CodecError> {
   282	    let mut reader = StreamReader::try_new(std::io::Cursor::new(bytes), None)?;
   283	    let batch = reader.next().ok_or(CodecError::Empty)??;
   284	
   285	    // Exactly one batch: a worker writing extra batches into one frame is malformed.
   286	    if reader.next().is_some() {
   287	        return Err(CodecError::TrailingBatch);
   288	    }
   289	
   290	    let schema = batch.schema();
   291	    // Validate the schema BEFORE any positional column access (so `col()` indexing
   292	    // is sound) and BEFORE trusting column identity (the `Utf8` `str`/`err` columns
   293	    // are otherwise indistinguishable by type).
   294	    validate_grid_schema(&schema)?;
   295	
   296	    let rows = shape_from_metadata(schema.metadata(), "rows")?;
   297	    let cols = shape_from_metadata(schema.metadata(), "cols")?;
   298	
   299	    let kind = col::<StringArray>(&batch, COL_KIND, "kind")?;
   300	    let num = col::<Float64Array>(&batch, COL_NUM, "num")?;
   301	    let text = col::<StringArray>(&batch, COL_STR, "str")?;
   302	    let boolean = col::<BooleanArray>(&batch, COL_BOOL, "bool")?;
   303	    let err = col::<StringArray>(&batch, COL_ERR, "err")?;
   304	
   305	    let n = batch.num_rows();
   306	    // `checked_mul` (matching `ArrayValue::new`) — a hostile shape that overflows is
   307	    // a loud error, not a silent saturation that happens to disagree with `n`.
   308	    let expected = (rows as usize)
   309	        .checked_mul(cols as usize)
   310	        .ok_or(CodecError::ShapeOverflow { rows, cols })?;
   311	    if n != expected {
   312	        return Err(CodecError::ShapeMismatch(format!(
   313	            "{n} cells but rows*cols = {expected} (rows={rows}, cols={cols})"
   314	        )));
   315	    }
   316	
   317	    let mut cells = Vec::with_capacity(n);
   318	    for i in 0..n {
   319	        // `kind` is non-nullable per the validated schema; an empty/garbage tag
   320	        // falls through to `BadKind` below rather than panicking.
   321	        let v = match kind.value(i) {
   322	            "blank" => Value::Blank,
   323	            "number" => {
   324	                if num.is_null(i) {
   325	                    return Err(CodecError::NullPayload {
   326	                        row: i,
   327	                        kind: "number".to_string(),
   328	                    });
   329	                }
   330	                let x = num.value(i);
   331	                // The engine's `Value::Number` invariant is "always finite"; a
   332	                // `NaN`/`Inf` from the worker is a malformed result (it would
   333	                // otherwise poison equality/dirty-tracking downstream).
   334	                if !x.is_finite() {
   335	                    return Err(CodecError::NonFinite { row: i, value: x });
   336	                }
   337	                Value::Number(x)
   338	            }
   339	            "bool" => {
   340	                if boolean.is_null(i) {
   341	                    return Err(CodecError::NullPayload {
   342	                        row: i,
   343	                        kind: "bool".to_string(),
   344	                    });
   345	                }
   346	                Value::Boolean(boolean.value(i))
   347	            }
   348	            "text" => {
   349	                if text.is_null(i) {
   350	                    return Err(CodecError::NullPayload {
   351	                        row: i,
   352	                        kind: "text".to_string(),
   353	                    });
   354	                }
   355	                Value::Text(Arc::from(text.value(i)))
   356	            }
   357	            "error" => {
   358	                if err.is_null(i) {
   359	                    return Err(CodecError::NullPayload {
   360	                        row: i,
   361	                        kind: "error".to_string(),
   362	                    });
   363	                }
   364	                let sigil = err.value(i);
   365	                let ev = ErrorValue::from_str(sigil)
   366	                    .map_err(|_| CodecError::BadErrorSigil(sigil.to_string()))?;
   367	                Value::Error(ev)
   368	            }
   369	            other => return Err(CodecError::BadKind(other.to_string())),
   370	        };
   371	        cells.push(v);
   372	    }
   373	
   374	    ArrayValue::new(rows, cols, cells)
   375	        .map_err(|e| CodecError::ShapeMismatch(format!("ArrayValue::new: {e:?}")))
   376	}
   377	
   378	/// Convenience: encode a single scalar as a 1×1 grid (a UDF returning a scalar).
   379	pub fn encode_scalar(value: Value) -> Result<Vec<u8>, CodecError> {
   380	    encode_grid(&ArrayValue::singleton(value))
   381	}
