    27	
    28	import struct
    29	
    30	import pyarrow as pa
    31	
    32	
    33	class Err:
    34	    """A spreadsheet error value, identified by its sigil (e.g. ``"#DIV/0!"``)."""
    35	
    36	    __slots__ = ("sigil",)
    37	
    38	    def __init__(self, sigil):
    39	        self.sigil = sigil
    40	
    41	    def __repr__(self):
    42	        return "Err(%r)" % (self.sigil,)
    43	
    44	    def __eq__(self, other):
    45	        return isinstance(other, Err) and other.sigil == self.sigil
    46	
    47	    def __hash__(self):
    48	        return hash(self.sigil)
    49	
    50	
    51	class Grid:
    52	    """A 2-D grid of cells in row-major order. A cell is one of: ``None`` (blank),
    53	    ``float``/``int`` (number), ``bool`` (boolean), ``str`` (text), ``Err`` (error)."""
    54	
    55	    __slots__ = ("rows", "cols", "cells")
    56	
    57	    def __init__(self, rows, cols, cells):
    58	        if len(cells) != rows * cols:
    59	            raise ValueError("Grid: %d cells != rows*cols = %d*%d" % (len(cells), rows, cols))
    60	        self.rows = rows
    61	        self.cols = cols
    62	        self.cells = cells
    63	
    64	    def get(self, r, c):
    65	        return self.cells[r * self.cols + c]
    66	
    67	    @staticmethod
    68	    def scalar(value):
    69	        return Grid(1, 1, [value])
    70	
    71	    def __eq__(self, other):
    72	        return (
    73	            isinstance(other, Grid)
    74	            and other.rows == self.rows
    75	            and other.cols == self.cols
    76	            and other.cells == self.cells
    77	        )
    78	
    79	    def __repr__(self):
    80	        return "Grid(%d, %d, %r)" % (self.rows, self.cols, self.cells)
    81	
    82	
    83	def as_grid(value):
    84	    """Coerce a UDF return value into a `Grid`: a `Grid` passes through; any scalar
    85	    cell value becomes a 1x1 grid."""
    86	    if isinstance(value, Grid):
    87	        return value
    88	    return Grid.scalar(value)
    89	
    90	
    91	_GRID_SCHEMA_FIELDS = [
    92	    pa.field("kind", pa.utf8(), nullable=False),
    93	    pa.field("num", pa.float64(), nullable=True),
    94	    pa.field("str", pa.utf8(), nullable=True),
    95	    pa.field("bool", pa.bool_(), nullable=True),
    96	    pa.field("err", pa.utf8(), nullable=True),
    97	]
    98	
    99	
   100	def encode_grid(grid):
   101	    """Encode a `Grid` to Arrow IPC stream bytes (matching `ql-udf::codec::encode_grid`)."""
   102	    kinds, nums, strs, bools, errs = [], [], [], [], []
   103	    for cell in grid.cells:
   104	        if cell is None:
   105	            kinds.append("blank"); nums.append(None); strs.append(None); bools.append(None); errs.append(None)
   106	        elif isinstance(cell, bool):
   107	            # NB: bool is a subclass of int — check it BEFORE the numeric branch.
   108	            kinds.append("bool"); nums.append(None); strs.append(None); bools.append(cell); errs.append(None)
   109	        elif isinstance(cell, (int, float)):
   110	            kinds.append("number"); nums.append(float(cell)); strs.append(None); bools.append(None); errs.append(None)
   111	        elif isinstance(cell, str):
   112	            kinds.append("text"); nums.append(None); strs.append(cell); bools.append(None); errs.append(None)
   113	        elif isinstance(cell, Err):
   114	            kinds.append("error"); nums.append(None); strs.append(None); bools.append(None); errs.append(cell.sigil)
   115	        else:
   116	            raise TypeError("Grid cell of unsupported type %r: %r" % (type(cell).__name__, cell))
   117	
   118	    schema = pa.schema(
   119	        _GRID_SCHEMA_FIELDS,
   120	        metadata={"rows": str(grid.rows), "cols": str(grid.cols)},
   121	    )
   122	    batch = pa.RecordBatch.from_arrays(
   123	        [
   124	            pa.array(kinds, pa.utf8()),
   125	            pa.array(nums, pa.float64()),
   126	            pa.array(strs, pa.utf8()),
   127	            pa.array(bools, pa.bool_()),
   128	            pa.array(errs, pa.utf8()),
   129	        ],
   130	        schema=schema,
   131	    )
   132	    sink = pa.BufferOutputStream()
   133	    with pa.ipc.new_stream(sink, schema) as writer:
   134	        writer.write_batch(batch)
   135	    return sink.getvalue().to_pybytes()
   136	
   137	
   138	def _md_get(metadata, key):
   139	    """Read a schema-metadata value; pyarrow returns keys/values as bytes."""
   140	    if metadata is None:
   141	        raise ValueError("grid schema has no metadata (missing rows/cols)")
   142	    kb = key.encode("utf-8")
   143	    if kb in metadata:
   144	        return metadata[kb].decode("utf-8")
   145	    if key in metadata:  # tolerate str-keyed metadata
   146	        return metadata[key]
   147	    raise ValueError("grid schema metadata missing %r" % key)
   148	
   149	
   150	def decode_grid(data):
   151	    """Decode Arrow IPC stream bytes (from the Rust engine) back to a `Grid`."""
   152	    reader = pa.ipc.open_stream(pa.BufferReader(data))
   153	    batches = list(reader)
   154	    if not batches:
   155	        raise ValueError("empty IPC stream (expected exactly one record batch)")
   156	    if len(batches) != 1:
   157	        raise ValueError("trailing data after the first record batch")
   158	    batch = batches[0]
   159	    schema = batch.schema
   160	    rows = int(_md_get(schema.metadata, "rows"))
   161	    cols = int(_md_get(schema.metadata, "cols"))
   162	
   163	    kind = batch.column(0)
   164	    num = batch.column(1)
   165	    strc = batch.column(2)
   166	    boolc = batch.column(3)
   167	    errc = batch.column(4)
   168	
   169	    cells = []
   170	    for i in range(batch.num_rows):
   171	        k = kind[i].as_py()
   172	        if k == "blank":
   173	            cells.append(None)
   174	        elif k == "number":
   175	            cells.append(num[i].as_py())
   176	        elif k == "bool":
   177	            cells.append(boolc[i].as_py())
   178	        elif k == "text":
   179	            cells.append(strc[i].as_py())
   180	        elif k == "error":
   181	            cells.append(Err(errc[i].as_py()))
   182	        else:
   183	            raise ValueError("unknown cell kind %r" % (k,))
   184	    return Grid(rows, cols, cells)
   185	
   186	
   187	# ---- CALL / RETURN payloads ----------------------------------------------
   188	
   189	def decode_call(payload):
   190	    """Decode a CALL payload → ``(handle, call_id, args_grid)``."""
   191	    if len(payload) < 16:
   192	        raise ValueError("CALL payload header truncated (need 16 bytes, got %d)" % len(payload))
   193	    handle = struct.unpack("<Q", payload[0:8])[0]
   194	    call_id = struct.unpack("<Q", payload[8:16])[0]
   195	    args = decode_grid(payload[16:])
   196	    return (handle, call_id, args)
   197	
   198	
   199	def encode_return(call_id, result_grid):
   200	    """Encode a RETURN payload: ``[u64 call_id][grid]``."""
   201	    return struct.pack("<Q", call_id) + encode_grid(result_grid)
   202	
   203	
   204	def encode_raise(call_id, exc_type, message):
   205	    """Encode a RAISE payload: ``[u64 call_id][u32 exc_type_len][exc_type][message]``."""
   206	    et = exc_type.encode("utf-8")
   207	    return (
   208	        struct.pack("<Q", call_id)
   209	        + struct.pack("<I", len(et))
   210	        + et
   211	        + message.encode("utf-8")
   212	    )
   213	
   214	
   215	# ---- control payloads -----------------------------------------------------
   216	
   217	def decode_hello(payload):
   218	    """Decode a HELLO payload → the engine's protocol version."""
   219	    if len(payload) < 4:
   220	        raise ValueError("HELLO payload truncated")
   221	    return struct.unpack("<I", payload[0:4])[0]
   222	
   223	
   224	def encode_hello_ack(protocol_version, worker_pid):
   225	    """Encode a HELLO_ACK payload: ``[u32 protocol_version][u32 worker_pid]``."""
   226	    return struct.pack("<I", protocol_version) + struct.pack("<I", worker_pid)

