  1096	    /// Import a workbook from in-memory bytes. v1 supports `"xlsx"` (inc.2c-10)
  1097	    /// and `"csv"` (inc.2c-11); any other format is a loud `BadArgument`.
  1098	    ///
  1099	    /// **csv:** parse via `ql_io_csv::import_csv_bytes` (no recompute — CSV has
  1100	    /// no formulas) → Option-1 adoption (same model as xlsx below, minus the
  1101	    /// recomputer).
  1102	    ///
  1103	    /// **xlsx (Option 1, same adoption model as [`open`]):** parse the bytes via
  1104	    /// `ql_io_xlsx::import_xlsx_bytes` — which recomputes BestEffort through the
  1105	    /// injected [`EngineXlsxRecomputer`] (dependency inversion: `ql-io-xlsx` is
  1106	    /// pure I/O) — then adopt the resulting workbook with a FRESH op-log + undo
  1107	    /// history (`*self = from_workbook`, registry preserved, epoch re-minted).
  1108	    /// Because the importer already recomputed, this does NOT recompute again
  1109	    /// (unlike `open`, which loads a possibly-stale `.qbook`). The import
  1110	    /// report's fidelity caveats (unsupported features, soft warnings, formulas
  1111	    /// the engine couldn't recompute) are surfaced as `Warning` diagnostics —
  1112	    /// never silently dropped (No-Fallbacks).
  1113	    ///
  1114	    /// **Panic safety (§8).** Unlike [`open`] — whose recompute mutates
  1115	    /// `self.workbook` IN PLACE under a `with_runtime` `FaultGuard` — `import`'s
  1116	    /// recompute runs inside `import_xlsx_bytes` on a LOCAL workbook (`self` only
  1117	    /// lends `&self.registry`), and `self` is replaced by the SINGLE atomic
  1118	    /// `*self = from_workbook(..)` only AFTER a successful parse+recompute. No
  1119	    /// step leaves `self` half-mutated: a panic in parse / recompute / adopt
  1120	    /// leaves `self` in its prior valid (`Ready`) state and the session stays
  1121	    /// usable. A `FaultGuard` here would be wrong — it would fault a healthy
  1122	    /// session. (Under `panic = "unwind"`, the boundary `catch_unwind` of §8.2
  1123	    /// still maps the panic to `EngineError::panic`.)
  1124	    ///
  1125	    /// [`open`]: WorkbookSession::open
  1126	    /// [`EngineXlsxRecomputer`]: crate::EngineXlsxRecomputer
  1127	    fn import(&mut self, bytes: &[u8], format: &str) -> EngineResult<()> {
  1128	        self.ensure_openable()?;
  1129	        match format {
  1130	            "xlsx" => {
  1131	                let result = ql_io_xlsx::import_xlsx_bytes(
  1132	                    bytes,
  1133	                    &self.registry,
  1134	                    ql_io_xlsx::XlsxImportOptions::default(),
  1135	                    Some(&crate::EngineXlsxRecomputer),
  1136	                )
  1137	                .map_err(map_xlsx_err)?;
