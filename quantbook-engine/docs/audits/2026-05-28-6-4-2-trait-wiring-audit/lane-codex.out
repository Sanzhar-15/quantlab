  3000	        // either, so the original Volatility::Pure entry survives.
  3001	        assert_eq!(
  3002	            r.metadata("MYUDF").unwrap().volatility,
  3003	            Volatility::Pure,
  3004	            "register_udf Conflict MUST NOT overwrite the existing metadata"
  3005	        );
  3006	    }
  3007	}

