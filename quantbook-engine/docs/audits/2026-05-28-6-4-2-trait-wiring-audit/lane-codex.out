   151	
   152	/// RAII guard that transitions the session to [`LifecycleState::Faulted`] if
   153	/// dropped while still armed (i.e., the wrapped block panicked). Lifted to
   154	/// module scope from the two inline copies in [`WorkbookSession::with_runtime`]
   155	/// and [`WorkbookSession::with_runtime_no_oplog`] so the **6.1C audit-fix M3**
   156	/// non-runtime mutator paths (`delete_sheet`, `restore_sheet`, `move_sheet`,
   157	/// `mark_volatiles_dirty`, and `batch`'s Phase 2 op-log append) can reuse it
   158	/// without duplicating the pattern. Disarmed on the normal return path; the
   159	/// drop is a no-op when `armed == false`.
   160	struct FaultGuard<'g> {
   161	    state: &'g mut LifecycleState,
   162	    armed: bool,
   163	}
   164	
   165	impl Drop for FaultGuard<'_> {
   166	    fn drop(&mut self) {
   167	        if self.armed {
   168	            *self.state = LifecycleState::Faulted;
   169	        }
   170	    }
   171	}
   172	
   173	/// The owning, single-writer engine session (contract §2.1).
   174	///
   175	/// Bindings wrap this behind an opaque handle (Node: `#[napi]` over
