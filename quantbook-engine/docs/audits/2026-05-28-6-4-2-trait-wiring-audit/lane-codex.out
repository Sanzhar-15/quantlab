  1031	    /// Open a `.qbook` directory (inc.2c-9). **Option 1 (locked 2026-05-27):**
  1032	    /// reconstruct the workbook from the `.qbook` and adopt it with a FRESH
  1033	    /// op-log + undo history (`baseline = loaded workbook`), so the undo
  1034	    /// invariant `baseline + replay(oplog) == workbook` holds trivially (the
  1035	    /// loaded workbook IS the baseline; replay of the empty log is identity) —
  1036	    /// matching `from_workbook` and avoiding Option 2's data-loss bug class
  1037	    /// (a loaded `oplog` whose replay diverges from the loaded envelope). The
  1038	    /// loaded file's op-log history is therefore NOT carried forward: a later
  1039	    /// `save` writes only THIS session's edits, and undo cannot cross the open
  1040	    /// point (the intended semantic). The on-disk `oplog.bin` is still loaded
  1041	    /// and validated (via the oplog-aware loader) so a corrupt sidecar fails
  1042	    /// loud here rather than being silently ignored — it is then discarded.
  1043	    fn open(&mut self, path: &str) -> EngineResult<()> {
  1044	        self.ensure_openable()?;
  1045	        // Load + validate BOTH the workbook envelope and the op-log sidecar; the
  1046	        // op-log is discarded (Option 1). A missing sidecar or a bad envelope
  1047	        // surfaces loud as a `Persistence` error (No-Fallbacks).
  1048	        let (wb, discarded_oplog) =
  1049	            ql_io::load_workbook_with_oplog(Path::new(path)).map_err(map_persistence_err)?;
  1050	        // `load_workbook_with_oplog` validates only the Loro snapshot FRAMING;
  1051	        // per-op JSON is deserialized lazily by `OpLog::iter()` (`log.rs:107`).
  1052	        // A frame-valid but payload-corrupt sidecar (e.g. a pre-Tier-D3 op shape
  1053	        // — see `ql-oplog/tests/d1_step8_legacy_op_shape.rs`) would otherwise be
  1054	        // silently accepted here and then masked by the next `save`'s overwrite.
  1055	        // Even though Option 1 discards this op-log, validate its payloads now so
  1056	        // a corrupt sidecar fails LOUD on open (the No-Fallbacks contract this
  1057	        // increment promises). Done BEFORE `*self = ...` → atomic: a failure
  1058	        // leaves the session untouched and still usable.
  1059	        for op in discarded_oplog.iter() {
  1060	            op.map_err(|e| map_persistence_err(ql_io::PersistenceError::OpLog(e)))?;
  1061	        }
  1062	        // Adopt as a fresh session over the loaded workbook. `from_workbook`
  1063	        // rebuilds the calcgraph, mints a new epoch (so any pre-open delta token
  1064	        // → EpochMismatch full rebuild), resets `state_seq`/`change_log`/`ops`/
  1065	        // `events`/`txns` (a fresh document), and — crucially — builds a FRESH
  1066	        // `OpLog` + `UndoManager` re-subscribed to it AND sets `baseline = wb`.
  1067	        // The function registry is session-scoped tooling (not document state),
  1068	        // so it is preserved across the open (v1: always the default registry).
  1069	        let registry = Arc::clone(&self.registry);
  1070	        *self = Self::from_workbook(wb);
  1071	        self.registry = registry;
  1072	        // Recompute on open — mirrors the canonical IDE path
  1073	        // (`loader.rs::load_workbook_and_recompute`): the saved computed values
  1074	        // may be stale relative to their inputs. Run with the op-log DETACHED so
  1075	        // the recompute appends no ops and feeds the (fresh) undo manager no
  1076	        // spurious commit. Structural failures surface as `CellDiagnostic`
  1077	        // events (never swallowed — the `run_recalc`/`rematerialize` pattern).
  1078	        let result = self.with_runtime_no_oplog(|rt| rt.recompute_all());
  1079	        for failure in &result.failures {
  1080	            self.events.push(Event::CellDiagnostic {
  1081	                diagnostic: Diagnostic {
  1082	                    addr: Some(CellAddr {
  1083	                        sheet: failure.sheet,
  1084	                        row: failure.row,
  1085	                        col: failure.col,
  1086	                    }),
  1087	                    severity: Severity::Error,
  1088	                    code: "formula_recompute_failed".to_string(),
  1089	                    message: failure.error.to_string(),
  1090	                },
  1091	            });
  1092	        }
  1093	        Ok(())
  1094	    }
