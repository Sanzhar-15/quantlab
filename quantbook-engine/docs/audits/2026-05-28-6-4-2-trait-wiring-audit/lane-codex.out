  1509	    fn dirty_formulas_referencing_function(&mut self, canonical_name: &str) -> usize {
  1510	        let upper = canonical_name.to_ascii_uppercase();
  1511	        let dependents: Vec<NodeId> = self
  1512	            .functions_used
  1513	            .get(upper.as_str())
  1514	            .map(|s| s.iter().copied().collect())
  1515	            .unwrap_or_default();
  1516	        let count = dependents.len();
  1517	        for n in dependents {
  1518	            self.dirty.insert(n);
  1519	            // Same transitive fanout as `on_set_name` (Phase 3.10 H2):
  1520	            // whatever depends on this function-referencing formula
  1521	            // must also recompute when the function's binding changes.
  1522	            if let Some((s, r, c)) = self.cell_address_for(n) {
  1523	                self.mark_dirty_from_cell_write(s, r, c);
  1524	            }
  1525	        }

