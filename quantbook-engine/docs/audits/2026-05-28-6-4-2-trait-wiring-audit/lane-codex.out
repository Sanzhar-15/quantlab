  4589	    /// Add a sheet; returns its assigned `SheetId` (u16 widened to u32).
  4590	    /// `chunkRows` is the per-sheet row partition size (must be ≥ 1; the engine
  4591	    /// rejects 0 to prevent a `ColumnStore` panic).
  4592	    #[napi(js_name = "addSheet")]
  4593	    pub fn add_sheet(&self, name: String, chunk_rows: f64) -> Result<u32> {
  4594	        let chunk_rows = validate_u32_index("addSheet", "chunkRows", chunk_rows)?;
  4595	        if chunk_rows == 0 {
  4596	            return Err(bad_argument_error(
  4597	                "addSheet: chunkRows must be >= 1 (engine rejects chunk_rows == 0)".into(),
  4598	            ));
  4599	        }
  4600	        let id = self
  4601	            .inner
  4602	            .lock()
  4603	            .add_sheet(&name, chunk_rows)
  4604	            .map_err(engine_error_to_napi)?;
  4605	        Ok(u32::from(id))
