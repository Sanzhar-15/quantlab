  4700	    /// Deterministically release the underlying [`ql_exec::WorkbookSession`]
  4701	    /// state — transitions the session to `Closed` (terminal). Subsequent
  4702	    /// command calls return a structured `[invalid_state]` engine error rather
  4703	    /// than panic. Any open transaction buffers are dropped (their handles
  4704	    /// become `[transaction_not_found]` if reused, never silent no-ops).
  4705	    ///
  4706	    /// **6.1C audit-fix M8 — closes the lifecycle hole.** Without this,
  4707	    /// JS-side the only way to free the workbook + op-log + plan cache + Loro
  4708	    /// substrate was to GC the JS handle — non-deterministic, can hold large
  4709	    /// workbooks in memory long after the IDE panel closes. Calling `close()`
  4710	    /// frees the engine state synchronously (engine `WorkbookSession::close`
  4711	    /// at `crates/ql-exec/src/session.rs`).
  4712	    #[napi(js_name = "close")]
  4713	    pub fn close(&self) -> Result<()> {
  4714	        self.inner.lock().close().map_err(engine_error_to_napi)
  4715	    }
  4716	
  4717	    // ============================================================================
  4718	    // 6.4-2 (2026-05-28) — function registration over napi.
  4719	    //
  4720	    // Wires the substrate shipped at 6.4-0 (function-metadata storage + hooks)
  4721	    // and 6.4-1 (binder ArgContext migration + PlanCache fn_gen invalidation +
  4722	    // M3 sorted_metadata + M5 mapper + I1 LazyShape) to the JS surface.
  4723	    // ============================================================================
  4724	
  4725	    /// **6.4-2:** Register a UDF — `metadata` is a `FunctionMetadataJson`
  4726	    /// describing the function's contract-§10.2 properties; `implHandle` is the
  4727	    /// opaque dispatch-pointer the worker dispatcher will consult at eval time
  4728	    /// (6.4-3). v1 stores the handle but does NOT yet dispatch to a Python
  4729	    /// worker — that lands at 6.4-3 (Arrow IPC + debugpy).
  4730	    ///
  4731	    /// **Behavior:**
  4732	    /// - Validates every enum string field at the napi boundary; unknown
  4733	    ///   strings surface a structured `[bad_argument]` engine error
  4734	    ///   (No-Fallbacks; never silent default).
  4735	    /// - Dirties + transitive-fans every formula that referenced the
  4736	    ///   (previously-unknown) `canonicalName` via the calcgraph hook.
  4737	    /// - Bumps the registry's `fn_gen` so the bind cache invalidates for
  4738	    ///   formulas needing re-extraction against the new metadata
  4739	    ///   (contract §10.3 "re-extract deps" half — option A from the 6.4-0
  4740	    ///   audit, shipped at 6.4-1 H3).
  4741	    /// - Lifecycle gate: rejects on Closed/Busy/New/Faulted with
  4742	    ///   `[invalid_state]` or `[session_busy]`.
  4743	    ///
  4744	    /// **Errors (Appendix A):**
  4745	    /// - `[function_exists]` — canonical name already registered (built-in
  4746	    ///   or existing UDF). `EngineError{Conflict, "function_exists"}`.
  4747	    /// - `[bad_argument]` — invalid enum string OR non-canonical (lower-case)
  4748	    ///   canonical_name. (The registry's canonicalization assert turns into
  4749	    ///   a panic, which the napi boundary wraps; callers should always pass
  4750	    ///   ASCII-uppercase canonical names — the IDE side is expected to
  4751	    ///   uppercase before the call.)
  4752	    /// - `[invalid_state]` — session is not Ready.
  4753	    #[napi(js_name = "registerFunction")]
  4754	    pub fn register_function(
  4755	        &self,
  4756	        metadata: FunctionMetadataJson,
  4757	        impl_handle: BigInt,
  4758	    ) -> Result<()> {
  4759	        let meta = function_metadata_from_json(metadata)?;
  4760	        // BigInt → u64: the napi-rs `BigInt::get_u64()` returns `(sign_bit,
  4761	        // value, lossless)`. Reject negative (sign bit set) + lossy (anything
  4762	        // above u64::MAX) loud per No-Fallbacks. Matches the `peerId` validation
  4763	        // discipline at `CollabSession::new`.
  4764	        let (sign_bit, raw, lossless) = impl_handle.get_u64();
  4765	        if sign_bit {
  4766	            return Err(bad_argument_error(
  4767	                "registerFunction: implHandle must be a non-negative BigInt".into(),
  4768	            ));
  4769	        }
  4770	        if !lossless {
  4771	            return Err(bad_argument_error(
  4772	                "registerFunction: implHandle exceeds u64::MAX (lossy conversion rejected)".into(),
  4773	            ));
  4774	        }
  4775	        let handle = FunctionImplHandle(raw);
  4776	        self.inner
  4777	            .lock()
  4778	            .register_function(meta, handle)
  4779	            .map_err(engine_error_to_napi)
  4780	    }
  4781	
  4782	    /// **6.4-2:** Unregister a UDF. Symmetric to [`Self::register_function`].
  4783	    /// Removes BOTH the metadata and the dispatch handle atomically (via the
  4784	    /// registry's `unregister_metadata` extension that clears
  4785	    /// `udf_handles[name]` on success). Dirties + transitive-fans every
  4786	    /// dependent formula via the calcgraph hook; the next eval will surface
  4787	    /// `#NAME?` because dispatch is now missing.
  4788	    ///
  4789	    /// **Errors (Appendix A):**
  4790	    /// - `[function_not_found]` — no UDF registered under `canonicalName`.
  4791	    /// - `[function_exists]` — `canonicalName` is a built-in (dispatch entry
  4792	    ///   still present; the registry's builtin-guard refuses removal). The
  4793	    ///   `Conflict / function_exists` class is the same as duplicate-register;
  4794	    ///   the message disambiguates (`"is a registered built-in"`).
  4795	    /// - `[invalid_state]` — session is not Ready.
  4796	    #[napi(js_name = "unregisterFunction")]
  4797	    pub fn unregister_function(&self, canonical_name: String) -> Result<()> {
  4798	        self.inner
  4799	            .lock()
  4800	            .unregister_function(&canonical_name)
  4801	            .map_err(engine_error_to_napi)
  4802	    }
  4803	
  4804	    /// **6.4-2:** List every registered function (built-ins + UDFs) with full
  4805	    /// metadata. Returned sorted ascending by `canonical_name` (per the 6.4-1
  4806	    /// M3 `sorted_metadata` discipline + the 6.1C H2 deterministic-ordering
  4807	    /// rule for snapshot DTOs).
  4808	    ///
  4809	    /// Allocates the full metadata table (~260 entries at v1; cheap for an
  4810	    /// IDE poll). Use sparingly — this is not a per-keystroke surface.
  4811	    ///
  4812	    /// **Errors:** `[invalid_state]` if the session is Closed/New/Faulted
  4813	    /// (Busy is OK — this is a read).
  4814	    #[napi(js_name = "listFunctions")]
  4815	    pub fn list_functions(&self) -> Result<Vec<FunctionMetadataJson>> {
  4816	        let metas = self
  4817	            .inner
  4818	            .lock()
  4819	            .list_functions()
  4820	            .map_err(engine_error_to_napi)?;
  4821	        Ok(metas.into_iter().map(function_metadata_to_json).collect())
  4822	    }
  4823	}
  4824	
  4825	// **Phase 6.1B inc.2d (2026-05-27) — Send + Sync positive proof (audit Rule 4).**
  4826	//
  4827	// `Session { inner: Arc<Mutex<CoreWorkbookSession>> }` mirrors `CollabSession`:
  4828	//   - `CoreWorkbookSession` (`ql_exec::WorkbookSession`) is asserted `Send`

