  2422	
  2423	    /// **6.4-2 (2026-05-28):** combined UDF metadata + dispatch-handle
  2424	    /// registration. Calls [`ql_functions::FunctionRegistry::register_udf`]
  2425	    /// (which calls `register_metadata` then inserts the handle on success,
  2426	    /// bumping `fn_gen` exactly once), then fires the
  2427	    /// [`CalcgraphSession::on_function_registered`] hook so every formula
  2428	    /// referencing the (previously-unknown) name dirties + transitive-fans.
  2429	    ///
  2430	    /// The `fn_gen` bump invalidates [`PlanCacheKey`] entries that were
  2431	    /// minted before this call, so the next eval re-binds + re-extracts
  2432	    /// deps against the new metadata — closes contract §10.3's
  2433	    /// "re-extract deps" half. The dirty fanout closes the "dirties every
  2434	    /// formula referencing that canonical name (reschedule)" half.
  2435	    ///
  2436	    /// **Errors (Appendix A):**
  2437	    /// - `Conflict / function_exists` — canonical name already registered
  2438	    ///   (built-in or existing UDF). Via [`map_function_registry_err`].
  2439	    /// - `Capability / session_busy` / `Capability / invalid_state` —
  2440	    ///   gated by [`Self::ensure_ready`]; mutator legal only in `Ready`.
  2441	    ///
  2442	    /// **No event emission v1:** function registration is session-scoped
  2443	    /// tooling (not document state — `open` / `import` deliberately
  2444	    /// preserve the registry across workbook adoption); contract §9
  2445	    /// doesn't list it as a `StructureChanged` source. Filed for 6.4-3 if
  2446	    /// observability demands it.
  2447	    ///
  2448	    /// **No version-token bump:** registry mutation does not advance the
  2449	    /// `{epoch, op_count}` token — the workbook + op-log are untouched.
  2450	    /// `snapshot()` after `register_function` returns the same token as
  2451	    /// before; consumers polling on the token won't see a change. This is
  2452	    /// deliberate (registry IS tooling, not document state).
  2453	    ///
  2454	    /// **FaultGuard discipline:** the registry mutation + graph hook are
  2455	    /// two separate state mutations on `self`. A panic between them would
  2456	    /// leave `fn_gen` bumped + metadata registered + handle inserted but
  2457	    /// no dirty fanout — a subtle inconsistency. Bracket the pair with a
  2458	    /// [`FaultGuard`] matching the 6.1C audit-fix M3 pattern at
  2459	    /// [`Self::delete_sheet`]. Disarms cleanly on the
  2460	    /// `register_udf`-returned-Err path so a legitimate `Conflict` does
  2461	    /// NOT seal the session.
  2462	    fn register_function(
  2463	        &mut self,
  2464	        metadata: FunctionMetadata,
  2465	        impl_handle: FunctionImplHandle,
  2466	    ) -> EngineResult<()> {
  2467	        self.ensure_ready()?;
  2468	        // Stash the canonical name BEFORE `register_udf` moves `metadata`
  2469	        // into the registry — needed for the dirty-fanout hook.
  2470	        let canonical_name = metadata.canonical_name.clone();
  2471	        // FaultGuard around registry + graph mutation (6.1C audit-fix M3 pattern).
  2472	        {
  2473	            let mut guard = FaultGuard {
  2474	                state: &mut self.state,
  2475	                armed: true,
  2476	            };
  2477	            match Arc::make_mut(&mut self.registry)
  2478	                .register_udf(metadata, impl_handle)
  2479	                .map_err(map_function_registry_err)
  2480	            {
  2481	                Ok(()) => {
  2482	                    // Substrate hook: dirty every dependent formula +
  2483	                    // transitive-fan. Returns the directly-dirtied count
  2484	                    // (downstream-of-downstream handled transitively by
  2485	                    // `mark_dirty_from_cell_write`).
  2486	                    let _dirty_count = self.graph.on_function_registered(&canonical_name);
  2487	                    guard.armed = false;
  2488	                }
  2489	                Err(e) => {
  2490	                    guard.armed = false;
  2491	                    return Err(e);
  2492	                }
  2493	            }
  2494	        }
  2495	        Ok(())
  2496	    }
  2497	
  2498	    /// **6.4-2 (2026-05-28):** symmetric counterpart to
  2499	    /// [`Self::register_function`]. Removes UDF metadata via
  2500	    /// [`ql_functions::FunctionRegistry::unregister_metadata`] (which
  2501	    /// clears the matching `udf_handles` entry symmetrically + bumps
  2502	    /// `fn_gen` on success), then fires
  2503	    /// [`CalcgraphSession::on_function_unregistered`] for the dirty
  2504	    /// fanout. After this call, formulas referencing the now-missing
  2505	    /// canonical name will surface `#NAME?` on the next eval (dispatch is
  2506	    /// gone from `RegisteredFn`; `scalar.rs:463` returns
  2507	    /// `Value::Error(ErrorValue::Name)` for missing-function calls).
  2508	    ///
  2509	    /// **Errors (Appendix A):**
  2510	    /// - `NotFound / function_not_found` — name has no metadata (never
  2511	    ///   registered, or already unregistered). Via [`map_function_registry_err`].
  2512	    /// - `Conflict / function_exists` — name is a built-in (dispatch entry
  2513	    ///   still present); the registry's builtin-guard prevents removing
  2514	    ///   built-in metadata. The mapper translates `Conflict` to
  2515	    ///   `function_exists` regardless of variant; the message distinguishes.
  2516	    /// - `Capability / session_busy` / `Capability / invalid_state` —
  2517	    ///   gated by [`Self::ensure_ready`].
  2518	    fn unregister_function(&mut self, canonical_name: &str) -> EngineResult<()> {
  2519	        self.ensure_ready()?;
  2520	        // FaultGuard around registry + graph mutation (6.1C audit-fix M3 pattern).
  2521	        {
  2522	            let mut guard = FaultGuard {
  2523	                state: &mut self.state,
  2524	                armed: true,
  2525	            };
  2526	            match Arc::make_mut(&mut self.registry)
  2527	                .unregister_metadata(canonical_name)
  2528	                .map_err(map_function_registry_err)
  2529	            {
  2530	                Ok(()) => {
  2531	                    let _dirty_count = self.graph.on_function_unregistered(canonical_name);
  2532	                    guard.armed = false;
  2533	                }
  2534	                Err(e) => {
  2535	                    guard.armed = false;
  2536	                    return Err(e);
  2537	                }
  2538	            }
  2539	        }
  2540	        Ok(())
  2541	    }
  2542	
  2543	    /// **6.4-2 (2026-05-28):** list every registered function (built-ins +
  2544	    /// UDFs) with full metadata. Reads via
  2545	    /// [`ql_functions::FunctionRegistry::sorted_metadata`] (M3 from 6.4-1)
  2546	    /// for deterministic ordering by `canonical_name` — matches the 6.1C
  2547	    /// H2 ordering discipline for snapshot DTOs (Vecs serialized over the
  2548	    /// wire MUST be call-stable; a 5-way megaudit caught the snapshot
  2549	    /// `formats` non-determinism at exactly this seam).
  2550	    ///
  2551	    /// Allocates `Vec<&FunctionMetadata>` of registry-len size at the
  2552	    /// registry layer, then clones each entry into the owned `Vec<FunctionMetadata>`
  2553	    /// the DTO returns. v1 sizes (~260 builtins + UDFs) keep this cheap.
  2554	    ///
  2555	    /// **Gate:** [`Self::ensure_readable`] (Ready/Busy OK; rejects
  2556	    /// New/Closed/Faulted). Matches `snapshot`/`cell`/`list_sheets`.
  2557	    fn list_functions(&self) -> EngineResult<Vec<FunctionMetadata>> {
  2558	        self.ensure_readable()?;
  2559	        Ok(self
  2560	            .registry
  2561	            .sorted_metadata()
  2562	            .into_iter()
  2563	            .cloned()
  2564	            .collect())
  2565	    }
