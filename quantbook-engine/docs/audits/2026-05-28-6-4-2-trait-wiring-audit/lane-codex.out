    93	
    94	/// How many arguments a function takes.
    95	#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
    96	#[serde(tag = "kind", rename_all = "snake_case")]
    97	pub enum Arity {
    98	    /// Exactly `n` arguments.
    99	    Fixed {
   100	        /// The arity.
   101	        n: u8,
   102	    },
   103	    /// Between `min` and (optional) `max` arguments.
   104	    Range {
   105	        /// Minimum.
   106	        min: u8,
   107	        /// Maximum (None = unbounded).
   108	        max: Option<u8>,
   109	    },
   110	    /// Any number of arguments.
   111	    Variadic,
   112	}
   113	
   114	/// Whether a function's result can change independently of its arguments.
   115	#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
   116	#[serde(rename_all = "snake_case")]
   117	pub enum Volatility {
   118	    /// Same args ⇒ same result; recomputes only on input change.
   119	    Pure,
   120	    /// Recomputes on every recalc / volatile pass (NOW, RAND, …).
   121	    Volatile,
   122	    /// Result depends on workbook structure, not just args (INDIRECT, OFFSET);
   123	    /// the conservative default for an unregistered/unknown function so it stays
   124	    /// graph-visible and never silently Pure (contract §10.3).
   125	    Dynamic,
   126	}
   127	
   128	/// How a function's arguments map to graph dependencies.
   129	#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
   130	#[serde(rename_all = "snake_case")]
   131	pub enum DepShape {
   132	    /// Normal value-deps (the default): referenced cells/ranges are deps.
   133	    ValueDeps,
   134	    /// Address-only (ROW / COLUMN / ROWS / COLUMNS): depends on address /
   135	    /// shape, not value. The walker recurses for Binary / Unary / Function
   136	    /// sub-trees because the eager materializer DOES evaluate those (so
   137	    /// `ROW(A1+1)` must keep A1's value-dep), but skips value-deps on
   138	    /// direct CellRef / RangeRef arguments.
   139	    AddressOnly,
   140	    /// **6.4-1 (2026-05-28; I1):** lazy syntactic-shape inspection (ISREF).
   141	    /// The function never evaluates its arg — it inspects the syntactic
   142	    /// shape via `materialize_ref_arg_lazy`. The walker MUST NOT recurse:
   143	    /// `ISREF(NOW())` must not mark the formula volatile; `ISREF(A1+1)`
   144	    /// must not register `A1` as a dep. Pre-6.4-1 this was a hardcoded
   145	    /// `name == "ISREF"` short-circuit at the walker's `Function` arm; the
   146	    /// I1 closure moves the decision to metadata so 6.4 UDFs declaring
   147	    /// `dep_shape: LazyShape` get the same treatment without engine-side
   148	    /// name special-casing.
   149	    LazyShape,
   150	    /// Caller supplies explicit deps at registration (`register_formula_function(
   151	    /// ..., deps=[...])`).
   152	    Custom,
   153	}
   154	
   155	/// Whether a function is called per-cell (scalar) or batch-shaped.
   156	#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
   157	#[serde(rename_all = "snake_case")]
   158	pub enum BatchShape {
   159	    /// One call per cell.
   160	    Scalar,
   161	    /// Arrow/array batch — UDFs use this from day one (contract §3.7 / decision-lock).
   162	    ArrayBatch,
   163	}
   164	
   165	/// Argument strictness/coercion policy.
   166	#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
   167	#[serde(rename_all = "snake_case")]
   168	pub enum ArgPolicy {
   169	    /// Reject type mismatches.
   170	    Strict,
   171	    /// Coerce per the engine's coercion rules.
   172	    Coercing,
   173	}
   174	
   175	/// **6.4-1 (2026-05-28; H1):** the binder's arg-admission category for this
   176	/// function. Mirrors the engine-internal `BindContext` enum at
   177	/// `ql-exec::plan` — kept as a separate DTO axis because:
   178	///
   179	/// 1. `BindContext` is internal to `ql-exec` and not part of the binding-
   180	///    neutral wire contract; the metadata DTO must own its own taxonomy.
   181	/// 2. The distinction is orthogonal to [`BatchShape`] (the eval-time call
   182	///    ABI). A scalar aggregate like `SUM` is `ArgContext::Aggregate`
   183	///    (binder admits range args) AND `BatchShape::Scalar` (eval calls
   184	///    `fn(&[Value]) -> Value` per cell after the named-range cache hit).
   185	///    Conflating the two would force Python UDFs that want range args to
   186	///    declare `BatchShape::ArrayBatch`, which has separate semantics
   187	///    around the Arrow IPC ABI.
   188	///
   189	/// Pre-6.4-1 this lived as two parallel `matches!` whitelists in
   190	/// `ql-exec::plan` (`is_aggregate_function`, `is_reference_aware_function`);
   191	/// 6.4-1 moves the decision to metadata so UDFs participating in the
   192	/// binder follow the same lookup path as builtins.
   193	///
   194	/// The default is [`ArgContext::Scalar`] — matches the binder's
   195	/// `else` arm before 6.4-1, and matches the conservative behavior for an
   196	/// unknown function (range args are rejected with
   197	/// `BindError::NamedRangeInScalarContext` rather than silently accepted).
   198	#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
   199	#[serde(rename_all = "snake_case")]
   200	pub enum ArgContext {
   201	    /// Rejects range args — `BindContext::Scalar`. The vast majority of
   202	    /// builtins (ABS, SQRT, IF, …) and the binder's `else` arm for
   203	    /// unknown names live here.
   204	    #[default]
   205	    Scalar,
   206	    /// Admits named-range / range-aware args — `BindContext::AggregateArg`.
   207	    /// Pre-6.4-1 list at `ql-exec::plan::is_aggregate_function`
   208	    /// (~100 names: scalar aggregates SUM/AVERAGE/COUNT/MIN/MAX/…,
   209	    /// range-aware lookups VLOOKUP/INDEX/MATCH/…, conditional aggregates
   210	    /// SUMIF/AVERAGEIFS/…, array-tier TRANSPOSE/FILTER, range-aware text
   211	    /// CONCAT/TEXTJOIN, financial NPV/IRR/XIRR, statistical CORREL/
   212	    /// COVARIANCE.P/SLOPE/…, order statistics PERCENTILE.*/QUARTILE.*,
   213	    /// SUBTOTAL).
   214	    Aggregate,
   215	    /// Admits literal references (CellRef / RangeRef / NameRef) —
   216	    /// `BindContext::ReferenceArg`. Pre-6.4-1 list at
   217	    /// `ql-exec::plan::is_reference_aware_function` (ROW / COLUMN / ROWS /
   218	    /// COLUMNS / ISREF / ISFORMULA / FORMULATEXT).
   219	    Reference,
   220	}
   221	
   222	/// How an in-flight call to this function is canceled (contract §6).
   223	#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
   224	#[serde(rename_all = "snake_case")]
   225	pub enum CancelPolicy {
   226	    /// Checked cooperatively at safe points.
   227	    Cooperative,
   228	    /// Hard cancel by killing the worker process (Python UDF / AI; contract §6.2).
   229	    WorkerKill,
   230	    /// Cannot be canceled once started.
   231	    NonCancelable,
   232	}
   233	
   234	/// First-class per-function metadata (contract §10.2). Built-ins register their
   235	/// true metadata; UDFs register theirs. The `canonical_name` is ASCII-uppercase,
   236	/// matching the parser's canonicalization (`ql-formula-syntax`); collision +
   237	/// invalidation rules are in contract §10.3.
   238	#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
   239	pub struct FunctionMetadata {
   240	    /// Canonical (ASCII-uppercase) name — the graph/lookup key.
   241	    pub canonical_name: String,
   242	    /// Optional display name.
