  2794	        };
  2795	        r.register_metadata(meta).unwrap();
  2796	        assert_eq!(r.fn_generation(), initial + 1, "register_metadata MUST bump fn_gen");
  2797	
  2798	        // Successful unregister bumps again.
  2799	        r.unregister_metadata("MYUDF1").unwrap();
  2800	        assert_eq!(r.fn_generation(), initial + 2, "unregister_metadata MUST bump fn_gen");
  2801	
  2802	        // Failed register (Conflict) MUST NOT bump.
