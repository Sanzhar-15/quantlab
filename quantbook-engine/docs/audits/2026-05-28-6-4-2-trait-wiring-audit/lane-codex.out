  2768	    /// **6.4-1 (2026-05-28; H3):** `fn_generation()` ticks monotonically
  2769	    /// on `register_metadata` / `unregister_metadata` success only. The
  2770	    /// `PlanCache` reads this value into `PlanCacheKey::fn_gen`; a tick
  2771	    /// invalidates every plan bound before the tick → next eval re-binds
  2772	    /// against current metadata. Closes the contract §10.3
  2773	    /// "re-extract deps" half.
  2774	    #[test]
  2775	    fn fn_gen_ticks_on_successful_register_and_unregister() {
  2776	        let mut r = default_registry();
  2777	        let initial = r.fn_generation();
  2778	        assert!(initial > 0, "default_registry runs ~260+ register_metadata calls at boot");
  2779	
  2780	        // Successful register bumps once.
  2781	        let meta = FunctionMetadata {
  2782	            canonical_name: "MYUDF1".to_string(),
  2783	            display_name: None,
  2784	            aliases: vec![],
  2785	            arity: Arity::Variadic,
