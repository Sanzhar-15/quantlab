   826	    /// Run a recompute closure under the `Busy` plus operation-registry model
   827	    /// (§6.4). In v1 the in-engine recompute is synchronous and runs to
   828	    /// completion within this call (it is the common fast path); the registry
   829	    /// and the `Busy` state are the shape the out-of-process UDF/SQL/AI paths
   830	    /// (6.4/6.5) reuse for honest hard-cancel. Structural failures surface as
   831	    /// `CellDiagnostic` events (never silently dropped).
   832	    fn run_recalc(
   833	        &mut self,
   834	        f: impl FnOnce(&mut WorkbookRuntime<'_>) -> Option<crate::RecomputeResult>,
   835	    ) -> OperationId {
   836	        let op = self.next_op();
   837	        self.ops.insert(op, OperationState::Running);
   838	        self.state = LifecycleState::Busy;
   839	
   840	        let result = self.with_runtime(f);
   841	
   842	        if let Some(res) = &result {
   843	            // F1: recompute commits via `put_computed_at` and appends NO ops, so
   844	            // the version token must advance HERE — fold the changed cells into
   845	            // the delta change-log (no-op if nothing changed).
   846	            if !res.changed_cells.is_empty() {
   847	                let changes: Vec<SessionChange> = res
   848	                    .changed_cells
   849	                    .iter()
   850	                    .map(|&(sheet, row, col)| SessionChange::Cell { sheet, row, col })
   851	                    .collect();
   852	                self.record_changes(changes);
   853	            }
   854	            for failure in &res.failures {
   855	                self.events.push(Event::CellDiagnostic {
   856	                    diagnostic: Diagnostic {
   857	                        addr: Some(CellAddr {
   858	                            sheet: failure.sheet,
   859	                            row: failure.row,
   860	                            col: failure.col,
   861	                        }),
   862	                        severity: Severity::Error,
   863	                        code: "formula_recompute_failed".to_string(),
   864	                        message: failure.error.to_string(),
   865	                    },
   866	                });
   867	            }
   868	        }
   869	
   870	        self.ops.insert(op, OperationState::Completed);
   871	        self.state = LifecycleState::Ready;
   872	        self.events.push(Event::OperationCompleted {
   873	            op,
   874	            state: OperationState::Completed,
   875	        });
   876	        op
   877	    }
