   178	pub struct WorkbookSession {
   179	    /// Live, single-writer cell/sheet/table/name/format storage.
   180	    workbook: Workbook,
   181	    /// **inc.2c-7 undo/redo baseline.** The workbook as it was at session
   182	    /// construction (the `from_workbook` argument), BEFORE any session edit. The
   183	    /// session's `oplog` records only edits made AFTER construction, so undo's
   184	    /// `rematerialize` replays the (post-undo) op-log onto a CLONE of this
   185	    /// baseline — NOT onto a fresh empty `Workbook`. For the wired `new()` path
   186	    /// the baseline is empty (clone is trivial), so behavior is unchanged; for a
   187	    /// session wrapping a populated workbook (the future `open`/`import` path)
   188	    /// this is what makes undo preserve the pre-loaded content instead of
   189	    /// silently dropping it (and makes "you cannot undo past the point the
   190	    /// workbook was opened" the correct, intended semantic). Audited 2026-05-27
   191	    /// (Codex HIGH / Opus M1: a fresh-`OpLog` + populated-workbook session would
   192	    /// otherwise lose its baseline on the first consumed undo).
   193	    baseline: Workbook,
   194	    /// Mandatory single-writer op-log — undo/save substrate + the `op_count`
   195	    /// half of the version token.
   196	    oplog: OpLog,
   197	    /// Dependency graph + dirty propagation.
   198	    graph: CalcgraphSession,
   199	    /// Session-owned bind-plan cache (threaded into the per-edit runtime via
   200	    /// `WorkbookRuntime::with_session_state` / `into_plan_cache`).
   201	    plan_cache: PlanCache,
   202	    /// Built-in + (future) custom function dispatch. `Arc` so a future
   203	    /// out-of-process UDF host can share it.
   204	    registry: Arc<FunctionRegistry>,
   205	    /// Lifecycle state; commands are gated on it (§2.3).
   206	    state: LifecycleState,
   207	    /// Version-token epoch (minted at construction; re-minted by [`bump_epoch`]
   208	    /// on changes the delta DTO cannot incrementally express — sheet reorder /
   209	    /// restore, table ops that rewrite arbitrary formula cells — and on
   210	    /// cache-clearing events). An old token whose epoch ≠ current →
   211	    /// `EpochMismatch` full rebuild.
   212	    ///
   213	    /// [`bump_epoch`]: WorkbookSession::bump_epoch
   214	    epoch: u128,
   215	    /// Monotonic logical state clock — the `op_count` half of the version token
   216	    /// (§4.0). **Replaces `oplog.len()`** (inc.2c-3): it advances on every
   217	    /// committed mutation AND every recompute that changed ≥1 cell, so — unlike
   218	    /// `oplog.len()`, which does NOT move on `put_computed_at` (recompute) nor on
   219	    /// a `set_value(Blank)` clear — two *distinct* visible states can never share
   220	    /// a token. The opaque 24-byte `{epoch, state_seq}` token shape is unchanged
   221	    /// (bindings round-trip it verbatim); only what the 8-byte counter *means*
   222	    /// changed. Closes audit F1 + the F2 token half.
   223	    state_seq: u64,
   224	    /// Bounded change-log keyed by `state_seq` — the source for `snapshot_delta`.
   225	    /// Records what changed; the delta resolves each to current committed state.
   226	    change_log: VecDeque<ChangeRecord>,
   227	    /// The highest `seq` that has been pruned from `change_log`. A `last` token
