   905	        // Formula cells (a formula cell can be Blank-valued but still present).
   906	        for (s, row, col, _text) in self.workbook.iter_formulas() {
   907	            if s == sheet_id {
   908	                set.insert((row, col));
   909	            }
   910	        }
   911	        let mut coords: Vec<(RowId, ColId)> = set.into_iter().collect();
   912	        coords.sort_unstable();
   913	        coords
   914	    }
