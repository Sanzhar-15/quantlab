  1159	                *self = Self::from_workbook(result.workbook);
  1160	                self.registry = registry;
  1161	                Ok(())
  1162	            }
  1163	            other => Err(EngineError::bad_argument(format!(
  1164	                "unsupported import format {other:?} (v1 supports \"xlsx\" and \"csv\")"
