     /// `RegisteredFn::Unified(f)`.
     pub fn register_unified(&mut self, name: &'static str, f: FunctionFn) {
         self.insert_or_panic(
             name,
             RegisteredFn::Unified(f),
             "FunctionRegistry::register_unified",
         );
     }
 
