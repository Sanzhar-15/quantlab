   890	                        let base_row = chunk_idx as u32 * chunk_rows;
   891	                        for (rel_row, _v) in user.iter() {
   892	                            set.insert((base_row + rel_row, col));
   893	                        }
   894	                        for (rel_row, _v) in computed.iter() {
   895	                            set.insert((base_row + rel_row, col));
   896	                        }
