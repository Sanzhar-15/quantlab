   244	    pub display_name: Option<String>,
   245	    /// Optional aliases (also canonicalized).
   246	    #[serde(default, skip_serializing_if = "Vec::is_empty")]
   247	    pub aliases: Vec<String>,
   248	    /// Argument count.
   249	    pub arity: Arity,
   250	    /// Volatility class.
   251	    pub volatility: Volatility,
   252	    /// Whether same args ⇒ same result.
   253	    pub determinism: bool,
   254	    /// Dependency shape.
   255	    pub dep_shape: DepShape,

