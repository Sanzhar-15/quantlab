   293	impl WorkbookSession {
   294	    /// Construct a fresh, empty in-memory session (→ `Ready`). The `new(options)`
   295	    /// product command (§3.1).
   296	    pub fn new() -> Self {
   297	        Self::from_workbook(Workbook::new())
   298	    }
   299	
   300	    /// Wrap an existing `Workbook` (e.g. a hand-built test workbook; later the
   301	    /// product of `open`/`import`). Rebuilds the calc graph from the workbook's
   302	    /// formulas so dependency tracking is live.
   303	    ///
   304	    /// **6.4-1 cycle-2 audit-fix H1 (2026-05-28):** `registry` is constructed
   305	    /// BEFORE `graph` so the dep walker passes through the same
   306	    /// `Arc<FunctionRegistry>` the session holds for the rest of its lifetime.
   307	    /// Pre-audit-fix the body called the zero-arg
   308	    /// `CalcgraphSession::rebuild_from_workbook(&workbook)` which constructs
   309	    /// `default_registry()` internally — silently divergent from `self.registry`
   310	    /// once 6.4-2 wires `register_function` and the two registries can drift.
   311	    /// Behavior-preserving today (both registries are builtin-equivalent at
   312	    /// session construction) but closes the same divergence pattern the 6.4-0
   313	    /// H2 audit-fix closed at `recompute_all` — the 6.4-0 sweep missed this
   314	    /// site and the parallel `rematerialize` site below; the 6.4-1 cycle-2
   315	    /// Opus lane surfaced both.
   316	    pub fn from_workbook(workbook: Workbook) -> Self {
   317	        let registry = Arc::new(ql_functions::default_registry());
   318	        let graph =
   319	            CalcgraphSession::rebuild_from_workbook_with_registry(&workbook, &registry).session;
   320	        // inc.2c-7: snapshot the construction-time workbook as the undo baseline
   321	        // BEFORE moving `workbook` into the struct (the op-log records only
   322	        // post-construction edits, so `rematerialize` replays onto a clone of
   323	        // this baseline — see the `baseline` field doc). Empty/cheap for `new()`.
   324	        let baseline = workbook.clone();
   325	        let oplog = OpLog::new();
   326	        // inc.2c-6: construct the undo manager AFTER `oplog` so it subscribes to
   327	        // the doc's commit stream and records every subsequent `append`'s commit.
   328	        // `set_merge_interval(0)` disables Loro's time-based commit merging so
   329	        // each commit is its own undo unit (HARD QUESTION 1) — every command
   330	        // already produces exactly one commit, so 1 command == 1 undo unit with
   331	        // no explicit grouping. The manager holds an internal Arc to the doc, so
   332	        // it does not borrow `oplog` and can be moved into the struct below.
   333	        let mut undo_manager = oplog.new_undo_manager();
   334	        undo_manager.set_merge_interval(0);
   335	        Self {
   336	            workbook,
   337	            baseline,
   338	            oplog,
   339	            graph,
   340	            plan_cache: PlanCache::new(),
   341	            registry,
   342	            state: LifecycleState::Ready,
   343	            epoch: mint_epoch(),
   344	            state_seq: 0,
   345	            change_log: VecDeque::new(),
   346	            change_log_floor: 0,
   347	            ops: HashMap::new(),
   348	            next_op_id: 1,
   349	            events: Vec::new(),
   350	            txns: HashMap::new(),
   351	            next_txn_id: 1,
   352	            undo_manager,
   353	        }
   354	    }
   355	
   356	    // --- internal helpers ---
   357	
   358	    /// Run a closure against a per-edit `WorkbookRuntime` that borrows the
   359	    /// session's owned state, recovering the (warmed) plan cache afterwards.
   360	    /// The runtime borrow never escapes this function.
   361	    ///
   362	    /// **Panic safety (F3 / contract §8):** `f` runs the engine kernels, which
   363	    /// contain reachable `.expect`/`panic!` (e.g. the recompute/spill paths). If
   364	    /// `f` unwinds, the plan-cache restore below is skipped (leaving the cache
   365	    /// taken/empty) and the session may be mid-edit. A [`FaultGuard`] marks the
   366	    /// session `Faulted` on unwind so no later command runs against torn state —
   367	    /// never silently `Ready`/`Busy`. It is disarmed on the normal return path.
   368	    ///
   369	    /// **6.1C audit-fix A-INFO/L-E6 — panic-default rationale corrected.** The
   370	    /// prior docstring claimed `panic = "abort"` was "today's default"; this is
   371	    /// factually wrong (the workspace `Cargo.toml` does not set `panic`, so the
   372	    /// cargo default for release cdylib is `unwind`). The operational behavior
   373	    /// (a `Session` method panic aborts the host) is still correct, but for the
   374	    /// **napi-derive opt-in** reason: napi-rs only wraps panics into JS errors
   375	    /// when `#[napi(catch_unwind)]` is set, and the `Session` class does not set
   376	    /// it (tracked 6.1C M1 → 6.3). Unwinding through the generated `extern "C"`
   377	    /// callback aborts. Once 6.3 lands `#[napi(catch_unwind)]` per method, this
   378	    /// in-engine guard becomes the half that ensures even a catch-unwind'd panic
   379	    /// leaves the session sealed (`Faulted`) rather than torn.
   380	    fn with_runtime<R>(&mut self, f: impl FnOnce(&mut WorkbookRuntime<'_>) -> R) -> R {
   381	        let cache = std::mem::take(&mut self.plan_cache);
   382	        // Borrows `self.state`; the runtime below borrows the other (disjoint)
   383	        // fields, so both coexist within this function.
   384	        let mut guard = FaultGuard {
   385	            state: &mut self.state,
   386	            armed: true,
   387	        };
   388	        let mut rt = WorkbookRuntime::with_session_state(
   389	            &mut self.workbook,
   390	            &self.registry,
   391	            &mut self.oplog,
   392	            &mut self.graph,
   393	            cache,
   394	        );
   395	        let out = f(&mut rt);
   396	        self.plan_cache = rt.into_plan_cache();
   397	        guard.armed = false;
   398	        out
   399	    }
   400	
   401	    /// Like [`with_runtime`] but with the op-log **detached** — the mutators
   402	    /// update the workbook AND maintain the calcgraph, but append **no** ops
   403	    /// (the [`batch`] path appends its single `Op::BatchCommit` itself). Same
   404	    /// `FaultGuard` panic safety + plan-cache take/restore as `with_runtime`.
   405	    ///
   406	    /// [`with_runtime`]: WorkbookSession::with_runtime
   407	    /// [`batch`]: WorkbookSession::batch
   408	    fn with_runtime_no_oplog<R>(&mut self, f: impl FnOnce(&mut WorkbookRuntime<'_>) -> R) -> R {
   409	        let cache = std::mem::take(&mut self.plan_cache);
   410	        let mut guard = FaultGuard {
   411	            state: &mut self.state,
   412	            armed: true,
   413	        };
   414	        let mut rt = WorkbookRuntime::with_session_state_no_oplog(
   415	            &mut self.workbook,
   416	            &self.registry,
   417	            &mut self.graph,
   418	            cache,
   419	        );
   420	        let out = f(&mut rt);
   421	        self.plan_cache = rt.into_plan_cache();
   422	        guard.armed = false;
   423	        out
   424	    }
