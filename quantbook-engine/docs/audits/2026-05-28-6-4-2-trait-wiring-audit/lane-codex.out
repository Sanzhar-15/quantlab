   255	    /// borrow crosses an FFI boundary.
   256	    ///
   257	    /// Ownership-transfer (vs the borrow-a-`&mut PlanCache` shape the
   258	    /// design doc sketched) keeps every existing `self.plan_cache` call
   259	    /// site and the field type unchanged — `PlanCache: Default`, so the
   260	    /// session `mem::take`s its cache in, runs the edit, and recovers the
   261	    /// warmed cache via [`into_plan_cache`]. The `format_cache` is still
   262	    /// fresh per edit (a re-parse cost only; correctness unaffected) —
   263	    /// session-owning it is a later refinement.
   264	    ///
   265	    /// [`into_plan_cache`]: WorkbookRuntime::into_plan_cache
   266	    pub fn with_session_state(
   267	        workbook: &'a mut Workbook,
   268	        registry: &'a FunctionRegistry,
   269	        oplog: &'a mut OpLog,
   270	        graph: &'a mut crate::CalcgraphSession,
   271	        plan_cache: PlanCache,
   272	    ) -> Self {
   273	        Self {
   274	            workbook,
   275	            registry,
   276	            oplog: Some(oplog),
   277	            plan_cache,
   278	            format_cache: std::collections::HashMap::new(),
   279	            graph: Some(graph),
   280	        }
   281	    }
   282	
   283	    /// **Phase 6.1B inc.2c-4 (2026-05-27) — `batch` detached-op-log path.**
   284	    /// Same as [`with_session_state`] but with the op-log **detached**
   285	    /// (`oplog = None`). Every mutator then updates the workbook AND
   286	    /// maintains the calcgraph session — the graph hooks fire on
