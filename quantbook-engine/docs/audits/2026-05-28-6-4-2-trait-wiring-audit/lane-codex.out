  4561	/// reason as [`CollabSession`] (positive proof at the bottom of this file): the
  4562	/// engine session is `Send + !Sync`, and `Arc<Mutex<Send>>` is `Send + Sync`.
  4563	///
  4564	/// **Scope (inc.2d + 6.4-2):** the minimal edit→recalc→snapshot smoke surface
  4565	/// (construct, single-cell edits, recalc, snapshot/read, close) PLUS the 6.4-2
  4566	/// function-registration surface (`registerFunction` / `unregisterFunction` /
  4567	/// `listFunctions`). The richer surface (batch/transaction/import/export/undo/
  4568	/// delta) is 6.3 Full Bindings. The 6.4-2 methods route through the substrate
  4569	/// shipped at 6.4-0 + 6.4-1: registry `register_udf` / `unregister_metadata` /
  4570	/// `sorted_metadata` + calcgraph `on_function_(un)registered` + the
  4571	/// `map_function_registry_err` mapper for the Appendix A `function_exists` /
  4572	/// `function_not_found` codes.
  4573	#[napi(js_name = "Session")]
  4574	pub struct Session {
  4575	    inner: Arc<Mutex<CoreWorkbookSession>>,
  4576	}
  4577	
  4578	#[napi]
  4579	impl Session {
  4580	    /// Construct a fresh, empty in-memory session (lifecycle `Ready`).
  4581	    #[napi(constructor)]
  4582	    #[allow(clippy::new_without_default)] // napi(constructor); Default would not be exposed to JS.
  4583	    pub fn new() -> Self {
  4584	        Self {
  4585	            inner: Arc::new(Mutex::new(CoreWorkbookSession::new())),
  4586	        }
