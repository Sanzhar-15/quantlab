   340	    /// Register first-class metadata for a function. The `canonical_name`
   341	    /// **must** be ASCII-uppercase (matches the parser's canonicalization);
   342	    /// rejecting a non-uppercase name with `Conflict` would be wrong
   343	    /// (that's bad input, not collision), so this asserts loud — the
   344	    /// caller is expected to pass already-canonical names per contract
   345	    /// §10.3 ("`register_function` normalizes + validates").
   346	    ///
   347	    /// Returns [`FunctionRegistryError::Conflict`] if a metadata entry
   348	    /// already exists for this name (built-in or prior UDF), per the
   349	    /// fail-loud collision rule in contract §10.3. This is the
   350	    /// non-panicking counterpart to [`Self::insert_or_panic`]'s
   351	    /// dispatch-side duplicate panic — UDFs register at runtime where
   352	    /// a panic would abort the host.
   353	    pub fn register_metadata(
   354	        &mut self,
   355	        meta: FunctionMetadata,
   356	    ) -> Result<(), FunctionRegistryError> {
   357	        assert!(
   358	            !meta.canonical_name.is_empty(),
   359	            "FunctionRegistry::register_metadata: canonical_name must not be empty"
   360	        );
   361	        assert!(
   362	            meta.canonical_name
   363	                .bytes()
   364	                .all(|b| !b.is_ascii_lowercase()),
   365	            "FunctionRegistry::register_metadata: canonical_name {:?} must be \
   366	             canonical upper-case (caller must normalize before calling)",
   367	            meta.canonical_name
   368	        );
   369	        if self.metadata.contains_key(&meta.canonical_name) {
   370	            return Err(FunctionRegistryError::Conflict {
   371	                name: meta.canonical_name,
   372	            });
   373	        }
   374	        self.metadata.insert(meta.canonical_name.clone(), meta);
   375	        // **6.4-1 (2026-05-28; H3):** bump the metadata generation counter
   376	        // so any `PlanCacheKey` minted before this call misses on next
   377	        // lookup. The bind cache invalidation is what closes contract
   378	        // §10.3's "re-extract deps" half — `CalcgraphSession`'s hooks
   379	        // already dirty + reschedule; the cache miss forces re-binding
   380	        // through `walk_plan_for_deps` against the current metadata so
   381	        // `FormulaDeps::is_volatile` / `functions_used` / `is_volatile`
   382	        // / `dep_shape`-driven routing all reflect the new entry. Only
   383	        // bumped on success — a `Conflict` returned above leaves the
   384	        // metadata table state and `fn_gen` both untouched.
   385	        self.fn_gen = self.fn_gen.saturating_add(1);
