   320	//
   321	// V2.7 design (Codex M3 + Opus V2.1/V2.2/V2.3 M3 convergent):
   322	//
   323	//   1. Engine: each error enum gets a `kind() -> &'static str`
   324	//      accessor (`crates/ql-collab/src/transport.rs::TransportError`,
   325	//      `crates/ql-collab-ws/src/lib.rs::WebSocketError`,
   326	//      `crates/ql-collab/src/session.rs::CollabSessionError`).
   327	//
   328	//   2. Binding: the helpers below prepend `[<kind>]` to the napi
   329	//      error message, producing strings like
   330	//      `"[transport_closed] transport closed"`.
   331	//
   332	//   3. IDE: `parseQuantbookError(err)` in
   333	//      `extensions/quantlab/src/quantbook/session.ts` extracts the
   334	//      bracketed code into a typed `QuantbookErrorCode` so reconnect
   335	//      logic can branch on `err.code === 'transport_closed'` etc.
   336	//
   337	// **V2.3 mocha test compatibility**: the existing Display strings
   338	// remain intact AFTER the prefix, so substring-match tests like
   339	// `/invalid WebSocket URL/` still match `"[websocket_invalid_url]
   340	// invalid WebSocket URL: ..."`. No test breakage expected.
   341	//
   342	// **Why not napi-rs `Error::with_code`?**: napi-rs 3.9.0's `Error`
   343	// uses `Status: enum` (no `Status::Custom(String)`). The standard
   344	// status codes don't map to our error variants. Prefix-encoding
   345	// in the message is the canonical workaround documented across the
   346	// napi-rs ecosystem until a future custom-code API lands.
   347	
   348	/// Map a [`CollabSessionError`] to a napi [`Error`] with a kind-
   349	/// prefixed message. The kind comes from
   350	/// [`CollabSessionError::kind`]; for `Transport(inner)` it
   351	/// transparently passes through the inner kind (e.g.
   352	/// `"transport_closed"` instead of `"session_transport"`).
   353	fn collab_session_error_to_napi(e: CollabSessionError) -> Error {
   354	    Error::from_reason(format!("[{}] {e}", e.kind()))
   355	}
   356	
   357	/// **Phase 5.7 V3.6.0.8.3 D6 (2026-05-25)** -- helper for the
   358	/// [`CollabSession::workbook_snapshot_delta`] fullRebuildRequired
   359	/// / empty-delta paths.  Single source of truth for the "empty
   360	/// arrays, just version + bool" shape; keeps the algorithm body
   361	/// reading sequentially.
   362	fn empty_delta(version: Buffer, full_rebuild_required: bool) -> WorkbookSnapshotDeltaJson {
   363	    WorkbookSnapshotDeltaJson {
   364	        changed_cells: Vec::new(),
   365	        removed_cells: Vec::new(),
   366	        sheets_changed: Vec::new(),
   367	        sheets_removed: Vec::new(),
   368	        formats_added: Vec::new(),
   369	        version,
   370	        full_rebuild_required,
   371	    }
   372	}
   373	
   374	/// **Phase 5.7 V3.6.0.8.3 D6 (2026-05-25)** -- classify a single op
   375	/// for [`CollabSession::workbook_snapshot_delta`]'s delta walk.
   376	///
   377	/// Sets `has_rename = true` on any `Op::RenameSheet | RenameTable |
   378	/// RenameColumn`; the caller's break-on-rename short-circuit takes
   379	/// effect after this returns.  Otherwise extracts the cell coord,
   380	/// sheet removal, or format registration into the appropriate
   381	/// output collection.
   382	///
   383	/// Recurses into `Op::BatchCommit` to handle nested cell ops (mirrors
   384	/// the V3.4.0.X HIGH-1 closure on `collect_cache_effects`).
   385	///
   386	/// Non-cell-keyed, non-rename, non-format ops (e.g., `SetName`,
   387	/// `AddSheet`, `MoveSheet`, `CreateTable`, `DropTable`, etc.) are
   388	/// silently skipped here.  V3.6.0.8.3 scope: their effects don't
   389	/// emit in this delta surface (would require sheets_changed or new
   390	/// surface fields; deferred to V3.6.0.8.4+).
   391	fn classify_delta_op(
   392	    op: &Op,
   393	    has_rename: &mut bool,
   394	    changed_cells: &mut std::collections::HashSet<(u16, u32, u32)>,
   395	    removed_sheets: &mut Vec<u16>,
   396	    new_formats: &mut Vec<ql_storage::FormatId>,
   397	) {
   398	    match op {
   399	        // **F2 Blank-durability closure (2026-05-27)**: Op::ClearValue
   400	        // joins the cell-keyed fast path. The delta's changedCells
   401	        // entry for the cleared cell carries its new (Blank) value when
   402	        // the IDE re-reads it; no full rebuild needed.
   403	        Op::PutValue { sheet, row, col, .. }
   404	        | Op::ClearValue { sheet, row, col }
   405	        | Op::PutFormula { sheet, row, col, .. }
   406	        | Op::ClearFormula { sheet, row, col }
   407	        | Op::SetCellFormat { sheet, row, col, .. } => {
   408	            changed_cells.insert((*sheet, *row, *col));
   409	        }
   410	        Op::RenameSheet { .. } | Op::RenameTable { .. } | Op::RenameColumn { .. } => {
   411	            *has_rename = true;
   412	        }
   413	        Op::RemoveSheet { id } => {
   414	            removed_sheets.push(*id);
   415	        }
   416	        Op::RegisterFormat { id, .. } => {
   417	            new_formats.push((*id).to_storage());
   418	        }
   419	        Op::BatchCommit { ops } => {
   420	            for inner in ops {
   421	                classify_delta_op(
   422	                    inner,
   423	                    has_rename,
   424	                    changed_cells,
   425	                    removed_sheets,
   426	                    new_formats,
   427	                );
   428	                if *has_rename {
   429	                    return;
   430	                }

