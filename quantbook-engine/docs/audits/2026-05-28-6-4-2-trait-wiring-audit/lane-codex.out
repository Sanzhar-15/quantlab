   251	);
   252	assert.throws(
   253	  () => s.setValue(sheetId, 0, 0, { kind: "number", number: 42 }),
   254	  /\[invalid_state\]/,
   255	  "post-close setValue() must fail loud with [invalid_state]",
   256	);
   257	// 6.4-2 post-close lifecycle: all three new methods rejected by ensure_ready
   258	// (registerFunction, unregisterFunction) or ensure_readable (listFunctions).
   259	assert.throws(
   260	  () => s.registerFunction(myUdfMeta, 1n),
   261	  /\[invalid_state\]/,
   262	  "post-close registerFunction must fail loud with [invalid_state]",
   263	);
   264	assert.throws(
   265	  () => s.unregisterFunction("MYUDF"),
   266	  /\[invalid_state\]/,
   267	  "post-close unregisterFunction must fail loud with [invalid_state]",
   268	);
   269	assert.throws(
   270	  () => s.listFunctions(),
   271	  /\[invalid_state\]/,
   272	  "post-close listFunctions must fail loud with [invalid_state]",
   273	);
   274	// Idempotent: re-closing a Closed session is a no-op (state stays Closed).
   275	s.close();

