   467	    /// Gate a mutating/recalc command: legal only in `Ready`.
   468	    fn ensure_ready(&self) -> EngineResult<()> {
   469	        match self.state {
   470	            LifecycleState::Ready => Ok(()),
   471	            LifecycleState::Busy => Err(EngineError::session_busy(
   472	                "a long operation is in progress; mutating commands are rejected while Busy",
   473	            )),
   474	            LifecycleState::New => Err(EngineError::invalid_state(
   475	                "session is not open yet (New); open or import a workbook first",
   476	            )),
   477	            LifecycleState::Closed => {
   478	                Err(EngineError::invalid_state("session is Closed (terminal)"))
   479	            }
   480	            LifecycleState::Faulted => {
   481	                Err(EngineError::invalid_state("session is Faulted (terminal)"))
   482	            }
   483	        }
   484	    }
   485	
   486	    /// Gate a read-only command: legal in `Ready` or `Busy` (reads the last
   487	    /// committed state); rejected once terminal.
   488	    fn ensure_readable(&self) -> EngineResult<()> {
   489	        match self.state {
   490	            LifecycleState::Ready | LifecycleState::Busy => Ok(()),
   491	            LifecycleState::New => Err(EngineError::invalid_state("session is not open yet (New)")),
   492	            LifecycleState::Closed => {
   493	                Err(EngineError::invalid_state("session is Closed (terminal)"))
   494	            }
   495	            LifecycleState::Faulted => {
   496	                Err(EngineError::invalid_state("session is Faulted (terminal)"))
   497	            }
   498	        }
   499	    }
   500	
   501	    /// Gate [`open`]/[`import`] (inc.2c-9 persistence): legal in `New` (the
   502	    /// `New → Ready` lifecycle transition the trait doc names) OR `Ready`
   503	    /// (re-opening over a live session is allowed — it replaces the document).
   504	    /// Rejected loud in `Busy` (a long op is in flight) and the terminal states.
   505	    /// NOT `ensure_ready` — that rejects `New`, which `open` is precisely the
   506	    /// way out of.
   507	    ///
   508	    /// [`open`]: WorkbookSession::open
   509	    /// [`import`]: WorkbookSession::import
   510	    fn ensure_openable(&self) -> EngineResult<()> {
   511	        match self.state {
   512	            LifecycleState::New | LifecycleState::Ready => Ok(()),
   513	            LifecycleState::Busy => Err(EngineError::session_busy(
   514	                "a long operation is in progress; open/import is rejected while Busy",
   515	            )),
   516	            LifecycleState::Closed => {
   517	                Err(EngineError::invalid_state("session is Closed (terminal)"))
   518	            }
   519	            LifecycleState::Faulted => {
   520	                Err(EngineError::invalid_state("session is Faulted (terminal)"))
   521	            }
   522	        }
   523	    }
