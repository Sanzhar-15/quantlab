   463	    /// `register_metadata` short-circuits BEFORE the handle insert, so
   464	    /// the registry never observes a state with a handle but no
   465	    /// metadata (the inverse — metadata without handle — is the normal
   466	    /// state for built-ins and metadata-only test registrations).
   467	    /// `HashMap::insert` itself cannot fail, so once `register_metadata`
   468	    /// succeeds, the handle insertion is infallible.
   469	    ///
   470	    /// **Single `fn_gen` bump:** the bump happens inside
   471	    /// [`Self::register_metadata`]; the handle insertion does NOT add
   472	    /// another bump. Bind cache invalidation is keyed by metadata mutation,
   473	    /// not by handle mutation — UDF dispatch consults the handle table at
   474	    /// eval time, not at bind time.
   475	    ///
   476	    /// Returns the same [`FunctionRegistryError`] taxonomy as
   477	    /// [`Self::register_metadata`]: `Conflict` on duplicate canonical name
   478	    /// (built-in or existing UDF). The `WorkbookSession` trait method
   479	    /// translates this via `map_function_registry_err` to the
   480	    /// contract-§10.3 `EngineError{class:Conflict, code:"function_exists"}`.
   481	    pub fn register_udf(
   482	        &mut self,
   483	        meta: FunctionMetadata,
   484	        handle: FunctionImplHandle,
   485	    ) -> Result<(), FunctionRegistryError> {
   486	        // Stash the canonical name BEFORE `register_metadata` moves `meta`
   487	        // into the table — needed as the `udf_handles` key.
   488	        let canonical_name = meta.canonical_name.clone();
   489	        self.register_metadata(meta)?;
   490	        // `register_metadata` succeeded → metadata is in the table and
   491	        // `fn_gen` ticked. Insert the handle under the same canonical key.
   492	        // HashMap::insert can't fail; the prior value (if any) was already
   493	        // ruled out by the `Conflict` check inside `register_metadata`.
   494	        self.udf_handles.insert(canonical_name, handle);
