   879	    /// Collect the populated `(row, col)` coordinates of one sheet from the live
   880	    /// workbook (overlay value cells ∪ formula cells ∪ format-overlay cells).
   881	    /// See the module-level read-path enumeration note.
   882	    fn populated_coords(&self, sheet_id: SheetId) -> Vec<(RowId, ColId)> {
   883	        let mut set: HashSet<(RowId, ColId)> = HashSet::new();
