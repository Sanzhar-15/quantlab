  1141	                // document state). Mirrors `open`'s Option-1 adoption.
  1142	                let registry = Arc::clone(&self.registry);
  1143	                *self = Self::from_workbook(result.workbook);
  1144	                self.registry = registry;
  1145	                self.push_xlsx_import_diagnostics(&report);
  1146	                Ok(())
  1147	            }
  1148	            "csv" => {
  1149	                // CSV has NO formulas (a leading `=` is imported as text), so
  1150	                // there is nothing to recompute — unlike xlsx import, this path
  1151	                // does not run a recomputer. Parse into a fresh single-sheet
  1152	                // workbook, then adopt it Option-1 (same model as `open`/xlsx
  1153	                // import: `*self = from_workbook`, registry preserved, fresh
  1154	                // op-log/undo, epoch re-minted).
  1155	                let result =
  1156	                    ql_io_csv::import_csv_bytes(bytes, ql_io_csv::CsvImportOptions::default())
  1157	                        .map_err(map_csv_err)?;
