   972	        let result = self.with_runtime(f);
   973	
   974	        if let Some(res) = &result {
   975	            // F1: recompute commits via `put_computed_at` and appends NO ops, so
   976	            // the version token must advance HERE — fold the changed cells into
   977	            // the delta change-log (no-op if nothing changed).
   978	            if !res.changed_cells.is_empty() {
   979	                let changes: Vec<SessionChange> = res
   980	                    .changed_cells
   981	                    .iter()
   982	                    .map(|&(sheet, row, col)| SessionChange::Cell { sheet, row, col })
   983	                    .collect();
   984	                self.record_changes(changes);
   985	            }
