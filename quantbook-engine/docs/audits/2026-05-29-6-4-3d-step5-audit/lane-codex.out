     1	/*---------------------------------------------------------------------------------------------
     2	 *  Trust Manager.
     3	 *
     4	 *  Manages workspace and strategy trust for live trading safety.
     5	 *
     6	 *  Spec Reference: Technical Spec §12.3 (Safety Layer)
     7	 *--------------------------------------------------------------------------------------------*/
     8	
     9	import * as vscode from 'vscode';
    10	import * as crypto from 'crypto';
    11	import * as path from 'path';
    12	import { EventEmitter } from 'events';
    13	import type TypedEmitter from 'typed-emitter';
    14	import type {
    15		TrustLevel,
