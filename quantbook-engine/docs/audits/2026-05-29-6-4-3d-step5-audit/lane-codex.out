     1	"""``python -m quantbook.worker`` — the out-of-process UDF worker loop. 6.4-3b.
     2	
     3	Speaks the `ql-udf` wire protocol over a RESERVED protocol fd (the original stdout): reads
     4	frames from **stdin**, replies on that protocol fd. The protocol fd is reserved EXCLUSIVELY for
     5	frames — `main()` repoints fd 1 and ``sys.stdout`` at stderr BEFORE importing any user code, so a
     6	stray ``print()`` in a UDF (or import-time chatter) goes to stderr instead of corrupting the frame
     7	stream (6.4-3b audit-fix: udf-print-corrupts-protocol-stdout).
     8	
     9	The engine (`ql-udf::ProcessWorker`) spawns this, performs the HELLO/HELLO_ACK handshake, and
    10	sends one CALL per UDF invocation. UDFs are registered by handle via
    11	`quantbook.register_formula_function`; the trusted user module that does the registering is named
    12	by ``QUANTBOOK_UDF_MODULE`` and imported once at startup (its import side-effects populate the
    13	registry).
    14	"""
    15	
    16	import importlib
    17	import os
    18	import struct
    19	import sys
    20	
    21	from . import _codec, _frame, _registry
    22	
    23	# Wire protocol version — MUST match `ql-udf::control::PROTOCOL_VERSION`.
    24	PROTOCOL_VERSION = 1
    25	
    26	
    27	def _import_udf_module():
    28	    """Import the trusted user module (registers UDFs by handle) if configured."""
    29	    mod = os.environ.get("QUANTBOOK_UDF_MODULE")
    30	    if mod:
    31	        importlib.import_module(mod)
    32	
    33	
    34	def run(stdin, stdout, stderr):
    35	    """The worker loop. ``stdout`` is the RESERVED protocol writer. Returns 0 when the engine
    36	    closes stdin (clean shutdown) or the protocol pipe (engine gone)."""
    37	    _import_udf_module()
    38	    try:
    39	        while True:
    40	            frame = _frame.read_frame(stdin)
    41	            if frame is None:
    42	                return 0  # engine closed stdin → clean exit
    43	            ftype, payload = frame
    44	            if ftype == _frame.HELLO:
    45	                # Validate the HELLO shape; the engine decides version compatibility from our
    46	                # ack. Reply with OUR protocol version + pid (pid → IDE debugpy, 6.4-3d).
    47	                _codec.decode_hello(payload)
    48	                _frame.write_frame(
    49	                    stdout, _frame.HELLO_ACK, _codec.encode_hello_ack(PROTOCOL_VERSION, os.getpid())
    50	                )
    51	            elif ftype == _frame.CALL:
    52	                # Decode the fixed 16-byte [handle][call_id] header OUTSIDE the try so we always
    53	                # have a call_id to correlate a failure. If even the header is unreadable we
    54	                # cannot address a RAISE — log to stderr and continue rather than crashing the
    55	                # loop (6.4-3b audit-fix: malformed-call-decode-crashes-loop-no-raise).
    56	                if len(payload) < 16:
    57	                    stderr.write(
    58	                        "quantbook.worker: dropping CALL with truncated %d-byte header\n"
    59	                        % len(payload)
    60	                    )
    61	                    stderr.flush()
    62	                    continue
    63	                handle, call_id = struct.unpack("<QQ", payload[:16])
    64	                try:
    65	                    # Grid-decode is INSIDE the try: a malformed args grid becomes a RAISE
    66	                    # correlated to call_id, not a loop-killing crash.
    67	                    args = _codec.decode_grid(payload[16:])
    68	                    fn = _registry.lookup(handle)
    69	                    if fn is None:
    70	                        raise LookupError("no UDF registered for handle %d" % handle)
    71	                    result = _codec.as_grid(fn(args))
    72	                    _frame.write_frame(stdout, _frame.RETURN, _codec.encode_return(call_id, result))
    73	                except Exception as e:  # noqa: BLE001 — ANY UDF/arg failure → RAISE, never crashes the loop
    74	                    _frame.write_frame(
    75	                        stdout, _frame.RAISE, _codec.encode_raise(call_id, type(e).__name__, str(e))
    76	                    )
    77	            elif ftype == _frame.CANCEL:
    78	                # Cooperative cancel: v1 best-effort no-op (the loop is busy inside the UDF when a
    79	                # CANCEL would arrive, so it isn't even read mid-call). Hard cancel = the engine
    80	                # SIGKILLs this process (the worker is designed to be killable mid-call).
    81	                pass
    82	            else:
    83	                stderr.write("quantbook.worker: ignoring unexpected frame type %d\n" % ftype)
    84	                stderr.flush()
    85	    except BrokenPipeError:
    86	        # The engine closed the protocol pipe (process gone). A clean shutdown, NOT an error to
    87	        # report — there is nobody left to report it to (6.4-3b audit-fix:
    88	        # hello-ack-broken-pipe-uncaught-during-handshake).
    89	        stderr.write("quantbook.worker: protocol pipe closed by engine; exiting\n")
    90	        stderr.flush()
    91	        return 0
    92	
    93	
    94	def _usable_fd(stream):
    95	    """Return ``stream``'s OS fd if it is a live, real fd, else ``None``.
    96	
    97	    A host that gives the child no console (notably the engine embedded in
    98	    node/electron — 6.4-3d Step 5) can leave ``sys.stdout``/``sys.stderr`` as
    99	    ``None`` or backed by a closed fd. ``fileno()`` then raises or the attribute
