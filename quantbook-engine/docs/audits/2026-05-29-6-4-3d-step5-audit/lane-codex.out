   898	// helpers bridge the gap: fold the event page into a per-cell message map, then
   899	// merge it onto a `QuantbookCellSnapshot` so `renderRows` can show a `title=`
   900	// tooltip explaining WHY a cell is `#CALC!`/`#TIMEOUT!`.
   901	// ---------------------------------------------------------------------
   902	
   903	/** Map key for a cell within a sheet. */
   904	function diagKey(row: number, col: number): string {
   905		return `${row},${col}`;
   906	}
   907	
   908	/**
   909	 * **Phase 6.4-3d Step 5**: fold the `cell_diagnostic` events of `events` for
   910	 * `sheetId` into a `Map` keyed by `"row,col"` whose value is the diagnostic
   911	 * MESSAGE. Last-wins (a later diagnostic for the same cell supersedes an earlier
   912	 * one, e.g. a re-eval that fails differently). Events for other sheets, events
   913	 * without a `cell_diagnostic` kind, and workbook-level diagnostics (no `addr`)
   914	 * are ignored. Pure -- no I/O.
   915	 *
   916	 * Note: the engine ring is append-only with no "diagnostic cleared" event; a
   917	 * cell that later recomputes to a real value keeps a stale entry HERE, but
   918	 * {@link attachCellDiagnostics} only surfaces a message on a cell whose CURRENT
   919	 * value is an error, so a recovered cell naturally drops its tooltip.
   920	 */
   921	export function buildCellDiagnosticMessages(
   922		events: readonly EventJson[],
   923		sheetId: number,
   924	): Map<string, string> {
   925		const out = new Map<string, string>();
   926		for (const e of events) {
   927			if (e.kind !== 'cell_diagnostic') {
   928				continue;
   929			}
   930			const d = e.diagnostic;
   931			if (d === undefined || d.addr === undefined || d.addr.sheet !== sheetId) {
   932				continue;
   933			}
   934			out.set(diagKey(d.addr.row, d.addr.col), d.message);
   935		}
   936		return out;
   937	}
   938	
   939	/**
   940	 * **Phase 6.4-3d Step 5**: return a COPY of `snapshot` where each ERROR-valued
   941	 * entry that has a message in `messages` gains a `diagnostic` field (the
   942	 * message). Non-error cells are left untouched even if a (stale) message exists
   943	 * for their coord -- so a UDF cell that recovered to a real value shows no
   944	 * tooltip. The conditional-key discipline (only set `diagnostic` when present)
   945	 * keeps shape-stability comparisons meaningful. Pure -- does not mutate input.
   946	 */
   947	export function attachCellDiagnostics(
   948		snapshot: QuantbookCellSnapshot,
   949		messages: Map<string, string>,
   950	): QuantbookCellSnapshot {
   951		if (messages.size === 0) {
   952			return snapshot;
   953		}
   954		const entries = snapshot.entries.map(entry => {
   955			if (entry.value.kind !== 'error') {
   956				return entry;
   957			}
   958			const msg = messages.get(diagKey(entry.row, entry.col));
   959			if (msg === undefined) {
   960				return entry;
   961			}
   962			return { ...entry, diagnostic: msg };
   963		});
   964		return { ...snapshot, entries };
   965	}
