   953		private tickPollRemote(): void {
   954			const state = this.attachmentState;
   955			if (state === undefined || state.disposed || state.reconnectInFlight) {
   956				return;
   957			}
   958			const result = classifyPollTick(this.session);
   959			switch (result.kind) {
   960				case 'idle':
   961					// **Phase 5.7 V3.5.0.X audit-closure A-HIGH-4 (2026-05-24)**:
   962					// defense-in-depth.  classifyPollTick returns 'idle' when
   963					// no NEW remote blobs arrived since the last tick.  If a
   964					// previous merged-tick render was SKIPPED (deferred via
   965					// `_pendingRenderAfterTyping`) AND the guard has since
   966					// cleared, fire the deferred render NOW.  This covers
   967					// edge cases where setPresenceTyping(false) never fired
   968					// (e.g., webview crashed mid-edit) and the watchdog
   969					// hasn't fired yet either.
   970					if (this._pendingRenderAfterTyping && !this._presenceRepaintInFlight && !this._disposed) {
   971						this._pendingRenderAfterTyping = false;
   972						state.log.appendLine(
   973							`[collab] pollRemote idle tick: firing deferred render (presence guard cleared since last merged-skip).`,
   974						);
   975						try {
   976							this.render();
   977						} catch (err) {
   978							const info = parseQuantbookError(err);
   979							state.log.appendLine(`[collab] deferred render() failed: code=${info.code} msg=${info.message}`);
   980							// Match the merged-branch policy: fatal codes ->
   981							// caller surfaces; transient -> swallow + log.
   982							// (Don't re-set the dirty flag on failure -- the
   983							// next genuine merge will re-trigger.)
   984						}
   985					}
