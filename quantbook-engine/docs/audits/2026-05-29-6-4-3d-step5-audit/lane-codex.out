     6	/**
     7	 * Phase 6.4-3d Step 5 (2026-05-29) -- IDE-side Python-UDF worker injection.
     8	 *
     9	 * Builds a {@link PythonWorkerConfigJson} and attaches it to an owning
    10	 * {@link SessionInstance} via `setUdfWorker`, behind two gates the engine cannot
    11	 * enforce (it has no workspace concept):
    12	 *
    13	 *   1. **Workspace trust.** A UDF worker runs ARBITRARY workspace Python. We
    14	 *      refuse to spawn one in an untrusted workspace, surfacing the IDE-only
    15	 *      `[worker_untrusted_workspace]` code (caller shows a non-fatal notice).
    16	 *   2. **Interpreter resolution.** The interpreter comes from the existing
    17	 *      `quantlab.pythonPath` cascade (see `../qviz/pythonPath`), verified to be
    18	 *      Python >= 3.9 (the worker is 3.9-compatible) before we hand it to the
    19	 *      engine.
    20	 *
    21	 * `setUdfWorker` is a SYNCHRONOUS napi method that blocks the calling thread up
    22	 * to the handshake timeout. {@link injectUdfWorker} is `async` and yields before
    23	 * the call; callers MUST invoke it OFF the UI/keystroke path. (Converting the
    24	 * engine method to an async napi `AsyncTask` is filed-forward; today the call
    25	 * runs on this thread.)
    26	 *
    27	 * The planning step ({@link planUdfWorkerConfig}) is a PURE function (no vscode /
    28	 * no spawn) so the trust + resolution + version logic is unit-testable; only the
    29	 * thin {@link injectUdfWorker} wrapper touches vscode + the singleton TrustManager.
    30	 */
    31	
    32	import * as path from 'path';
    33	
    34	import { resolveQuantlabPython, verifyPythonVersion, type ResolvedPython } from '../qviz/pythonPath';
    35	import { resolveEnginePath } from './loader';
    36	import type { PythonWorkerConfigJson, SessionInstance } from './types';
    37	
    38	// `vscode` + `TrustManager` are imported LAZILY inside `injectUdfWorker` (the
    39	// only vscode-touching entry point) so this module's top-level import graph
    40	// stays vscode-free -- keeping the pure planner + diagnostics helpers importable
    41	// (and unit-testable) in plain mocha without the vscode shim (mirrors the
    42	// `../qviz/pythonPath` discipline).
    43	
    44	/** Minimum interpreter version -- the worker (`quantbook.worker`) is 3.9-compatible. */
    45	export const UDF_MIN_PY_MAJOR = 3;
    46	export const UDF_MIN_PY_MINOR = 9;
    47	
    48	/**
    49	 * Default eager-handshake timeout (ms). A cold `import pyarrow` in a freshly
    50	 * spawned interpreter can take several seconds; the engine default (5000) is too
    51	 * tight when the IDE host has never warmed the interpreter, so the helper passes
    52	 * a generous default. Capped engine-side at 600000.
    53	 */
    54	export const UDF_DEFAULT_HANDSHAKE_MS = 30_000;
    55	
    56	/**
    57	 * Resolve the engine's `crates/quantbook-py/python` directory (the `quantbook`
    58	 * package + the worker module live here). Derived from {@link resolveEnginePath}
    59	 * -- `.../quantbook-engine/target/release/lib...` → `.../quantbook-engine` →
    60	 * `crates/quantbook-py/python` -- so it tracks the same canonical layout (and the
    61	 * `QUANTBOOK_ENGINE_PATH` override).
    62	 */
    63	export function resolveQuantbookPyDir(): string {
    64		const enginePath = resolveEnginePath();
    65		// dirname = target/release → up two = the quantbook-engine crate root.
    66		const engineRoot = path.resolve(path.dirname(enginePath), '..', '..');
    67		return path.join(engineRoot, 'crates', 'quantbook-py', 'python');
    68	}
    69	
    70	/** Lazy interpreter version check (only invoked once the trust gate passes). */
    71	export type VersionCheck = (pythonPath: string) => { ok: boolean; error?: string };
    72	
    73	export interface PlanUdfWorkerInputs {
    74		/** Result of the workspace-trust check (`true` = trusted). */
    75		readonly isWorkspaceTrusted: boolean;
    76		/** The resolved interpreter (or `null` when none was found). */
    77		readonly resolvedPython: ResolvedPython | null;
    78		/** The engine `quantbook-py/python` dir (first PYTHONPATH entry). */
    79		readonly quantbookPyDir: string;
    80		/**
    81		 * Optional version check, invoked ONLY after the trust gate passes and an
    82		 * interpreter resolved -- so an untrusted workspace never spawns a subprocess.
    83		 */
    84		readonly versionCheck?: VersionCheck;
    85		/** Trusted user module the worker imports to register UDFs by handle. */
    86		readonly udfModule?: string;
    87		/** Extra PYTHONPATH dirs appended after {@link quantbookPyDir} (e.g. the workspace UDF dir). */
    88		readonly extraPythonPath?: readonly string[];
    89		/** Handshake timeout override (ms). Defaults to {@link UDF_DEFAULT_HANDSHAKE_MS}. */
    90		readonly handshakeTimeoutMs?: number;
    91	}
    92	
    93	/**
    94	 * PURE: build the worker config, applying the trust + resolution + version
    95	 * gates. Throws a `[code] message` engine-style error on any gate failure (so
    96	 * the caller can `parseQuantbookError` it uniformly):
    97	 *   - `[worker_untrusted_workspace]` -- workspace not trusted (no spawn).
    98	 *   - `[worker_spawn_failed]` -- no interpreter found, OR the interpreter is too
    99	 *     old / not runnable (the version check failed).
   100	 *
   101	 * No I/O beyond the injected `versionCheck` (which the caller wires to
   102	 * `verifyPythonVersion`); never touches vscode.
   103	 */
   104	export function planUdfWorkerConfig(inp: PlanUdfWorkerInputs): PythonWorkerConfigJson {
   105		if (!inp.isWorkspaceTrusted) {
   106			throw new Error(
   107				'[worker_untrusted_workspace] refusing to launch a Python UDF worker: the workspace is not ' +
   108				'trusted. A UDF worker runs arbitrary workspace Python -- trust the workspace to enable Python UDFs.',
   109			);
   110		}
   111		if (inp.resolvedPython === null) {
   112			throw new Error(
   113				'[worker_spawn_failed] no Python interpreter found. Set `quantlab.pythonPath` (or ' +
   114				'`python.defaultInterpreterPath`, or create ~/.quantlab/venv) to a Python >= ' +
   115				`${UDF_MIN_PY_MAJOR}.${UDF_MIN_PY_MINOR} with pyarrow installed.`,
   116			);
   117		}
   118		const python = inp.resolvedPython.pythonPath;
   119		if (inp.versionCheck) {
   120			const v = inp.versionCheck(python);
   121			if (!v.ok) {
   122				throw new Error(`[worker_spawn_failed] interpreter ${python} is not usable: ${v.error ?? 'unknown'}`);
   123			}
   124		}
   125		const pythonpath = [inp.quantbookPyDir, ...(inp.extraPythonPath ?? [])];
   126		const config: PythonWorkerConfigJson = {
   127			python,
   128			pythonpath,
   129			handshakeTimeoutMs: inp.handshakeTimeoutMs ?? UDF_DEFAULT_HANDSHAKE_MS,
   130		};
   131		// Per napi-rs: OMIT optional fields when unset (do not pass `undefined`-valued).
   132		if (inp.udfModule !== undefined && inp.udfModule.length > 0) {
   133			config.udfModule = inp.udfModule;
   134		}
   135		return config;
   136	}
   137	
   138	export interface InjectUdfWorkerOptions {
   139		/** Workspace URI for the trust gate (e.g. `workspaceFolders[0].uri.toString()`). */
   140		readonly workspaceUri: string;
   141		/** Trusted user module the worker imports to register UDFs by handle. */
   142		readonly udfModule?: string;
   143		/** Extra PYTHONPATH dirs (e.g. the workspace UDF directory). */
   144		readonly extraPythonPath?: readonly string[];
   145		/** Handshake timeout override (ms). Defaults to {@link UDF_DEFAULT_HANDSHAKE_MS}. */
   146		readonly handshakeTimeoutMs?: number;
   147	}
   148	
   149	/**
   150	 * Resolve config from the workspace + the `quantlab.pythonPath` cascade, gate on
   151	 * trust, and attach the worker to `session`. Async -- yields before the
   152	 * SYNCHRONOUS, blocking `setUdfWorker` call so it is never invoked inline on a
   153	 * caller's synchronous tick; the caller still MUST run this off the UI/keystroke
   154	 * path (the engine method blocks this thread up to the handshake timeout).
   155	 *
   156	 * On success the caller should `session.recalcAll()` so existing `#CALC!` UDF
   157	 * cells pick up the worker (`recalcDirty` will not heal them).
   158	 *
   159	 * Throws `[worker_untrusted_workspace]` / `[worker_spawn_failed]` /
   160	 * `[worker_handshake]` / `[invalid_state]` / `[session_busy]` /
   161	 * `[bad_argument]` -- all `parseQuantbookError`-parseable.
   162	 */
   163	export async function injectUdfWorker(
   164		session: SessionInstance,
   165		opts: InjectUdfWorkerOptions,
   166	): Promise<void> {
   167		// Lazy runtime imports (see the top-of-file note): keeps this module's
   168		// top-level graph vscode-free for testability.
   169		const vscode = await import('vscode');
   170		const { TrustManager } = await import('../core/trust/TrustManager');
   171	
   172		const isWorkspaceTrusted = TrustManager.getInstance().isWorkspaceTrusted(opts.workspaceUri);
   173	
   174		const quantlabConfigPath =
   175			vscode.workspace.getConfiguration('quantlab').get<string>('pythonPath') || undefined;
   176		const pythonExtConfigPath =
   177			vscode.workspace.getConfiguration('python').get<string>('defaultInterpreterPath') || undefined;
   178		const resolvedPython = resolveQuantlabPython({ quantlabConfigPath, pythonExtConfigPath });
   179	
   180		const config = planUdfWorkerConfig({
   181			isWorkspaceTrusted,
   182			resolvedPython,
   183			quantbookPyDir: resolveQuantbookPyDir(),
   184			versionCheck: (p) => {
   185				const r = verifyPythonVersion(p, UDF_MIN_PY_MAJOR, UDF_MIN_PY_MINOR);
   186				return r.ok ? { ok: true } : { ok: false, error: r.error };
   187			},
   188			udfModule: opts.udfModule,
   189			extraPythonPath: opts.extraPythonPath,
   190			handshakeTimeoutMs: opts.handshakeTimeoutMs,
   191		});
   192	
   193		// `setUdfWorker` is SYNCHRONOUS and blocks up to the handshake timeout. Yield
   194		// once so we never block within a synchronous caller's tick; the engine call
   195		// itself still runs on this thread (the async-napi `AsyncTask` variant is
   196		// filed-forward). Callers MUST invoke `injectUdfWorker` off the UI path.
   197		await Promise.resolve();
   198		session.setUdfWorker(config);
   199	}

