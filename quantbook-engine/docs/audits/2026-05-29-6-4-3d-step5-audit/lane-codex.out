    33	
    34	class Err:
    35	    """A spreadsheet error value, identified by its sigil (e.g. ``"#DIV/0!"``)."""
    36	
    37	    __slots__ = ("sigil",)
    38	
    39	    def __init__(self, sigil):
    40	        self.sigil = sigil
    41	
    42	    def __repr__(self):
    43	        return "Err(%r)" % (self.sigil,)
    44	
    45	    def __eq__(self, other):
    46	        return isinstance(other, Err) and other.sigil == self.sigil
    47	
    48	    def __hash__(self):
    49	        return hash(self.sigil)
    50	
    51	
    52	class Grid:
    53	    """A 2-D grid of cells in row-major order. A cell is one of: ``None`` (blank),
    54	    ``float``/``int`` (number), ``bool`` (boolean), ``str`` (text), ``Err`` (error)."""
    55	
    56	    __slots__ = ("rows", "cols", "cells")
    57	
    58	    def __init__(self, rows, cols, cells):
    59	        if len(cells) != rows * cols:
    60	            raise ValueError("Grid: %d cells != rows*cols = %d*%d" % (len(cells), rows, cols))
    61	        self.rows = rows
    62	        self.cols = cols
    63	        self.cells = cells
    64	
    65	    def get(self, r, c):
    66	        return self.cells[r * self.cols + c]
    67	
    68	    @staticmethod
    69	    def scalar(value):
    70	        return Grid(1, 1, [value])
    71	
    72	    def __eq__(self, other):
    73	        return (
    74	            isinstance(other, Grid)
    75	            and other.rows == self.rows
    76	            and other.cols == self.cols
    77	            and other.cells == self.cells
    78	        )
    79	
    80	    def __repr__(self):
