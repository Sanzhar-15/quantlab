   105	        if cell is None:
   106	            kinds.append("blank"); nums.append(None); strs.append(None); bools.append(None); errs.append(None)
   107	        elif isinstance(cell, bool):
   108	            # NB: bool is a subclass of int — check it BEFORE the numeric branch.
   109	            kinds.append("bool"); nums.append(None); strs.append(None); bools.append(cell); errs.append(None)
