     8	/// Opaque identifier for a long-running operation (recalc, UDF, SQL, AI).
     9	///
    10	/// Returned by long commands; the caller polls/waits/cancels by this id. It is
    11	/// opaque — the caller round-trips it without interpreting (contract §6.1).
    12	#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord, Serialize, Deserialize)]
    13	pub struct OperationId(pub u64);
