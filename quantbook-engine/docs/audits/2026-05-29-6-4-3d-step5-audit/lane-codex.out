    15	/// Terminal-or-running state of an operation (contract §6.1). Terminal states
    16	/// (`Completed`/`Canceled`/`Failed`) are immutable once reached.
    17	// NOTE: not `Eq` — `Failed` holds an `EngineError`, which is not `Eq`.
    18	#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
    19	#[serde(tag = "state", rename_all = "snake_case")]
