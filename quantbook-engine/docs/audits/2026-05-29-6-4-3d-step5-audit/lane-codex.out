  4474	/// Map an [`ql_session::OperationState`] to its JS DTO. The `Failed` error is
  4475	/// rendered via the `[code] message` `Display` (the same wire convention the
  4476	/// napi error helpers use) so the IDE can `parseQuantbookError` it.
  4477	fn operation_state_json_from_session(s: ql_session::OperationState) -> OperationStateJson {
  4478	    use ql_session::OperationState;
  4479	    match s {
  4480	        OperationState::Running => OperationStateJson {
  4481	            state: "running".to_string(),
  4482	            error: None,
  4483	        },
  4484	        OperationState::Completed => OperationStateJson {
  4485	            state: "completed".to_string(),
  4486	            error: None,
  4487	        },
  4488	        OperationState::Canceled => OperationStateJson {
  4489	            state: "canceled".to_string(),
  4490	            error: None,
  4491	        },
  4492	        OperationState::Failed { error } => OperationStateJson {
  4493	            state: "failed".to_string(),
  4494	            error: Some(error.to_string()),
  4495	        },
  4496	    }
  4497	}
