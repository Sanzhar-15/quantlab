     6	/**
     7	 * Phase 5.7 V1 (2026-05-22) -- ql-bindings-node loader.
     8	 *
     9	 * Locates and loads the engine's compiled cdylib (`.dylib` on macOS,
    10	 * `.so` on Linux, `.dll` on Windows). Resolves via the environment
    11	 * variable `QUANTBOOK_ENGINE_PATH` first; falls back to the workspace-
    12	 * relative dev path otherwise. **Per CLAUDE.md no-fallback rule**:
    13	 * "fallback" here is a path-resolution alternative, not an error-
    14	 * masking behavior. If both resolutions fail OR the file isn't loadable,
    15	 * we throw LOUDLY with a precise diagnostic.
    16	 *
    17	 * V1 dev-path resolution:
    18	 *   quantlab-quantbook/quantbook-engine/target/release/libql_bindings_node.<ext>
    19	 * computed relative to the IDE workspace root (the parent of
    20	 * `quantlab/` which is the IDE-fork repo).
    21	 *
    22	 * V2 publish pipeline (deferred):
    23	 *   Use `@napi-rs/cli` or a custom artifact pipeline to ship the .node
    24	 *   file as part of the extension package. V1's dev-path approach
    25	 *   requires both engine + IDE repos checked out side-by-side at
    26	 *   ~/Documents/Sanzhar/Sanzhar/quantlab/.
    27	 */
    28	
    29	import * as os from 'os';
    30	import * as path from 'path';
    31	import * as fs from 'fs';
    32	
    33	import type { QuantbookNativeModule } from './types';
    34	
    35	let cachedModule: QuantbookNativeModule | undefined;
    36	
    37	/**
    38	 * Resolve the absolute path to the cdylib for the current platform.
    39	 * Returns the absolute path (regardless of whether the file exists);
    40	 * existence is checked in {@link loadQuantbookEngine}.
    41	 *
    42	 * Resolution order:
    43	 * 1. `QUANTBOOK_ENGINE_PATH` env var, if set + non-empty.
    44	 * 2. V1 dev-path discovery: walk UP from `__dirname` until we find
    45	 *    the extensions/quantlab/package.json anchor (identified by
    46	 *    `name: "quantlab"`), then `..` twice to the IDE repo root, then
    47	 *    `..` to the parent workspace dir, then descend to
    48	 *    `quantlab-quantbook/quantbook-engine/target/release`.
    49	 *
    50	 * **V1 audit closure (Opus M2 + Codex M3, 2026-05-22)**: the prior
    51	 * anchor was the IDE-root `package.json` with `name: "code-oss-dev"`.
    52	 * Verified that the engine worktree (`quantlab-quantbook/`) is itself
    53	 * a worktree of the IDE repo and SHARES the same `code-oss-dev`
    54	 * package.json. That meant a user `cd`'d into the engine worktree
    55	 * would walk up to the WRONG IDE-root (the engine worktree's own) and
    56	 * resolve to `quantlab-quantbook/quantlab-quantbook/quantbook-engine/...`
    57	 * which doesn't exist. The extensions/quantlab/package.json is
    58	 * unique enough (named `"quantlab"` vs the root's `"code-oss-dev"`)
    59	 * to avoid this collision. Both worktrees have `extensions/quantlab/`
    60	 * with the same source, so we anchor THROUGH the extension to its
    61	 * containing IDE repo root.
    62	 *
    63	 * **Phase 5.7 V1 megaudit closure (Codex MEDIUM, 2026-05-22)**: the
    64	 * prior V1 implementation had a `console.warn`-then-fall-through
    65	 * "coarse 6-hop path" branch when the extension anchor wasn't found.
    66	 * Per CLAUDE.md no-fallback rule, this was a silent failure mode (a
    67	 * stale .dylib in the 6-hop path would load successfully). Replaced
    68	 * with an explicit `throw` directing the caller to set
    69	 * `QUANTBOOK_ENGINE_PATH`. The only valid resolution paths are now
    70	 * (1) explicit env var, (2) successful walk-up anchor discovery.
    71	 */
    72	export function resolveEnginePath(): string {
    73		const env = process.env.QUANTBOOK_ENGINE_PATH;
    74		if (typeof env === 'string' && env.length > 0) {
    75			return path.resolve(env);
    76		}
    77		const ext = nativeLibExt();
    78		const extensionDir = findExtensionDir(__dirname);
    79		if (extensionDir === undefined) {
    80			// **Phase 5.7 V1 megaudit closure (Codex MEDIUM, 2026-05-22):**
    81			// the prior V1 closure emitted a `console.warn` then fell
    82			// through to a coarse 6-hop relative path. Per CLAUDE.md
    83			// no-fallback rule, that's a silent failure mode -- if the
    84			// 6-hop path happened to contain a stale .dylib (e.g., from a
    85			// different engine checkout), the loader would happily load
    86			// it. Throw LOUDLY instead. The only legitimate way to reach
    87			// this branch is a non-canonical workspace layout, in which
    88			// case `QUANTBOOK_ENGINE_PATH` is the right escape hatch.
    89			throw new Error(
    90				'[quantbook loader] Could not locate the extensions/quantlab ' +
    91				`anchor by walking up from ${__dirname}. ` +
    92				'This indicates a non-canonical workspace layout (the engine ' +
    93				'expects the extension to be at .../quantlab/extensions/quantlab ' +
    94				'sibling to .../quantlab-quantbook/quantbook-engine). ' +
    95				'Set QUANTBOOK_ENGINE_PATH=<absolute path to libql_bindings_node.' +
    96				`${ext}> to bypass discovery.`,
    97			);
    98		}
    99		// extensionDir is .../{IDE-root}/extensions/quantlab
   100		// .. twice = IDE-root
   101		// .. thrice = parent workspace (sibling-of-IDE)
   102		// + quantlab-quantbook/quantbook-engine/target/release/lib...
   103		return path.resolve(
   104			extensionDir,
   105			'..', '..', '..',
   106			'quantlab-quantbook', 'quantbook-engine', 'target', 'release',
   107			`libql_bindings_node.${ext}`,
   108		);
   109	}
   110	
   111	/**
   112	 * Walk UP from `start` looking for the extension's `package.json`
   113	 * (identified by `name: "quantlab"` AND ending in `extensions/quantlab`
   114	 * to disambiguate from any other "quantlab"-named packages). Returns
   115	 * the absolute path to that directory, or `undefined` if not found.
   116	 *
   117	 * Anchoring to the extension instead of the IDE root avoids the
   118	 * worktree-collision issue documented above the caller.
   119	 */
   120	function findExtensionDir(start: string): string | undefined {
   121		let cur = path.resolve(start);
   122		for (let depth = 0; depth < 16; depth += 1) {
   123			const pkgPath = path.join(cur, 'package.json');
   124			if (fs.existsSync(pkgPath)) {
   125				try {
   126					const raw = fs.readFileSync(pkgPath, 'utf8');
   127					const pkg = JSON.parse(raw) as { name?: string };
   128					if (pkg.name === 'quantlab' && cur.endsWith(path.join('extensions', 'quantlab'))) {
   129						return cur;
   130					}
   131				} catch {
   132					// Malformed package.json or read failure -- keep walking.
   133					// We're scanning ancestors; don't surface a partial read.
   134				}
   135			}
   136			const parent = path.dirname(cur);
   137			if (parent === cur) {
   138				return undefined;
   139			}
   140			cur = parent;
   141		}
   142		return undefined;
   143	}
   144	
   145	function nativeLibExt(): string {
   146		switch (process.platform) {
   147			case 'darwin': return 'dylib';
   148			case 'linux': return 'so';
   149			case 'win32': return 'dll';
   150			default:
   151				throw new Error(
   152					`Unsupported platform "${process.platform}" for ql-bindings-node V1. ` +
   153					`Supported: darwin, linux, win32.`,
   154				);
   155		}
   156	}
   157	
   158	/**
   159	 * Resolve the path to the `relay-server` example binary shipped by
   160	 * `ql-collab-ws` (V3.1.a). Mirrors {@link resolveEnginePath}'s
   161	 * extension-anchor walk-up pattern.
   162	 *
   163	 * **Phase 5.7 V3.1.b (2026-05-22)**: the multi-window IDE demo spawns
   164	 * this binary as a child process so two VS Code windows can each
   165	 * connect via `WebSocketTransport` to a shared localhost ws relay.
   166	 *
   167	 * Failure modes:
   168	 * - `QUANTBOOK_RELAY_BINARY_PATH` set but file doesn't exist -> throws
   169	 *   directing the user to fix the env var.
   170	 * - Anchor walk-up fails (non-canonical workspace) -> throws directing
   171	 *   the user to set `QUANTBOOK_RELAY_BINARY_PATH` as the escape hatch.
   172	 * - Resolved path does not exist (binary not built) -> the caller's
   173	 *   `child_process.spawn` will surface ENOENT.
   174	 */
   175	export function resolveRelayBinaryPath(): string {
   176		const env = process.env.QUANTBOOK_RELAY_BINARY_PATH;
   177		if (typeof env === 'string' && env.length > 0) {
   178			return path.resolve(env);
   179		}
   180		const extensionDir = findExtensionDir(__dirname);
   181		if (extensionDir === undefined) {
   182			throw new Error(
   183				'[quantbook loader] Could not locate the extensions/quantlab ' +
   184				`anchor by walking up from ${__dirname} to resolve the relay ` +
   185				'binary. Set QUANTBOOK_RELAY_BINARY_PATH=<absolute path to ' +
   186				'.../target/release/examples/relay-server> to bypass discovery.',
   187			);
   188		}
   189		const binaryName = process.platform === 'win32' ? 'relay-server.exe' : 'relay-server';
   190		// extensionDir is .../{IDE-root}/extensions/quantlab; .. thrice
   191		// = parent workspace dir; then quantlab-quantbook/quantbook-engine/
   192		// target/release/examples/<binary>.
   193		return path.resolve(
   194			extensionDir,
   195			'..', '..', '..',
   196			'quantlab-quantbook', 'quantbook-engine', 'target', 'release', 'examples',
   197			binaryName,
   198		);
   199	}
   200	
