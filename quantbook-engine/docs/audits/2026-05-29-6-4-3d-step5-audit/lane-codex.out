    25	suite('quantbook 6.4-3d Step 5 -- UDF worker wiring', () => {
    26		suite('error-code allowlist (the 5 new codes parse)', () => {
    27			// The Record<Exclude<QuantbookErrorCode,'unknown'>, true> in session.ts is
    28			// COMPILE-enforced parity; `parseQuantbookError` derives its recognized
    29			// set from that Record's keys. So a `[code] msg` round-trip proves both
    30			// the union member AND the Record entry exist for each new code.
    31			for (const code of [
    32				'worker_spawn_failed',
    33				'worker_handshake',
    34				'worker_untrusted_workspace',
    35				'invalid_state',
    36				'session_busy',
    37			] as const) {
    38				test(`parseQuantbookError recognizes [${code}]`, () => {
    39					const info = parseQuantbookError(new Error(`[${code}] something went wrong`));
    40					assert.strictEqual(info.code, code);
    41					assert.strictEqual(info.message, 'something went wrong');
    42				});
    43			}
    44	
    45			test('an unknown bracket code still falls back to unknown (sanity)', () => {
    46				const info = parseQuantbookError(new Error('[definitely_not_a_code] x'));
    47				assert.strictEqual(info.code, 'unknown');
    48			});
    49		});
    50	
    51		suite('planUdfWorkerConfig (pure trust + resolution gates)', () => {
    52			const okPython = { pythonPath: '/usr/bin/python3', source: 'config-quantlab' as const };
    53			const qpyDir = '/engine/crates/quantbook-py/python';
    54	
    55			test('untrusted workspace -> [worker_untrusted_workspace], no spawn (versionCheck never runs)', () => {
    56				let versionChecked = false;
    57				assert.throws(
    58					() =>
    59						planUdfWorkerConfig({
    60							isWorkspaceTrusted: false,
    61							resolvedPython: okPython,
    62							quantbookPyDir: qpyDir,
    63							versionCheck: () => {
    64								versionChecked = true;
    65								return { ok: true };
    66							},
    67						}),
    68					/\[worker_untrusted_workspace\]/,
    69				);
    70				assert.strictEqual(versionChecked, false, 'must not probe the interpreter when untrusted');
    71			});
    72	
    73			test('no interpreter resolved -> [worker_spawn_failed] mentioning quantlab.pythonPath', () => {
    74				assert.throws(
    75					() =>
    76						planUdfWorkerConfig({
    77							isWorkspaceTrusted: true,
    78							resolvedPython: null,
    79							quantbookPyDir: qpyDir,
    80						}),
    81					/\[worker_spawn_failed\][\s\S]*quantlab\.pythonPath/,
    82				);
    83			});
    84	
    85			test('interpreter too old -> [worker_spawn_failed] (version check fails)', () => {
    86				assert.throws(
    87					() =>
    88						planUdfWorkerConfig({
    89							isWorkspaceTrusted: true,
    90							resolvedPython: okPython,
    91							quantbookPyDir: qpyDir,
    92							versionCheck: () => ({ ok: false, error: 'python 3.8 is below minimum 3.9' }),
    93						}),
    94					/\[worker_spawn_failed\][\s\S]*3\.8 is below/,
    95				);
    96			});
    97	
    98			test('happy path: config carries python, quantbookPyDir first on PYTHONPATH, default handshake, udfModule', () => {
    99				const cfg = planUdfWorkerConfig({
   100					isWorkspaceTrusted: true,
   101					resolvedPython: okPython,
   102					quantbookPyDir: qpyDir,
   103					versionCheck: () => ({ ok: true }),
   104					udfModule: 'my_udfs',
   105					extraPythonPath: ['/workspace/udfs'],
   106				});
   107				assert.strictEqual(cfg.python, '/usr/bin/python3');
   108				assert.deepStrictEqual(cfg.pythonpath, [qpyDir, '/workspace/udfs']);
   109				assert.strictEqual(cfg.pythonpath?.[0], qpyDir, 'engine package dir must be first');
   110				assert.strictEqual(cfg.udfModule, 'my_udfs');
   111				assert.strictEqual(cfg.handshakeTimeoutMs, UDF_DEFAULT_HANDSHAKE_MS);
   112			});
   113	
   114			test('udfModule omitted when not provided (no undefined-valued key); handshake override honored', () => {
   115				const cfg = planUdfWorkerConfig({
   116					isWorkspaceTrusted: true,
   117					resolvedPython: okPython,
   118					quantbookPyDir: qpyDir,
   119					versionCheck: () => ({ ok: true }),
   120					handshakeTimeoutMs: 12345,
   121				});
   122				assert.ok(
   123					!Object.prototype.hasOwnProperty.call(cfg, 'udfModule'),
   124					'udfModule key must be ABSENT, not undefined (napi-rs)',
   125				);
   126				assert.strictEqual(cfg.handshakeTimeoutMs, 12345);
   127				assert.deepStrictEqual(cfg.pythonpath, [qpyDir]);
   128			});
   129		});
   130	
   131		suite('buildCellDiagnosticMessages (event -> per-cell message map)', () => {
   132			const events: EventJson[] = [
   133				{ kind: 'recalc_progress', op: 1n, done: 0n, total: 1n }, // ignored
   134				{
   135					kind: 'cell_diagnostic',
   136					diagnostic: { addr: { sheet: 0, row: 0, col: 1 }, severity: 'error', code: 'udf_no_worker', message: 'no worker' },
   137				},
   138				{
   139					// other sheet -> ignored when filtering sheet 0
   140					kind: 'cell_diagnostic',
   141					diagnostic: { addr: { sheet: 1, row: 0, col: 1 }, severity: 'error', code: 'udf_raised', message: 'other sheet' },
   142				},
   143				{
   144					// later diagnostic for the SAME cell wins
   145					kind: 'cell_diagnostic',
   146					diagnostic: { addr: { sheet: 0, row: 0, col: 1 }, severity: 'error', code: 'udf_raised', message: 'ValueError: boom' },
   147				},
   148				{
   149					// workbook-level (no addr) -> ignored
   150					kind: 'cell_diagnostic',
   151					diagnostic: { severity: 'warning', code: 'something', message: 'no addr' },
   152				},
   153			];
   154	
   155			test('filters by sheet, ignores non-diagnostic + addr-less, last-wins', () => {
   156				const m = buildCellDiagnosticMessages(events, 0);
   157				assert.strictEqual(m.size, 1);
   158				assert.strictEqual(m.get('0,1'), 'ValueError: boom');
   159			});
   160	
   161			test('a different sheet sees only its own diagnostics', () => {
   162				const m = buildCellDiagnosticMessages(events, 1);
   163				assert.strictEqual(m.size, 1);
   164				assert.strictEqual(m.get('0,1'), 'other sheet');
   165			});
   166		});
   167	
   168		suite('attachCellDiagnostics (merge onto error-valued cells only)', () => {
   169			const base: QuantbookCellSnapshot = {
   170				snapshot_format_version: 1,
   171				sheet: 0,
   172				entries: [
   173					{ row: 0, col: 0, value: { kind: 'number', value: 42 } },
   174					{ row: 0, col: 1, value: { kind: 'error', value: '#CALC!' } },
   175				],
   176			};
   177	
   178			test('attaches the message to the error cell only; number cell untouched', () => {
   179				const msgs = new Map<string, string>([
   180					['0,0', 'stale message for a recovered cell'],
   181					['0,1', 'no Python worker is configured for this session'],
   182				]);
   183				const out = attachCellDiagnostics(base, msgs);
   184				const errCell = out.entries.find(e => e.col === 1)!;
   185				const numCell = out.entries.find(e => e.col === 0)!;
   186				assert.strictEqual(errCell.diagnostic, 'no Python worker is configured for this session');
   187				assert.ok(
   188					!Object.prototype.hasOwnProperty.call(numCell, 'diagnostic'),
   189					'a non-error (recovered) cell drops the stale tooltip',
   190				);
   191			});
   192	
   193			test('empty message map returns the same snapshot reference (no-op)', () => {
   194				const out = attachCellDiagnostics(base, new Map());
   195				assert.strictEqual(out, base);
   196			});
   197	
   198			test('does not mutate the input snapshot', () => {
