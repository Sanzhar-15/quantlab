   882	        // empty workbook): the op-log holds only post-construction edits, so
   883	        // `baseline + (post-undo log)` reconstructs the correct state and
   884	        // preserves any pre-loaded content. Empty/trivial for the `new()` path.
   885	        let mut wb = self.baseline.clone();
