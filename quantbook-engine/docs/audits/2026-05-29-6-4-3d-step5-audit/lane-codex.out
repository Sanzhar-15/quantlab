  1080	    /// diagnostics (inc.2c-10). The import SUCCEEDS, but unsupported OOXML
  1081	    /// features (dropped), soft warnings, and formulas the engine couldn't
  1082	    /// recompute (Excel cached value preserved) are all reported as poll-able
  1083	    /// events — never silently dropped (No-Fallbacks). Called AFTER the
  1084	    /// `*self = from_workbook(..)` adoption (which resets `events`).
  1085	    fn push_xlsx_import_diagnostics(&mut self, report: &ql_io_xlsx::XlsxImportReport) {
  1086	        // The PRIMARY fidelity-loss channel: `scan_unsupported_features` records
  1087	        // dropped OOXML features (conditional formatting, data validation, merged
  1088	        // cells, hyperlinks, protection, comments, drawings, images, pivots,
  1089	        // macros, external links, hidden sheets) into `feature_inventory.counts`
  1090	        // — NOT into `report.unsupported` (which carries only per-occurrence
  1091	        // detail for a couple of cases). Under `UnsupportedPolicy::Permissive`
  1092	        // (the import default) those features are silently ignored on the wire,
  1093	        // so surfacing the inventory here is what keeps the No-Fallbacks promise.
  1094	        // Sorted by kind for deterministic event order (HashMap iteration order
  1095	        // is otherwise nondeterministic).
  1096	        let mut inventory: Vec<_> = report.feature_inventory.counts.iter().collect();
  1097	        inventory.sort_by_key(|(kind, _)| format!("{kind:?}"));
  1098	        for (kind, count) in inventory {
  1099	            self.events.push(Event::CellDiagnostic {
  1100	                diagnostic: Diagnostic {
  1101	                    addr: None,
  1102	                    severity: Severity::Warning,
  1103	                    code: "xlsx_unsupported_feature".to_string(),
  1104	                    message: format!(
  1105	                        "{kind:?} is not represented by the engine and was dropped on import \
  1106	                         ({count} occurrence(s))"
  1107	                    ),
  1108	                },
  1109	            });
  1110	        }
  1111	        // Per-occurrence unsupported records (location detail the inventory tally
  1112	        // lacks — e.g. an unregistered custom number format at a specific cell).
  1113	        for uf in &report.unsupported {
  1114	            self.events.push(Event::CellDiagnostic {
  1115	                diagnostic: Diagnostic {
  1116	                    addr: None,
  1117	                    severity: Severity::Warning,
  1118	                    code: "xlsx_unsupported_feature".to_string(),
  1119	                    message: format!("{:?} in {}: {}", uf.kind, uf.part, uf.detail),
  1120	                },
  1121	            });
  1122	        }
  1123	        for w in &report.warnings {
  1124	            self.events.push(Event::CellDiagnostic {
  1125	                diagnostic: Diagnostic {
  1126	                    addr: None,
  1127	                    severity: Severity::Warning,
  1128	                    code: "xlsx_import_warning".to_string(),
  1129	                    message: format!("{}: {}", w.location, w.message),
  1130	                },
  1131	            });
  1132	        }
  1133	        for f in &report.formula_failures {
  1134	            self.events.push(Event::CellDiagnostic {
  1135	                diagnostic: Diagnostic {
  1136	                    addr: Some(CellAddr {
  1137	                        sheet: f.sheet,
  1138	                        row: f.row,
  1139	                        col: f.col,
  1140	                    }),
  1141	                    severity: Severity::Warning,
  1142	                    code: "xlsx_formula_recompute_failed".to_string(),
  1143	                    message: format!("formula {:?}: {}", f.formula, f.reason),
  1144	                },
  1145	            });
