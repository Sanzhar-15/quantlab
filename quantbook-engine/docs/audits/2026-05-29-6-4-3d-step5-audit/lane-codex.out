   130	/// A managed Python worker process implementing [`UdfWorker`].
   131	pub struct ProcessWorker {
   132	    config: PythonWorkerConfig,
   133	    proc: Option<WorkerProcess>,
   134	    next_call_id: u64,
   135	}
   136	
   137	impl ProcessWorker {
   138	    /// Create a worker handle. The process is spawned lazily on the first
   139	    /// [`UdfWorker::call`] (or via [`ProcessWorker::ensure_started`]).
   140	    pub fn new(config: PythonWorkerConfig) -> Self {
   141	        Self {
   142	            config,
   143	            proc: None,
   144	            next_call_id: 1,
   145	        }
   146	    }
   147	
   148	    /// The live worker's OS pid, if spawned.
   149	    pub fn pid(&self) -> Option<u32> {
   150	        self.proc.as_ref().map(|p| p.pid)
   151	    }
   152	
   153	    /// Eagerly spawn + handshake (otherwise the first `call()` does it lazily). Uses the
   154	    /// full configured `handshake_timeout` (no per-call deadline applies to eager startup).
   155	    pub fn ensure_started(&mut self) -> Result<(), UdfError> {
   156	        if self.proc.is_none() {
   157	            self.proc = Some(self.spawn(self.config.handshake_timeout)?);
   158	        }
   159	        Ok(())
   160	    }
   161	
   162	    /// Kill + reap the worker and mark dead so the next call re-spawns.
   163	    pub fn shutdown(&mut self) {
   164	        self.proc = None; // `WorkerProcess::drop` kills + reaps.
   165	    }
   166	
   167	    /// Spawn + handshake. `handshake_timeout` bounds the wait for `HELLO_ACK` (the caller
   168	    /// passes either the full configured timeout for eager startup, or — from `call()` — the
   169	    /// remaining per-call deadline budget, capped by the configured timeout).
   170	    fn spawn(&self, handshake_timeout: Duration) -> Result<WorkerProcess, UdfError> {
   171	        let mut cmd = Command::new(&self.config.python);
   172	        cmd.arg("-m")
   173	            .arg(&self.config.module)
   174	            .stdin(Stdio::piped())
   175	            .stdout(Stdio::piped())
   176	            .stderr(Stdio::inherit()); // worker stderr (stray prints / tracebacks) → our stderr
   177	
   178	        // PYTHONPATH = configured dirs ++ inherited (so site-packages stays reachable
   179	        // via the normal interpreter config; pyarrow lives there).
   180	        let mut paths = self.config.pythonpath.clone();
   181	        if let Some(existing) = std::env::var_os("PYTHONPATH") {
   182	            paths.extend(std::env::split_paths(&existing));
   183	        }
   184	        if !paths.is_empty() {
   185	            let joined = std::env::join_paths(paths)
   186	                .map_err(|e| UdfError::WorkerDied(format!("invalid PYTHONPATH: {e}")))?;
   187	            cmd.env("PYTHONPATH", joined);
   188	        }
