   891	        // `default_registry()`. `rematerialize` runs on every undo/redo; the
   892	        // 6.4-0 H2 audit-fix closed the parallel `recompute_all` site but
   893	        // missed this one and `from_workbook` — both surfaced by the 6.4-1
   894	        // cycle-2 Opus lane. Behavior-preserving today; prevents future
   895	        // silent divergence once 6.4-2 wires `register_function`.
   896	        self.graph =
   897	            CalcgraphSession::rebuild_from_workbook_with_registry(&self.workbook, &self.registry)
   898	                .session;
   899	        // Recompute computed values with the op-log detached (no spurious ops /
   900	        // no UndoManager commit). The result's failures become diagnostics.
   901	        let result = self.with_runtime_no_oplog(|rt| rt.recompute_all());
   902	        for failure in &result.failures {
   903	            self.events.push(Event::CellDiagnostic {
   904	                diagnostic: Diagnostic {
   905	                    addr: Some(CellAddr {
   906	                        sheet: failure.sheet,
   907	                        row: failure.row,
   908	                        col: failure.col,
   909	                    }),
   910	                    severity: Severity::Error,
   911	                    code: "formula_recompute_failed".to_string(),
   912	                    message: failure.error.to_string(),
   913	                },
   914	            });
   915	        }
   916	        // The wholesale rebuild cannot be conveyed incrementally → force a full
   917	        // rebuild for any outstanding token (and advance the state token).
   918	        self.bump_epoch();
