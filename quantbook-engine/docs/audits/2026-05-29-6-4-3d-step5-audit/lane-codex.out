     6	/**
     7	 * Phase 5.7 V1 (2026-05-22) -- thin TypeScript wrapper over the napi
     8	 * `CollabSession` class.
     9	 *
    10	 * The wrapper exists so:
    11	 * 1. Consumer code imports a STABLE TS-side identifier
    12	 *    (`QuantbookSession`) instead of reaching into a dynamically-loaded
    13	 *    module. The loader is hot-pathed once at startup; the wrapper
    14	 *    holds the resolved native class.
    15	 * 2. We can attach JSDoc + IDE-side validation that the napi layer
    16	 *    doesn't (e.g., reject negative `sheet` integers before the BigInt
    17	 *    boundary makes the error less actionable).
    18	 * 3. V2 / V3 can grow the wrapper without changing the napi surface
    19	 *    (e.g., add async retry wrappers around `mergeBytes`).
    20	 *
    21	 * **Per V1 scope:** no Transport, no presence, no undo, no formula
    22	 * support. See engine repo's `docs/phase5/5-7-v1-exit-packet.md`
    23	 * section "V1 deferred to V2" for the full V1 deferred list
    24	 * (engine + IDE).
    25	 */
    26	
    27	import { loadQuantbookEngine } from './loader';
    28	import type {
    29		AutoFlushPolicy,
    30		CollabSessionInstance,
    31		LoopbackPairInstance,
    32		PresenceStateJson,
    33		QuantbookCellSnapshot,
    34		QuantbookErrorCode,
    35		QuantbookErrorInfo,
    36		SessionInstance,
    37		TransportInstance,
    38		WorkbookSnapshotDeltaJson,
    39		WorkbookSnapshotJson,
    40	} from './types';
    41	
    42	/**
    43	 * Construct a fresh `CollabSession` for the given peer.
    44	 *
    45	 * @param peerId Non-zero u64-domain peer identifier. Throws if `0n`,
    46	 *               negative, or doesn't fit in u64.
    47	 */
    48	export function createSession(peerId: bigint): CollabSessionInstance {
    49		const engine = loadQuantbookEngine();
    50		return new engine.CollabSession(peerId);
    51	}
    52	
    53	/**
    54	 * **Phase 6.1B inc.2d (2026-05-28) -- typed factory for the owning
    55	 * `WorkbookSession`.**
    56	 *
    57	 * Constructs a fresh `Session` (the product-neutral, single-writer engine
    58	 * session, distinct from the collab `CollabSession`). Single-line indirection
    59	 * matching {@link createSession} so consumers hold a stable IDE-side identifier
    60	 * over the dynamically-loaded native class. No peer id: the owning session is
    61	 * not a CRDT peer.
    62	 */
    63	export function createWorkbookSession(): SessionInstance {
    64		const engine = loadQuantbookEngine();
    65		return new engine.Session();
    66	}
    67	
    68	/**
    69	 * Append a `PutValue` op with JS-side input validation that the napi
    70	 * layer cannot perform (due to ECMAScript ToUint32 coercion happening
    71	 * BEFORE the Rust code sees the value).
    72	 *
    73	 * **V1 audit closure (Opus H2 + Codex H3, 2026-05-22)**: napi-rs's
    74	 * `napi_get_value_uint32` applies ECMAScript ToUint32 to JS Number
    75	 * arguments. That converts:
    76	 *   - `-1` to `0xFFFFFFFF` (silent wrap)
    77	 *   - `NaN` to `0` (silent coercion)
    78	 *   - `Infinity` to `0` (silent coercion)
    79	 *   - `2.5` to `2` (silent floor-toward-zero)
    80	 *
    81	 * The Rust binding sees the post-ToUint32 value and has no way to
    82	 * detect the original JS-side intent. Validate at the TS layer
    83	 * BEFORE the call so each failure surfaces a precise error.
    84	 *
    85	 * @throws Error if sheet/row/col aren't non-negative integers in range,
    86	 *               or if value isn't a finite number.
    87	 */
    88	export function appendPutValueValidated(
    89		session: CollabSessionInstance,
    90		sheet: number,
    91		row: number,
    92		col: number,
    93		value: number,
    94	): void {
    95		// V3.2.d HIGH-2 closure (2026-05-22): all IDE-side validator
    96		// throws carry the `[bad_argument]` bracketed prefix so
    97		// `parseQuantbookError(err).code` resolves to `'bad_argument'` --
    98		// matching the engine-side validator contract from V2.7.
    99		// Pre-V3.2.d these threw plain `Error` strings without the prefix,
   100		// which `parseQuantbookError` bucketed under `'unknown'`,
   101		// breaking webview consumers that switch on the code to
   102		// differentiate bad-input from generic errors.
   103		if (!Number.isInteger(sheet) || sheet < 0 || sheet > 0xFFFF) {
   104			throw new Error(`[bad_argument] appendPutValue: sheet must be an integer in [0, 65535], got ${sheet}`);
   105		}
   106		if (!Number.isInteger(row) || row < 0 || row > 0xFFFFFFFF) {
   107			throw new Error(`[bad_argument] appendPutValue: row must be an integer in [0, 4294967295], got ${row}`);
   108		}
   109		if (!Number.isInteger(col) || col < 0 || col > 0xFFFFFFFF) {
   110			throw new Error(`[bad_argument] appendPutValue: col must be an integer in [0, 4294967295], got ${col}`);
   111		}
   112		if (typeof value !== 'number' || !Number.isFinite(value)) {
   113			throw new Error(`[bad_argument] appendPutValue: value must be a finite number, got ${value}`);
   114		}
   115		session.appendPutValue(sheet, row, col, value);
   116	}
   117	
   118	/**
   119	 * **Phase 5.7 V3.6.0.6 D5 (2026-05-24)** -- typed wrapper for
   120	 * `CollabSession.appendPutFormula` with JS-side validation.
   121	 *
   122	 * Mirrors {@link appendPutValueValidated}'s discipline (validate
   123	 * sheet/row/col BEFORE the napi boundary so `parseQuantbookError(err)
   124	 * .code` surfaces `bad_argument` consistently; ToUint32 coercion at
   125	 * the FFI layer would silently wrap negative/non-integer values
   126	 * otherwise).
   127	 *
   128	 * **No `text` validation here**: any string is a valid formula at
   129	 * the wire level.  Engine-side evaluation surfaces parse errors via
   130	 * `Workbook::formula_at` / `recompute_all` -- the IDE renders those
   131	 * as `#NAME?` / `#REF!` / etc. in cell snapshots, NOT as
   132	 * `[bad_argument]` throws on append.  This matches `appendPutValue`'s
   133	 * "value-must-be-finite" pattern: the wire accepts any finite
   134	 * number; the IDE pre-rejects only what the wire layer can't.
   135	 *
   136	 * @throws Error with `parseQuantbookError(err).code === 'bad_argument'`
   137	 *         if sheet/row/col are out of range or non-integer.
   138	 */
   139	export function appendPutFormulaValidated(
   140		session: CollabSessionInstance,
   141		sheet: number,
   142		row: number,
   143		col: number,
   144		text: string,
   145	): void {
   146		if (!Number.isInteger(sheet) || sheet < 0 || sheet > 0xFFFF) {
   147			throw new Error(`[bad_argument] appendPutFormula: sheet must be an integer in [0, 65535], got ${sheet}`);
   148		}
   149		if (!Number.isInteger(row) || row < 0 || row > 0xFFFFFFFF) {
   150			throw new Error(`[bad_argument] appendPutFormula: row must be an integer in [0, 4294967295], got ${row}`);
   151		}
   152		if (!Number.isInteger(col) || col < 0 || col > 0xFFFFFFFF) {
   153			throw new Error(`[bad_argument] appendPutFormula: col must be an integer in [0, 4294967295], got ${col}`);
   154		}
   155		if (typeof text !== 'string') {
   156			throw new Error(`[bad_argument] appendPutFormula: text must be a string, got ${typeof text}`);
   157		}
   158		session.appendPutFormula(sheet, row, col, text);
   159	}
