  1230	        // recompute honestly (rematerialize's replayed cells have no saved value
  1231	        // → preserving would write Blank, a silent wrong result).
  1232	        let result = self.with_runtime_no_oplog(|rt| rt.recompute_all_preserving_saved_udf());
  1233	        for failure in &result.failures {
  1234	            self.events.push(Event::CellDiagnostic {
  1235	                diagnostic: Diagnostic {
  1236	                    addr: Some(CellAddr {
  1237	                        sheet: failure.sheet,
  1238	                        row: failure.row,
  1239	                        col: failure.col,
  1240	                    }),
  1241	                    severity: Severity::Error,
  1242	                    code: "formula_recompute_failed".to_string(),
  1243	                    message: failure.error.to_string(),
  1244	                },
  1245	            });
  1440	            other => Err(EngineError::bad_argument(format!(
  1441	                "unsupported export format {other:?} (v1 supports \"csv\"{})",
  1442	                if cfg!(feature = "xlsx-write") {
  1443	                    " and \"xlsx\""
  1444	                } else {
  1445	                    ""
  1446	                }
  1447	            ))),
  1448	        }
  1449	    }
