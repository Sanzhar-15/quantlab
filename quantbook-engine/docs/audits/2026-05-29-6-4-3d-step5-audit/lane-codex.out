   239	
   240	    fn handshake(&self, wp: &mut WorkerProcess, timeout: Duration) -> Result<(), UdfError> {
   241	        let hello = Frame::new(FrameType::Hello, encode_hello(self.config.protocol_version));
   242	        write_frame(&mut wp.stdin, &hello)
   243	            .map_err(|e| UdfError::WorkerDied(format!("write HELLO: {e}")))?;
   244	        // (write_frame writes the whole frame; ChildStdin is unbuffered, no flush needed,
   245	        // but flushing is harmless and explicit.)
   246	        use std::io::Write;
   247	        wp.stdin
   248	            .flush()
   249	            .map_err(|e| UdfError::WorkerDied(format!("flush HELLO: {e}")))?;
   250	
   251	        match wp.rx.recv_timeout(timeout) {
   252	            Ok(ReaderMsg::Frame(f)) => {
   253	                if f.frame_type != FrameType::HelloAck {
   254	                    return Err(UdfError::Protocol(format!(
   255	                        "expected HELLO_ACK, got {:?}",
   256	                        f.frame_type
   257	                    )));
   258	                }
   259	                let ack = decode_hello_ack(&f.payload)?;
   260	                if ack.protocol_version != self.config.protocol_version {
   261	                    return Err(UdfError::Handshake {
   262	                        expected: self.config.protocol_version,
   263	                        got: ack.protocol_version,
   264	                    });
   265	                }
   266	                Ok(())
   267	            }
   268	            Ok(ReaderMsg::Error(e)) => {
   269	                Err(UdfError::WorkerDied(format!("reader during handshake: {e}")))
   270	            }
   271	            Err(RecvTimeoutError::Timeout) => {
   272	                Err(UdfError::WorkerDied("handshake timed out (no HELLO_ACK)".to_string()))
   273	            }
   274	            Err(RecvTimeoutError::Disconnected) => {
   275	                Err(UdfError::WorkerDied("worker exited before handshake".to_string()))
   276	            }
   277	        }
   278	    }
   279	
   280	    fn kill_worker(&mut self) {
   281	        // Dropping the `WorkerProcess` kills + reaps the child and winds down the
   282	        // reader thread; setting `None` marks dead so the next call re-spawns.
   283	        self.proc = None;
   284	    }
   285	}
   285	}
   286	
   287	impl UdfWorker for ProcessWorker {
   288	    fn call(
   289	        &mut self,
   290	        handle: u64,
   291	        args: &ArrayValue,
   292	        deadline: Duration,
   293	    ) -> Result<ArrayValue, UdfError> {
   294	        // Absolute deadline for the WHOLE call — covers (re)spawn + handshake + CALL write +
   295	        // the RETURN/RAISE wait (6.4-3b audit-fix: call-deadline-excludes-respawn-handshake-and-write).
   296	        let deadline_at = Instant::now() + deadline;
   297	        let call_id = self.next_call_id;
   298	        self.next_call_id = self.next_call_id.wrapping_add(1);
   299	
   300	        // (Re)spawn if dead, bounding the handshake by the REMAINING call budget (capped by the
   301	        // configured `handshake_timeout`) so a respawn can't blow the caller's deadline. A
   302	        // spawn/handshake failure is the caller's error.
   303	        if self.proc.is_none() {
   304	            let remaining = deadline_at.saturating_duration_since(Instant::now());
   305	            let hs_timeout = self.config.handshake_timeout.min(remaining);
   306	            self.proc = Some(self.spawn(hs_timeout)?);
   307	        }
   308	
   309	        // Encode + send the CALL.
   310	        let payload = encode_call(&CallPayload {
   311	            handle,
   312	            call_id,
   313	            args: args.clone(),
   314	        })?;
   315	        let frame = Frame::new(FrameType::Call, payload);
   316	        let write_res: Result<(), FrameError> = {
   317	            let wp = self.proc.as_mut().expect("spawned above");
   318	            use std::io::Write;
   319	            write_frame(&mut wp.stdin, &frame).and_then(|()| wp.stdin.flush().map_err(FrameError::from))
   320	        };
   321	        if let Err(e) = write_res {
   322	            self.kill_worker();
   323	            return Err(UdfError::WorkerDied(format!("write CALL: {e}")));
   324	        }
   325	
   326	        // Await the correlated RETURN/RAISE, honoring the absolute deadline.
   327	        loop {
   328	            // Deadline guard FIRST: a worker that floods `LOG` / stale-`call_id` frames keeps
   329	            // `recv_timeout` returning a ready frame regardless of `remaining`, which would
   330	            // otherwise let it defeat the deadline indefinitely (6.4-3b audit-fix:
   331	            // frame-flood-defeats-timeout / contract §10.4 exit test 6). Check the clock before
   332	            // each recv so a continuous nonterminal-frame stream still hard-cancels on time.
   333	            if Instant::now() >= deadline_at {
   334	                self.kill_worker();
   335	                return Err(UdfError::Timeout(deadline));
   336	            }
   337	            let remaining = deadline_at.saturating_duration_since(Instant::now());
   338	            let msg = {
   339	                let wp = self.proc.as_mut().expect("spawned above");
   340	                wp.rx.recv_timeout(remaining)
   341	            };
   342	            match msg {
   343	                Ok(ReaderMsg::Frame(f)) => match f.frame_type {
   344	                    FrameType::Return => {
   345	                        let ret = decode_return(&f.payload)?;
   346	                        if ret.call_id != call_id {
   347	                            continue; // stale response from a prior call — skip
   348	                        }
   349	                        return Ok(ret.result);
   350	                    }
   351	                    FrameType::Raise => {
   352	                        let r = decode_raise(&f.payload)?;
   353	                        if r.call_id != call_id {
   354	                            continue;
   355	                        }
   356	                        return Err(UdfError::Raised {
   357	                            exc_type: r.exc_type,
   358	                            message: r.message,
   359	                        });
   360	                    }
   361	                    FrameType::Log => {
   362	                        let log = decode_log(&f.payload)?;
   363	                        // Surfaced visibly (NOT silently dropped). 6.4-3c routes worker
   364	                        // logs to `CellDiagnostic`s; until then they go to stderr.
   365	                        eprintln!(
   366	                            "[quantbook-udf worker log lvl={}] {}",
   367	                            log.level, log.message
   368	                        );
   369	                        continue;
   370	                    }
   371	                    other => {
   372	                        self.kill_worker();
   373	                        return Err(UdfError::Protocol(format!(
   374	                            "unexpected {other:?} frame while awaiting RETURN/RAISE for call_id {call_id}"
   375	                        )));
   376	                    }
   377	                },
   378	                Ok(ReaderMsg::Error(e)) => {
   379	                    self.kill_worker();
   380	                    return Err(UdfError::WorkerDied(format!("reader: {e}")));
   381	                }
   382	                Err(RecvTimeoutError::Timeout) => {
   383	                    // Hard cancel: kill the worker so a late RETURN is dropped (exit test 6).
   384	                    self.kill_worker();
   385	                    return Err(UdfError::Timeout(deadline));
   386	                }
   387	                Err(RecvTimeoutError::Disconnected) => {
   388	                    self.kill_worker();
   389	                    return Err(UdfError::WorkerDied("worker exited mid-call".to_string()));
   390	                }
   391	            }
   392	        }
   393	    }
   394	}
