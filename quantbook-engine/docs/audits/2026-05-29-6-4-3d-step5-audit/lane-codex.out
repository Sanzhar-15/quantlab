   940	
   941	    /// Build a full `SheetSnapshot` for one live sheet (shared by `snapshot` and
   942	    /// `snapshot_delta`'s `sheets_changed`). `None` if the sheet is gone.
   943	    fn build_sheet_snapshot(&self, sheet_id: SheetId) -> Option<SheetSnapshot> {
   944	        let name = self.workbook.sheet(sheet_id)?.name().to_string();
   945	        let mut cells = Vec::new();
   946	        for (row, col) in self.populated_coords(sheet_id) {
   947	            if let Some(cell) = self.build_cell_snapshot(sheet_id, row, col) {
   948	                cells.push(cell);
   949	            }
   950	        }
   951	        Some(SheetSnapshot {
   952	            id: sheet_id,
   953	            name,
   954	            cells,
   955	        })
   956	    }
   957	
   958	    /// Run a recompute closure under the `Busy` plus operation-registry model
   959	    /// (§6.4). In v1 the in-engine recompute is synchronous and runs to
   960	    /// completion within this call (it is the common fast path); the registry
   961	    /// and the `Busy` state are the shape the out-of-process UDF/SQL/AI paths
   962	    /// (6.4/6.5) reuse for honest hard-cancel. Structural failures surface as
   963	    /// `CellDiagnostic` events (never silently dropped).
   964	    fn run_recalc(
   965	        &mut self,
   966	        f: impl FnOnce(&mut WorkbookRuntime<'_>) -> Option<crate::RecomputeResult>,
   967	    ) -> OperationId {
   968	        let op = self.next_op();
   969	        self.ops.insert(op, OperationState::Running);
   970	        self.state = LifecycleState::Busy;
