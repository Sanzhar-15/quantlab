   319	impl WorkbookSession {
   320	    /// Construct a fresh, empty in-memory session (→ `Ready`). The `new(options)`
   321	    /// product command (§3.1).
   322	    pub fn new() -> Self {
   323	        Self::from_workbook(Workbook::new())
   324	    }
   325	
   326	    /// Wrap an existing `Workbook` (e.g. a hand-built test workbook; later the
   327	    /// product of `open`/`import`) using a CALLER-PROVIDED registry `Arc`.
   328	    /// Rebuilds the calc graph from the workbook's formulas — extracting deps,
   329	    /// arg-context, and volatility against THAT registry — so dependency
   330	    /// tracking is live and consistent with the registry the session will hold.
   331	    ///
   332	    /// **6.4-2 cycle-2 audit-fix (F2 — Codex):** the `open`/`import` adoption
   333	    /// sites need this overload. They previously did
   334	    /// `*self = Self::from_workbook(wb); self.registry = preserved_registry;`
   335	    /// — but `from_workbook` builds the graph against a FRESH `default_registry()`,
   336	    /// so after the post-hoc `self.registry =` swap the graph was extracted
   337	    /// UDF-free while `self.registry` was UDF-aware: a graph⊥registry divergence
   338	    /// the increment introduces once 6.4-2 lets a UDF be registered before an
   339	    /// adoption. (`open` self-healed via its post-swap `recompute_all`, which
   340	    /// rebuilds the graph against `self.registry`; xlsx `import` does NOT
   341	    /// recompute after the swap, so its graph stayed divergent.) Passing the
   342	    /// preserved registry into construction closes the divergence at the source
   343	    /// for ALL adoption sites and removes `open`'s wasteful double graph build.
   344	    /// This is the same divergence class the 6.4-0 H2 + 6.4-1 H1 audit-fixes
   345	    /// closed at `recompute_all` / `rematerialize`; the adoption-site variant
   346	    /// was the gap those sweeps missed.
   347	    pub fn from_workbook_with_registry(
   348	        workbook: Workbook,
   349	        registry: Arc<FunctionRegistry>,
   350	    ) -> Self {
   351	        let graph =
   352	            CalcgraphSession::rebuild_from_workbook_with_registry(&workbook, &registry).session;
   353	        // inc.2c-7: snapshot the construction-time workbook as the undo baseline
   354	        // BEFORE moving `workbook` into the struct (the op-log records only
   355	        // post-construction edits, so `rematerialize` replays onto a clone of
   356	        // this baseline — see the `baseline` field doc). Empty/cheap for `new()`.
   357	        let baseline = workbook.clone();
   358	        let oplog = OpLog::new();
   359	        // inc.2c-6: construct the undo manager AFTER `oplog` so it subscribes to
   360	        // the doc's commit stream and records every subsequent `append`'s commit.
   361	        // `set_merge_interval(0)` disables Loro's time-based commit merging so
   362	        // each commit is its own undo unit (HARD QUESTION 1) — every command
   363	        // already produces exactly one commit, so 1 command == 1 undo unit with
   364	        // no explicit grouping. The manager holds an internal Arc to the doc, so
   365	        // it does not borrow `oplog` and can be moved into the struct below.
   366	        let mut undo_manager = oplog.new_undo_manager();
   367	        undo_manager.set_merge_interval(0);
   368	        Self {
   369	            workbook,
   370	            baseline,
   371	            oplog,
   372	            graph,
   373	            plan_cache: PlanCache::new(),
   374	            registry,
   375	            state: LifecycleState::Ready,
   376	            epoch: mint_epoch(),
   377	            state_seq: 0,
   378	            change_log: VecDeque::new(),
   379	            change_log_floor: 0,
   380	            ops: HashMap::new(),
   381	            next_op_id: 1,
   382	            events: Vec::new(),
   383	            txns: HashMap::new(),
   384	            next_txn_id: 1,
   385	            undo_manager,
   386	            // 6.4-3c: no UDF worker until the host injects one via set_udf_worker.
   387	            udf_worker: None,
   388	            // 6.4-3d (blocker G): empty per-recompute diagnostic collector.
   389	            udf_diagnostics: RefCell::new(Vec::new()),
   390	        }
   391	    }
   392	
   393	    /// Wrap an existing `Workbook` with a FRESH default registry (built-ins
   394	    /// only). The construction-time path for `new()` and hand-built test
   395	    /// workbooks, where no UDFs exist yet. Adoption sites that must preserve a
   396	    /// UDF-aware registry across workbook replacement use
   397	    /// [`Self::from_workbook_with_registry`] instead (6.4-2 cycle-2 audit-fix F2).
   398	    pub fn from_workbook(workbook: Workbook) -> Self {
   399	        Self::from_workbook_with_registry(workbook, Arc::new(ql_functions::default_registry()))
   400	    }
   401	
   402	    /// **6.4-3c (2026-05-29):** install the out-of-process Python-UDF worker
   403	    /// this session dispatches registered UDFs to. Until this is called, a
   404	    /// registered `=MYUDF(A1)` evaluates to `#CALC!` (No-Fallbacks-honest — the
   405	    /// UDF is known to the graph but cannot compute without a worker). Wrapping
   406	    /// in `RefCell` gives the interior mutability the shared-`&` eval stack needs
   407	    /// to reach [`ql_udf::UdfWorker::call`]'s `&mut self`.
   408	    ///
   409	    /// Idempotent-replace: a second call swaps the worker (the prior one is
   410	    /// dropped — its `Drop` kills + reaps the child per 6.4-3b). v1 takes a
   411	    /// `Box<dyn UdfWorker + Send>` directly; the napi/IDE bridge that constructs a
   412	    /// `ProcessWorker` from trusted-workspace config (+ `debugpy`) is 6.4-3d.
   413	    ///
   414	    /// NOTE: this does NOT itself recompute, and it does NOT dirty anything.
   415	    /// A UDF cell evaluated BEFORE the worker was installed is a *clean*
   416	    /// `#CALC!`, so `recalc_dirty` will NOT heal it — callers that want existing
   417	    /// UDF cells to pick up the worker must call `recalc_all` (Codex MED-1 /
   418	    /// Opus LOW-2, 6.4-3c audit). In the intended flow the host injects the
   419	    /// worker BEFORE any UDF formulas are entered, so `set_formula`'s immediate
   420	    /// eval sees it and no heal is needed. Auto-dirtying UDF-using cells on
   421	    /// injection (via the 6.4-0 `functions_used` reverse index) is FILED-FORWARD
   422	    /// for the 6.4-3d host bridge, which owns injection ordering.
   423	    pub fn set_udf_worker(&mut self, worker: Box<dyn UdfWorker + Send>) {
   424	        self.udf_worker = Some(RefCell::new(worker));
   425	    }
   426	
   427	    /// **6.4-3d (audit-fix HIGH-3):** lifecycle-gated worker injection for the
   428	    /// napi/host boundary. `ensure_ready()` first, so a `New`/`Busy`/`Closed`/
   429	    /// `Faulted` session rejects with `[invalid_state]`/`[session_busy]` instead
   430	    /// of silently attaching a live Python child to a terminal session (and the
   431	    /// `close()` worker-drop would then never run for it). The bare
   432	    /// [`set_udf_worker`] stays an infallible field-setter for Rust tests on a
   433	    /// known-`Ready` session.
   434	    ///
   435	    /// The napi `setUdfWorker` spawns + handshakes the worker OUTSIDE the session
   436	    /// lock (a process op), then calls this UNDER the lock — so a session that
   437	    /// transitioned to `Closed` during the spawn is caught HERE and the passed
   438	    /// `worker` is dropped by the caller (its child killed + reaped), closing the
   439	    /// inject-vs-close race.
   440	    ///
   441	    /// [`set_udf_worker`]: WorkbookSession::set_udf_worker
   442	    pub fn set_udf_worker_checked(
   443	        &mut self,
   444	        worker: Box<dyn UdfWorker + Send>,
   445	    ) -> EngineResult<()> {
   446	        self.ensure_ready()?;
   447	        self.udf_worker = Some(RefCell::new(worker));
   448	        Ok(())
   449	    }
   450	
   451	    // --- internal helpers ---
   452	
   453	    /// Run a closure against a per-edit `WorkbookRuntime` that borrows the
   454	    /// session's owned state, recovering the (warmed) plan cache afterwards.
   455	    /// The runtime borrow never escapes this function.
   456	    ///
   457	    /// **Panic safety (F3 / contract §8):** `f` runs the engine kernels, which
   458	    /// contain reachable `.expect`/`panic!` (e.g. the recompute/spill paths). If
   459	    /// `f` unwinds, the plan-cache restore below is skipped (leaving the cache
   460	    /// taken/empty) and the session may be mid-edit. A [`FaultGuard`] marks the
   470	    /// when `#[napi(catch_unwind)]` is set, and the `Session` class does not set
   471	    /// it (tracked 6.1C M1 → 6.3). Unwinding through the generated `extern "C"`
   472	    /// callback aborts. Once 6.3 lands `#[napi(catch_unwind)]` per method, this
   473	    /// in-engine guard becomes the half that ensures even a catch-unwind'd panic
   474	    /// leaves the session sealed (`Faulted`) rather than torn.
   475	    fn with_runtime<R>(&mut self, f: impl FnOnce(&mut WorkbookRuntime<'_>) -> R) -> R {
   476	        let cache = std::mem::take(&mut self.plan_cache);
   477	        // Borrows `self.state`; the runtime below borrows the other (disjoint)
   478	        // fields, so both coexist within this function.
   479	        let mut guard = FaultGuard {
   480	            state: &mut self.state,
   481	            armed: true,
   482	        };
   483	        let mut rt = WorkbookRuntime::with_session_state(
   484	            &mut self.workbook,
   485	            &self.registry,
   486	            &mut self.oplog,
   487	            &mut self.graph,
   488	            cache,
   489	            // 6.4-3c: lend the worker (disjoint field from the &mut borrows above).
   490	            self.udf_worker.as_ref(),
   491	            // 6.4-3d (blocker G): lend the per-recompute diagnostic collector.
   492	            Some(&self.udf_diagnostics),
   493	        );
   494	        let out = f(&mut rt);
   495	        self.plan_cache = rt.into_plan_cache();
   496	        guard.armed = false;
   497	        // 6.4-3d (blocker G): release the runtime + guard borrows, then drain
   498	        // any UDF-dispatch diagnostics into the event stream.
   499	        drop(guard);
   500	        self.drain_udf_diagnostics();
   501	        out
   502	    }
   503	
   504	    /// **6.4-3d (2026-05-29; megaudit blocker G):** drain the per-recompute UDF
   505	    /// diagnostic collector into the event stream as `Event::CellDiagnostic`.
   506	    /// Called by [`with_runtime`]/[`with_runtime_no_oplog`] AFTER the runtime
   507	    /// (and its borrow of `self.udf_diagnostics`) is dropped, so the fresh
   508	    /// `borrow_mut` here cannot overlap the dispatch-site borrows. The cell
   509	    /// VALUE was already written during recompute; this only surfaces WHY a
   510	    /// UDF failed. Severity is always `Error` for these codes.
   511	    ///
   512	    /// [`with_runtime`]: WorkbookSession::with_runtime
   513	    /// [`with_runtime_no_oplog`]: WorkbookSession::with_runtime_no_oplog
   514	    fn drain_udf_diagnostics(&mut self) {
   515	        let diags: Vec<UdfCellDiagnostic> = self.udf_diagnostics.borrow_mut().drain(..).collect();
   516	        for diag in diags {
   517	            self.events.push(Event::CellDiagnostic {
   518	                diagnostic: Diagnostic {
   519	                    addr: Some(diag.addr.into()),
   520	                    severity: Severity::Error,
   521	                    code: diag.code.to_string(),
   522	                    message: diag.message,
   523	                },
   524	            });
   525	        }
   850	    /// recompute computed values, and bump the epoch (inc.2c-6 undo/redo).
   851	    ///
   852	    /// After a Loro `undo()`/`redo()`, the UndoManager retracts (or re-applies)
   853	    /// the commit(s) for the reverted command, so the op-log's visible list
   854	    /// (`OpLog::iter`) now yields the POST-undo op sequence. But the session's
   855	    /// LIVE `workbook` + `graph` still reflect the pre-undo state — Loro reverts
   856	    /// only its own op-list, not our derived workbook/graph (which are NOT Loro
   857	    /// containers). So we re-derive both from the op-log:
