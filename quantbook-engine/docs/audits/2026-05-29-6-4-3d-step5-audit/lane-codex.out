   813	/**
   814	 * Runtime view of {@link KNOWN_QUANTBOOK_ERROR_CODE_RECORD}, derived
   815	 * via `Object.keys`. Used by {@link parseQuantbookError} to validate
   816	 * bracket-prefix codes. The Set is structurally guaranteed to match
   817	 * the record's keys -- no manual sync required.
   818	 */
   819	const KNOWN_QUANTBOOK_ERROR_CODES: ReadonlySet<QuantbookErrorCode> = new Set(
   820		Object.keys(KNOWN_QUANTBOOK_ERROR_CODE_RECORD) as Array<Exclude<QuantbookErrorCode, 'unknown'>>,
   821	);
   822	
   823	/**
   824	 * Bracket-prefix regex: `[<code>] <message>` where `<code>` starts
   825	 * with a lowercase letter and is composed of lowercase alphabetics,
   826	 * digits, and underscores. Matches the napi binding's
   827	 * `[{kind}] {Display}` convention from
   828	 * `crates/ql-bindings-node/src/lib.rs::{collab_session,transport,websocket}_error_to_napi`.
   829	 *
   830	 * **V2.7 audit closure (Opus LOW-1, 2026-05-22)**: extended
   831	 * character class to `[a-z0-9_]*` (was `[a-z_]*`) for future-proofing.
   832	 * Today's kinds use only letters + underscores, but a future variant
   833	 * like `transport_io_v2` would have parsed already (alpha + _); the
   834	 * extension future-proofs digit-bearing variants like `http2_failed`.
   835	 */
   836	const QUANTBOOK_ERROR_PREFIX_RE = /^\[([a-z][a-z0-9_]*)\]\s*(.*)$/s;
   837	
   838	/**
   839	 * Maximum depth for walking `Error.cause` chains in
   840	 * {@link parseQuantbookError}. Defends against pathological
   841	 * self-referencing caches or accidental cycles while still allowing
   842	 * realistic napi wrapper chains (typically 1-3 levels).
   843	 */
   844	const QUANTBOOK_ERROR_CAUSE_MAX_DEPTH = 8;
   845	
   846	/**
   847	 * Extract the structured code + message from a caught error.
   848	 *
   849	 * **Usage**:
   850	 * ```ts
   851	 * try {
   852	 *   session.flushPendingToTransport();
   853	 * } catch (err) {
   854	 *   const info = parseQuantbookError(err);
   855	 *   if (info.code === 'transport_closed') {
   856	 *     // reconnect logic
   857	 *   }
   858	 * }
   859	 * ```
   860	 *
   861	 * **Cause-chain walking (V2.8 megaudit closure -- Opus-B Lane C
   862	 * MEDIUM-4, 2026-05-22)**: when no `[<code>]` prefix is found on
   863	 * the top-level `Error.message`, this function walks the
   864	 * `Error.cause` chain (max depth {@link QUANTBOOK_ERROR_CAUSE_MAX_DEPTH},
   865	 * self-cycle guard) looking for a bracket-prefixed engine error.
   866	 * Required because napi `spawn_blocking` task-panic paths wrap the
   867	 * engine's structured error in a generic Node `Error` whose
   868	 * `.message` has no bracket -- without the cause walk these were
   869	 * silently bucketed under `'unknown'`, defeating the V2.7 closure.
   870	 * The returned `code` reflects the deepest matched engine prefix;
   871	 * `cause` always points at the original top-level throwable so
   872	 * callers can still log the full wrapper context.
   873	 *
   874	 * **Returns**: a `QuantbookErrorInfo` with `code = 'unknown'` if:
   875	 * - the value is not an `Error` instance (e.g., a `throw 'string'`
   876	 *   from non-engine code; **the structured discriminant is lost**
   877	 *   in this case -- callers handling external code paths should
   878	 *   wrap their throws in an `Error` to preserve the discriminant),
   879	 * - no `Error` in the cause chain has a `[<code>] ` prefix, OR
   880	 * - a prefix is found but its code is not a recognized
   881	 *   `QuantbookErrorCode` (which means the IDE binding is older than
   882	 *   the engine; a build refresh is in order).
   883	 *
   884	 * For the unrecognized-prefix case (binding drift), the `message`
   885	 * field preserves the FULL original top-level `Error.message`
   886	 * including the bracket prefix, so callers can log it for diagnosis.
   887	 *
   888	 * Closes V2.1 Opus MEDIUM-3 carryforward (lossy Display projection,
   889	 * carried as V2.2 Opus MEDIUM-4 and re-flagged in V2.3), V2.7 Opus
   890	 * LOW-4 (non-Error throwable JSDoc clarity), and V2.8 Opus-B Lane C
   891	 * MEDIUM-4 (Error.cause chain walking for napi wrapper paths).
   892	 */
   893	export function parseQuantbookError(err: unknown): QuantbookErrorInfo {
   894		if (!(err instanceof Error)) {
   895			return {
   896				code: 'unknown',
   897				message: typeof err === 'string' ? err : String(err),
   898				cause: err,
   899			};
   900		}
   901		// Walk Error.cause looking for the first bracket-prefixed engine
   902		// error message. Self-cycle guard via Set of visited Errors.
   903		const visited = new Set<Error>();
   904		let current: unknown = err;
   905		let depth = 0;
   906		while (current instanceof Error && depth < QUANTBOOK_ERROR_CAUSE_MAX_DEPTH) {
   907			if (visited.has(current)) {
   908				break;
   909			}
   910			visited.add(current);
   911			const match = QUANTBOOK_ERROR_PREFIX_RE.exec(current.message);
   912			if (match) {
   913				const rawCode = match[1];
   914				const rest = match[2];
   915				if (KNOWN_QUANTBOOK_ERROR_CODES.has(rawCode as QuantbookErrorCode)) {
   916					return { code: rawCode as QuantbookErrorCode, message: rest, cause: err };
   917				}
   918				// Unknown code prefix: preserve the original top-level
   919				// message (so the user sees the literal prefix) and
   920				// signal 'unknown'. Caller can escalate this as a
   921				// binding-drift signal.
   922				return { code: 'unknown', message: err.message, cause: err };
   923			}
   924			current = (current as { cause?: unknown }).cause;
   925			depth += 1;
   926		}
   927		// No bracket prefix anywhere in the chain → genuinely unknown.
   928		return { code: 'unknown', message: err.message, cause: err };
   929	}
   930	
   931	/**
   932	 * Set including the `'unknown'` fallback sentinel; used by the
   933	 * `isQuantbookErrorCode` type guard. Distinct from
   934	 * `KNOWN_QUANTBOOK_ERROR_CODES` (parser-only, no `'unknown'`)
   935	 * per the V2.7 audit closure (Opus MEDIUM-1): the parser must
   936	 * NOT treat literal `[unknown]` prefixes as recognized codes,
   937	 * but the type guard SHOULD accept `'unknown'` because the parser
   938	 * returns it on fallback.
   939	 */
   940	const ALL_QUANTBOOK_ERROR_CODES: ReadonlySet<QuantbookErrorCode> = new Set<QuantbookErrorCode>([
   941		...KNOWN_QUANTBOOK_ERROR_CODES,
   942		'unknown',
   943	]);
   944	
   945	/**
   946	 * Type guard for `QuantbookErrorCode`. Mirrors `isAutoFlushPolicy`'s
   947	 * defensive shape -- use when reading codes from external config or
   948	 * persisted error logs.
   949	 *
   950	 * Accepts ALL `QuantbookErrorCode` values including `'unknown'`
   951	 * (the parser fallback). See `ALL_QUANTBOOK_ERROR_CODES` vs
   952	 * `KNOWN_QUANTBOOK_ERROR_CODES` for the role split.
   953	 */
   954	export function isQuantbookErrorCode(value: unknown): value is QuantbookErrorCode {
   955		return typeof value === 'string' && ALL_QUANTBOOK_ERROR_CODES.has(value as QuantbookErrorCode);
   956	}

