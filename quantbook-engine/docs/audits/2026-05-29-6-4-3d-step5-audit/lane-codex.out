     1	//! Structured error taxonomy (contract §5 + Appendix A; acceptance API6-03).
     2	//!
     3	//! Replaces the per-binding `[<kind>]`-prefix-on-Display workaround
     4	//! (`crates/ql-bindings-node/src/lib.rs:306-349`, forced because napi-rs's
     5	//! `Error` `Status` is an enum with no custom string code). Here the `code` is
     6	//! carried as **data**, mapped once, consumed by every binding.
     7	
     8	use std::collections::BTreeMap;
     9	use std::fmt;
    10	
    11	use serde::{Deserialize, Serialize};
    12	
    13	/// Coarse source category for an [`EngineError`]. Bindings map these to
    14	/// JS/Python/C/HTTP/gRPC error shapes; tooling branches on `code`, humans read
    15	/// `message` (contract §5.2).
    16	#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
    17	#[serde(rename_all = "snake_case")]
    18	pub enum ErrorClass {
    19	    /// FFI-boundary validation failure (NaN/Inf/oversize/coercion).
    20	    BadArgument,
    21	    /// Illegal command for the current lifecycle state (incl. `session_busy`,
    22	    /// `invalid_state`).
    23	    Lifecycle,
    24	    /// Sheet / cell / name / function / format absent.
    25	    NotFound,
    26	    /// Op/structure conflict (duplicate name, out-of-range move, etc.).
    27	    Conflict,
    28	    /// Formula/eval error surfaced as an op failure (a formula that *evaluates*
    29	    /// to an error is a [`crate::dto::CellValue::Error`], NOT an `EngineError`;
    30	    /// contract §5.5).
    31	    Compute,
    32	    /// Save / load / `.qbook` I/O.
    33	    Persistence,
    34	    /// DTO / version / decoding mismatch (incl. `invalid_version_token`,
    35	    /// `unsupported_schema_version`).
    36	    Protocol,
    37	    /// Operation canceled or deadline exceeded.
    38	    Canceled,
    39	    /// Feature not available (collab disabled, `AINotAvailable`, …).
    40	    Capability,
    41	    /// Bug / invariant violation (panic boundary). Never a swallowed fallback.
    42	    Internal,
    43	}
    44	
    45	/// The structured engine error crossing the contract boundary (contract §5.1).
    46	///
    47	/// `code` strings are **stable across releases** (public contract). Adding a
    48	/// code is backward-compatible; renaming/removing one is breaking and bumps
    49	/// [`crate::SCHEMA_VERSION`]. No catch-all "unknown" code may leak to a caller —
    50	/// an unmapped engine variant is an [`ErrorClass::Internal`] bug to fix (§5.3).
    51	// NOTE: not `Eq` — `details` holds `serde_json::Value`, which is `PartialEq` but
    52	// not `Eq` (it can contain floats).
    53	#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
    54	pub struct EngineError {
    55	    /// Stable, machine-matchable code (e.g. `"bad_argument"`, `"sheet_not_found"`).
    56	    pub code: String,
    57	    /// Coarse source category.
    58	    pub class: ErrorClass,
    59	    /// Human-readable message (the prior Display string is preserved here).
    60	    pub message: String,
    61	    /// Structured context (failing op index, address, limit, …).
    62	    #[serde(default, skip_serializing_if = "BTreeMap::is_empty")]
    63	    pub details: BTreeMap<String, serde_json::Value>,
    64	    /// Whether a naive retry is meaningful.
    65	    pub retryable: bool,
    66	    /// Optional upstream cause chain (debug).
    67	    #[serde(default, skip_serializing_if = "Option::is_none")]
    68	    pub source: Option<String>,
    69	}
    70	
    71	impl EngineError {
    72	    /// Construct a minimal error (no details, not retryable, no source).
    73	    pub fn new(class: ErrorClass, code: impl Into<String>, message: impl Into<String>) -> Self {
    74	        Self {
    75	            code: code.into(),
    76	            class,
    77	            message: message.into(),
    78	            details: BTreeMap::new(),
    79	            retryable: false,
    80	            source: None,
    81	        }
    82	    }
    83	
    84	    /// Builder: attach a structured detail key.
    85	    #[must_use]
    86	    pub fn with_detail(mut self, key: impl Into<String>, value: serde_json::Value) -> Self {
    87	        self.details.insert(key.into(), value);
    88	        self
    89	    }
    90	
    91	    /// Builder: mark retryable.
    92	    #[must_use]
    93	    pub fn retryable(mut self) -> Self {
    94	        self.retryable = true;
    95	        self
    96	    }
    97	
    98	    /// Builder: attach an upstream cause string.
    99	    #[must_use]
   100	    pub fn with_source(mut self, source: impl Into<String>) -> Self {
   101	        self.source = Some(source.into());
   102	        self
   103	    }
   104	
   105	    // --- Common constructors (codes are part of the stable contract) ---
   106	
   107	    /// FFI-boundary validation failure.
   108	    pub fn bad_argument(message: impl Into<String>) -> Self {
   109	        Self::new(ErrorClass::BadArgument, "bad_argument", message)
   110	    }
   111	
   112	    /// Command issued in an illegal lifecycle state.
   113	    pub fn invalid_state(message: impl Into<String>) -> Self {
   114	        Self::new(ErrorClass::Lifecycle, "invalid_state", message)
   115	    }
   116	
   117	    /// Mutating/recalc command issued while a long operation owns engine state.
   118	    pub fn session_busy(message: impl Into<String>) -> Self {
   119	        Self::new(ErrorClass::Lifecycle, "session_busy", message)
   120	    }
   121	
   122	    /// A version token failed to decode / used an unsupported schema
   123	    /// (contract §4.3 / MED-2 — fail-loud, never a silent resync).
   124	    pub fn invalid_version_token(message: impl Into<String>) -> Self {
   125	        Self::new(ErrorClass::Protocol, "invalid_version_token", message)
   126	    }
   127	
   128	    /// A DTO carried an unknown schema version (contract §4.1).
   129	    pub fn unsupported_schema_version(message: impl Into<String>) -> Self {
   130	        Self::new(ErrorClass::Protocol, "unsupported_schema_version", message)
   131	    }
   132	
   133	    /// Operation canceled (cooperative or pre-start).
   134	    pub fn canceled(message: impl Into<String>) -> Self {
   135	        Self::new(ErrorClass::Canceled, "canceled", message).retryable()
   136	    }
   137	
   138	    /// A panic was caught at the FFI boundary (contract §8).
   139	    pub fn panic(message: impl Into<String>) -> Self {
   140	        Self::new(ErrorClass::Internal, "panic", message)
   141	    }
   142	}
   143	
