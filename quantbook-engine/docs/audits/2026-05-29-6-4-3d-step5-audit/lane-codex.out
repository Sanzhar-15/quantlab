    29	const TRUST_SCHEMA_VERSION = 1;
    30	
    31	/**
    32	 * Get per-workspace trust store key (NEW-SEC-003).
    33	 *
    34	 * Each workspace gets its own trust store to prevent a malicious
    35	 * workspace from inheriting trust granted to a legitimate one.
    36	 */
    37	function getTrustStoreKey(): string {
    38		const workspaceFolders = vscode.workspace.workspaceFolders;
    39		if (workspaceFolders && workspaceFolders.length > 0) {
    40			const workspaceId = crypto.createHash('sha256')
    41				.update(workspaceFolders[0].uri.toString())
    42				.digest('hex')
    43				.substring(0, 16);
    44			return `quantlab.trustStore.${workspaceId}`;
    45		}
    46		return 'quantlab.trustStore.global';
    47	}
    48	
    49	/**
    50	 * Manages trust for workspaces and strategies.
    51	 *
    52	 * Key safety features:
    53	 * - Workspaces must be explicitly trusted before live trading
    54	 * - Strategies are hashed to detect modifications
    55	 * - Trust can be revoked at any time
    56	 * - Verification required before each live session
    57	 */
    58	export class TrustManager extends (EventEmitter as new () => TypedEmitter<TrustManagerEvents>) {
    59		private static instance: TrustManager | undefined;
    60	
    61		private readonly workspaceTrust: Map<string, WorkspaceTrust> = new Map();
    62		private readonly strategyTrust: Map<string, StrategyTrust> = new Map();
    63		private context: vscode.ExtensionContext | undefined;
    64	
    65		private constructor() {
    66			super();
    67		}
    68	
    69		/**
    70		 * Get singleton instance.
    71		 */
    72		static getInstance(): TrustManager {
    73			if (!TrustManager.instance) {
    74				TrustManager.instance = new TrustManager();
    75			}
    76			return TrustManager.instance;
    77		}
    78	
    79		/**
    80		 * Initialize trust manager with extension context.
    81		 */
    82		async initialize(context: vscode.ExtensionContext): Promise<void> {
    83			this.context = context;
    84			await this.loadTrustStore();
    85	
    86			// Watch for file changes to detect strategy modifications
    87			const watcher = vscode.workspace.createFileSystemWatcher('**/*.py');
    88			watcher.onDidChange(uri => this.onStrategyFileChanged(uri));
    89			watcher.onDidDelete(uri => this.onStrategyFileDeleted(uri));
    90	
    91			context.subscriptions.push(watcher);
    92		}
    93	
    94		// ============================================================
    95		// Workspace Trust
    96		// ============================================================
    97	
    98		/**
    99		 * Check if a workspace is trusted.
   100		 */
   101		isWorkspaceTrusted(workspaceUri: string): boolean {
   102			const normalizedUri = this.normalizeUri(workspaceUri);
   103			const trust = this.workspaceTrust.get(normalizedUri);
   104			return trust?.trusted ?? false;
   105		}
   106	
   107		/**
   108		 * Trust a workspace.
   109		 */
   110		async trustWorkspace(workspaceUri: string): Promise<void> {
   111			const normalizedUri = this.normalizeUri(workspaceUri);
   112			const previousTrust = this.workspaceTrust.get(normalizedUri);
   113	
   114			const trust: WorkspaceTrust = {
   115				workspaceUri: normalizedUri,
   116				trusted: true,
   117				trustedAt: Date.now(),
   118				trustedBy: 'user',
