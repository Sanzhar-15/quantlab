   987				case 'merged':
   988					// **Phase 5.7 V3.5.0.7 (2026-05-24)** -- D5 / R-V3.4-3
   989					// closure: skip the merged-tick render when the local
   990					// user is mid-editing a cell.  Without this skip, the
   991					// `this.render()` call below would reassign
   992					// `this.panel.webview.html`, destroying the in-progress
   993					// `<input>` element (the cell editor).  The merged op
   994					// stays in the engine's last_snapshot cache (it was
   995					// merged via mergeBytes/pollRemote into the LoroDoc
   996					// before classifyPollTick returned 'merged').
   997					//
   998					// **V3.5.0.X audit-closure A-HIGH-4 (2026-05-24)**:
   999					// pre-closure the merged-skip set NO dirty flag, so
  1000					// the deferred render was lost (subsequent ticks would
  1001					// classify as 'idle' and never fire).  Now: set the
  1002					// `_pendingRenderAfterTyping` dirty flag so the render
  1003					// fires when ANY of (a) setPresenceTyping(false) is
  1004					// called, (b) the watchdog auto-clears, (c) defense-
  1005					// in-depth in the idle branch above.
  1006					//
  1007					// Watchdog mitigates the stuck-true edge case (panel
  1008					// hung mid-edit / window closed without endEdit);
  1009					// PRESENCE_TYPING_WATCHDOG_MS auto-clears after 30s.
  1010					if (this._presenceRepaintInFlight) {
  1011						this._pendingRenderAfterTyping = true;
  1012						state.log.appendLine(
  1013							`[collab] pollRemote merged ${result.count} remote blob(s); ` +
  1014							`SKIPPING render (presenceRepaintInFlight; local user mid-edit). ` +
  1015							`Deferred render flagged; will fire on typing:false / watchdog / next idle tick.`,
  1016						);
  1017						return;
  1018					}
  1019					// V3.5.0.X audit-closure A-HIGH-4: a new merged tick
  1020					// supersedes any prior deferred render (we're about to
  1021					// render NOW with fresher data), so clear the flag.
  1022					this._pendingRenderAfterTyping = false;
  1023					state.log.appendLine(`[collab] pollRemote merged ${result.count} remote blob(s); re-rendering`);
  1024					// V3.2.d Codex M3 closure (2026-05-22): wrap render()
  1025					// in try/catch.  exportCellSnapshot can throw at the
  1026					// engine boundary (op log iteration / JSON decode of
  1027					// a maliciously-formed merged blob).  Pre-V3.2.d a
  1028					// throw here bubbled into setInterval which silently
  1029					// swallowed it AND kept ticking -- the panel
  1030					// continued to fire merged ticks that did no visible
  1031					// work.  Now: log the structured code; on a
  1032					// `bad_argument` / `session_oplog` (semantic engine
  1033					// failure) tear down the panel cleanly via
  1034					// handleTransportClosed-style dispose; on transient
  1035					// errors skip this tick.
  1036					try {
  1037						this.render();
  1038					} catch (err) {
  1039						const info = parseQuantbookError(err);
  1040						state.log.appendLine(`[collab] render() failed after merged tick: code=${info.code} msg=${info.message}`);
  1041						if (info.code === 'bad_argument' || info.code === 'session_oplog') {
  1042							state.log.appendLine('[collab] render() error is fatal; disposing panel');
  1043							void vscode.window.showWarningMessage(
  1044								`Cell Grid (Collab) failed to render after a remote merge: [${info.code}] ${info.message}.`,
  1045								'Restart Cell Grid (Collab)',
  1046							).then(choice => {
  1047								if (choice === 'Restart Cell Grid (Collab)') {
  1048									void vscode.commands.executeCommand('quantlab.quantbookCellGridCollab');
  1120				// Dispose BEFORE prompting so the panel stops ticking
  1121				// before the user makes a choice (same pattern as
  1122				// multiWindowDemo's V3.1.c handler).
  1123				this.panel.dispose();
  1124				const choice = await vscode.window.showWarningMessage(
  1125					`Cell Grid collab lost connection: ${info.message}.`,
  1126					'Restart Cell Grid (Collab)',
  1127				);
  1128				if (choice === 'Restart Cell Grid (Collab)') {
  1129					void vscode.commands.executeCommand('quantlab.quantbookCellGridCollab');
