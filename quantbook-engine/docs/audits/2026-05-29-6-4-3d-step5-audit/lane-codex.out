    91	
    92	_GRID_SCHEMA_FIELDS = [
    93	    pa.field("kind", pa.utf8(), nullable=False),
    94	    pa.field("num", pa.float64(), nullable=True),
    95	    pa.field("str", pa.utf8(), nullable=True),
    96	    pa.field("bool", pa.bool_(), nullable=True),
    97	    pa.field("err", pa.utf8(), nullable=True),
