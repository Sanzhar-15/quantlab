  1163	    /// Open a `.qbook` directory (inc.2c-9). **Option 1 (locked 2026-05-27):**
  1164	    /// reconstruct the workbook from the `.qbook` and adopt it with a FRESH
  1165	    /// op-log + undo history (`baseline = loaded workbook`), so the undo
  1166	    /// invariant `baseline + replay(oplog) == workbook` holds trivially (the
  1167	    /// loaded workbook IS the baseline; replay of the empty log is identity) —
  1168	    /// matching `from_workbook` and avoiding Option 2's data-loss bug class
  1169	    /// (a loaded `oplog` whose replay diverges from the loaded envelope). The
  1170	    /// loaded file's op-log history is therefore NOT carried forward: a later
  1171	    /// `save` writes only THIS session's edits, and undo cannot cross the open
  1172	    /// point (the intended semantic). The on-disk `oplog.bin` is still loaded
  1173	    /// and validated (via the oplog-aware loader) so a corrupt sidecar fails
  1174	    /// loud here rather than being silently ignored — it is then discarded.
  1175	    fn open(&mut self, path: &str) -> EngineResult<()> {
  1176	        self.ensure_openable()?;
  1177	        // Load + validate BOTH the workbook envelope and the op-log sidecar; the
  1178	        // op-log is discarded (Option 1). A missing sidecar or a bad envelope
  1179	        // surfaces loud as a `Persistence` error (No-Fallbacks).
  1180	        let (wb, discarded_oplog) =
  1181	            ql_io::load_workbook_with_oplog(Path::new(path)).map_err(map_persistence_err)?;
  1182	        // `load_workbook_with_oplog` validates only the Loro snapshot FRAMING;
  1183	        // per-op JSON is deserialized lazily by `OpLog::iter()` (`log.rs:107`).
  1184	        // A frame-valid but payload-corrupt sidecar (e.g. a pre-Tier-D3 op shape
  1185	        // — see `ql-oplog/tests/d1_step8_legacy_op_shape.rs`) would otherwise be
  1186	        // silently accepted here and then masked by the next `save`'s overwrite.
  1187	        // Even though Option 1 discards this op-log, validate its payloads now so
  1188	        // a corrupt sidecar fails LOUD on open (the No-Fallbacks contract this
  1189	        // increment promises). Done BEFORE `*self = ...` → atomic: a failure
  1190	        // leaves the session untouched and still usable.
  1191	        for op in discarded_oplog.iter() {
  1192	            op.map_err(|e| map_persistence_err(ql_io::PersistenceError::OpLog(e)))?;
  1193	        }
  1194	        // Adopt as a fresh session over the loaded workbook. `from_workbook`
  1195	        // rebuilds the calcgraph, mints a new epoch (so any pre-open delta token
  1196	        // → EpochMismatch full rebuild), resets `state_seq`/`change_log`/`ops`/
  1197	        // `events`/`txns` (a fresh document), and — crucially — builds a FRESH
  1198	        // `OpLog` + `UndoManager` re-subscribed to it AND sets `baseline = wb`.
  1199	        // The function registry is session-scoped tooling (not document state),
  1200	        // so it is preserved across the open (v1: always the default registry).
  1201	        // **6.4-2 cycle-2 audit-fix (F2):** adopt via `from_workbook_with_registry`
  1202	        // so the rebuilt graph is extracted against the PRESERVED (UDF-aware)
  1203	        // registry — not the fresh default `from_workbook` would build. (`open`
  1204	        // additionally self-heals via the `recompute_all` below, but building the
  1205	        // graph correctly the first time avoids the wasteful double build and
  1206	        // keeps the pre-recompute graph consistent.)
  1207	        let registry = Arc::clone(&self.registry);
  1208	        // **6.4-3d (megaudit blocker D1):** preserve the live Python-UDF worker
  1209	        // across the wholesale `*self = ...` replacement. `take()` leaves `None`
  1210	        // in the about-to-be-dropped old self (so its `Drop` kills nothing), and
  1211	        // we re-home the worker into the rebuilt session BEFORE the recompute
  1212	        // below — so a `=MYUDF(..)` recomputes against the live worker instead
  1213	        // of being destroyed to `#CALC!`. Moving the `RefCell<Box<..>>` (a
  1214	        // by-value IPC handle) never signals the child process. When no worker
  1215	        // is configured, this is `None` and blocker D2 (recompute preserves
  1216	        // saved UDF values) keeps the loaded values intact.
  1217	        let preserved_worker = self.udf_worker.take();
  1218	        *self = Self::from_workbook_with_registry(wb, registry);
  1219	        self.udf_worker = preserved_worker;
  1220	        // Recompute on open — mirrors the canonical IDE path
  1221	        // (`loader.rs::load_workbook_and_recompute`): the saved computed values
  1222	        // may be stale relative to their inputs. Run with the op-log DETACHED so
  1223	        // the recompute appends no ops and feeds the (fresh) undo manager no
  1224	        // spurious commit. Structural failures surface as `CellDiagnostic`
  1225	        // events (never swallowed — the `run_recalc`/`rematerialize` pattern).
  1226	        // **6.4-3d (audit-fix HIGH-1):** the LOAD path uses the PRESERVING
  1227	        // variant so a saved UDF value survives an open with no worker (D2).
  1228	        // `recalc_all` (session.rs:2227) and `rematerialize` (session.rs:877)
