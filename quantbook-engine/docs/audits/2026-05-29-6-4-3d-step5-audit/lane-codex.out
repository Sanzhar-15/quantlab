   987	                self.events.push(Event::CellDiagnostic {
   988	                    diagnostic: Diagnostic {
   989	                        addr: Some(CellAddr {
   990	                            sheet: failure.sheet,
   991	                            row: failure.row,
   992	                            col: failure.col,
   993	                        }),
   994	                        severity: Severity::Error,
   995	                        code: "formula_recompute_failed".to_string(),
   996	                        message: failure.error.to_string(),
   997	                    },
   998	                });
   999	            }
  1000	        }
