  1136		/**
  1137		 * V3.2.c.3: tear down the collab lifecycle.  Idempotent.
  1138		 *
  1139		 * - Clear the pollRemote timer.
  1140		 * - Detach transport (best-effort -- session may already have a
  1141		 *   dead transport).
  1142		 * - Kill the spawned relay child process IF this window spawned
  1143		 *   it (mirrors multiWindowDemo's V3.1.e signal-aware predicate).
  1144		 *
  1145		 * Called from `panel.onDidDispose`.  Safe to call on a panel
  1146		 * that was never wired (no-op via `attachmentState === undefined`
  1147		 * guard).
  1148		 */
  1149		private disposeAttachment(): void {
  1150			const state = this.attachmentState;
  1151			if (state === undefined || state.disposed) {
  1152				return;
  1153			}
  1154			state.disposed = true;
  1155			clearInterval(state.pollTimer);
  1156			try {
  1157				this.session.detachTransport();
  1158			} catch { /* best-effort */ }
  1159			if (
  1160				state.spawnedRelay !== undefined &&
  1161				state.spawnedRelay.exitCode === null &&
  1162				state.spawnedRelay.signalCode === null &&
  1163				!state.spawnedRelay.killed
  1164			) {
  1165				state.log.appendLine('[collab] killing spawned relay child process');
  1166				try {
  1167					state.spawnedRelay.kill();
  1168				} catch { /* best-effort */ }
  1169			}
  1170			state.log.appendLine(`[collab] disposed (sheet ${this.sheet}).`);
  1171		}
  1172	}
