   121	export class CellGridPanel {
   122		static show(
   123			context: vscode.ExtensionContext,
   124			session: CollabSessionInstance,
   125			sheet: number,
   126			attachment?: CollabAttachment,
   127		): CellGridPanel {
   128			// V3.2.a.1 single-tab-per-sheet + V3.2.d HIGH-1 closure
   129			// (2026-05-22): two separate cache maps for local + collab
   130			// modes.  A local + a collab panel for the SAME sheet are
   131			// LEGITIMATELY distinct surfaces (different sessions,
   132			// different intent) and CAN coexist; the cache returns the
   133			// existing same-mode panel (reveal + refresh) and NEVER
   134			// silently swaps mode under the user.
   135			//
   136			// Specifically:
   137			//   - LOCAL open + LOCAL panel exists: reveal + refresh.
   138			//   - LOCAL open + only COLLAB panel exists: create new local.
   139			//   - COLLAB open + COLLAB panel exists: reveal existing +
   140			//     showInformationMessage (V3.1.b PeerId-uniqueness:
   141			//     don't spawn a second concurrent collab session under
   142			//     the same PID).
   143			//   - COLLAB open + only LOCAL panel exists: create new collab.
   144			const mode = attachment === undefined ? 'local' : 'collab';
   145			const panels = mode === 'local' ? localPanels : collabPanels;
