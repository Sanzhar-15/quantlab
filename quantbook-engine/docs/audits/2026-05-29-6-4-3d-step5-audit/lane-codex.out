    36	impl OperationState {
    37	    /// True once the operation can no longer change state.
    38	    pub fn is_terminal(&self) -> bool {
    39	        !matches!(self, OperationState::Running)
    40	    }
    41	}
    42	
    43	/// The session's lifecycle state (contract §2.3). Commands are gated on it;
    44	/// an illegal-state call returns [`EngineError::invalid_state`] (never a panic).
    45	#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
    46	#[serde(rename_all = "snake_case")]
    47	pub enum LifecycleState {
    48	    /// Constructed, not yet opened/imported.
    49	    New,
    50	    /// Open and accepting edit/recalc/query commands.
    51	    Ready,
    52	    /// Executing a long operation that owns mutable engine state. Mutating /
    53	    /// recalc commands are rejected with `session_busy`; read-only snapshot of
    54	    /// the last committed state + `cancel`/`operation_status` remain legal.
    55	    /// This is what makes the cancellation/lock story implementable over the
    56	    /// synchronous compute core (contract §2.3 / HIGH-1).
    57	    Busy,
    58	    /// Closed; the handle is freed. Terminal.
    59	    Closed,
    60	    /// An error before/at `Ready`, or a panic during a mutating command, left
    61	    /// the session possibly inconsistent. Terminal; only diagnostics + close.
    62	    Faulted,
    63	}

