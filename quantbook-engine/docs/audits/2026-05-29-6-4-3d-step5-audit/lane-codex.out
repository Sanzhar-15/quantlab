   773	 * behavior symmetric across both cases (V2.7 Opus MEDIUM-1 invariant).
   774	 */
   775	const KNOWN_QUANTBOOK_ERROR_CODE_RECORD: Record<Exclude<QuantbookErrorCode, 'unknown'>, true> = {
   776		transport_io: true,
   777		transport_closed: true,
   778		websocket_invalid_url: true,
   779		websocket_connect_failed: true,
   780		websocket_handshake_failed: true,
   781		websocket_runtime_error: true,
   782		session_oplog: true,
   783		session_presence: true,
   784		session_undo: true,
   785		session_replay: true,
   786		bad_argument: true,
