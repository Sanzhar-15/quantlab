   250	/// FIVE failure modes:
   251	///   - negative BigInt (signed bit set) -- PeerId is u64-domain
   252	///   - BigInt doesn't fit in u64 (lossless = false)
   253	///   - `peer_id == 0` -- Loro's LEGACY_PEER sentinel; rejected with a
   254	///     PROACTIVE check here (the engine's `CollabSession::new` would
   255	///     hit `assert_ne!` and panic, which napi-rs 3.x doesn't reliably
   256	///     catch into a JS exception -- observed during V1 smoke test:
   257	///     "failed to initiate panic, error 5, aborting"). Pre-validate
   258	///     in the FFI boundary to keep Node alive.
   259	///   - `peer_id == u64::MAX` -- Loro's `PeerID::MAX` sentinel (verified
   260	///     via Loro 1.12 `loro-internal-1.12.0/src/loro.rs:184`:
   261	///     `if peer == PeerID::MAX { return Err(...) }`). Loro returns a
   262	///     CLEAN `Err` here (not a panic), so the FFI boundary is intact
   263	///     either way -- but pre-rejecting at the binding gives a faster
   264	///     failure and a consistent error message paired with the
   265	///     `peer_id == 0` case.
   266	///
   267	/// napi-rs 3.x `BigInt::get_u64()` returns `(sign_bit: bool, value: u64,
   268	/// lossless: bool)`. `sign_bit == true` indicates a negative BigInt.
   269	/// Per CLAUDE.md no-fallback rule: each failure mode surfaces a distinct
   270	/// error message so IDE consumers can show the right user-facing copy.
   271	///
   272	/// **Phase 5.7 V1 smoke-test finding (2026-05-22)**: the original
   273	/// version of this helper allowed `peer_id == 0` through, expecting
   274	/// `CollabSession::new`'s `assert_ne!(0, 0)` to surface a clean error.
   275	/// In practice the panic ABORTED the Node process. Lesson:
   276	/// engine-level `assert_*!` is NOT a safe boundary for FFI. Every
   277	/// engine method that uses `assert_*!` for input validation needs a
   278	/// proactive pre-check at the FFI layer.
   279	///
   280	/// **Phase 5.7 V1 audit closure (Rule 4 / Opus boundary test,
   281	/// 2026-05-22)**: the closure test `BigInt boundary -- u64::MAX
   282	/// accepted, 2^64 rejected` revealed that Loro also reserves
   283	/// `PeerID::MAX` (in addition to 0). Added pre-rejection here for
   284	/// symmetry. V2 will sweep the engine + Loro for any other reserved
   285	/// sentinel values as the binding surface grows.
   286	fn peer_id_from_bigint(peer_id: &BigInt) -> Result<PeerId> {
   287	    let (sign_bit, peer_u64, lossless) = peer_id.get_u64();
   288	    if sign_bit {
   289	        return Err(bad_argument_error(
   290	            "peerId BigInt must be non-negative (PeerId is u64-domain)".to_string(),
   291	        ));
   292	    }
   293	    if !lossless {
   294	        return Err(bad_argument_error(
   295	            "peerId BigInt does not fit in u64 (lossy conversion)".to_string(),
   296	        ));
   297	    }
   298	    if peer_u64 == 0 {
   299	        return Err(bad_argument_error(
   300	            "peerId must be non-zero (PeerId(0) is LEGACY_PEER, reserved for pre-collab single-writer + qbook migration)".to_string(),
   301	        ));
   302	    }
   303	    if peer_u64 == u64::MAX {
   304	        return Err(bad_argument_error(
   305	            "peerId must not be u64::MAX (Loro reserves PeerID::MAX as an internal sentinel)"
