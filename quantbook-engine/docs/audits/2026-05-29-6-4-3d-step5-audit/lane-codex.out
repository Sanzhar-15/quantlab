     5	
     6	/**
     7	 * Python interpreter resolver shared by qviz extension-host code.
     8	 *
     9	 * Mirrors `EngineHost.resolvePythonPath()` but is exported as a stand-
    10	 * alone function so the daemon-lifecycle owner (extension activation)
    11	 * doesn't have to instantiate `EngineHost`.
    12	 *
    13	 * Lookup order (matches the implementation):
    14	 *
    15	 *   1. `process.env.QUANTLAB_PYTHON` -- highest priority. Test / CI
    16	 *      override; explicit user intent. If this points at a path that
    17	 *      doesn't exist or isn't executable, the resolver FAILS LOUDLY
    18	 *      (returns null without falling through) -- an explicit override
    19	 *      should not be silently demoted (Step C megaudit PP1 fix).
    20	 *   2. `quantlab.pythonPath` setting (Quantlab-specific override).
    21	 *   3. `python.defaultInterpreterPath` setting (VS Code Python extension).
    22	 *   4. Managed venv:
    23	 *        - POSIX: `~/.quantlab/venv/bin/python`
    24	 *        - Windows: `~/.quantlab/venv/Scripts/python.exe`
    25	 *
    26	 * Returns `null` when no Python is available -- callers MUST handle
    27	 * the null case explicitly (CLAUDE.md "no fallbacks": don't substitute
    28	 * a generic `python3` without knowing the daemon will work).
    29	 *
    30	 * No vscode imports here so the function is testable from plain mocha.
    31	 *
    32	 * Step C megaudit PP3: the executable check now requires `isFile()`
    33	 * AND `X_OK`. Bare `accessSync(X_OK)` accepts directories (an
    34	 * executable directory satisfies X_OK on POSIX), which would later
    35	 * cause `child_process.spawn(directoryPath)` to fail confusingly.
    36	 */
    37	
    38	import * as fs from 'fs';
    39	import * as os from 'os';
    40	import * as path from 'path';
    41	import { execFileSync } from 'child_process';
    42	
    43	export interface ResolvedPython {
    44		readonly pythonPath: string;
    45		readonly source: 'override-env' | 'config-quantlab' | 'config-python-ext' | 'managed-venv';
    46	}
    47	
    48	export interface PythonPathResolverOptions {
    49		readonly quantlabConfigPath?: string;
    50		readonly pythonExtConfigPath?: string;
    51		readonly homeDir?: string;
    52		readonly env?: NodeJS.ProcessEnv;
    53		/** Override the platform string. Tests may set this to exercise
    54		 *  Windows venv layout from a POSIX host. Defaults to
    55		 *  `process.platform`. */
    56		readonly platform?: NodeJS.Platform;
    57	}
    58	
    59	/**
    60	 * Resolve a Python interpreter path. Returns `null` when nothing was
    61	 * found.
    62	 *
    63	 * If `QUANTLAB_PYTHON` is set in the env, it is treated as an explicit
    64	 * user override: if the value doesn't resolve to an executable file,
    65	 * the resolver returns null (does NOT fall through to subsequent
    66	 * candidates). An explicit override pointing at a non-existent path
    67	 * should fail visibly, not silently demote.
    68	 */
    69	export function resolveQuantlabPython(
    70		opts: PythonPathResolverOptions = {},
    71	): ResolvedPython | null {
    72		const env = opts.env ?? process.env;
    73		const platform = opts.platform ?? process.platform;
    74	
    75		// 1. QUANTLAB_PYTHON env override. If the user explicitly set this,
    76		//    fall-through is wrong -- return null on misconfiguration.
    77		const envPath = env.QUANTLAB_PYTHON;
    78		if (envPath && envPath.length > 0) {
    79			if (existsAndExecutableFile(envPath)) {
    80				return { pythonPath: envPath, source: 'override-env' };
    81			}
    82			// Explicit override that doesn't resolve: fail visibly.
    83			return null;
    84		}
    85	
    86		// 2. quantlab.pythonPath. Same explicit-fail-loud policy: if the
    87		//    user configured a path and it's bad, that's a configuration
    88		//    bug -- don't paper over.
    89		if (opts.quantlabConfigPath && opts.quantlabConfigPath.length > 0) {
    90			if (existsAndExecutableFile(opts.quantlabConfigPath)) {
    91				return { pythonPath: opts.quantlabConfigPath, source: 'config-quantlab' };
    92			}
    93			return null;
    94		}
    95	
    96		// 3. python.defaultInterpreterPath. Treated similarly: explicit
    97		//    user setting must resolve, or fail.
    98		if (opts.pythonExtConfigPath && opts.pythonExtConfigPath.length > 0) {
    99			if (existsAndExecutableFile(opts.pythonExtConfigPath)) {
   100				return { pythonPath: opts.pythonExtConfigPath, source: 'config-python-ext' };
   101			}
   102			return null;
   103		}
   104	
   105		// 4. Managed venv. Last resort; null if not present.
   106		const home = opts.homeDir ?? os.homedir();
   107		const managed = managedVenvPath(home, platform);
   108		if (existsAndExecutableFile(managed)) {
   109			return { pythonPath: managed, source: 'managed-venv' };
   110		}
   111		return null;
   112	}
   113	
   114	function managedVenvPath(home: string, platform: NodeJS.Platform): string {
   115		if (platform === 'win32') {
   116			return path.join(home, '.quantlab', 'venv', 'Scripts', 'python.exe');
   117		}
   118		return path.join(home, '.quantlab', 'venv', 'bin', 'python');
   119	}
   120	
   121	function existsAndExecutableFile(p: string): boolean {
   122		// Megaudit MAJOR-14: this helper intentionally returns boolean
   123		// because the resolver wants a fast yes/no and falls through to
   124		// the next candidate on no. The previous silent catches were the
   125		// right shape -- but we now log the underlying error code so a
   126		// misconfigured path (typo'd, permission-denied) is diagnosable
   127		// in the developer console instead of looking identical to
   128		// "not found".
   129		let stat: fs.Stats;
   130		try {
   131			stat = fs.statSync(p);
   132		} catch (e) {
   133			const code = (e as NodeJS.ErrnoException).code;
   134			if (code !== 'ENOENT') {
   135				console.warn(`qviz pythonPath: stat(${p}) failed (${code})`);
   136			}
   137			return false;
   138		}
   139		if (!stat.isFile()) { return false; }
   140		try {
   141			fs.accessSync(p, fs.constants.X_OK);
   142			return true;
   143		} catch (e) {
   144			console.warn(
   145				`qviz pythonPath: ${p} exists but is not executable (${(e as NodeJS.ErrnoException).code})`,
   146			);
   147			return false;
   148		}
   149	}
   150	
   151	// ---------------------------------------------------------------------------
   152	// version verification
   153	// ---------------------------------------------------------------------------
   154	
   155	export type PythonVersionResult =
   156		| { readonly ok: true; readonly version: string; readonly major: number; readonly minor: number }
   157		| { readonly ok: false; readonly error: string };
   158	
   159	/**
   160	 * Verify a Python interpreter is at least the given minimum version.
   161	 * Used by the lifecycle creator to fail loudly if the configured
   162	 * Python is e.g. Python 2.7 -- that path resolves successfully but the
   163	 * daemon would crash at first import (Step C megaudit PP3).
   164	 *
   165	 * Calls `python -c "import sys; print(sys.version_info[:2])"` (~50ms
   166	 * cold). Caller should cache the result per-path to avoid repeating.
   167	 */
   168	export function verifyPythonVersion(
   169		pythonPath: string,
   170		minMajor: number, minMinor: number,
   171	): PythonVersionResult {
   172		let raw: string;
   173		try {
   174			const out = execFileSync(
   175				pythonPath,
   176				['-c', 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")'],
   177				{ timeout: 5_000, encoding: 'utf-8' },
   178			);
   179			raw = out.trim();
   180		} catch (e) {
   181			return {
   182				ok: false,
   183				error: `failed to execute ${pythonPath} for version check: ${(e as Error).message}`,
   184			};
   185		}
   186		const m = /^(\d+)\.(\d+)$/.exec(raw);
   187		if (!m) {
   188			return {
   189				ok: false,
   190				error: `python version output not in expected MAJOR.MINOR form: ${JSON.stringify(raw)}`,
   191			};
   192		}
   193		const major = parseInt(m[1], 10);
   194		const minor = parseInt(m[2], 10);
   195		if (major < minMajor || (major === minMajor && minor < minMinor)) {
   196			return {
   197				ok: false,
   198				error: `python ${major}.${minor} is below minimum ${minMajor}.${minMinor}`,
   199			};
   200		}
   201		return { ok: true, version: raw, major, minor };
   202	}

