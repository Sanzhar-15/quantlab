  4952	    pub fn snapshot(&self) -> Result<WorkbookSnapshotJson> {
  4953	        let snap = self.inner.lock().snapshot().map_err(engine_error_to_napi)?;
  4954	        Ok(workbook_snapshot_json_from_session(snap))
  4955	    }
  4956	
  4957	    /// Single-cell lookup. `null` if the cell is empty/absent.
  4958	    #[napi(js_name = "cell")]
  4959	    pub fn cell(&self, sheet: f64, row: f64, col: f64) -> Result<Option<CellSnapshotJson>> {
  4960	        let addr = session_addr_from_f64("cell", sheet, row, col)?;
  4961	        let cell = self.inner.lock().cell(addr).map_err(engine_error_to_napi)?;
  4962	        Ok(cell.map(cell_snapshot_json_from_session))
  4963	    }
  4964	
  4965	    /// List (non-tombstoned) sheets (id + name, no cells).
  4966	    #[napi(js_name = "listSheets")]
  4967	    pub fn list_sheets(&self) -> Result<Vec<SheetInfoJson>> {
  4968	        let sheets = self
  4969	            .inner
  4970	            .lock()
  4971	            .list_sheets()
  4972	            .map_err(engine_error_to_napi)?;
  4973	        Ok(sheets
  4974	            .into_iter()
  4975	            .map(|s| SheetInfoJson {
  4976	                id: u32::from(s.id),
  4977	                name: s.name,
  4978	            })
  4979	            .collect())
  4980	    }
  4981	
  4982	    /// Deterministically release the underlying [`ql_exec::WorkbookSession`]
  4983	    /// state — transitions the session to `Closed` (terminal). Subsequent
  4984	    /// command calls return a structured `[invalid_state]` engine error rather
  4985	    /// than panic. Any open transaction buffers are dropped (their handles
  4986	    /// become `[transaction_not_found]` if reused, never silent no-ops).
  4987	    ///
  4988	    /// **6.1C audit-fix M8 — closes the lifecycle hole.** Without this,
  4989	    /// JS-side the only way to free the workbook + op-log + plan cache + Loro
  4990	    /// substrate was to GC the JS handle — non-deterministic, can hold large
  4991	    /// workbooks in memory long after the IDE panel closes. Calling `close()`
  4992	    /// frees the engine state synchronously (engine `WorkbookSession::close`
  4993	    /// at `crates/ql-exec/src/session.rs`).
  4994	    #[napi(js_name = "close")]
  4995	    pub fn close(&self) -> Result<()> {
  4996	        self.inner.lock().close().map_err(engine_error_to_napi)
  4997	    }
  4998	
  4999	    // ============================================================================
  5000	    // 6.4-2 (2026-05-28) — function registration over napi.
  5001	    //
  5002	    // Wires the substrate shipped at 6.4-0 (function-metadata storage + hooks)
  5003	    // and 6.4-1 (binder ArgContext migration + PlanCache fn_gen invalidation +
  5004	    // M3 sorted_metadata + M5 mapper + I1 LazyShape) to the JS surface.
  5005	    // ============================================================================
  5006	
  5007	    /// **6.4-2:** Register a UDF — `metadata` is a `FunctionMetadataJson`
  5008	    /// describing the function's contract-§10.2 properties; `implHandle` is the
  5009	    /// opaque dispatch-pointer the worker dispatcher will consult at eval time
  5010	    /// (6.4-3). v1 stores the handle but does NOT yet dispatch to a Python
  5011	    /// worker — that lands at 6.4-3 (Arrow IPC + debugpy).
  5012	    ///
  5013	    /// **Behavior:**
  5014	    /// - Validates every enum string field at the napi boundary; unknown
  5015	    ///   strings surface a structured `[bad_argument]` engine error
  5016	    ///   (No-Fallbacks; never silent default).
  5017	    /// - Dirties + transitive-fans every formula that referenced the
  5018	    ///   (previously-unknown) `canonicalName` via the calcgraph hook.
  5019	    /// - Bumps the registry's `fn_gen` so the bind cache invalidates for
  5020	    ///   formulas needing re-extraction against the new metadata
  5021	    ///   (contract §10.3 "re-extract deps" half — option A from the 6.4-0
  5022	    ///   audit, shipped at 6.4-1 H3).
  5023	    /// - Lifecycle gate: rejects on Closed/Busy/New/Faulted with
  5024	    ///   `[invalid_state]` or `[session_busy]`.
  5025	    ///
  5026	    /// **Errors (Appendix A):**
  5027	    /// - `[function_exists]` — canonical name already registered (built-in
  5028	    ///   or existing UDF). `EngineError{Conflict, "function_exists"}`.
  5029	    /// - `[bad_argument]` — invalid enum string, OR empty/non-canonical
  5030	    ///   (lower-case) canonical_name. **6.4-2 cycle-2 audit-fix (H1):** the
  5031	    ///   trait method `WorkbookSession::register_function` VALIDATES the
  5032	    ///   canonical name before touching the registry and returns a structured
  5033	    ///   `[bad_argument]` for empty/lower-case names. (Pre-fix it forwarded the
  5034	    ///   name unchecked and the registry's `assert!` PANICKED across this
  5035	    ///   catch_unwind-free boundary, sealing the session — that path no longer
  5036	    ///   exists.) Callers should still pass ASCII-uppercase canonical names; the
  5037	    ///   IDE is expected to uppercase before the call.
  5038	    /// - `[invalid_state]` — session is not Ready.
  5039	    #[napi(js_name = "registerFunction")]
  5040	    pub fn register_function(
  5041	        &self,
  5042	        metadata: FunctionMetadataJson,
  5043	        impl_handle: BigInt,
  5044	    ) -> Result<()> {
  5045	        let meta = function_metadata_from_json(metadata)?;
  5046	        // BigInt → u64: the napi-rs `BigInt::get_u64()` returns `(sign_bit,
  5047	        // value, lossless)`. Reject negative (sign bit set) + lossy (anything
  5048	        // above u64::MAX) loud per No-Fallbacks. Matches the `peerId` validation
  5049	        // discipline at `CollabSession::new`.
  5050	        let (sign_bit, raw, lossless) = impl_handle.get_u64();
  5051	        if sign_bit {
  5052	            return Err(bad_argument_error(
  5053	                "registerFunction: implHandle must be a non-negative BigInt".into(),
  5054	            ));
  5055	        }
  5056	        if !lossless {
  5057	            return Err(bad_argument_error(
  5058	                "registerFunction: implHandle exceeds u64::MAX (lossy conversion rejected)".into(),
  5059	            ));
  5060	        }
  5061	        let handle = FunctionImplHandle(raw);
  5062	        self.inner
  5063	            .lock()
  5064	            .register_function(meta, handle)
  5065	            .map_err(engine_error_to_napi)
  5066	    }
  5067	
  5068	    /// **6.4-2:** Unregister a UDF. Symmetric to [`Self::register_function`].
  5069	    /// Removes BOTH the metadata and the dispatch handle atomically (via the
  5070	    /// registry's `unregister_metadata` extension that clears
  5071	    /// `udf_handles[name]` on success). Dirties + transitive-fans every
  5072	    /// dependent formula via the calcgraph hook; the next eval will surface
  5073	    /// `#NAME?` because dispatch is now missing.
  5074	    ///
  5075	    /// **Errors (Appendix A):**
  5076	    /// - `[function_not_found]` — no UDF registered under `canonicalName`.
  5077	    /// - `[function_exists]` — `canonicalName` is a built-in (dispatch entry
  5078	    ///   still present; the registry's builtin-guard refuses removal). The
  5079	    ///   `Conflict / function_exists` class is the same as duplicate-register;
  5080	    ///   the message disambiguates (`"is a registered built-in"`).
  5081	    /// - `[invalid_state]` — session is not Ready.
  5082	    #[napi(js_name = "unregisterFunction")]
  5083	    pub fn unregister_function(&self, canonical_name: String) -> Result<()> {
  5084	        self.inner
  5085	            .lock()
  5086	            .unregister_function(&canonical_name)
  5087	            .map_err(engine_error_to_napi)
  5088	    }
  5089	
  5090	    /// **6.4-2:** List every registered function (built-ins + UDFs) with full
  5230	//   - `CoreWorkbookSession` (`ql_exec::WorkbookSession`) is asserted `Send`
  5231	//     below. It owns the same Loro substrate (an `OpLog` + a `loro::UndoManager`,
  5232	//     each holding an internal `Arc<LoroDoc>`) as `CoreCollabSession` (documented
  5233	//     `Send + !Sync`), plus `Workbook` / `CalcgraphSession` / `PlanCache` /
  5234	//     `Arc<FunctionRegistry>` / plain collections.
  5235	//   - `parking_lot::Mutex<T>: Send + Sync` when `T: Send` (no poison flag).
  5236	//   - `Arc<T>: Send + Sync` when `T: Send + Sync`.
  5237	//   - Therefore `Session` is `Send + Sync`.
  5238	//
  5239	// If `assert_send::<CoreWorkbookSession>()` fails to compile, that is a REAL
  5240	// contract finding — the owning engine session is not FFI-shareable as-is — NOT
  5241	// something to paper over. Surfacing exactly this class of gap is the point of
  5242	// migrating the Node path early (decision-lock risk-mitigation #1).
  5243	const _ASSERT_BINDING_SESSION_SEND: fn() = || {
  5244	    fn assert_send<T: Send>() {}
  5245	    fn assert_sync<T: Sync>() {}
  5246	    assert_send::<CoreWorkbookSession>();
  5247	    assert_send::<Session>();
  5248	    assert_sync::<Session>();
  5249	};

