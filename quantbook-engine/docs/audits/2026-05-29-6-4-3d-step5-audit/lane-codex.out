  1174	const NONCE_ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
  1175	const NONCE_LENGTH = 32;
  1176	
  1177	/**
  1178	 * 32-char alphanumeric nonce.  Matches `LoginWebviewPanel._nonce`'s
  1179	 * shape so any future audit reviewing webview security across the
  1180	 * extension sees consistent token shapes.
  1181	 *
  1182	 * `Math.random()` is adequate here.  The threat model is "prevent
  1183	 * inline `<script>` injection via snapshot data leaking past
  1184	 * `escapeHtml`", NOT "resist a determined attacker with crypto-grade
  1185	 * brute force."  62^32 ~= 10^57 possibilities; Math.random()'s 53
  1186	 * bits of entropy per call have well-over-cryptographic margin
  1187	 * against snapshot-content collisions.
  1188	 */
  1189	function buildPanelNonce(): string {
  1190		let out = '';
  1191		for (let i = 0; i < NONCE_LENGTH; i += 1) {
  1192			out += NONCE_ALPHABET[Math.floor(Math.random() * NONCE_ALPHABET.length)];
  1193		}
  1194		return out;
  1195	}

