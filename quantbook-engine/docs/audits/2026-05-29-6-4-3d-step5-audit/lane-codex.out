   720		/**
   721		 * **Phase 5.7 V3.6.1 (2026-05-26) -- acquire the workbook snapshot via
   722		 * the incremental delta protocol (OPUS-PT-B10).**
   723		 *
   724		 * Realizes the V3.6.0.8 D6 engine win: instead of a full O(N)
   725		 * `workbookSnapshot()` (rebuild_workbook over the whole op log --
   726		 * ~246 ms at 100k cells) on every repaint, this seeds once via a full
   727		 * snapshot, then fetches incremental deltas (~1 ms at 100 new cells;
   728		 * 228x faster) and merges them into {@link _cachedWorkbookSnapshot}
   729		 * via {@link mergeWorkbookDelta}.
   730		 *
   731		 * **Two-call protocol** (engine contract; see {@link workbookSnapshotDelta}):
   732		 * - No cached version -> full `workbookSnapshot()` (seed); capture its
   733		 *   `version`.
   734		 * - Else -> `workbookSnapshotDelta(version)`.  If `fullRebuildRequired`
   735		 *   (cache miss / staleness / rename / metadata op / malformed token)
   736		 *   -> full `workbookSnapshot()` re-fetch.  Else -> merge the delta.
   737		 *
   738		 * `fullRebuildRequired` is an EXPLICIT designed protocol signal, not a
   739		 * swallowed error.  There is deliberately NO hidden periodic full
   740		 * resync: per CLAUDE.md No-Fallbacks a merge divergence (if one could
   741		 * occur) must surface loudly, not be silently papered over.  The
   742		 * engine's conservative fullRebuild allowlist + 5 cache-invalidation
   743		 * sites form a complete divergence safety net (every structural change
   744		 * trips fullRebuild); the `quantbook V3.6.1 -- delta-merge shape
   745		 * equivalence` mocha suite pins fast-path === full-path.
   746		 *
   747		 * **Where the win actually lands** (so future readers don't chase the
   748		 * expected full rebuilds as a regression):
   749		 * - LOCAL-edit `onCommit` repaint: fast delta (`append_op` does not
   750		 *   invalidate the engine cache).  This is the typing-latency path.
   751		 * - COLLAB merged-tick repaint: `pollRemote` force-clears the engine
   752		 *   cache on a merge, so the next delta returns `fullRebuildRequired`
   753		 *   -> full fetch.  Same cost as pre-V3.6.1 (no regression).
   754		 * - MULTIPLE panels on ONE session: all ride the fast path.  The client
   755		 *   cache is shared per session (see {@link getSharedDeltaCache}) to
   756		 *   mirror the engine's per-session cache, so the first panel's delta
   757		 *   advances the shared snapshot + version and siblings then observe a
   758		 *   same-VV empty delta (not a full rebuild).  A panel opened later
   759		 *   piggybacks on the already-seeded shared snapshot.
   760		 */
   761		private acquireWorkbookSnapshot(): WorkbookSnapshotJson {
   762			// Delegates to the pure, vscode-free orchestrator so the two-call
   763			// protocol is mocha-testable without a panel.  The cache is shared
   764			// per session (mutated in place: snapshot + version advance) so all
   765			// panels bound to this session ride the delta fast path.
   766			return acquireWorkbookSnapshotViaDelta(this.session, getSharedDeltaCache(this.session));
   767		}
   768	
   769		/**
   770		 * Compute the snapshot, generate a fresh nonce, AND set the
   771		 * webview's HTML.  Re-rendering blows away any prior webview
   772		 * script + state; the host's `onDidReceiveMessage` handler
   773		 * survives because it's attached to the panel, not the document.
   774		 *
   775		 * V3.2.b.2: nonce is regenerated each call so refreshes get a
   776		 * fresh script-src CSP token.
   777		 *
   778		 * **V3.5.0.4b (2026-05-24)**: migrated from `exportSnapshot(sheet)`
   779		 * to `workbookSnapshot()`.  Routes through engine `rebuild_workbook`
   780		 * which reflects V3.5.0.3 sheet ops (rename/delete/move) IMMEDIATELY
   781		 * -- no pollRemote tick wait.  Bonus: panel title sheet-count is
   782		 * now reactive (was point-in-time at `show()` per V3.3.0.X reactive-
   783		 * panel-title backlog item; backlog cleared here).
   784		 *
   785		 * **V3.6.1 (2026-05-26)**: the snapshot is now acquired via
   786		 * {@link acquireWorkbookSnapshot} (incremental delta protocol;
   787		 * OPUS-PT-B10) instead of an unconditional full `workbookSnapshot()`.
   788		 * The local-edit repaint path drops from O(N) op-log replay to an
   789		 * O(changed-cells) delta + merge.  Everything downstream of the
   790		 * snapshot (active-sheet extract, title, presence, buildHtml) is
   791		 * unchanged -- it consumes the same {@link WorkbookSnapshotJson} shape.
   792		 *
   793		 * **Sheet-not-found (tombstone race)**: if the active sheet was
   794		 * deleted via V3.5.0.4a `quantlab.quantbookSheetDelete` while the
   795		 * panel is open, `extractSheetSnapshot` returns null.  We render
   796		 * an empty cell-grid + log a warning -- the user sees the panel
   797		 * is now showing a deleted sheet (cells empty), and can close it.
   798		 * V3.6+ may auto-dispose the panel on its sheet's tombstoning.
   799		 * (The delta path reaches the same state: `deleteSheet` arrives as a
   800		 * `sheetsRemoved` delta that drops the sheet from the merged cache.)
   801		 */
   802		render(): void {
   803			const wbSnapshot = this.acquireWorkbookSnapshot();
   804			const sheetSnapshot: QuantbookCellSnapshot | null = extractSheetSnapshot(wbSnapshot, this.sheet);
   805			const snapshot: QuantbookCellSnapshot = sheetSnapshot ?? {
   806				// Tombstoned-mid-lifetime fallback: render empty.  CLAUDE.md
   807				// No-Fallbacks tension: we deliberately render an empty
   808				// frame rather than throw, BUT the warning below makes the
   809				// state visible.  Without this branch, a stale panel that
   810				// outlived its sheet's deletion would throw on every render
   811				// -- worse UX (red error banner forever) than the empty
   812				// frame + warning here.
   813				snapshot_format_version: 1,
   814				sheet: this.sheet,
   815				entries: [],
   816			};
   817			if (sheetSnapshot === null) {
   818				console.warn(
   819					`[cellGrid] active sheet ${this.sheet} not found in workbookSnapshot ` +
   820					`(likely tombstoned by quantbookSheetDelete).  Rendering empty cell grid; close the panel.`,
   821				);
   822			}
   823			// V3.5.0.4b: reactive panel title -- reflects current sheet
   824			// count from workbookSnapshot (includes empty addSheet'd sheets,
   825			// unlike the show()-time listSheets() call which was cache-
   826			// based per V3.3.0.X MEDIUM-3).  Clears the V3.3.0.X reactive-
   827			// panel-title backlog item.
   828			const totalSheets = wbSnapshot.sheets.length;
   829			const titleSuffix = totalSheets > 1 ? ` of ${totalSheets}` : '';
   830			const sheetName = sheetSnapshot !== null
   831				? wbSnapshot.sheets.find(s => s.id === this.sheet)?.name
   832				: undefined;
   833			const baseTitle = this.attachmentState !== undefined ? 'Cell Grid -- Collab' : 'Cell Grid';
   834			const sheetLabel = sheetName !== undefined
   835				? `Sheet ${this.sheet} "${sheetName}"`
   836				: `Sheet ${this.sheet}`;
   837			this.panel.title = `${baseTitle} (${sheetLabel}${titleSuffix})`;
   838			const nonce = buildPanelNonce();
   839			// V3.4.0.5b (2026-05-23): build presence snapshot at render time.
   840			// Presence is non-critical decoration; if the engine throws,
   841			// render the cell grid WITHOUT presence rather than failing the
   842			// whole render.  Per CLAUDE.md No-Fallbacks rule the error MUST
   843			// be visible -- console.warn the exception so the extension
   844			// host's debug console catches it.  The user sees: cells render
   845			// correctly, peer presence borders absent.
   846			let presence;
