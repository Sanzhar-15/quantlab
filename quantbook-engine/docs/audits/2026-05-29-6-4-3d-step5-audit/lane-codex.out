   243				const rawValueStr = formatCellValue(e.value);
   244				// **Phase 5.7 V3.6.0.6 D5 (2026-05-24)**: when the cell
   245				// carries formula text (post Phase 5.3 repair_sheet_rename_chain),
   246				// emit `data-raw-formula` so beginEdit shows formula source
   247				// on click-to-edit, NOT the cached literal value.  Per
   248				// V3.6.0.X audit-of-D4 Opus section G.2: a cell with both a
   249				// formula AND a value has two raw representations; the
   250				// formula is the more-authoritative source for editing
   251				// (it's what the user typed; the value is computed from
   252				// it).  beginEdit precedence: data-raw-formula >
   253				// data-raw-value > data-original-text.  Absent attribute
   254				// (the typical pure-literal case) lets beginEdit fall
   255				// back to data-raw-value as before.
   256				const formulaAttr = (editable && typeof e.formula === 'string')
   257					? ` data-raw-formula="${escapeHtml(e.formula)}"`
   258					: '';
   259				// V3.2.b.2: cells gain `data-row` / `data-col` attributes when
   260				// editable so the client script can identify which cell was
   261				// clicked. The `.cell-value` class is the hit-test target.
   262				//
   263				// `data-sheet` is NOT added here -- it's a panel-level
   264				// constant (one panel = one sheet) baked into the script's
   265				// `SHEET` const, so emitting it per-cell would be redundant
   266				// + a drift surface.
   267				//
   268				// `data-original-text` captures the rendered display text so
   269				// the Escape-cancel path can restore it without consulting
   270				// the snapshot (which the client doesn't hold a copy of).
   271				// V3.3.0.X audit closure (LOW-1, 2026-05-23, convergent
   272				// Codex L3 + Opus L1): defense-in-depth coerce row/col
   273				// to Number().  Engine-typed `e.row` / `e.col` are
   274				// already u32 integers per the V3.2.a JSON shape, but
   275				// the literal claim in the V3.3.0.X audit was "all
   276				// attribute values are escaped" -- making that claim
   277				// true.  `Number(non-numeric)` returns NaN, which
   278				// interpolates as `"NaN"` (a valid CSS-selector +
   279				// HTML-attribute value with no XSS surface).
   280				const rowSafe = Number(e.row);
   281				const colSafe = Number(e.col);
   282				const dataAttrs = editable
   283					? ` data-row="${rowSafe}" data-col="${colSafe}" data-original-text="${escapeHtml(displayStr)}" data-raw-value="${escapeHtml(rawValueStr)}"${formulaAttr} data-original-kind="${escapeHtml(e.value.kind)}"`
   284					: '';
   285				// **Phase 6.4-3d Step 5 (2026-05-29)**: a per-cell diagnostic (from
   286				// `Event::CellDiagnostic` via `pollEvents`, merged onto error-valued
   287				// cells by `attachCellDiagnostics`) surfaces as a `title=` tooltip so
   288				// a failed UDF explains WHY -- the `#CALC!`/`#TIMEOUT!` text is KEPT.
   289				// CSP-safe: the message is `escapeHtml`d like every other attribute.
   290				const titleAttr = (typeof e.diagnostic === 'string' && e.diagnostic.length > 0)
   291					? ` title="${escapeHtml(e.diagnostic)}"`
   292					: '';
   293				const cellClass = editable ? 'cell-value' : '';
   294				return `<tr><td>${rowSafe}</td><td>${colSafe}</td><td class="${cellClass}"${dataAttrs}${titleAttr}>${escapeHtml(displayStr)}<span class="kind">[${escapeHtml(e.value.kind)}]</span></td></tr>`;
   295			})
   296			.join('');
   297	}
   298	
   299	/**
   300	 * Render a cell value for display. Type-narrowed via the
   301	 * {@link QuantbookCellValue} tagged-union; the `switch` is
   302	 * exhaustive (TS infers `never` in any unreachable branch as a
   303	 * compile-time correctness pin).
   304	 */
   305	export function formatCellValue(value: QuantbookCellValue): string {
   760			'  if (viewport !== null) {',
   761			'    viewport.addEventListener(\'scroll\', repaintForScroll);',
   762			'    // Initial paint after geometry is known (viewport.clientHeight is',
   763			'    // only valid after layout).  rAF defers to after first paint.',
   764			'    requestAnimationFrame(repaintForScroll);',
   765			'  }',
   766			'}());',
   767		].join('\n');
   768	}
   769	
   770	function escapeHtml(s: string): string {
   771		return s.replace(/[&<>"']/g, c => {
   772			switch (c) {
   773				case '&': return '&amp;';
   774				case '<': return '&lt;';
   775				case '>': return '&gt;';
   776				case '"': return '&quot;';
   777				case '\'': return '&#39;';
   778				default: return c;
   779			}
   780		});
   781	}

