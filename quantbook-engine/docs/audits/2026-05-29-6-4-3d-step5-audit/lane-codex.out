  1181	
  1182	/// **6.4-3d (2026-05-29; megaudit blocker G):** push a [`UdfCellDiagnostic`] for
  1183	/// the current formula cell into the env's per-recompute collector (a no-op when
  1184	/// the env carries no collector or no formula cell). Keyed by the formula's own
  1185	/// address (`env_formula_cell`), which the recompute / `set_formula` env sites
  1186	/// always set.
  1187	fn push_udf_cell_diagnostic<E: CellEnv + ?Sized>(env: &E, code: &'static str, message: String) {
  1188	    if let Some(addr) = env_formula_cell(env) {
  1189	        env.push_udf_diagnostic(crate::env::UdfCellDiagnostic {
  1190	            addr,
  1191	            code,
  1192	            message,
  1193	        });
  1194	    }
  1195	}
  1196	
  1197	/// **6.4-3d (2026-05-29; megaudit blocker G):** map a [`ql_udf::UdfError`] to a
  1198	/// stable diagnostic `code` + a human-readable `message`. Parallels
  1199	/// [`map_udf_error`] (which maps to the cell VALUE); this maps to the structured
  1200	/// `CellDiagnostic` detail so the IDE can show WHY a UDF failed (exit test 7).
  1201	fn udf_error_diagnostic(e: &ql_udf::UdfError) -> (&'static str, String) {
  1202	    use ql_udf::UdfError;
  1203	    match e {
  1204	        UdfError::Raised { exc_type, message } => ("udf_raised", format!("{exc_type}: {message}")),
  1205	        UdfError::Timeout(d) => (
  1206	            "udf_timeout",
  1207	            format!("UDF call exceeded its deadline ({d:?})"),
  1208	        ),
  1209	        UdfError::Cancelled => ("udf_cancelled", "UDF call cancelled".to_string()),
  1210	        UdfError::Handshake { expected, got } => (
  1211	            "udf_handshake",
  1212	            format!("worker handshake failed: protocol mismatch (engine {expected}, worker {got})"),
  1213	        ),
  1214	        UdfError::Protocol(m) => ("udf_protocol", format!("worker protocol violation: {m}")),
  1215	        UdfError::WorkerDied(m) => (
  1216	            "udf_worker_died",
  1217	            format!("Python worker died / transport broken: {m}"),
  1218	        ),
  1219	        UdfError::Codec(c) => ("udf_codec", format!("UDF argument/return codec error: {c}")),
  1220	    }
  1221	}
  1222	
  1223	/// **6.4-3c (2026-05-29):** map a [`ql_udf::UdfError`] to a deterministic cell
  1224	/// error value. v1 is coarse: only `Timeout` → `#TIMEOUT!`; everything else
  1225	/// (`Raised`/`Cancelled`/`Handshake`/`Protocol`/`WorkerDied`/`Codec`) → `#CALC!`.
  1226	/// This maps only the cell VALUE; the structured `CellDiagnostic` that
  1227	/// distinguishes the variants (no-worker / raise / death — exit test 7's target)
  1228	/// is emitted ADDITIONALLY by [`dispatch_udf`] via [`udf_error_diagnostic`] +
  1229	/// [`push_udf_cell_diagnostic`] (6.4-3d, megaudit blocker G).
  1230	fn map_udf_error(e: &ql_udf::UdfError) -> ErrorValue {
  1231	    match e {
  1232	        ql_udf::UdfError::Timeout(_) => ErrorValue::Timeout,
  1233	        _ => ErrorValue::Calc,
  1234	    }
  1235	}
  1236	
  1237	fn eval_binary(op: Operator, lhs: Value, rhs: Value) -> Value {
  1238	    // Error propagation comes first — Excel's left-error-wins rule.
  1239	    if let Value::Error(e) = lhs {
  1240	        return Value::Error(e);
  1241	    }
  1242	    if let Value::Error(e) = rhs {
  1243	        return Value::Error(e);
  1244	    }
  1245	

