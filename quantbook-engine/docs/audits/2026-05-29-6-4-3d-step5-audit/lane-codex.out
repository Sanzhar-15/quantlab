   923	    /// Build a delta that tells the caller to reseed via `snapshot()` (§4.3):
   924	    /// empty change vectors + the current token + the designed `reason`. This is
   925	    /// a *designed* state (NOT an error — unlike a malformed token, which is the
   926	    /// fail-loud `invalid_version_token`).
   927	    fn full_rebuild_delta(&self, reason: FullRebuildReason) -> WorkbookSnapshotDelta {
   928	        WorkbookSnapshotDelta {
   929	            schema_version: SCHEMA_VERSION,
   930	            changed_cells: Vec::new(),
   931	            removed_cells: Vec::new(),
   932	            sheets_changed: Vec::new(),
   933	            sheets_removed: Vec::new(),
   934	            formats_added: Vec::new(),
   935	            version: self.current_version(),
