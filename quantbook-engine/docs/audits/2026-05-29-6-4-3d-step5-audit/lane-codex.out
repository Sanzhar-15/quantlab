  1002	        self.ops.insert(op, OperationState::Completed);
  1003	        self.state = LifecycleState::Ready;
  1004	        self.events.push(Event::OperationCompleted {
  1005	            op,
  1006	            state: OperationState::Completed,
  1007	        });
