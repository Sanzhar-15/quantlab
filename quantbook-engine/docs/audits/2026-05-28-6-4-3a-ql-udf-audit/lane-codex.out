   157	        .unwrap();
   158	
   159	        // --- engine → wire ---
   160	        let call_frame = Frame::new(FrameType::Call, encode_grid(&args).unwrap());
   161	        let mut pipe = Vec::new();
   162	        write_frame(&mut pipe, &call_frame).unwrap();
   163	
   164	        // --- worker side: read the CALL, decode, "run" the UDF, encode RETURN ---
   165	        let mut cursor = std::io::Cursor::new(pipe);
   166	        let got = read_frame(&mut cursor).unwrap().expect("a frame");
   167	        assert_eq!(got.frame_type, FrameType::Call);
   168	        let decoded_args = decode_grid(&got.payload).unwrap();
   169	        // The worker echoes its args back as the result (identity UDF).
   170	        let result = decoded_args.clone();
   171	        let return_frame = Frame::new(FrameType::Return, encode_grid(&result).unwrap());
   172	        let mut back = Vec::new();
   173	        write_frame(&mut back, &return_frame).unwrap();
