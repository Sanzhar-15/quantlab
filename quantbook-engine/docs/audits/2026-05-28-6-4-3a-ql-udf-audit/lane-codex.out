     1	//! `ArrayValue` — a 2D array of `Value` cells.
     2	//!
     3	//! **Phase 4.7 sub-phase A (W5-95)** — first sub-phase of the array-formulas
     4	//! and dynamic-spills arc. Design doc:
     5	//! `docs/architecture/2026-05-14-array-formulas-and-spills.md` § 6.1.
     6	//!
     7	//! ## Why `ql-types` and not `ql-exec`?
     8	//!
     9	//! Codex design review (HIGH-1): the function-dispatch ABI in `ql-functions`
    10	//! must be able to PASS and RETURN array values. `ql-functions` depends only
    11	//! on `ql-types` — adding a `ql-functions` → `ql-exec` edge would close a
    12	//! cycle (since `ql-exec` already depends on `ql-functions`). So `ArrayValue`
    13	//! lives here, alongside `Value` and `ErrorValue`.
    14	//!
    15	//! ## What this is NOT
    16	//!
    17	//! - `ArrayValue` is NOT a `Value` variant. Storage cells stay scalar by
    18	//!   Excel canon — spilling MATERIALIZES arrays into per-cell scalars in
    19	//!   the computed overlay. `Value::Array(...)` would force every `read`
    20	//!   caller to handle the multi-cell case, which is wrong at that boundary.
    21	//! - `ArrayValue` is NOT an iterator-over-`Value`. It is a fixed-shape
    22	//!   container with row-major indexing.
    23	//!
    24	//! ## Invariants
    25	//!
    26	//! 1. **Length:** `cells.len() == (rows as usize) * (cols as usize)`. The
    27	//!    `new` constructor enforces this; convenience constructors `row`,
    28	//!    `column`, `singleton`, and `empty` build correct shapes by
    29	//!    construction.
    30	//! 2. **Row-major:** `cells[row * cols + col]` is the cell at logical
    31	//!    coordinate `(row, col)`. Iteration order in `cells.iter()` is
    32	//!    row-major.
    33	//! 3. **Degenerate shapes:** `rows == 0 || cols == 0` produces `cells: []`.
    34	//!    Degenerate arrays are valid containers (functions like `FILTER` with
    35	//!    an all-false mask produce them); the runtime spill path surfaces them
    36	//!    as `#CALC!` (NOT `#SPILL!`) per design § 9.1.
    37	//!
    38	//! ## Equality
    39	//!
    40	//! `PartialEq` only — `Value::Number(f64)` is not `Eq` (NaN). Test code
    41	//! that compares `ArrayValue`s composed of NaN should use bitwise
    42	//! comparison helpers, not `==`.
    43	
    44	use std::fmt;
    45	
    46	use crate::value::Value;
    47	
    48	/// A 2D array of `Value` cells in row-major layout.
    49	///
    50	/// Used at the EVAL boundary and in the unified function-dispatch ABI
    51	/// (`FunctionArg::Array` / `FunctionReturn::Array`, defined in
    52	/// `ql-functions`). Storage cells stay scalar — see module docs.
    53	#[derive(Clone, Debug, PartialEq, Default)]
    54	pub struct ArrayValue {
    55	    rows: u32,
    56	    cols: u32,
    57	    cells: Vec<Value>,
    58	}
    59	
    60	/// Errors emitted when constructing or operating on an `ArrayValue` with
    61	/// invalid arguments. These are PROGRAMMING errors (caller-side bugs);
    62	/// user-visible array errors (degenerate result, out-of-bounds spill, etc.)
    63	/// surface as `Value::Error(ErrorValue::*)` at the eval boundary, not here.
    64	#[derive(Clone, Debug, PartialEq, Eq)]
    65	#[non_exhaustive]
    66	pub enum ArrayShapeError {
    67	    /// Number of cells supplied doesn't match `rows * cols`.
    68	    CellCountMismatch {
    69	        rows: u32,
    70	        cols: u32,
    71	        expected: usize,
    72	        found: usize,
    73	    },
    74	
    75	    /// Coordinate passed to `at` / `at_mut` is outside the array bounds.
    76	    IndexOutOfBounds {
    77	        row: u32,
    78	        col: u32,
    79	        rows: u32,
    80	        cols: u32,
    81	    },
    82	}
    83	
    84	impl fmt::Display for ArrayShapeError {
    85	    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
    86	        match self {
    87	            Self::CellCountMismatch {
    88	                rows,
    89	                cols,
    90	                expected,
    91	                found,
    92	            } => write!(
    93	                f,
    94	                "ArrayValue construction: cell count {found} does not match \
    95	                 rows ({rows}) * cols ({cols}) = {expected}"
    96	            ),
    97	            Self::IndexOutOfBounds {
    98	                row,
    99	                col,
   100	                rows,
   101	                cols,
   102	            } => write!(
   103	                f,
   104	                "ArrayValue index out of bounds: ({row}, {col}) for shape ({rows}, {cols})"
   105	            ),
   106	        }
   107	    }
   108	}
   109	
   110	impl std::error::Error for ArrayShapeError {}
   111	
   112	impl ArrayValue {
   113	    /// Construct an array from `rows × cols` cells in row-major order.
   114	    ///
   115	    /// Returns `Err(CellCountMismatch)` if `cells.len() != rows * cols`.
   116	    /// For degenerate shapes (`rows == 0` or `cols == 0`), `cells` must
   117	    /// be empty.
   118	    pub fn new(rows: u32, cols: u32, cells: Vec<Value>) -> Result<Self, ArrayShapeError> {
   119	        let expected = (rows as usize).checked_mul(cols as usize).ok_or(
   120	            ArrayShapeError::CellCountMismatch {
   121	                rows,
   122	                cols,
   123	                expected: usize::MAX,
   124	                found: cells.len(),
   125	            },
   126	        )?;
   127	        if cells.len() != expected {
   128	            return Err(ArrayShapeError::CellCountMismatch {
   129	                rows,
   130	                cols,
   131	                expected,
   132	                found: cells.len(),
   133	            });
   134	        }
   135	        Ok(Self { rows, cols, cells })
   136	    }
   137	
   138	    /// 1×1 array wrapping a single value. Used by `FILTER`'s `if_empty`
   139	    /// path (a scalar fallback returned in array form).
   140	    pub fn singleton(value: Value) -> Self {
   141	        Self {
   142	            rows: 1,
   143	            cols: 1,
   144	            cells: vec![value],
   145	        }
   146	    }
   147	
   148	    /// 1×N horizontal vector. Convenience constructor.
   149	    pub fn row(values: Vec<Value>) -> Self {
   150	        let cols = values.len() as u32;
   151	        Self {
   152	            rows: 1,
   153	            cols,
   154	            cells: values,
   155	        }
   156	    }
   157	
   158	    /// N×1 vertical vector. Convenience constructor.
   159	    pub fn column(values: Vec<Value>) -> Self {
   160	        let rows = values.len() as u32;
   161	        Self {
   162	            rows,
   163	            cols: 1,
   164	            cells: values,
   165	        }
   166	    }
   167	
   168	    /// Degenerate (zero-area) array: `rows == 0 || cols == 0`, `cells` empty.
   169	    /// Returned by `FILTER` when no `include` cell is TRUE and no `if_empty`
   170	    /// is provided (the function itself then returns `#CALC!` instead of
   171	    /// this — see design § 9.1).
   172	    pub fn empty(rows: u32, cols: u32) -> Self {
   173	        debug_assert!(
   174	            rows == 0 || cols == 0,
   175	            "ArrayValue::empty: ({rows}, {cols}) is not degenerate"
   176	        );
   177	        Self {
   178	            rows,
   179	            cols,
   180	            cells: Vec::new(),
   181	        }
   182	    }
   183	
   184	    /// Number of rows. `u32` for symmetry with `RowId`.
   185	    #[inline]
   186	    pub fn rows(&self) -> u32 {
   187	        self.rows
   188	    }
   189	
   190	    /// Number of columns.
   191	    #[inline]
   192	    pub fn cols(&self) -> u32 {
   193	        self.cols
   194	    }
   195	
   196	    /// Total cell count (`rows * cols`). 0 if degenerate.
   197	    #[inline]
   198	    pub fn len(&self) -> usize {
   199	        self.cells.len()
   200	    }
   201	
   202	    /// True if `rows == 0` or `cols == 0`. Distinguished from `len() == 0`
   203	    /// only for clarity; the two are equivalent given the construction
   204	    /// invariant.
   205	    #[inline]
   206	    pub fn is_degenerate(&self) -> bool {
   207	        self.rows == 0 || self.cols == 0
   208	    }
   209	
   210	    /// True if degenerate OR `len() == 0`. Provided for the `Vec`-like
   211	    /// API symmetry; identical to `is_degenerate()` under the invariant.
   212	    #[inline]
   213	    pub fn is_empty(&self) -> bool {
   214	        self.cells.is_empty()
   215	    }
   216	
   217	    /// Borrow the cell at logical `(row, col)`. Returns `None` for
   218	    /// out-of-bounds. Use [`at`](Self::at) for the panicking variant.
   219	    #[inline]
   220	    pub fn get(&self, row: u32, col: u32) -> Option<&Value> {
   221	        if row >= self.rows || col >= self.cols {
   222	            return None;
   223	        }
   224	        Some(&self.cells[(row as usize) * (self.cols as usize) + (col as usize)])
   225	    }
   226	
   227	    /// Borrow the cell at logical `(row, col)`. Panics on out-of-bounds —
   228	    /// for the fallible variant use [`get`](Self::get).
   229	    #[inline]
   230	    pub fn at(&self, row: u32, col: u32) -> &Value {
   231	        self.get(row, col).unwrap_or_else(|| {
   232	            panic!(
   233	                "ArrayValue::at: ({row}, {col}) out of bounds for shape ({}, {})",
   234	                self.rows, self.cols
   235	            )
   236	        })
   237	    }
   238	
   239	    /// First cell — `cells[0]`. Panics if degenerate. Helper for callers
   240	    /// (e.g. tests) that need a single-cell view; the runtime's array →
   241	    /// scalar contract uses `#CALC!`, NOT `first()` (per design § 6.3).
   242	    pub fn first(&self) -> &Value {
   243	        self.cells
   244	            .first()
   245	            .expect("ArrayValue::first: degenerate array has no cells")
   246	    }
   247	
   248	    /// Borrow the underlying row-major `Vec<Value>`. Useful for fast
   249	    /// iteration in evaluator hot paths.
   250	    #[inline]
   251	    pub fn cells(&self) -> &[Value] {
   252	        &self.cells
   253	    }
   254	
   255	    /// Iterate cells in row-major order.
   256	    pub fn iter(&self) -> std::slice::Iter<'_, Value> {
   257	        self.cells.iter()
   258	    }
   259	
   260	    /// Iterate rows as `&[Value]` slices. The slice length is always
   261	    /// `cols`. Skips iteration entirely if `is_degenerate()`.
   262	    pub fn iter_rows(&self) -> impl Iterator<Item = &[Value]> + '_ {
   263	        let cols = self.cols as usize;
   264	        self.cells
   265	            .chunks_exact(cols.max(1))
   266	            .take(self.rows as usize)
   267	    }
   268	}
   269	
   270	#[cfg(test)]
   271	mod tests {
   272	    use super::*;
   273	    use crate::error::ErrorValue;
   274	
   275	    fn n(x: f64) -> Value {
   276	        Value::Number(x)
   277	    }
   278	
   279	    #[test]
   280	    fn singleton_is_1x1() {
   281	        let a = ArrayValue::singleton(n(42.0));
   282	        assert_eq!(a.rows(), 1);
   283	        assert_eq!(a.cols(), 1);
   284	        assert_eq!(a.len(), 1);
   285	        assert!(!a.is_degenerate());
   286	        assert!(matches!(a.first(), Value::Number(x) if *x == 42.0));
   287	    }
   288	
   289	    #[test]
   290	    fn row_constructor_is_1xn() {
   291	        let a = ArrayValue::row(vec![n(1.0), n(2.0), n(3.0)]);
   292	        assert_eq!(a.rows(), 1);
   293	        assert_eq!(a.cols(), 3);
   294	        assert_eq!(a.len(), 3);
   295	        assert!(matches!(a.at(0, 1), Value::Number(x) if *x == 2.0));
   296	    }
   297	
   298	    #[test]
   299	    fn column_constructor_is_nx1() {
   300	        let a = ArrayValue::column(vec![n(1.0), n(2.0), n(3.0)]);
   301	        assert_eq!(a.rows(), 3);
   302	        assert_eq!(a.cols(), 1);
   303	        assert_eq!(a.len(), 3);
   304	        assert!(matches!(a.at(1, 0), Value::Number(x) if *x == 2.0));
   305	    }
   306	
   307	    #[test]
   308	    fn new_validates_cell_count() {
   309	        // Wrong count — error.
   310	        let err = ArrayValue::new(2, 3, vec![n(1.0); 5]).unwrap_err();
   311	        assert!(matches!(
   312	            err,
   313	            ArrayShapeError::CellCountMismatch {
   314	                rows: 2,
   315	                cols: 3,
   316	                expected: 6,
   317	                found: 5
   318	            }
   319	        ));
   320	        // Right count — ok.
   321	        let a = ArrayValue::new(2, 3, vec![n(1.0); 6]).unwrap();
   322	        assert_eq!(a.rows(), 2);
   323	        assert_eq!(a.cols(), 3);
   324	        assert_eq!(a.len(), 6);
   325	    }
   326	
   327	    #[test]
   328	    fn new_with_degenerate_shape_requires_empty_cells() {
   329	        // 0×N or N×0 with empty cells — ok.
   330	        let a = ArrayValue::new(0, 5, vec![]).unwrap();
   331	        assert!(a.is_degenerate());
   332	        assert!(a.is_empty());
   333	        let b = ArrayValue::new(5, 0, vec![]).unwrap();
   334	        assert!(b.is_degenerate());
   335	        // 0×N with cells — error.
   336	        let err = ArrayValue::new(0, 5, vec![n(1.0)]).unwrap_err();
   337	        assert!(matches!(err, ArrayShapeError::CellCountMismatch { .. }));
   338	    }
   339	
   340	    #[test]
   341	    fn empty_helper_constructs_degenerate() {
   342	        let a = ArrayValue::empty(0, 3);
   343	        assert!(a.is_degenerate());
   344	        assert_eq!(a.rows(), 0);
   345	        assert_eq!(a.cols(), 3);
   346	        assert_eq!(a.len(), 0);
   347	    }
   348	
   349	    #[test]
   350	    fn row_major_indexing() {
   351	        // 2×3 row-major: [1, 2, 3, 4, 5, 6]
   352	        //                 [[1, 2, 3], [4, 5, 6]]
   353	        let a =
   354	            ArrayValue::new(2, 3, vec![n(1.0), n(2.0), n(3.0), n(4.0), n(5.0), n(6.0)]).unwrap();
   355	        assert!(matches!(a.at(0, 0), Value::Number(x) if *x == 1.0));
   356	        assert!(matches!(a.at(0, 1), Value::Number(x) if *x == 2.0));
   357	        assert!(matches!(a.at(0, 2), Value::Number(x) if *x == 3.0));
   358	        assert!(matches!(a.at(1, 0), Value::Number(x) if *x == 4.0));
   359	        assert!(matches!(a.at(1, 1), Value::Number(x) if *x == 5.0));
   360	        assert!(matches!(a.at(1, 2), Value::Number(x) if *x == 6.0));
   361	    }
   362	
   363	    #[test]
   364	    fn get_returns_none_for_out_of_bounds() {
   365	        let a = ArrayValue::row(vec![n(1.0), n(2.0)]);
   366	        assert!(a.get(0, 0).is_some());
   367	        assert!(a.get(0, 2).is_none());
   368	        assert!(a.get(1, 0).is_none());
   369	        assert!(a.get(u32::MAX, u32::MAX).is_none());
   370	    }
   371	
   372	    #[test]
   373	    #[should_panic(expected = "out of bounds")]
   374	    fn at_panics_on_out_of_bounds() {
   375	        let a = ArrayValue::row(vec![n(1.0)]);
   376	        let _ = a.at(0, 7);
   377	    }
   378	
   379	    #[test]
   380	    #[should_panic(expected = "degenerate array has no cells")]
   381	    fn first_panics_on_degenerate() {
   382	        let a = ArrayValue::empty(0, 3);
   383	        let _ = a.first();
   384	    }
   385	
   386	    #[test]
   387	    fn iter_rows_yields_row_slices() {
   388	        // 2×3 array; iter_rows should yield two slices of len 3 each.
   389	        let a =
   390	            ArrayValue::new(2, 3, vec![n(1.0), n(2.0), n(3.0), n(4.0), n(5.0), n(6.0)]).unwrap();
   391	        let rows: Vec<&[Value]> = a.iter_rows().collect();
   392	        assert_eq!(rows.len(), 2);
   393	        assert_eq!(rows[0].len(), 3);
   394	        assert_eq!(rows[1].len(), 3);
   395	        assert!(matches!(rows[0][2], Value::Number(x) if x == 3.0));
   396	        assert!(matches!(rows[1][0], Value::Number(x) if x == 4.0));
   397	    }
   398	
   399	    #[test]
   400	    fn iter_yields_row_major() {
   401	        let a = ArrayValue::new(2, 2, vec![n(10.0), n(20.0), n(30.0), n(40.0)]).unwrap();
   402	        let vs: Vec<f64> = a
   403	            .iter()
   404	            .map(|v| match v {
   405	                Value::Number(x) => *x,
   406	                _ => panic!("not a number"),
   407	            })
   408	            .collect();
   409	        assert_eq!(vs, vec![10.0, 20.0, 30.0, 40.0]);
   410	    }
   411	
   412	    #[test]
   413	    fn heterogeneous_cells_compile() {
   414	        // Array cells can be mixed type. Excel canon: error literals can
   415	        // appear in array constants. Verify the type accepts the union.
   416	        let a = ArrayValue::row(vec![
   417	            Value::Number(1.5),
   418	            Value::Boolean(true),
   419	            Value::text("hi"),
   420	            Value::Error(ErrorValue::Num),
   421	        ]);
   422	        assert_eq!(a.len(), 4);
   423	        assert!(matches!(a.at(0, 3), Value::Error(ErrorValue::Num)));
   424	    }
   425	
   426	    #[test]
   427	    fn default_is_degenerate_zero_zero() {
   428	        let a = ArrayValue::default();
   429	        assert_eq!(a.rows(), 0);
   430	        assert_eq!(a.cols(), 0);
   431	        assert!(a.is_degenerate());
   432	        assert!(a.is_empty());
   433	    }
   434	
   435	    #[test]
   436	    fn equality_compares_shape_and_cells() {
   437	        let a = ArrayValue::row(vec![n(1.0), n(2.0)]);
   438	        let b = ArrayValue::row(vec![n(1.0), n(2.0)]);
   439	        let c = ArrayValue::column(vec![n(1.0), n(2.0)]); // same cells, different shape
   440	        let d = ArrayValue::row(vec![n(1.0), n(3.0)]); // different cells
   441	        assert_eq!(a, b);
   442	        assert_ne!(a, c);
   443	        assert_ne!(a, d);
   444	    }
   445	}

