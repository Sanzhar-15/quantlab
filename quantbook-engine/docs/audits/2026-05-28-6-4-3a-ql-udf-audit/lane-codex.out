     1	//! `ErrorValue` — the 14 error kinds the Quantbook engine surfaces, per spec Part V §2.
     2	//!
     3	//! Nine are Excel-equivalents (`#REF!`, `#VALUE!`, `#N/A`, `#DIV/0!`, `#NULL!`, `#NUM!`,
     4	//! `#NAME?`, `#SPILL!`, `#CALC!`). Four are Quantbook-specific surfaces for kernel/connector
     5	//! failures, and one is reserved for the AI cell function:
     6	//! - `Disconnected` — terminal:// or external data source went away
     7	//! - `Binding` — `qb.show(df)` BoundFrame coercion failed
     8	//! - `Timeout` — UDF / connector exceeded its budget
     9	//! - `Permission` — Workspace-Trust gate denied (kernel spawn / file read)
    10	//! - `AINotAvailable` — parser-reserved error for `=AI(...)` until the v2 AI cell function ships
    11	//!   (Round 7 CORR-06 / T4-D05; sigil `#AI_NOT_AVAILABLE_V1`)
    12	//!
    13	//! `#CIRC!` was added in Engine Phase 3.4 (W5-37, 2026-05-12) — the Tarjan SCC scheduler
    14	//! emits it for cells in non-trivial strongly connected components or with a self-loop.
    15	//! `#NIMPL!` and `#CANCEL!` remain deferred (interpreter / collab phases).
    16	
    17	use std::fmt;
    18	use std::str::FromStr;
    19	
    20	/// Excel + Quantbook error surface. Cheap (1 byte enum), `Copy`, structurally compared.
    21	///
    22	/// Marked `#[non_exhaustive]`: Excel periodically introduces new error
    23	/// sigils (e.g. `#FIELD!`, `#PYTHON!`, `#BUSY!`), so downstream consumers
    24	/// must include a `_` arm when matching across crate boundaries.
    25	#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
    26	#[non_exhaustive]
    27	pub enum ErrorValue {
    28	    /// `#REF!` — formula refers to a cell/range that no longer exists.
    29	    Ref,
    30	    /// `#VALUE!` — wrong-type argument (e.g. text where number expected, strict coercion).
    31	    Value,
    32	    /// `#N/A` — explicitly-not-available result (lookup miss).
    33	    NA,
    34	    /// `#DIV/0!` — division by zero / modulo zero.
    35	    DivZero,
    36	    /// `#NULL!` — intersection of two ranges is empty.
    37	    Null,
    38	    /// `#NUM!` — number out of range / NaN / infinity result.
    39	    Num,
    40	    /// `#NAME?` — unresolved name (named range, function, defined name).
    41	    Name,
    42	    /// `#SPILL!` — dynamic-array spill blocked (target region not empty, or merged cell).
    43	    Spill,
    44	    /// `#CALC!` — generic calculation error (LAMBDA recursion, empty array, etc.).
    45	    Calc,
    46	    /// `#DISCONNECTED!` — terminal:// or external data source unavailable. Quantbook-specific.
    47	    Disconnected,
    48	    /// `#BINDING!` — `qb.show(df)` round-trip coercion failed (df schema drift). Quantbook-specific.
    49	    Binding,
    50	    /// `#TIMEOUT!` — UDF or connector exceeded its budget. Quantbook-specific.
    51	    Timeout,
    52	    /// `#PERMISSION!` — Workspace-Trust gate denied an operation. Quantbook-specific.
    53	    Permission,
    54	    /// `#AI_NOT_AVAILABLE_V1` — `=AI(...)` is reserved keyword in Phase 0; the actual AI cell
    55	    /// function ships in v2. Parser emits `Error(AINotAvailable)` on any `=AI(...)` formula
    56	    /// entry. The `_V1` suffix marks this as a temporary error class — when v2 lands, callers
    57	    /// can match-distinguish v1-era pre-AI formulas from real AI invocations.
    58	    /// Round 7 CORR-06 / T4-D05.
    59	    AINotAvailable,
    60	    /// `#CIRC!` — circular reference. Emitted by the Engine Phase 3.4 Tarjan SCC
    61	    /// scheduler for every cell in a non-trivial strongly connected component or with
    62	    /// a self-loop in the dependency graph. Excel's canonical surface for cycles.
    63	    Circ,
    64	}
    65	
    66	impl ErrorValue {
    67	    /// Excel-style sigil string, e.g. `"#REF!"`. Stable; safe to embed in serialized
    68	    /// formats and to compare against in diagnostics.
    69	    pub fn sigil(self) -> &'static str {
    70	        match self {
    71	            ErrorValue::Ref => "#REF!",
    72	            ErrorValue::Value => "#VALUE!",
    73	            ErrorValue::NA => "#N/A",
    74	            ErrorValue::DivZero => "#DIV/0!",
    75	            ErrorValue::Null => "#NULL!",
    76	            ErrorValue::Num => "#NUM!",
    77	            ErrorValue::Name => "#NAME?",
    78	            ErrorValue::Spill => "#SPILL!",
    79	            ErrorValue::Calc => "#CALC!",
    80	            ErrorValue::Disconnected => "#DISCONNECTED!",
    81	            ErrorValue::Binding => "#BINDING!",
    82	            ErrorValue::Timeout => "#TIMEOUT!",
    83	            ErrorValue::Permission => "#PERMISSION!",
    84	            ErrorValue::AINotAvailable => "#AI_NOT_AVAILABLE_V1",
    85	            ErrorValue::Circ => "#CIRC!",
    86	        }
    87	    }
    88	
    89	    /// All 15 variants in declaration order. Stable; used by exhaustiveness tests and the
    90	    /// future error-surface UI.
    91	    pub const ALL: [ErrorValue; 15] = [
    92	        ErrorValue::Ref,
    93	        ErrorValue::Value,
    94	        ErrorValue::NA,
    95	        ErrorValue::DivZero,
    96	        ErrorValue::Null,
    97	        ErrorValue::Num,
    98	        ErrorValue::Name,
    99	        ErrorValue::Spill,
   100	        ErrorValue::Calc,
   101	        ErrorValue::Disconnected,
   102	        ErrorValue::Binding,
   103	        ErrorValue::Timeout,
   104	        ErrorValue::Permission,
   105	        ErrorValue::AINotAvailable,
   106	        ErrorValue::Circ,
   107	    ];
   108	}
   109	
   110	impl fmt::Display for ErrorValue {
   111	    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
   112	        f.write_str(self.sigil())
   113	    }
   114	}
   115	
   116	/// Parse from the Excel sigil (`#REF!`, `#VALUE!`, …) or the Quantbook-specific sigils.
   117	/// Comparison is ASCII case-insensitive on the sigil (Excel itself preserves case in source
   118	/// but is case-insensitive on parse).
   119	impl FromStr for ErrorValue {
   120	    type Err = ParseErrorValueError;
   121	    fn from_str(s: &str) -> Result<Self, Self::Err> {
   122	        // Search ALL — cheap (14 entries) and avoids hand-mapping mistakes.
   123	        for e in ErrorValue::ALL {
   124	            if s.eq_ignore_ascii_case(e.sigil()) {
   125	                return Ok(e);
   126	            }
   127	        }
   128	        Err(ParseErrorValueError {
   129	            input: s.to_owned(),
   130	        })
   131	    }
   132	}
   133	
   134	/// Returned by `<ErrorValue as FromStr>::from_str` when the input isn't a known sigil.
   135	#[derive(Clone, Debug, PartialEq, Eq)]
   136	pub struct ParseErrorValueError {
   137	    pub input: String,
   138	}
   139	
   140	impl fmt::Display for ParseErrorValueError {
   141	    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
   142	        write!(f, "not a recognized error sigil: {:?}", self.input)
   143	    }
   144	}
   145	
   146	impl std::error::Error for ParseErrorValueError {}
   147	
   148	#[cfg(test)]
   149	mod tests {
   150	    use super::*;
   151	
   152	    #[test]
   153	    fn all_contains_fifteen_distinct_variants() {
   154	        assert_eq!(ErrorValue::ALL.len(), 15);
   155	        // Distinctness: convert to a set-shaped Vec of sigils and check.
   156	        let mut sigils: Vec<&str> = ErrorValue::ALL.iter().map(|e| e.sigil()).collect();
   157	        sigils.sort();
   158	        sigils.dedup();
   159	        assert_eq!(sigils.len(), 15);
   160	    }
   161	
   162	    /// Engine Phase 3.4 (2026-05-12): `#CIRC!` is the canonical Excel sigil for
   163	    /// circular references. The Tarjan SCC scheduler emits it for every cell in
   164	    /// a non-trivial SCC or with a self-loop.
   165	    #[test]
   166	    fn sigil_circ_matches_excel_canonical_form() {
   167	        assert_eq!(ErrorValue::Circ.sigil(), "#CIRC!");
   168	        // Round-trip.
   169	        assert_eq!("#CIRC!".parse::<ErrorValue>().unwrap(), ErrorValue::Circ);
   170	        // Case-insensitive.
   171	        assert_eq!("#circ!".parse::<ErrorValue>().unwrap(), ErrorValue::Circ);
   172	    }
   173	
   174	    #[test]
   175	    fn sigil_excel_set_matches_excel_canonical_forms() {
   176	        assert_eq!(ErrorValue::Ref.sigil(), "#REF!");
   177	        assert_eq!(ErrorValue::Value.sigil(), "#VALUE!");
   178	        assert_eq!(ErrorValue::NA.sigil(), "#N/A");
   179	        assert_eq!(ErrorValue::DivZero.sigil(), "#DIV/0!");
   180	        assert_eq!(ErrorValue::Null.sigil(), "#NULL!");
   181	        assert_eq!(ErrorValue::Num.sigil(), "#NUM!");
   182	        assert_eq!(ErrorValue::Name.sigil(), "#NAME?");
   183	        assert_eq!(ErrorValue::Spill.sigil(), "#SPILL!");
   184	        assert_eq!(ErrorValue::Calc.sigil(), "#CALC!");
   185	    }
   186	
   187	    #[test]
   188	    fn sigil_quantbook_specific() {
   189	        assert_eq!(ErrorValue::Disconnected.sigil(), "#DISCONNECTED!");
   190	        assert_eq!(ErrorValue::Binding.sigil(), "#BINDING!");
   191	        assert_eq!(ErrorValue::Timeout.sigil(), "#TIMEOUT!");
   192	        assert_eq!(ErrorValue::Permission.sigil(), "#PERMISSION!");
   193	        assert_eq!(ErrorValue::AINotAvailable.sigil(), "#AI_NOT_AVAILABLE_V1");
   194	    }
   195	
   196	    #[test]
   197	    fn ai_not_available_parses_with_v1_suffix() {
   198	        // CORR-06 / T4-D05: the parser-emitted sigil must round-trip identically.
   199	        assert_eq!(
   200	            "#AI_NOT_AVAILABLE_V1".parse::<ErrorValue>().unwrap(),
   201	            ErrorValue::AINotAvailable
   202	        );
   203	        // ASCII case-insensitive (consistent with the other variants).
   204	        assert_eq!(
   205	            "#ai_not_available_v1".parse::<ErrorValue>().unwrap(),
   206	            ErrorValue::AINotAvailable
   207	        );
   208	    }
   209	
   210	    #[test]
   211	    fn display_matches_sigil() {
   212	        for e in ErrorValue::ALL {
   213	            assert_eq!(format!("{e}"), e.sigil());
   214	        }
   215	    }
   216	
   217	    #[test]
   218	    fn from_str_roundtrips_all_variants() {
   219	        for e in ErrorValue::ALL {
   220	            assert_eq!(e.sigil().parse::<ErrorValue>().unwrap(), e);
   221	        }
   222	    }
   223	
   224	    #[test]
   225	    fn from_str_case_insensitive() {
   226	        assert_eq!("#ref!".parse::<ErrorValue>().unwrap(), ErrorValue::Ref);
   227	        assert_eq!("#Value!".parse::<ErrorValue>().unwrap(), ErrorValue::Value);
   228	        assert_eq!("#n/A".parse::<ErrorValue>().unwrap(), ErrorValue::NA);
   229	        assert_eq!(
   230	            "#disconnected!".parse::<ErrorValue>().unwrap(),
   231	            ErrorValue::Disconnected
   232	        );
   233	    }
   234	
   235	    #[test]
   236	    fn from_str_rejects_unknown() {
   237	        assert!("#NOTAREAL!".parse::<ErrorValue>().is_err());
   238	        assert!("".parse::<ErrorValue>().is_err());
   239	        assert!("REF".parse::<ErrorValue>().is_err());
   240	        assert!("garbage".parse::<ErrorValue>().is_err());
   241	    }
   242	
   243	    #[test]
   244	    fn parse_error_carries_input() {
   245	        let e = "#NOPE".parse::<ErrorValue>().unwrap_err();
   246	        assert_eq!(e.input, "#NOPE");
   247	    }
   248	
   249	    #[test]
   250	    fn copy_is_actually_copy() {
   251	        // Compile-time guard: ErrorValue is Copy. If someone adds a heap-bearing variant
   252	        // this test refuses to compile.
   253	        fn assert_copy<T: Copy>() {}
   254	        assert_copy::<ErrorValue>();
   255	        let a = ErrorValue::Ref;
   256	        let b = a; // move-out-of-Copy is ok
   257	        assert_eq!(a, b);
   258	    }
   259	
   260	    #[test]
   261	    fn equality_is_structural() {
   262	        assert_eq!(ErrorValue::DivZero, ErrorValue::DivZero);
   263	        assert_ne!(ErrorValue::DivZero, ErrorValue::Num);
   264	    }
   265	}

