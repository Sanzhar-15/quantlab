   151	    fn from(e: ErrorValue) -> Self {
   152	        Value::Error(e)
   153	    }
   154	}
   155	
   156	#[cfg(test)]
   157	mod tests {
   158	    use super::*;
   159	
   160	    #[test]
   161	    fn default_is_blank() {
   162	        assert!(matches!(Value::default(), Value::Blank));
   163	    }
   164	
   165	    #[test]
   166	    fn number_constructor_sanitizes_nan_and_inf() {
   167	        assert_eq!(Value::number(f64::NAN), Value::Error(ErrorValue::Num));
   168	        assert_eq!(Value::number(f64::INFINITY), Value::Error(ErrorValue::Num));
   169	        assert_eq!(
   170	            Value::number(f64::NEG_INFINITY),
   171	            Value::Error(ErrorValue::Num)
   172	        );
   173	        assert_eq!(Value::number(1.5), Value::Number(1.5));
   174	        assert_eq!(Value::number(0.0), Value::Number(0.0));
   175	        assert_eq!(Value::number(-0.0), Value::Number(-0.0));
   176	    }
   177	
   178	    #[test]
   179	    fn text_constructor_shares_buffer_for_arc_input() {
   180	        let arc: Arc<str> = "hi".into();
   181	        let v = Value::text(Arc::clone(&arc));
   182	        if let Value::Text(t) = v {
   183	            assert!(Arc::ptr_eq(&arc, &t));
   184	        } else {
   185	            panic!();
   186	        }
   187	    }
   188	
   189	    #[test]
   190	    fn is_error_helper() {
   191	        assert!(Value::Error(ErrorValue::Ref).is_error());
   192	        assert!(!Value::Number(1.0).is_error());
   193	        assert!(!Value::Blank.is_error());
   194	    }
   195	
   196	    #[test]
   197	    fn is_blank_helper() {
   198	        assert!(Value::Blank.is_blank());
   199	        assert!(!Value::Number(0.0).is_blank());
   200	        assert!(!Value::text("").is_blank()); // "" is Text, not Blank
   201	    }
   202	
   203	    #[test]
   204	    fn as_error_yields_error_only() {
   205	        assert_eq!(
   206	            Value::Error(ErrorValue::Num).as_error(),
   207	            Some(ErrorValue::Num)
   208	        );
   209	        assert_eq!(Value::Number(1.0).as_error(), None);
   210	        assert_eq!(Value::Blank.as_error(), None);
   211	    }
   212	
   213	    #[test]
   214	    fn display_matches_excel_invariant_forms() {
   215	        assert_eq!(format!("{}", Value::Blank), "");
   216	        assert_eq!(format!("{}", Value::Number(1.5)), "1.5");
   217	        assert_eq!(format!("{}", Value::Number(0.0)), "0");
   218	        assert_eq!(format!("{}", Value::Boolean(true)), "TRUE");
   219	        assert_eq!(format!("{}", Value::Boolean(false)), "FALSE");
   220	        assert_eq!(format!("{}", Value::text("hi")), "hi");
   221	        assert_eq!(format!("{}", Value::Error(ErrorValue::Ref)), "#REF!");
   222	    }
   223	
   224	    #[test]
   225	    fn equality_is_structural_per_variant() {
   226	        assert_eq!(Value::Blank, Value::Blank);
   227	        assert_eq!(Value::Number(1.5), Value::Number(1.5));
   228	        assert_eq!(Value::Boolean(true), Value::Boolean(true));
   229	        assert_eq!(Value::text("a"), Value::text("a"));
   230	        assert_eq!(Value::Error(ErrorValue::Ref), Value::Error(ErrorValue::Ref));
   231	        // Cross-variant inequality:
   232	        assert_ne!(Value::Blank, Value::Number(0.0));
   233	        assert_ne!(Value::Number(0.0), Value::Boolean(false));
   234	        assert_ne!(Value::text(""), Value::Blank);
   235	    }
   236	
   237	    #[test]
   238	    fn nan_number_unequal_per_ieee() {
   239	        // Note: Value::number sanitizes NaN, so the only way to construct Number(NaN) is via
   240	        // the raw variant. We construct it explicitly here to lock in the IEEE-754 semantics.
   241	        let a = Value::Number(f64::NAN);
   242	        let b = Value::Number(f64::NAN);
   243	        assert_ne!(a, b);
   244	    }
   245	
   246	    #[test]
   247	    fn from_impls() {
   248	        assert_eq!(Value::from(1.5_f64), Value::Number(1.5));
   249	        assert_eq!(Value::from(f64::NAN), Value::Error(ErrorValue::Num));
   250	        assert_eq!(Value::from(true), Value::Boolean(true));
   251	        assert_eq!(Value::from("hi"), Value::text("hi"));
   252	        assert_eq!(Value::from(String::from("x")), Value::text("x"));
   253	        assert_eq!(
   254	            Value::from(ErrorValue::Permission),
   255	            Value::Error(ErrorValue::Permission)
   256	        );
   257	    }
   258	
   259	    #[test]
   260	    fn size_of_value_is_reasonable() {
   261	        // 24 bytes on 64-bit is the natural size (Arc fat pointer + discriminant + padding).
   262	        // If this gets larger something added a heap-bearing variant — flag it loudly.
   263	        assert!(
   264	            std::mem::size_of::<Value>() <= 24,
   265	            "Value grew to {} bytes — investigate",
   266	            std::mem::size_of::<Value>()
   267	        );
   268	    }
   269	}

