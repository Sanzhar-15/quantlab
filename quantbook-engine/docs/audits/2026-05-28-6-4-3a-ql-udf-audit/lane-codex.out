   133	        let mut slow = MockWorker::new(|_h, _a| Err(UdfError::Timeout(Duration::from_millis(500))));
   134	        assert!(matches!(
   135	            slow.call(1, &scalar(Value::Blank), Duration::from_millis(500)),
   136	            Err(UdfError::Timeout(_))
