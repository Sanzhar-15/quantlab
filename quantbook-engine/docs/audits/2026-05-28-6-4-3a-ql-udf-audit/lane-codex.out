     1	//! The [`UdfWorker`] abstraction + its error taxonomy + an in-process
     2	//! [`MockWorker`].
     3	//!
     4	//! **6.4-3a.** The eval layer (6.4-3c) will hold a `&mut dyn UdfWorker` on the
     5	//! eval context and call it from the `RegisteredFn::Udf` dispatch arm. This cycle
     6	//! defines the trait + the loud [`UdfError`] taxonomy and proves the call paths
     7	//! (success / raise / timeout) against a [`MockWorker`] — **no subprocess, no
     8	//! Python**. The real process-backed worker (spawn / handshake / timeout-kill /
     9	//! respawn) lands in 6.4-3b and will implement this same trait.
    10	
    11	use std::time::Duration;
    12	
    13	use ql_types::ArrayValue;
    14	
    15	use crate::codec::CodecError;
    16	
    17	/// Outcome of a failed UDF dispatch. Every variant maps to a *deterministic*
    18	/// engine-side result at the call site (6.4-3c) — a cell error value + a
    19	/// `CellDiagnostic` — never a panic and never a silently-dropped failure
    20	/// (No-Fallbacks; contract §10.4 exit tests 6 + 7).
    21	#[derive(Debug, thiserror::Error)]
    22	pub enum UdfError {
    23	    /// The Python callable raised. Maps to `#CALC!`/`#VALUE!` + a diagnostic
    24	    /// carrying `exc_type` + `message` (exit test 7).
    25	    #[error("udf raised {exc_type}: {message}")]
    26	    Raised { exc_type: String, message: String },
    27	    /// The call exceeded its deadline. The worker is killed; the result (if any
    28	    /// arrives late) is dropped (exit test 6). Maps to `#TIMEOUT!`.
    29	    #[error("udf timed out after {0:?}")]
    30	    Timeout(Duration),
    31	    /// The worker process died / the transport broke. Maps to `#CALC!` + a
    32	    /// diagnostic; the worker respawns lazily on the next call.
    33	    #[error("udf worker died / transport broken: {0}")]
    34	    WorkerDied(String),
    35	    /// Args could not be encoded, or the result could not be decoded.
    36	    #[error("udf codec: {0}")]
    37	    Codec(#[from] CodecError),
    38	}
    39	
    40	/// Dispatch one UDF call: marshal `args`, invoke the worker function identified by
    41	/// `handle`, and return its result grid — subject to `deadline`.
    42	///
    43	/// Implementations must guarantee: a `deadline` breach surfaces
    44	/// [`UdfError::Timeout`] (and, for a real process worker, kills it), and a dead
    45	/// worker surfaces [`UdfError::WorkerDied`] rather than hanging. A scalar result
    46	/// is a 1×1 [`ArrayValue`].
    47	pub trait UdfWorker {
    48	    fn call(
    49	        &mut self,
    50	        handle: u64,
    51	        args: &ArrayValue,
    52	        deadline: Duration,
    53	    ) -> Result<ArrayValue, UdfError>;
    54	}
    55	
    56	/// In-process worker double for tests + for wiring the eval layer before the real
    57	/// process worker exists. Runs a Rust closure in place of the Python callable.
    58	///
    59	/// It does NOT enforce `deadline` itself (there is no out-of-process work to time
    60	/// out) — a test simulates a timeout by having the closure return
    61	/// [`UdfError::Timeout`]. Real deadline enforcement + process-kill is 6.4-3b.
    62	pub struct MockWorker<F> {
    63	    responder: F,
    64	}
    65	
    66	impl<F> MockWorker<F>
    67	where
    68	    F: FnMut(u64, &ArrayValue) -> Result<ArrayValue, UdfError>,
    69	{
    70	    pub fn new(responder: F) -> Self {
    71	        Self { responder }
    72	    }
    73	}
    74	
    75	impl<F> UdfWorker for MockWorker<F>
    76	where
    77	    F: FnMut(u64, &ArrayValue) -> Result<ArrayValue, UdfError>,
    78	{
    79	    fn call(
    80	        &mut self,
    81	        handle: u64,
    82	        args: &ArrayValue,
    83	        _deadline: Duration,
    84	    ) -> Result<ArrayValue, UdfError> {
    85	        (self.responder)(handle, args)
    86	    }
    87	}
    88	
