   140	    /// The load-bearing composition test: push args + result through the FULL
   141	    /// wire pipeline (codec → frame → … → frame → codec) with the mock standing
   142	    /// in for the worker process. Proves [`crate::codec`] + [`crate::frame`]
   143	    /// compose into a faithful round-trip — the thing the real 6.4-3b worker will
   144	    /// rely on across the actual pipe.
   145	    #[test]
   146	    fn call_round_trips_through_frame_and_codec() {
   147	        // Engine-side args grid (a 1×3 row of mixed values).
   148	        let args = ArrayValue::new(
   149	            1,
   150	            3,
   151	            vec![
