     1	//! Arrow ⇄ engine-`Value` codec — the wire payload for `CALL` / `RETURN` frames.
     2	//!
     3	//! **6.4-3a.** A UDF call's arguments and result are 2-D grids of spreadsheet
     4	//! values ([`ql_types::ArrayValue`]); a scalar is just a 1×1 grid. This module
     5	//! encodes a grid to Arrow IPC stream bytes and back.
     6	//!
     7	//! **Encoding (design §3 — the tagged columns).** Arrow has no native
     8	//! spreadsheet-error type, so a value is encoded across five parallel columns of
     9	//! length `rows*cols` (row-major), discriminated by `kind`:
    10	//!
    11	//! | kind     | populated column | engine `Value`            |
    12	//! |----------|------------------|---------------------------|
    13	//! | `blank`  | (none)           | `Value::Blank`            |
    14	//! | `number` | `num: f64`       | `Value::Number`           |
    15	//! | `bool`   | `bool: bool`     | `Value::Boolean`          |
    16	//! | `text`   | `str: Utf8`      | `Value::Text`             |
    17	//! | `error`  | `err: Utf8`      | `Value::Error` (by sigil) |
    18	//!
    19	//! The grid shape (`rows`, `cols`) rides in the Arrow schema metadata so degenerate
    20	//! shapes (`rows==0` or `cols==0`, zero cells) round-trip faithfully. The encoding
    21	//! is deliberately verbose-but-unambiguous; a compact layout is a later optimization
    22	//! behind this same boundary.
    23	
    24	use std::collections::HashMap;
    25	use std::str::FromStr;
    26	use std::sync::Arc;
    27	
    28	use arrow::array::{
    29	    Array, ArrayRef, BooleanArray, BooleanBuilder, Float64Array, Float64Builder, StringArray,
    30	    StringBuilder,
    31	};
    32	use arrow::datatypes::{DataType, Field, Schema};
    33	use arrow::ipc::reader::StreamReader;
    34	use arrow::ipc::writer::StreamWriter;
    35	use arrow::record_batch::RecordBatch;
    36	
    37	use ql_types::{ArrayValue, ErrorValue, Value};
    38	
    39	/// Failure to encode/decode a grid on the UDF wire. Every variant is loud — no
    40	/// silent normalization (No-Fallbacks).
    41	#[derive(Debug, thiserror::Error)]
    42	pub enum CodecError {
    43	    /// Underlying Arrow IPC read/write error.
    44	    #[error("arrow ipc: {0}")]
    45	    Arrow(#[from] arrow::error::ArrowError),
    46	    /// The IPC stream contained no record batch.
    47	    #[error("decode: empty IPC stream (expected exactly one record batch)")]
    48	    Empty,
    49	    /// The schema metadata was missing the `rows`/`cols` shape keys.
    50	    #[error("decode: missing '{0}' in schema metadata")]
    51	    MissingShape(&'static str),
    52	    /// A shape metadata value did not parse as a u32.
    53	    #[error("decode: shape '{key}' = {value:?} is not a u32")]
    54	    BadShape { key: &'static str, value: String },
    55	    /// A column was absent or had the wrong Arrow type.
    56	    #[error("decode: column {0} missing or wrong type")]
    57	    BadColumn(&'static str),
    58	    /// A `kind` discriminant was not one of the five known tags.
    59	    #[error("decode: unknown kind {0:?}")]
    60	    BadKind(String),
    61	    /// An `error` cell carried a sigil that is not a known `ErrorValue`.
    62	    #[error("decode: unknown error sigil {0:?}")]
    63	    BadErrorSigil(String),
    64	    /// The decoded cells did not match the declared shape.
    65	    #[error("decode: shape mismatch ({0})")]
    66	    ShapeMismatch(String),
    67	}
    68	
    69	const COL_KIND: usize = 0;
    70	const COL_NUM: usize = 1;
    71	const COL_STR: usize = 2;
    72	const COL_BOOL: usize = 3;
    73	const COL_ERR: usize = 4;
    74	
    75	fn grid_schema(rows: u32, cols: u32) -> Schema {
    76	    let fields = vec![
    77	        Field::new("kind", DataType::Utf8, false),
    78	        Field::new("num", DataType::Float64, true),
    79	        Field::new("str", DataType::Utf8, true),
    80	        Field::new("bool", DataType::Boolean, true),
    81	        Field::new("err", DataType::Utf8, true),
    82	    ];
    83	    let metadata = HashMap::from([
    84	        ("rows".to_string(), rows.to_string()),
    85	        ("cols".to_string(), cols.to_string()),
    86	    ]);
    87	    Schema::new(fields).with_metadata(metadata)
    88	}
    89	
    90	/// Encode a grid to Arrow IPC stream bytes (the `CALL`/`RETURN` frame payload).
    91	pub fn encode_grid(grid: &ArrayValue) -> Result<Vec<u8>, CodecError> {
    92	    let rows = grid.rows();
    93	    let cols = grid.cols();
    94	
    95	    let mut kind = StringBuilder::new();
    96	    let mut num = Float64Builder::new();
    97	    let mut text = StringBuilder::new();
    98	    let mut boolean = BooleanBuilder::new();
    99	    let mut err = StringBuilder::new();
   100	
   101	    // Row-major, matching `ArrayValue`'s own cell ordering.
   102	    for r in 0..rows {
   103	        for c in 0..cols {
   104	            let v = grid
   105	                .get(r, c)
   106	                .ok_or_else(|| CodecError::ShapeMismatch(format!("get({r},{c}) out of bounds")))?;
   107	            match v {
   108	                Value::Blank => {
   109	                    kind.append_value("blank");
   110	                    num.append_null();
   111	                    text.append_null();
   112	                    boolean.append_null();
   113	                    err.append_null();
   114	                }
   115	                Value::Number(x) => {
   116	                    kind.append_value("number");
   117	                    num.append_value(*x);
   118	                    text.append_null();
   119	                    boolean.append_null();
   120	                    err.append_null();
   121	                }
   122	                Value::Boolean(x) => {
   123	                    kind.append_value("bool");
   124	                    num.append_null();
   125	                    text.append_null();
   126	                    boolean.append_value(*x);
   127	                    err.append_null();
   128	                }
   129	                Value::Text(t) => {
   130	                    kind.append_value("text");
   131	                    num.append_null();
   132	                    text.append_value(t.as_ref());
   133	                    boolean.append_null();
   134	                    err.append_null();
   135	                }
   136	                Value::Error(e) => {
   137	                    kind.append_value("error");
   138	                    num.append_null();
   139	                    text.append_null();
   140	                    boolean.append_null();
   141	                    err.append_value(e.sigil());
   142	                }
   143	            }
   144	        }
   145	    }
   146	
   147	    let columns: Vec<ArrayRef> = vec![
   148	        Arc::new(kind.finish()),
   149	        Arc::new(num.finish()),
   150	        Arc::new(text.finish()),
   151	        Arc::new(boolean.finish()),
   152	        Arc::new(err.finish()),
   153	    ];
   154	    let schema = Arc::new(grid_schema(rows, cols));
   155	    let batch = RecordBatch::try_new(schema.clone(), columns)?;
   156	
   157	    let mut buf = Vec::new();
   158	    {
   159	        let mut writer = StreamWriter::try_new(&mut buf, &schema)?;
   160	        writer.write(&batch)?;
   161	        writer.finish()?;
   162	    }
   163	    Ok(buf)
   164	}
   165	
   166	fn shape_from_metadata(md: &HashMap<String, String>, key: &'static str) -> Result<u32, CodecError> {
   167	    let raw = md.get(key).ok_or(CodecError::MissingShape(key))?;
   168	    raw.parse::<u32>().map_err(|_| CodecError::BadShape {
   169	        key,
   170	        value: raw.clone(),
   171	    })
   172	}
   173	
   174	fn col<'a, T: Array + 'static>(batch: &'a RecordBatch, idx: usize, name: &'static str) -> Result<&'a T, CodecError> {
   175	    batch
   176	        .column(idx)
   177	        .as_any()
   178	        .downcast_ref::<T>()
   179	        .ok_or(CodecError::BadColumn(name))
   180	}
   181	
   182	/// Decode Arrow IPC stream bytes (a `CALL`/`RETURN` frame payload) back to a grid.
   183	pub fn decode_grid(bytes: &[u8]) -> Result<ArrayValue, CodecError> {
   184	    let mut reader = StreamReader::try_new(std::io::Cursor::new(bytes), None)?;
   185	    let batch = reader.next().ok_or(CodecError::Empty)??;
   186	
   187	    let schema = batch.schema();
   188	    let rows = shape_from_metadata(schema.metadata(), "rows")?;
   189	    let cols = shape_from_metadata(schema.metadata(), "cols")?;
   190	
   191	    let kind = col::<StringArray>(&batch, COL_KIND, "kind")?;
   192	    let num = col::<Float64Array>(&batch, COL_NUM, "num")?;
   193	    let text = col::<StringArray>(&batch, COL_STR, "str")?;
   194	    let boolean = col::<BooleanArray>(&batch, COL_BOOL, "bool")?;
   195	    let err = col::<StringArray>(&batch, COL_ERR, "err")?;
   196	
   197	    let n = batch.num_rows();
   198	    let expected = (rows as usize).saturating_mul(cols as usize);
   199	    if n != expected {
   200	        return Err(CodecError::ShapeMismatch(format!(
   201	            "{n} cells but rows*cols = {expected} (rows={rows}, cols={cols})"
   202	        )));
   203	    }
   204	
   205	    let mut cells = Vec::with_capacity(n);
   206	    for i in 0..n {
   207	        let v = match kind.value(i) {
   208	            "blank" => Value::Blank,
   209	            // Raw `Value::Number` (not the sanitizing constructor) to round-trip
   210	            // the f64 bit pattern faithfully.
   211	            "number" => Value::Number(num.value(i)),
   212	            "bool" => Value::Boolean(boolean.value(i)),
   213	            "text" => Value::Text(Arc::from(text.value(i))),
   214	            "error" => {
   215	                let sigil = err.value(i);
   216	                let ev = ErrorValue::from_str(sigil)
   217	                    .map_err(|_| CodecError::BadErrorSigil(sigil.to_string()))?;
   218	                Value::Error(ev)
   219	            }
   220	            other => return Err(CodecError::BadKind(other.to_string())),
   221	        };
   222	        cells.push(v);
   223	    }
   224	
   225	    ArrayValue::new(rows, cols, cells)
   226	        .map_err(|e| CodecError::ShapeMismatch(format!("ArrayValue::new: {e:?}")))
   227	}
   228	
   229	/// Convenience: encode a single scalar as a 1×1 grid (a UDF returning a scalar).
   230	pub fn encode_scalar(value: Value) -> Result<Vec<u8>, CodecError> {
   231	    encode_grid(&ArrayValue::singleton(value))
   232	}
