   175	        // --- wire → engine: read the RETURN, decode ---
   176	        let mut rcursor = std::io::Cursor::new(back);
   177	        let rframe = read_frame(&mut rcursor).unwrap().expect("a frame");
   178	        assert_eq!(rframe.frame_type, FrameType::Return);
   179	        let final_grid = decode_grid(&rframe.payload).unwrap();
