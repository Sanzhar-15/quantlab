     1	//! The UDF wire envelope: `[u32 LE total_len][u8 frame_type][payload…]`.
     2	//!
     3	//! **6.4-3a.** `total_len` counts the type byte + payload (so a frame with an
     4	//! empty payload is `total_len == 1`). The payload bytes are **opaque at this
     5	//! layer**: for [`FrameType::Call`] / [`FrameType::Return`] they are the Arrow
     6	//! IPC stream from [`crate::codec`]; for the control frames
     7	//! ([`FrameType::Hello`] / `HelloAck` / `Raise` / `Cancel` / `Log`) the internal
     8	//! field encoding is intentionally deferred to 6.4-3b (where the real worker
     9	//! handshake pins it). This module owns only the framing + the type tag, so the
    10	//! transport is exercisable and round-trip-tested now.
    11	
    12	use std::io::{Read, Write};
    13	
    14	/// Discriminates the kind of a [`Frame`]. The `u8` tag is stable wire identity.
    15	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    16	#[repr(u8)]
    17	pub enum FrameType {
    18	    /// Worker→? handshake request (protocol version, capabilities).
    19	    Hello = 1,
    20	    /// ?→worker handshake ack (worker pid for debugpy, accepted version).
    21	    HelloAck = 2,
    22	    /// Engine→worker: one UDF invocation. Payload = Arrow IPC args grid.
    23	    Call = 3,
    24	    /// Worker→engine: success. Payload = Arrow IPC result grid.
    25	    Return = 4,
    26	    /// Worker→engine: the Python callable raised. Payload = error detail.
    27	    Raise = 5,
    28	    /// Engine→worker: cooperative cancel of an in-flight call.
    29	    Cancel = 6,
    30	    /// Worker→engine: a log line (stdout/stderr passthrough), surfaced as a diagnostic.
    31	    Log = 7,
    32	}
    33	
    34	impl FrameType {
    35	    fn from_u8(b: u8) -> Option<Self> {
    36	        match b {
    37	            1 => Some(FrameType::Hello),
    38	            2 => Some(FrameType::HelloAck),
    39	            3 => Some(FrameType::Call),
    40	            4 => Some(FrameType::Return),
    41	            5 => Some(FrameType::Raise),
    42	            6 => Some(FrameType::Cancel),
    43	            7 => Some(FrameType::Log),
    44	            _ => None,
    45	        }
    46	    }
    47	}
    48	
    49	/// A single framed message: a [`FrameType`] tag plus an opaque payload.
    50	#[derive(Debug, Clone, PartialEq, Eq)]
    51	pub struct Frame {
    52	    pub frame_type: FrameType,
    53	    pub payload: Vec<u8>,
    54	}
    55	
    56	impl Frame {
    57	    pub fn new(frame_type: FrameType, payload: Vec<u8>) -> Self {
    58	        Self {
    59	            frame_type,
    60	            payload,
    61	        }
    62	    }
    63	}
    64	
    65	/// Errors framing/deframing can produce. Loud — a malformed frame is never
    66	/// silently skipped (No-Fallbacks).
    67	#[derive(Debug, thiserror::Error)]
    68	pub enum FrameError {
    69	    #[error("frame io: {0}")]
    70	    Io(#[from] std::io::Error),
    71	    /// The declared length was zero — there is no room even for the type byte.
    72	    #[error("frame: zero-length frame (need at least the 1-byte type tag)")]
    73	    ZeroLength,
    74	    /// The type byte was not a known [`FrameType`].
    75	    #[error("frame: unknown frame type tag {0}")]
    76	    UnknownType(u8),
    77	    /// A frame payload exceeded the sanity cap.
    78	    #[error("frame: length {0} exceeds the {MAX_FRAME_LEN}-byte cap")]
    79	    TooLarge(u32),
    80	}
    81	
    82	/// Sanity cap on a single frame (64 MiB). A larger declared length is rejected
    83	/// rather than used to allocate — defends the reader against a corrupt/hostile
    84	/// length prefix.
    85	pub const MAX_FRAME_LEN: u32 = 64 * 1024 * 1024;
    86	
    87	/// Write one frame: `[u32 LE (1 + payload.len())][type][payload]`.
    88	pub fn write_frame<W: Write>(w: &mut W, frame: &Frame) -> Result<(), FrameError> {
    89	    let total = 1u64 + frame.payload.len() as u64;
    90	    if total > u64::from(MAX_FRAME_LEN) {
    91	        return Err(FrameError::TooLarge(MAX_FRAME_LEN));
    92	    }
    93	    let total = total as u32;
    94	    w.write_all(&total.to_le_bytes())?;
    95	    w.write_all(&[frame.frame_type as u8])?;
    96	    w.write_all(&frame.payload)?;
    97	    Ok(())
    98	}
    99	
   100	/// Read one frame. Returns `Ok(None)` on a clean EOF *before any bytes of the
   101	/// length prefix* (the stream ended between frames); any other short read is a
   102	/// loud error.
   103	pub fn read_frame<R: Read>(r: &mut R) -> Result<Option<Frame>, FrameError> {
   104	    let mut len_buf = [0u8; 4];
   105	    match read_exact_or_eof(r, &mut len_buf)? {
   106	        ReadOutcome::Eof => return Ok(None),
   107	        ReadOutcome::Filled => {}
   108	    }
   109	    let total = u32::from_le_bytes(len_buf);
   110	    if total == 0 {
   111	        return Err(FrameError::ZeroLength);
   112	    }
   113	    if total > MAX_FRAME_LEN {
   114	        return Err(FrameError::TooLarge(total));
   115	    }
   116	    let mut type_buf = [0u8; 1];
   117	    r.read_exact(&mut type_buf)?;
   118	    let frame_type = FrameType::from_u8(type_buf[0]).ok_or(FrameError::UnknownType(type_buf[0]))?;
   119	    let payload_len = (total - 1) as usize;
   120	    let mut payload = vec![0u8; payload_len];
   121	    r.read_exact(&mut payload)?;
   122	    Ok(Some(Frame {
   123	        frame_type,
   124	        payload,
   125	    }))
   126	}
   127	
   128	enum ReadOutcome {
   129	    Filled,
   130	    Eof,
   131	}
   132	
   133	/// Like `read_exact`, but distinguishes a clean EOF *before the first byte* (the
   134	/// stream ended between frames — a normal shutdown) from a partial read (a torn
   135	/// frame — an error).
   136	fn read_exact_or_eof<R: Read>(r: &mut R, buf: &mut [u8]) -> Result<ReadOutcome, FrameError> {
   137	    let mut filled = 0;
   138	    while filled < buf.len() {
   139	        match r.read(&mut buf[filled..]) {
   140	            Ok(0) => {
   141	                if filled == 0 {
   142	                    return Ok(ReadOutcome::Eof);
   143	                }
   144	                return Err(FrameError::Io(std::io::Error::new(
   145	                    std::io::ErrorKind::UnexpectedEof,
   146	                    "torn length prefix",
   147	                )));
   148	            }
   149	            Ok(n) => filled += n,
   150	            Err(ref e) if e.kind() == std::io::ErrorKind::Interrupted => continue,
   151	            Err(e) => return Err(FrameError::Io(e)),
   152	        }
   153	    }
   154	    Ok(ReadOutcome::Filled)
   155	}
