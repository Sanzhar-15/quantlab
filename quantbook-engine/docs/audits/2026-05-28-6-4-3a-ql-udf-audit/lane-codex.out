   157	#[cfg(test)]
   158	mod tests {
   159	    use super::*;
   160	
   161	    #[test]
   162	    fn frame_round_trips_through_a_byte_buffer() {
   163	        let frames = vec![
   164	            Frame::new(FrameType::Hello, vec![1, 2, 3]),
   165	            Frame::new(FrameType::Call, vec![0u8; 1000]),
   166	            Frame::new(FrameType::Cancel, vec![]), // empty payload → total_len == 1
   167	            Frame::new(FrameType::Return, vec![255, 0, 128]),
   168	            Frame::new(FrameType::Log, b"a warning".to_vec()),
   169	        ];
   170	        let mut buf = Vec::new();
   171	        for f in &frames {
   172	            write_frame(&mut buf, f).unwrap();
   173	        }
   174	        let mut cursor = std::io::Cursor::new(buf);
   175	        let mut got = Vec::new();
   176	        while let Some(f) = read_frame(&mut cursor).unwrap() {
   177	            got.push(f);
   178	        }
   179	        assert_eq!(got, frames);
   180	    }
   181	
   182	    #[test]
   183	    fn read_returns_none_on_clean_eof_between_frames() {
   184	        let mut cursor = std::io::Cursor::new(Vec::<u8>::new());
   185	        assert_eq!(read_frame(&mut cursor).unwrap(), None);
   186	    }
   187	
   188	    #[test]
   189	    fn read_rejects_unknown_type_tag() {
   190	        // total_len = 1 (just the type byte), type = 99 (unknown).
   191	        let mut bytes = Vec::new();
   192	        bytes.extend_from_slice(&1u32.to_le_bytes());
   193	        bytes.push(99);
   194	        let mut cursor = std::io::Cursor::new(bytes);
   195	        let e = read_frame(&mut cursor).unwrap_err();
   196	        assert!(matches!(e, FrameError::UnknownType(99)), "got {e:?}");
   197	    }
   198	
   199	    #[test]
   200	    fn read_rejects_zero_length_frame() {
   201	        let mut cursor = std::io::Cursor::new(0u32.to_le_bytes().to_vec());
   202	        let e = read_frame(&mut cursor).unwrap_err();
   203	        assert!(matches!(e, FrameError::ZeroLength), "got {e:?}");
   204	    }
   205	
   206	    #[test]
   207	    fn read_rejects_oversized_length_without_allocating() {
   208	        let mut bytes = Vec::new();
   209	        bytes.extend_from_slice(&(MAX_FRAME_LEN + 1).to_le_bytes());
   210	        let mut cursor = std::io::Cursor::new(bytes);
