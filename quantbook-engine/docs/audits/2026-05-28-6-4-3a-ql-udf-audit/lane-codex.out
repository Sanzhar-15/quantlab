   113	        });
   114	        let out = w
   115	            .call(7, &scalar(Value::Number(21.0)), Duration::from_secs(1))
   116	            .unwrap();
   117	        assert_eq!(out.get(0, 0), Some(&Value::Number(42.0)));
   118	    }
