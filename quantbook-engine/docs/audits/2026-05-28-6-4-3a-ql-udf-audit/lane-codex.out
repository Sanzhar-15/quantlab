   212	        assert!(matches!(e, FrameError::TooLarge(_)), "got {e:?}");
   213	    }
   214	
   215	    #[test]
   216	    fn torn_length_prefix_is_an_error_not_eof() {
   217	        // Two bytes then EOF — a partial length prefix is a torn frame, not a
   218	        // clean between-frames shutdown.
