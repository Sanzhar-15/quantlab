   109	def main():
   110	    # Reserve the wire-protocol channel — the engine's pipe, which `ProcessWorker`
   111	    # wires to the child's fd 1 (`Command::stdout(piped)`). Use the RAW fd 1, not
   112	    # `sys.stdout.fileno()`: an embedded host may hand us a `None`/closed
   113	    # sys.stdout, and the protocol channel is fd 1 regardless of the Python-level
   114	    # stream object.
   115	    proto_fd = os.dup(1)

