  1044	    /// Collect the populated `(row, col)` coordinates of one sheet from the live
  1045	    /// workbook (overlay value cells ∪ formula cells ∪ format-overlay cells).
  1046	    /// See the module-level read-path enumeration note.
  1047	    fn populated_coords(&self, sheet_id: SheetId) -> Vec<(RowId, ColId)> {
  1048	        let mut set: HashSet<(RowId, ColId)> = HashSet::new();
  1049	        if let Some(sheet) = self.workbook.sheet(sheet_id) {
  1050	            // Value cells: union of user + computed overlay keys across columns.
  1051	            for col in 0..sheet.column_count() as ColId {
  1052	                if let Some(column) = sheet.column(col) {
  1053	                    let chunk_rows = column.chunk_rows();
  1054	                    for (chunk_idx, _base, user, computed) in column.iter_chunks() {
  1055	                        let base_row = chunk_idx as u32 * chunk_rows;
  1056	                        for (rel_row, _v) in user.iter() {
  1057	                            set.insert((base_row + rel_row, col));
  1058	                        }
  1059	                        for (rel_row, _v) in computed.iter() {
  1060	                            set.insert((base_row + rel_row, col));
  1061	                        }
  1062	                    }
  1063	                }
  1064	            }
  1065	            // Format-only cells.
  1066	            for ((row, c), _fmt) in sheet.format_overlay().iter() {
  1067	                set.insert((row, c));
  1068	            }
  1069	        }
  1070	        // Formula cells (a formula cell can be Blank-valued but still present).
  1071	        for (s, row, col, _text) in self.workbook.iter_formulas() {
  1072	            if s == sheet_id {
  1073	                set.insert((row, col));
  1074	            }
  1075	        }
  1076	        let mut coords: Vec<(RowId, ColId)> = set.into_iter().collect();
  1077	        coords.sort_unstable();
  1078	        coords
  1079	    }
