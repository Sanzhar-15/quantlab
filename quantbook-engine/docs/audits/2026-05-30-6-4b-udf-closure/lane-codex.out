   280	
   281	/// Validate that `schema` is EXACTLY the expected 5-field grid schema (each field's
   282	/// name, type, and nullability, in order). Worker-controlled bytes are not trusted
   283	/// to honor the column order/identity; a mismatch (reordered, renamed, retyped,
   284	/// wrong count) is rejected loudly so positional column access below is sound and
   285	/// the two `Utf8` columns (`str`/`err`) can never be silently swapped.
   286	fn validate_grid_schema(schema: &Schema) -> Result<(), CodecError> {
   287	    let fields = schema.fields();
   288	    if fields.len() != EXPECTED_FIELDS.len() {
   289	        return Err(CodecError::BadSchema(format!(
   290	            "expected {} columns, got {}",
   291	            EXPECTED_FIELDS.len(),
   292	            fields.len()
   293	        )));
   294	    }
   295	    for (idx, (name, dt, nullable)) in EXPECTED_FIELDS.iter().enumerate() {
   296	        let f = &fields[idx];
   297	        if f.name() != *name {
   298	            return Err(CodecError::BadSchema(format!(
   299	                "column {idx}: expected name {name:?}, got {:?}",
   300	                f.name()
   301	            )));
   302	        }
   303	        if f.data_type() != dt {
   304	            return Err(CodecError::BadSchema(format!(
   305	                "column {idx} ({name:?}): expected type {dt:?}, got {:?}",
   306	                f.data_type()
   307	            )));
   308	        }
   309	        if f.is_nullable() != *nullable {
   310	            return Err(CodecError::BadSchema(format!(
   311	                "column {idx} ({name:?}): expected nullable={nullable}, got {}",
   312	                f.is_nullable()
   313	            )));
   314	        }
   315	    }
   316	    Ok(())
   317	}
   318	
   319	fn shape_from_metadata(md: &HashMap<String, String>, key: &'static str) -> Result<u32, CodecError> {
   320	    let raw = md.get(key).ok_or(CodecError::MissingShape(key))?;
   321	    raw.parse::<u32>().map_err(|_| CodecError::BadShape {
   322	        key,
   323	        value: raw.clone(),
   324	    })
   325	}
   326	
   327	fn col<'a, T: Array + 'static>(
   328	    batch: &'a RecordBatch,
   329	    idx: usize,
   330	    name: &'static str,
   331	) -> Result<&'a T, CodecError> {
   332	    // `idx` is in-bounds: `validate_grid_schema` has already asserted exactly 5
   333	    // columns, so `batch.column(idx)` for idx in 0..5 cannot panic.
   334	    batch
   335	        .column(idx)
   336	        .as_any()
   337	        .downcast_ref::<T>()
   338	        .ok_or(CodecError::BadColumn(name))
   339	}
   340	
   341	/// Decode Arrow IPC stream bytes (a `CALL`/`RETURN` frame payload) back to a grid.
   342	///
   343	/// Every failure mode for worker-controlled bytes is a loud [`CodecError`] — no
   344	/// reachable panic, no silent coercion (No-Fallbacks; design §5).
   345	pub fn decode_grid(bytes: &[u8]) -> Result<ArrayValue, CodecError> {
   346	    decode_grid_capped(bytes, MAX_GRID_CELLS, MAX_GRID_BYTES)
   347	}
   348	
   349	/// [`decode_grid`] with explicit caps (the public wrapper passes the
   350	/// [`MAX_GRID_CELLS`] / [`MAX_GRID_BYTES`] defaults). Split out so tests can drive
   351	/// the cap paths with tiny limits instead of decoding a multi-million-cell grid.
   352	fn decode_grid_capped(
   353	    bytes: &[u8],
   354	    max_cells: usize,
   355	    max_bytes: usize,
   356	) -> Result<ArrayValue, CodecError> {
   357	    // **6.4B (item I):** reject an over-cap input buffer up front (defense in depth
   358	    // — the transport frame layer already caps reads at `MAX_FRAME_LEN`, but a
   359	    // direct `decode_grid` of in-memory bytes does not pass through it).
   360	    if bytes.len() > max_bytes {
   361	        return Err(CodecError::GridTooManyBytes {
   362	            bytes: bytes.len(),
   363	            max: max_bytes,
   364	        });
   365	    }
   366	    let mut reader = StreamReader::try_new(std::io::Cursor::new(bytes), None)?;
   367	    let batch = reader.next().ok_or(CodecError::Empty)??;
   368	
   369	    // Exactly one batch: a worker writing extra batches into one frame is malformed.
   370	    if reader.next().is_some() {
   371	        return Err(CodecError::TrailingBatch);
   372	    }
   373	
   374	    let schema = batch.schema();
   375	    // Validate the schema BEFORE any positional column access (so `col()` indexing
   376	    // is sound) and BEFORE trusting column identity (the `Utf8` `str`/`err` columns
   377	    // are otherwise indistinguishable by type).
   378	    validate_grid_schema(&schema)?;
   379	
   380	    let rows = shape_from_metadata(schema.metadata(), "rows")?;
   381	    let cols = shape_from_metadata(schema.metadata(), "cols")?;
   382	
   383	    let kind = col::<StringArray>(&batch, COL_KIND, "kind")?;
   384	    let num = col::<Float64Array>(&batch, COL_NUM, "num")?;
   385	    let text = col::<StringArray>(&batch, COL_STR, "str")?;
   386	    let boolean = col::<BooleanArray>(&batch, COL_BOOL, "bool")?;
   387	    let err = col::<StringArray>(&batch, COL_ERR, "err")?;
   388	
   389	    let n = batch.num_rows();
   390	    // `checked_mul` (matching `ArrayValue::new`) — a hostile shape that overflows is
   391	    // a loud error, not a silent saturation that happens to disagree with `n`.
   392	    let expected = (rows as usize)
   393	        .checked_mul(cols as usize)
   394	        .ok_or(CodecError::ShapeOverflow { rows, cols })?;
   395	    if n != expected {
   396	        return Err(CodecError::ShapeMismatch(format!(
   397	            "{n} cells but rows*cols = {expected} (rows={rows}, cols={cols})"
   398	        )));
   399	    }
   400	
   401	    // **6.4B (item I):** reject an over-cap grid BEFORE the `Vec::with_capacity(n)`
   402	    // allocation below — a worker returning a legitimately-shaped but enormous grid
   403	    // (within the byte cap) is a visible `#VALUE!`, not a multi-million-element alloc.
   404	    if n > max_cells {
   405	        return Err(CodecError::GridTooManyCells {
   406	            cells: n,
   407	            max: max_cells,
   408	        });
   409	    }
   410	
   411	    let mut cells = Vec::with_capacity(n);
   412	    for i in 0..n {
   413	        // `kind` is non-nullable per the validated schema; an empty/garbage tag
   414	        // falls through to `BadKind` below rather than panicking.
   415	        let v = match kind.value(i) {
   416	            "blank" => Value::Blank,
   417	            "number" => {
   418	                if num.is_null(i) {
   419	                    return Err(CodecError::NullPayload {
   420	                        row: i,
   421	                        kind: "number".to_string(),
   422	                    });
   423	                }
   424	                let x = num.value(i);
   425	                // The engine's `Value::Number` invariant is "always finite"; a
   426	                // `NaN`/`Inf` from the worker is a malformed result (it would
   427	                // otherwise poison equality/dirty-tracking downstream).
   428	                if !x.is_finite() {
   429	                    return Err(CodecError::NonFinite { row: i, value: x });
   430	                }
   431	                Value::Number(x)
   432	            }
   433	            "bool" => {
   434	                if boolean.is_null(i) {
   435	                    return Err(CodecError::NullPayload {
   436	                        row: i,
   437	                        kind: "bool".to_string(),
   438	                    });
   439	                }
   440	                Value::Boolean(boolean.value(i))
   441	            }
   442	            "text" => {
   443	                if text.is_null(i) {
   444	                    return Err(CodecError::NullPayload {
   445	                        row: i,
   446	                        kind: "text".to_string(),
   447	                    });
   448	                }
   449	                Value::Text(Arc::from(text.value(i)))
   450	            }
   451	            "error" => {
   452	                if err.is_null(i) {
   453	                    return Err(CodecError::NullPayload {
   454	                        row: i,
   455	                        kind: "error".to_string(),
   456	                    });
   457	                }
   458	                let sigil = err.value(i);
   459	                let ev = ErrorValue::from_str(sigil)
   460	                    .map_err(|_| CodecError::BadErrorSigil(sigil.to_string()))?;
   461	                Value::Error(ev)
   462	            }
   463	            other => return Err(CodecError::BadKind(other.to_string())),
   464	        };
   465	        cells.push(v);
   466	    }
   467	
   468	    ArrayValue::new(rows, cols, cells)
   469	        .map_err(|e| CodecError::ShapeMismatch(format!("ArrayValue::new: {e:?}")))
   470	}
   471	
   472	/// Convenience: encode a single scalar as a 1×1 grid (a UDF returning a scalar).
   473	pub fn encode_scalar(value: Value) -> Result<Vec<u8>, CodecError> {
   474	    encode_grid(&ArrayValue::singleton(value))
   475	}
