  1170	                        sheet: f.sheet,
  1171	                        row: f.row,
  1172	                        col: f.col,
  1173	                    }),
  1174	                    severity: Severity::Warning,
  1175	                    code: "xlsx_formula_recompute_failed".to_string(),
