    97	    ///
    98	    /// [`recompute_all`]: WorkbookRuntime::recompute_all
    99	    /// [`recompute_all_preserving_saved_udf`]: WorkbookRuntime::recompute_all_preserving_saved_udf
   100	    fn recompute_all_impl(&mut self, preserve_saved_udf: bool) -> RecomputeResult {
   101	        // **Tier C1 (2026-05-18 — Phase 4.12 Opus-B H-2 closure):**
   102	        // cycle detection. `recompute_all` is the no-session-attached
   103	        // fallback used by `.qbook` load + replay. Before this fix,
   104	        // cyclic formulas like `=A1+1` in A1 silently produced
   105	        // wrong values on each call (1, then 2, then 3, …) because
   106	        // HashMap-order evaluation just re-read the prior value.
   107	        //
   108	        // Strategy: build an ephemeral `CalcgraphSession` from the
   109	        // current workbook, mark every formula dirty, run Tarjan
   110	        // SCC via `schedule_dirty`, and write `#CIRC!` for every
   111	        // cell in a cycle BEFORE the HashMap-order eval loop runs.
   112	        // The acyclic remainder evaluates through the existing
   113	        // HashMap-order loop; any cell that reads from a cycled
   114	        // cell sees the freshly-written `#CIRC!` and propagates it
   115	        // via standard error semantics.
   116	        //
   117	        // `rebuild_from_workbook` parses every formula a second
   118	        // time (the existing loop below also parses each via
   119	        // `try_recompute_one_cached`). Acceptable cost for the
   120	        // load/replay path; `recompute_dirty` is the performance
