     1	//! UDF-6-03 — Rust↔Python type-conversion matrix, end-to-end through the REAL
     2	//! Python worker.
     3	//!
     4	//! Where `udf_e2e.rs` proves one number computes, this proves the *conversion
     5	//! contract*: every [`Value`] variant and all 15 [`ErrorValue`] sigils survive a
     6	//! full round-trip (Rust encode → length-prefixed Arrow-IPC → stdin → pyarrow
     7	//! decode → the `_echo` UDF → pyarrow encode → stdout → Rust decode), bit-exactly;
     8	//! and the numpy/pandas dtype boundary fails LOUDLY rather than silently coercing.
     9	//!
    10	//! It drives `ql_udf::ProcessWorker::call` directly (not the formula evaluator) so
    11	//! it can inject *every* variant — including error sigils, which the binder's
    12	//! `ArgPolicy::Strict` would short-circuit before dispatch in a real formula.
    13	//!
    14	//! Skip discipline mirrors `udf_e2e.rs`: if no `python3`/`python` with `pyarrow`
    15	//! is on PATH the test prints a LOUD skip and returns. numpy/pandas sub-cases are
    16	//! additionally guarded on their library importing — a missing library is a skip,
    17	//! NOT a silent pass (and never gets mistaken for the type-boundary `TypeError`).
    18	//! This is test-environment gating, NOT a production fallback (the engine fails
    19	//! loud on a missing interpreter).
    20	
    21	use std::path::PathBuf;
    22	use std::process::Command;
    23	use std::sync::Arc;
    24	use std::time::Duration;
    25	
    26	use ql_types::{ArrayValue, ErrorValue, Value};
    27	use ql_udf::{ProcessWorker, PythonWorkerConfig, UdfError, UdfWorker};
    28	
    29	/// `_smoke_udfs` handle 8 — identity over the whole args grid (round-trip).
    30	const ECHO: u64 = 8;
    31	/// numpy/pandas return-type fixtures (see `_smoke_udfs.py`).
    32	const RET_NUMPY_FLOAT64: u64 = 20;
    33	const RET_NUMPY_INT64: u64 = 21;
    34	const RET_NUMPY_BOOL: u64 = 22;
    35	const RET_PANDAS_SERIES: u64 = 23;
    36	const RET_PANDAS_DATAFRAME: u64 = 24;
    37	
    38	/// Generous per-call deadline — these calls are trivial; we are testing
    39	/// conversion, not timing.
    40	const DEADLINE: Duration = Duration::from_secs(30);
    41	
    42	/// Find an interpreter that can `import pyarrow`, or `None`.
    43	fn python_with_pyarrow() -> Option<String> {
    44	    for py in ["python3", "python"] {
    45	        if module_importable(py, "pyarrow") {
    46	            return Some(py.to_string());
    47	        }
    48	    }
    49	    None
    50	}
    51	
    52	/// Whether `py -c "import <module>"` succeeds.
    53	fn module_importable(py: &str, module: &str) -> bool {
    54	    Command::new(py)
    55	        .args(["-c", &format!("import {module}")])
    56	        .output()
    57	        .map(|o| o.status.success())
    58	        .unwrap_or(false)
    59	}
    60	
    61	/// The `_smoke_udfs` worker config — `quantbook-py/python` is a sibling of this
    62	/// crate (`crates/ql-exec` → `crates/quantbook-py`). Mirrors `udf_e2e::smoke_config`.
    63	fn smoke_config(py: &str) -> PythonWorkerConfig {
    64	    let pythonpath = PathBuf::from(env!("CARGO_MANIFEST_DIR"))
    65	        .join("../quantbook-py/python")
    66	        .canonicalize()
    67	        .expect("quantbook-py/python directory should exist");
    68	    PythonWorkerConfig::new(py)
    69	        .with_pythonpath(pythonpath)
    70	        .with_udf_module("quantbook._smoke_udfs")
    71	}
    72	
    73	/// Spawn + handshake a real worker, failing loud if it cannot start.
    74	fn started_worker(py: &str) -> ProcessWorker {
    75	    let mut w = ProcessWorker::new(smoke_config(py));
    76	    w.ensure_started()
    77	        .expect("the real Python worker should spawn + handshake");
    78	    w
    79	}
    80	
    81	/// LOUD-skip guard shared by every test. Returns the interpreter or `None` after
    82	/// printing a skip line.
    83	fn require_pyarrow(test: &str) -> Option<String> {
    84	    match python_with_pyarrow() {
    85	        Some(p) => Some(p),
    86	        None => {
    87	            eprintln!("SKIP {test}: no `python3`/`python` with `pyarrow` on PATH");
    88	            None
    89	        }
    90	    }
    91	}
    92	
    93	/// Every `Value` variant and all 15 `ErrorValue` sigils round-trip identically
    94	/// through the real worker, across scalar, 1×N, multi-row, and degenerate shapes.
    95	#[test]
    96	fn value_variants_and_error_sigils_round_trip_through_real_worker() {
    97	    let Some(py) = require_pyarrow("value_variants_and_error_sigils_round_trip_through_real_worker")
    98	    else {
    99	        return;
   100	    };
   101	    let mut w = started_worker(&py);
   102	
   103	    // --- A 1×N row containing every Value variant + all 15 error sigils. ---
   104	    let mut cells = vec![
   105	        Value::Blank,
   106	        Value::Boolean(true),
   107	        Value::Boolean(false),
   108	        Value::Number(0.0),
   109	        Value::Number(1.0),
   110	        Value::Number(-1.0),
   111	        Value::Number(3.5),
   112	        Value::Number(f64::MAX),
   113	        Value::Number(f64::MIN),
   114	        Value::Number(f64::MIN_POSITIVE),
   115	        Value::Number(1e-300),
   116	        Value::Number(1e300),
   117	        Value::Text(Arc::from("")),
   118	        Value::Text(Arc::from("hello")),
   119	        // Unicode + multi-byte: the codec is UTF-8, must survive.
   120	        Value::Text(Arc::from("café π → ✓ 日本語")),
   121	    ];
   122	    for ev in ErrorValue::ALL {
   123	        cells.push(Value::Error(ev));
   124	    }
   125	    let row = ArrayValue::row(cells);
   126	    let out = w.call(ECHO, &row, DEADLINE).expect("echo of the full row");
   127	    assert_eq!(
   128	        out, row,
   129	        "every Value variant + all 15 ErrorValue sigils must round-trip identically"
   130	    );
   131	
   132	    // --- A 1×1 scalar of each variant (the spreadsheet's common case). ---
   133	    for v in [
   134	        Value::Blank,
   135	        Value::Boolean(true),
   136	        Value::Number(42.0),
   137	        Value::Text(Arc::from("scalar")),
   138	        Value::Error(ErrorValue::DivZero),
   139	    ] {
   140	        let g = ArrayValue::singleton(v.clone());
   141	        let out = w.call(ECHO, &g, DEADLINE).expect("echo of a scalar");
   142	        assert_eq!(out, g, "scalar {v:?} must round-trip");
   143	    }
   144	
   145	    // --- A multi-row (3×2) grid: rows/cols metadata + row-major order. ---
   146	    let grid = ArrayValue::new(
   147	        3,
   148	        2,
   149	        vec![
   150	            Value::Number(1.0),
   151	            Value::Text(Arc::from("a")),
   152	            Value::Boolean(true),
   153	            Value::Blank,
   154	            Value::Error(ErrorValue::NA),
   155	            Value::Number(-2.5),
   156	        ],
   157	    )
   158	    .expect("3×2 grid is well-formed");
   159	    let out = w.call(ECHO, &grid, DEADLINE).expect("echo of a 3×2 grid");
   160	    assert_eq!(out, grid, "a 3×2 grid must round-trip with shape preserved");
   161	    assert_eq!(out.rows(), 3, "row count preserved");
   162	
   163	    // --- Degenerate (0-area) shapes must survive the codec's metadata path. ---
   164	    let empty = ArrayValue::empty(0, 3);
   165	    let out = w.call(ECHO, &empty, DEADLINE).expect("echo of a 0×3 grid");
   166	    assert_eq!(out, empty, "a 0×3 degenerate grid must round-trip");
   167	}
   168	
   169	/// Signed zero is preserved bit-exactly (`-0.0` keeps its sign bit). `ArrayValue`'s
   170	/// `PartialEq` treats `0.0 == -0.0`, so the matrix test above cannot catch a sign
   171	/// flip — assert the raw bits here.
   172	#[test]
   173	fn negative_zero_round_trips_bit_exact() {
   174	    let Some(py) = require_pyarrow("negative_zero_round_trips_bit_exact") else {
   175	        return;
   176	    };
   177	    let mut w = started_worker(&py);
   178	
   179	    let neg_zero = ArrayValue::singleton(Value::Number(-0.0));
   180	    let out = w.call(ECHO, &neg_zero, DEADLINE).expect("echo of -0.0");
   181	    match out.get(0, 0) {
   182	        Some(Value::Number(x)) => assert_eq!(
   183	            x.to_bits(),
   184	            (-0.0f64).to_bits(),
   185	            "-0.0 must round-trip bit-exact (sign bit preserved), got {x}"
   186	        ),
   187	        other => panic!("expected a Number cell, got {other:?}"),
   188	    }
   189	}
   190	
   191	/// The numpy scalar boundary: `numpy.float64` round-trips (it subclasses Python
   192	/// `float`); `numpy.int64` and `numpy.bool_` do NOT — the encoder raises a loud
   193	/// `TypeError` (surfaced as [`UdfError::Raised`]), never a silent coercion.
   194	/// Guarded on numpy being importable (a missing numpy is a SKIP, not the boundary).
   195	#[test]
   196	fn numpy_scalar_type_boundary_is_honest() {
   197	    let Some(py) = require_pyarrow("numpy_scalar_type_boundary_is_honest") else {
   198	        return;
   199	    };
   200	    if !module_importable(&py, "numpy") {
   201	        eprintln!("SKIP numpy_scalar_type_boundary_is_honest: `numpy` not importable by {py}");
   202	        return;
   203	    }
   204	    let mut w = started_worker(&py);
   205	    // The fixtures ignore their args; pass a 1×1 placeholder.
   206	    let arg = ArrayValue::singleton(Value::Number(0.0));
   207	
   208	    // numpy.float64 — a Python `float` subclass → encodes as Value::Number.
   209	    let out = w
   210	        .call(RET_NUMPY_FLOAT64, &arg, DEADLINE)
   211	        .expect("numpy.float64 must round-trip (float subclass)");
   212	    assert_eq!(
   213	        out.get(0, 0),
   214	        Some(&Value::Number(2.5)),
   215	        "numpy.float64(2.5) must decode to Value::Number(2.5)"
   216	    );
   217	
   218	    // numpy.int64 — NOT an int/float subclass → loud TypeError.
   219	    assert_type_rejected(
   220	        w.call(RET_NUMPY_INT64, &arg, DEADLINE),
   221	        "numpy.int64",
   222	    );
   223	
   224	    // numpy.bool_ — NOT a bool/int subclass → loud TypeError.
   225	    assert_type_rejected(
   226	        w.call(RET_NUMPY_BOOL, &arg, DEADLINE),
   227	        "numpy.bool_",
   228	    );
   229	}
   230	
   231	/// The pandas boundary: a `Series`/`DataFrame` is an unsupported cell type → the
   232	/// encoder raises a loud `TypeError`. Guarded on pandas being importable.
   233	#[test]
   234	fn pandas_type_boundary_is_honest() {
   235	    let Some(py) = require_pyarrow("pandas_type_boundary_is_honest") else {
   236	        return;
   237	    };
   238	    if !module_importable(&py, "pandas") {
   239	        eprintln!("SKIP pandas_type_boundary_is_honest: `pandas` not importable by {py}");
   240	        return;
   241	    }
   242	    let mut w = started_worker(&py);
   243	    let arg = ArrayValue::singleton(Value::Number(0.0));
   244	
   245	    assert_type_rejected(
   246	        w.call(RET_PANDAS_SERIES, &arg, DEADLINE),
   247	        "pandas.Series",
   248	    );
   249	    assert_type_rejected(
   250	        w.call(RET_PANDAS_DATAFRAME, &arg, DEADLINE),
   251	        "pandas.DataFrame",
   252	    );
   253	}
   254	
   255	/// Assert a `call` result is a loud `TypeError` RAISE (the encoder rejecting an
   256	/// unsupported return type) — never a silent success or a different failure mode.
   257	fn assert_type_rejected(result: Result<ArrayValue, UdfError>, what: &str) {
   258	    match result {
   259	        Err(UdfError::Raised { exc_type, message }) => {
   260	            assert_eq!(
   261	                exc_type, "TypeError",
   262	                "{what} must be rejected as a TypeError (got {exc_type}: {message})"
   263	            );
   264	        }
   265	        Err(other) => panic!("{what}: expected a Raised TypeError, got a different UdfError: {other:?}"),
   266	        Ok(grid) => panic!("{what}: expected a loud TypeError, but the call SUCCEEDED with {grid:?} (silent coercion!)"),
   267	    }
   268	}

