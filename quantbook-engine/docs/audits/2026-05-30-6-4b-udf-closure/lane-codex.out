    50	/// Read a single cell value. Out-of-bounds reads return `Value::Blank` per Excel semantics.
    51	pub trait CellEnv {
    52	    fn read_cell(&self, sheet: SheetId, row: RowId, col: ColId) -> Value;
    53	
    54	    /// Phase 3.6 (2026-05-12) — AGG-3-04 entry point. Materialize a range
    55	    /// into a flat `Vec<Value>` for aggregate functions (SUM, AVERAGE,
    56	    /// MIN, MAX, COUNT, PRODUCT). Default impl iterates the range row by
    57	    /// row using `read_cell`; impls that have cheaper bounds info (e.g.
    58	    /// `WorkbookEnv` clamps to `Sheet::bounds`) override.
    59	    ///
    60	    /// Returns an empty Vec for a degenerate range (e.g. range entirely
    61	    /// outside a sheet's populated area). The aggregate function then
    62	    /// applies its empty-input rule (MIN/MAX → 0; AVERAGE → `#DIV/0!`;
    63	    /// SUM/COUNT/PRODUCT → 0 or 1; see `ql-functions::scalar_fns`).
    64	    fn read_range(&self, range: Range) -> Vec<Value> {
    65	        let mut out = Vec::new();
    66	        for row in range.start_row..=range.end_row {
    67	            for col in range.start_col..=range.end_col {
    68	                out.push(self.read_cell(range.sheet, row, col));
    69	            }
    70	            // Safety: end_row could be `RowId::MAX` (whole-column); the
    71	            // outer range syntax must be bounded by the caller. The
    72	            // default impl iterates to completion — the WorkbookEnv
    73	            // override clamps to `Sheet::bounds().row_extent`.
    74	        }
    75	        out
    76	    }
    77	
    78	    /// **W5-54 (range-aware functions, GAP-F-05 follow-up):** return
    79	    /// the flat `Vec<Value>` for the range PLUS its 2D shape (rows,
    80	    /// cols). For range-aware functions like VLOOKUP/INDEX which
    81	    /// need to address by `(row, col)`, the dispatcher uses this to
    82	    /// construct `FnArg::Range { values, rows, cols }`.
    83	    ///
    84	    /// `rows * cols == values.len()` is the invariant. If the env
    85	    /// clamps to sheet bounds (`WorkbookEnv`), the returned shape
    86	    /// reflects the clamped dimensions. The default impl below
    87	    /// returns the unclamped shape derived from the range bounds —
    88	    /// matching the unclamped `read_range` default.
    89	    fn read_range_with_shape(&self, range: Range) -> (Vec<Value>, usize, usize) {
    90	        let values = self.read_range(range);
    91	        let rows = (range.end_row - range.start_row + 1) as usize;
    92	        let cols = (range.end_col - range.start_col + 1) as usize;
    93	        debug_assert_eq!(rows.saturating_mul(cols), values.len());
    94	        (values, rows, cols)
    95	    }
