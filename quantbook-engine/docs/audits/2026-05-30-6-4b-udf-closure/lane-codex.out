   153	
   154	    #[test]
   155	    fn decode_return_rejects_a_truncated_header() {
   156	        let e = decode_return(&[0u8; 7]).unwrap_err();
   157	        assert!(
   158	            matches!(e, CodecError::ShortHeader { need: 8, got: 7 }),
   159	            "got {e:?}"
   160	        );
   161	    }
   162	
   163	    #[test]
   164	    fn decode_call_propagates_a_bad_grid_loudly() {
   165	        // Valid 16-byte header + garbage grid bytes → the codec error surfaces (not a panic).
   166	        let mut bytes = Vec::new();
   167	        bytes.extend_from_slice(&7u64.to_le_bytes());
   168	        bytes.extend_from_slice(&1u64.to_le_bytes());
   169	        bytes.extend_from_slice(b"not arrow ipc");
   170	        assert!(decode_call(&bytes).is_err());
   171	    }
   172	}

