   329	impl WorkbookSession {
   330	    /// Construct a fresh, empty in-memory session (→ `Ready`). The `new(options)`
   331	    /// product command (§3.1).
   332	    pub fn new() -> Self {
   333	        Self::from_workbook(Workbook::new())
   334	    }
   335	
   336	    /// Wrap an existing `Workbook` (e.g. a hand-built test workbook; later the
   337	    /// product of `open`/`import`) using a CALLER-PROVIDED registry `Arc`.
   338	    /// Rebuilds the calc graph from the workbook's formulas — extracting deps,
   339	    /// arg-context, and volatility against THAT registry — so dependency
   340	    /// tracking is live and consistent with the registry the session will hold.
   341	    ///
   342	    /// **6.4-2 cycle-2 audit-fix (F2 — Codex):** the `open`/`import` adoption
   343	    /// sites need this overload. They previously did
   344	    /// `*self = Self::from_workbook(wb); self.registry = preserved_registry;`
   345	    /// — but `from_workbook` builds the graph against a FRESH `default_registry()`,
   346	    /// so after the post-hoc `self.registry =` swap the graph was extracted
   347	    /// UDF-free while `self.registry` was UDF-aware: a graph⊥registry divergence
   348	    /// the increment introduces once 6.4-2 lets a UDF be registered before an
   349	    /// adoption. (`open` self-healed via its post-swap `recompute_all`, which
   350	    /// rebuilds the graph against `self.registry`; xlsx `import` does NOT
   351	    /// recompute after the swap, so its graph stayed divergent.) Passing the
   352	    /// preserved registry into construction closes the divergence at the source
   353	    /// for ALL adoption sites and removes `open`'s wasteful double graph build.
   354	    /// This is the same divergence class the 6.4-0 H2 + 6.4-1 H1 audit-fixes
   355	    /// closed at `recompute_all` / `rematerialize`; the adoption-site variant
   356	    /// was the gap those sweeps missed.
   357	    pub fn from_workbook_with_registry(
   358	        workbook: Workbook,
   359	        registry: Arc<FunctionRegistry>,
   360	    ) -> Self {
   361	        let graph =
   362	            CalcgraphSession::rebuild_from_workbook_with_registry(&workbook, &registry).session;
   363	        // inc.2c-7: snapshot the construction-time workbook as the undo baseline
   364	        // BEFORE moving `workbook` into the struct (the op-log records only
   365	        // post-construction edits, so `rematerialize` replays onto a clone of
   366	        // this baseline — see the `baseline` field doc). Empty/cheap for `new()`.
   367	        let baseline = workbook.clone();
   368	        let oplog = OpLog::new();
   369	        // inc.2c-6: construct the undo manager AFTER `oplog` so it subscribes to
   370	        // the doc's commit stream and records every subsequent `append`'s commit.
   371	        // `set_merge_interval(0)` disables Loro's time-based commit merging so
   372	        // each commit is its own undo unit (HARD QUESTION 1) — every command
   373	        // already produces exactly one commit, so 1 command == 1 undo unit with
   374	        // no explicit grouping. The manager holds an internal Arc to the doc, so
   375	        // it does not borrow `oplog` and can be moved into the struct below.
   376	        let mut undo_manager = oplog.new_undo_manager();
   377	        undo_manager.set_merge_interval(0);
   378	        Self {
   379	            workbook,
   380	            baseline,
   381	            oplog,
   382	            graph,
   383	            plan_cache: PlanCache::new(),
   384	            registry,
   385	            state: LifecycleState::Ready,
   386	            epoch: mint_epoch(),
   387	            state_seq: 0,
   388	            change_log: VecDeque::new(),
   389	            change_log_floor: 0,
   390	            ops: HashMap::new(),
   391	            next_op_id: 1,
   392	            events: Vec::new(),
   393	            txns: HashMap::new(),
   394	            next_txn_id: 1,
   395	            undo_manager,
   396	            // 6.4-3c: no UDF worker until the host injects one via set_udf_worker.
   397	            udf_worker: None,
   398	            // 6.4-3d (blocker G): empty per-recompute diagnostic collector.
   399	            udf_diagnostics: RefCell::new(Vec::new()),
   400	            udf_op_budget: crate::scalar::UDF_OP_BUDGET,
   401	        }
   402	    }
   403	
   404	    /// Wrap an existing `Workbook` with a FRESH default registry (built-ins
   405	    /// only). The construction-time path for `new()` and hand-built test
   406	    /// workbooks, where no UDFs exist yet. Adoption sites that must preserve a
   407	    /// UDF-aware registry across workbook replacement use
   408	    /// [`Self::from_workbook_with_registry`] instead (6.4-2 cycle-2 audit-fix F2).
   409	    pub fn from_workbook(workbook: Workbook) -> Self {
   410	        Self::from_workbook_with_registry(workbook, Arc::new(ql_functions::default_registry()))
   411	    }
   412	
   413	    /// **6.4-3c (2026-05-29):** install the out-of-process Python-UDF worker
   414	    /// this session dispatches registered UDFs to. Until this is called, a
   415	    /// registered `=MYUDF(A1)` evaluates to `#CALC!` (No-Fallbacks-honest — the
   416	    /// UDF is known to the graph but cannot compute without a worker). Wrapping
   417	    /// in `RefCell` gives the interior mutability the shared-`&` eval stack needs
   418	    /// to reach [`ql_udf::UdfWorker::call`]'s `&mut self`.
   419	    ///
   420	    /// Idempotent-replace: a second call swaps the worker (the prior one is
   421	    /// dropped — its `Drop` kills + reaps the child per 6.4-3b). v1 takes a
   422	    /// `Box<dyn UdfWorker + Send>` directly; the napi/IDE bridge that constructs a
   423	    /// `ProcessWorker` from trusted-workspace config (+ `debugpy`) is 6.4-3d.
   424	    ///
   425	    /// NOTE: this does NOT itself recompute, and it does NOT dirty anything.
   426	    /// A UDF cell evaluated BEFORE the worker was installed is a *clean*
   427	    /// `#CALC!`, so `recalc_dirty` will NOT heal it — callers that want existing
   428	    /// UDF cells to pick up the worker must call `recalc_all` (Codex MED-1 /
   429	    /// Opus LOW-2, 6.4-3c audit). In the intended flow the host injects the
   430	    /// worker BEFORE any UDF formulas are entered, so `set_formula`'s immediate
   431	    /// eval sees it and no heal is needed. Auto-dirtying UDF-using cells on
   432	    /// injection (via the 6.4-0 `functions_used` reverse index) is FILED-FORWARD
   433	    /// for the 6.4-3d host bridge, which owns injection ordering.
   434	    pub fn set_udf_worker(&mut self, worker: Box<dyn UdfWorker + Send>) {
   435	        self.udf_worker = Some(RefCell::new(worker));
   436	    }
   437	
   438	    /// **6.4-3d (audit-fix HIGH-3):** lifecycle-gated worker injection for the
   439	    /// napi/host boundary. `ensure_ready()` first, so a `New`/`Busy`/`Closed`/
   440	    /// `Faulted` session rejects with `[invalid_state]`/`[session_busy]` instead
   441	    /// of silently attaching a live Python child to a terminal session (and the
   442	    /// `close()` worker-drop would then never run for it). The bare
   443	    /// [`set_udf_worker`] stays an infallible field-setter for Rust tests on a
   444	    /// known-`Ready` session.
   445	    ///
   446	    /// The napi `setUdfWorker` spawns + handshakes the worker OUTSIDE the session
   447	    /// lock (a process op), then calls this UNDER the lock — so a session that
   448	    /// transitioned to `Closed` during the spawn is caught HERE and the passed
   449	    /// `worker` is dropped by the caller (its child killed + reaped), closing the
   450	    /// inject-vs-close race.
   451	    ///
   452	    /// [`set_udf_worker`]: WorkbookSession::set_udf_worker
   453	    pub fn set_udf_worker_checked(
   454	        &mut self,
   455	        worker: Box<dyn UdfWorker + Send>,
   456	    ) -> EngineResult<()> {
   457	        self.ensure_ready()?;
   458	        self.udf_worker = Some(RefCell::new(worker));
   459	        Ok(())
   460	    }
   461	
   462	    // --- internal helpers ---
   463	
   464	    /// Run a closure against a per-edit `WorkbookRuntime` that borrows the
   465	    /// session's owned state, recovering the (warmed) plan cache afterwards.
   466	    /// The runtime borrow never escapes this function.
   467	    ///
   468	    /// **Panic safety (F3 / contract §8):** `f` runs the engine kernels, which
   469	    /// contain reachable `.expect`/`panic!` (e.g. the recompute/spill paths). If
   470	    /// `f` unwinds, the plan-cache restore below is skipped (leaving the cache
   471	    /// taken/empty) and the session may be mid-edit. A [`FaultGuard`] marks the
   472	    /// session `Faulted` on unwind so no later command runs against torn state —
   473	    /// never silently `Ready`/`Busy`. It is disarmed on the normal return path.
   474	    ///
   475	    /// **6.1C audit-fix A-INFO/L-E6 — panic-default rationale corrected.** The
   476	    /// prior docstring claimed `panic = "abort"` was "today's default"; this is
   477	    /// factually wrong (the workspace `Cargo.toml` does not set `panic`, so the
