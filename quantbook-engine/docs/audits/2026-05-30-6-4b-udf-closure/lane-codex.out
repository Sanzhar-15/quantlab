   296	    /// **Engine Phase 3.4 (2026-05-12) — W5-37 SCH-3-01..04 entry
   297	    /// point.** Recompute only the formulas the attached
   298	    /// [`CalcgraphSession`] has marked dirty since the last call.
   299	    /// The scheduler runs iterative Tarjan SCC over the dirty
   300	    /// subset; nodes in non-trivial SCCs (or with self-loops) are
   301	    /// written as `Value::Error(ErrorValue::Circ)`. Everything else
   302	    /// is evaluated in topological order via the existing PlanCache
   303	    /// pipeline.
   304	    ///
   305	    /// Returns `None` when no `CalcgraphSession` is attached (the
   306	    /// runtime was constructed via `new` or `with_oplog`); the
   307	    /// dirty-set lives on the session, so we can't do incremental
   308	    /// recompute without it. Callers in that mode should use
   309	    /// `recompute_all` for a full HashMap-order pass instead.
   310	    ///
   311	    /// Returns `Some(RecomputeResult)` otherwise, matching the
   312	    /// aggregation shape of `recompute_all`: per-cell failures
   313	    /// (parse / bind issues that have somehow surfaced post-bind,
   314	    /// e.g. a name was deleted between extract and recompute) are
   315	    /// collected, the rest succeed.
   316	    pub fn recompute_dirty(&mut self) -> Option<RecomputeResult> {
   317	        // The session lives behind an `Option<&'a mut CalcgraphSession>`
   318	        // — take it out for the duration of this call so we can borrow
   319	        // both the workbook and the session simultaneously. Reattach
   320	        // before returning.
   321	        let mut session_slot = self.graph.take();
   322	        let session = session_slot.as_deref_mut()?;
