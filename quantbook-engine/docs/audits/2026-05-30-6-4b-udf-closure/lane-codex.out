   231	impl<'w> WorkbookEnv<'w> {
   232	    pub fn new(workbook: &'w ql_storage::Workbook) -> Self {
   233	        // **W5-153 (post-4.9.O):** wire workbook.locale() through.
   234	        // Pre-fix, eval-side EvalContext.locale was always EnUs
   235	        // regardless of workbook.set_locale() calls. No production
   236	        // function reads EvalContext.locale today, so the gap was
   237	        // latent rather than a correctness bug, but any future
   238	        // locale-aware eval function (e.g. locale-sensitive TEXT()
   239	        // formatting) now sees the right locale.
   240	        let eval_ctx = EvalContext {
   241	            date_system: workbook.date_system(),
   242	            locale: workbook.locale(),
   243	            ..EvalContext::default()
   244	        };
