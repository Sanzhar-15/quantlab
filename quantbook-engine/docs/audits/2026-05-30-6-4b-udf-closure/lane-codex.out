   161	def decode_grid(data):
   162	    """Decode Arrow IPC stream bytes (from the Rust engine) back to a `Grid`."""
   163	    reader = pa.ipc.open_stream(pa.BufferReader(data))
   164	    batches = list(reader)
   165	    if not batches:
   166	        raise ValueError("empty IPC stream (expected exactly one record batch)")
   167	    if len(batches) != 1:
   168	        raise ValueError("trailing data after the first record batch")
   169	    batch = batches[0]
