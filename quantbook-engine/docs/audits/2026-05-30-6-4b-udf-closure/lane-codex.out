   497	    /// Write a hand-built (schema, columns) pair to IPC stream bytes — for the
   498	    /// adversarial decode tests that fabricate malformed worker output.
   499	    fn write_ipc(schema: &Arc<Schema>, columns: Vec<ArrayRef>) -> Vec<u8> {
   500	        let batch = RecordBatch::try_new(schema.clone(), columns).unwrap();
   501	        let mut buf = Vec::new();
   502	        let mut w = StreamWriter::try_new(&mut buf, schema).unwrap();
   503	        w.write(&batch).unwrap();
   504	        w.finish().unwrap();
   505	        buf
   506	    }
