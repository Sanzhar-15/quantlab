   849	    /// delta can't convey) and table ops (`create/rename/rename_column/resize/
   850	    /// drop_table`, which rewrite arbitrary formula cells the session can't
   851	    /// enumerate) — and for cache-clearing events (undo/redo, future). The
   852	    /// change-log is keyed by the OLD epoch's seqs, so it is cleared (a new-epoch
   853	    /// token starts fresh from the current `state_seq`).
   854	    fn bump_epoch(&mut self) {
   855	        self.epoch = mint_epoch();
