 succeeded in 0ms:
     1	//! Arrow ⇄ engine-`Value` codec — the wire payload for `CALL` / `RETURN` frames.
     2	//!
     3	//! **6.4-3a.** A UDF call's arguments and result are 2-D grids of spreadsheet
     4	//! values ([`ql_types::ArrayValue`]); a scalar is just a 1×1 grid. This module
     5	//! encodes a grid to Arrow IPC stream bytes and back.
     6	//!
     7	//! **Encoding (design §3 — the tagged columns).** Arrow has no native
     8	//! spreadsheet-error type, so a value is encoded across five parallel columns of
     9	//! length `rows*cols` (row-major), discriminated by `kind`:
    10	//!
    11	//! | kind     | populated column | engine `Value`            |
    12	//! |----------|------------------|---------------------------|
    13	//! | `blank`  | (none)           | `Value::Blank`            |
    14	//! | `number` | `num: f64`       | `Value::Number`           |
    15	//! | `bool`   | `bool: bool`     | `Value::Boolean`          |
    16	//! | `text`   | `str: Utf8`      | `Value::Text`             |
    17	//! | `error`  | `err: Utf8`      | `Value::Error` (by sigil) |
    18	//!
    19	//! The grid shape (`rows`, `cols`) rides in the Arrow schema metadata so degenerate
    20	//! shapes (`rows==0` or `cols==0`, zero cells) round-trip faithfully. The encoding
    21	//! is deliberately verbose-but-unambiguous; a compact layout is a later optimization
    22	//! behind this same boundary.
    23	//!
    24	//! **Decode is a trust boundary (6.4-3a cycle-1 audit-fix).** The bytes a `RETURN`
    25	//! frame carries are produced by an out-of-process Python worker — possibly buggy
    26	//! or hostile. `decode_grid` therefore validates the batch BEFORE trusting it:
    27	//! - the schema must be EXACTLY the 5 expected fields, by name + Arrow type +
    28	//!   nullability, in order ([`validate_grid_schema`]) — so a `pyarrow` worker that
    29	//!   reorders/renames columns is rejected loudly rather than silently mis-read (the
    30	//!   two `Utf8` columns `str`/`err` are otherwise type-interchangeable);
    31	//! - the active payload column for each `kind` must be non-null (a null active slot
    32	//!   is a malformed response, not a silent `0.0`/`false`/`""`);
    33	//! - a decoded `number` must be finite (`NaN`/`Inf` from the worker is a malformed
    34	//!   result — the engine's `Value::Number` invariant is "always finite");
    35	//! - the stream must contain EXACTLY one record batch (trailing data is rejected).
    36	//!
    37	//! No code path reachable from worker-controlled bytes may panic — every failure is
    38	//! a loud [`CodecError`] (No-Fallbacks; design §5 / contract §10.4 exit tests 6+7).
    39	//! `encode_grid` trusts its input (engine-resident `Value`s already satisfy the
    40	//! finite-`Number` invariant); the validation above guards the untrusted *decode*
    41	//! direction.
    42	
    43	use std::collections::HashMap;
    44	use std::str::FromStr;
    45	use std::sync::Arc;
    46	
    47	use arrow::array::{
    48	    Array, ArrayRef, BooleanArray, BooleanBuilder, Float64Array, Float64Builder, StringArray,
    49	    StringBuilder,
    50	};
    51	use arrow::datatypes::{DataType, Field, Schema};
    52	use arrow::ipc::reader::StreamReader;
    53	use arrow::ipc::writer::StreamWriter;
    54	use arrow::record_batch::RecordBatch;
    55	
    56	use ql_types::{ArrayValue, ErrorValue, Value};
    57	
    58	/// Failure to encode/decode a grid on the UDF wire. Every variant is loud — no
    59	/// silent normalization (No-Fallbacks).
    60	#[derive(Debug, thiserror::Error)]
    61	pub enum CodecError {
    62	    /// Underlying Arrow IPC read/write error.
    63	    #[error("arrow ipc: {0}")]
    64	    Arrow(#[from] arrow::error::ArrowError),
    65	    /// The IPC stream contained no record batch.
    66	    #[error("decode: empty IPC stream (expected exactly one record batch)")]
    67	    Empty,
    68	    /// The IPC stream contained MORE than one record batch (expected exactly one).
    69	    #[error("decode: trailing data after the first record batch (expected exactly one)")]
    70	    TrailingBatch,
    71	    /// The batch schema was not the exact expected 5-field grid schema.
    72	    #[error("decode: bad grid schema ({0})")]
    73	    BadSchema(String),
    74	    /// The schema metadata was missing the `rows`/`cols` shape keys.
    75	    #[error("decode: missing '{0}' in schema metadata")]
    76	    MissingShape(&'static str),
    77	    /// A shape metadata value did not parse as a u32.
    78	    #[error("decode: shape '{key}' = {value:?} is not a u32")]
    79	    BadShape { key: &'static str, value: String },
    80	    /// `rows * cols` overflowed `usize` (a hostile/garbage shape).
    81	    #[error("decode: shape rows={rows} * cols={cols} overflows usize")]
    82	    ShapeOverflow { rows: u32, cols: u32 },
    83	    /// A column was absent or had the wrong Arrow type.
    84	    #[error("decode: column {0} missing or wrong type")]
    85	    BadColumn(&'static str),
    86	    /// A `kind` discriminant was not one of the five known tags.
    87	    #[error("decode: unknown kind {0:?}")]
    88	    BadKind(String),
    89	    /// The active payload column for a cell's `kind` was NULL (malformed response —
    90	    /// reading it would silently coerce to `0.0`/`false`/`""`).
    91	    #[error("decode: cell {row} has kind {kind:?} but its payload column is null")]
    92	    NullPayload { row: usize, kind: String },
    93	    /// A decoded `number` was non-finite (`NaN`/`Inf`) — out of the engine's
    94	    /// `Value::Number` finite invariant; a malformed worker result.
    95	    #[error("decode: cell {row} is a non-finite number ({value})")]
    96	    NonFinite { row: usize, value: f64 },
    97	    /// An `error` cell carried a sigil that is not a known `ErrorValue`.
    98	    #[error("decode: unknown error sigil {0:?}")]
    99	    BadErrorSigil(String),
   100	    /// The decoded cells did not match the declared shape.
   101	    #[error("decode: shape mismatch ({0})")]
   102	    ShapeMismatch(String),
   103	    /// A `CALL`/`RETURN` payload was shorter than its fixed `handle`/`call_id`
   104	    /// header (6.4-3a audit-fix: typed payload framing — see [`crate::payload`]).
   105	    #[error("decode: payload header truncated (need {need} bytes, got {got})")]
   106	    ShortHeader { need: usize, got: usize },
   107	    /// A control-frame string field ([`crate::control`]) was not valid UTF-8.
   108	    #[error("decode: {field} field is not valid UTF-8")]
   109	    BadUtf8 { field: &'static str },
   110	    /// **6.4B (item I):** the grid's cell count (`rows * cols`) exceeds
   111	    /// [`MAX_GRID_CELLS`]. Rejected loudly BEFORE allocating the cell vec — bounds
   112	    /// both the engine-side `Vec<Value>` and the downstream spill.
   113	    #[error("grid: {cells} cells exceeds the {max}-cell cap")]
   114	    GridTooManyCells { cells: usize, max: usize },
   115	    /// **6.4B (item I):** the encoded (or decoded-input) grid byte length exceeds
   116	    /// [`MAX_GRID_BYTES`]. A coarse guard sized at the transport frame cap so a
   117	    /// hostile grid is rejected here (a specific [`CodecError`]) rather than only
   118	    /// at allocation. NOTE: it does NOT make a frame-layer rejection impossible —
   119	    /// the frame payload is the grid PLUS a fixed header (8/16 bytes) PLUS the
   120	    /// 1-byte type tag, so a grid within `(MAX_FRAME_LEN - 17, MAX_FRAME_LEN]`
   121	    /// still trips [`crate::frame::MAX_FRAME_LEN`] (also fail-loud, just a less
   122	    /// specific error). The frame layer remains the authoritative wire-size gate.
   123	    #[error("grid: {bytes} bytes exceeds the {max}-byte cap")]
   124	    GridTooManyBytes { bytes: usize, max: usize },
   125	}
   126	
   127	/// **6.4B (item I):** max cell count (`rows * cols`) of a UDF arg/return grid. A
   128	/// larger grid is rejected as [`CodecError::GridTooManyCells`] rather than
   129	/// allocated. Bounds the engine-side `Vec<Value>` and the spill that follows a UDF
   130	/// array return. Generous (a full Excel column is ~1.05M cells; this admits ~5
   131	/// columns of full height) but finite.
   132	pub const MAX_GRID_CELLS: usize = 5_000_000;
   133	
   134	/// **6.4B (item I):** max byte length of an encoded grid / decode input. Set to the
   135	/// transport frame cap so `encode_grid` never yields a payload the frame writer
   136	/// would reject, and a direct `decode_grid` of an over-cap buffer fails the same way.
   137	pub const MAX_GRID_BYTES: usize = crate::frame::MAX_FRAME_LEN as usize;
   138	
   139	const COL_KIND: usize = 0;
   140	const COL_NUM: usize = 1;
   141	const COL_STR: usize = 2;
   142	const COL_BOOL: usize = 3;
   143	const COL_ERR: usize = 4;
   144	
   145	/// The exact field layout (name, type, nullability) the decoder requires. `kind`
   146	/// is the non-null discriminant; the four payload columns are nullable (only the
   147	/// one matching `kind` is populated per cell).
   148	const EXPECTED_FIELDS: [(&str, DataType, bool); 5] = [
   149	    ("kind", DataType::Utf8, false),
   150	    ("num", DataType::Float64, true),
   151	    ("str", DataType::Utf8, true),
   152	    ("bool", DataType::Boolean, true),
   153	    ("err", DataType::Utf8, true),
   154	];
   155	
   156	fn grid_schema(rows: u32, cols: u32) -> Schema {
   157	    let fields: Vec<Field> = EXPECTED_FIELDS
   158	        .iter()
   159	        .map(|(name, dt, nullable)| Field::new(*name, dt.clone(), *nullable))
   160	        .collect();
   161	    let metadata = HashMap::from([
   162	        ("rows".to_string(), rows.to_string()),
   163	        ("cols".to_string(), cols.to_string()),
   164	    ]);
   165	    Schema::new(fields).with_metadata(metadata)
   166	}
   167	
   168	/// Encode a grid to Arrow IPC stream bytes (the `CALL`/`RETURN` frame payload).
   169	/// Rejects a grid exceeding [`MAX_GRID_CELLS`] / [`MAX_GRID_BYTES`] (6.4B item I).
   170	pub fn encode_grid(grid: &ArrayValue) -> Result<Vec<u8>, CodecError> {
   171	    encode_grid_capped(grid, MAX_GRID_CELLS, MAX_GRID_BYTES)
   172	}
   173	
   174	/// [`encode_grid`] with explicit caps (the public wrapper passes the
   175	/// [`MAX_GRID_CELLS`] / [`MAX_GRID_BYTES`] defaults). Split out so tests can drive
   176	/// the cap paths with tiny limits instead of allocating a multi-million-cell grid.
   177	fn encode_grid_capped(
   178	    grid: &ArrayValue,
   179	    max_cells: usize,
   180	    max_bytes: usize,
   181	) -> Result<Vec<u8>, CodecError> {
   182	    let rows = grid.rows();
   183	    let cols = grid.cols();
   184	
   185	    // **6.4B (item I):** reject an over-cap arg grid (e.g. a huge range arg) BEFORE
   186	    // building any Arrow buffers. `rows`/`cols` are `u32`; `checked_mul` guards the
   187	    // 32-bit product overflowing `usize` on a hostile shape.
   188	    let cell_count = (rows as usize)
   189	        .checked_mul(cols as usize)
   190	        .ok_or(CodecError::GridTooManyCells {
   191	            cells: usize::MAX,
   192	            max: max_cells,
   193	        })?;
   194	    if cell_count > max_cells {
   195	        return Err(CodecError::GridTooManyCells {
   196	            cells: cell_count,
   197	            max: max_cells,
   198	        });
   199	    }
   200	
   201	    let mut kind = StringBuilder::new();
   202	    let mut num = Float64Builder::new();
   203	    let mut text = StringBuilder::new();
   204	    let mut boolean = BooleanBuilder::new();
   205	    let mut err = StringBuilder::new();
   206	
   207	    // Row-major, matching `ArrayValue`'s own cell ordering.
   208	    for r in 0..rows {
   209	        for c in 0..cols {
   210	            let v = grid
   211	                .get(r, c)
   212	                .ok_or_else(|| CodecError::ShapeMismatch(format!("get({r},{c}) out of bounds")))?;
   213	            match v {
   214	                Value::Blank => {
   215	                    kind.append_value("blank");
   216	                    num.append_null();
   217	                    text.append_null();
   218	                    boolean.append_null();
   219	                    err.append_null();
   220	                }
   221	                Value::Number(x) => {
   222	                    kind.append_value("number");
   223	                    num.append_value(*x);
   224	                    text.append_null();
   225	                    boolean.append_null();
   226	                    err.append_null();
   227	                }
   228	                Value::Boolean(x) => {
   229	                    kind.append_value("bool");
   230	                    num.append_null();
   231	                    text.append_null();
   232	                    boolean.append_value(*x);
   233	                    err.append_null();
   234	                }
   235	                Value::Text(t) => {
   236	                    kind.append_value("text");
   237	                    num.append_null();
   238	                    text.append_value(t.as_ref());
   239	                    boolean.append_null();
   240	                    err.append_null();
   241	                }
   242	                Value::Error(e) => {
   243	                    kind.append_value("error");
   244	                    num.append_null();
   245	                    text.append_null();
   246	                    boolean.append_null();
   247	                    err.append_value(e.sigil());
   248	                }
   249	            }
   250	        }
   251	    }
   252	
   253	    let columns: Vec<ArrayRef> = vec![
   254	        Arc::new(kind.finish()),
   255	        Arc::new(num.finish()),
   256	        Arc::new(text.finish()),
   257	        Arc::new(boolean.finish()),
   258	        Arc::new(err.finish()),
   259	    ];
   260	    let schema = Arc::new(grid_schema(rows, cols));

