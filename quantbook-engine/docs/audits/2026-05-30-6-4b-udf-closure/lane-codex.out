     1	//! `WorkbookTransaction` — Phase 2A.2 batch-write API.
     2	//!
     3	//! Buffers a sequence of value + formula writes, then applies them atomically on
     4	//! `commit`. The IDE's "paste a 10×10 block" operation goes through one
     5	//! transaction instead of 100 individual `set_value` calls — one save-state
     6	//! change, one entry in the Phase 2A.3 op log per transaction.
     7	//!
     8	//! ## Semantics
     9	//!
    10	//! - **Eager validation**: `put_formula` runs lex + parse + bind at call time, so
    11	//!   syntactic + name-resolution errors surface before any workbook state changes.
    12	//!   Eval is deferred to commit (no `RuntimeError` from `commit` itself).
    13	//! - **Two-pass commit**:
    14	//!     1. Apply every literal value write + persist every formula's text. No
    15	//!        formula evaluation yet.
    16	//!     2. Evaluate each buffered formula against the now-updated workbook and
    17	//!        write its result to the cell.
    18	//!
    19	//!   This means a formula that references a literal-value cell written EARLIER
    20	//!   IN THE SAME TRANSACTION sees the new value (paste-block semantics).
    21	//! - **Intra-batch formula→formula dependencies**: formulas evaluate in op-insert
    22	//!   order. A formula referencing another formula in the same batch may see a
    23	//!   stale value (whichever was computed last wins). Engine Phase 3 calcgraph
    24	//!   integration adds topological scheduling (see `docs/MASTER-PLAN.md`
    25	//!   Phase 3.4).
    26	//! - **Drop without commit** = no-op. Buffered ops are discarded; workbook is
    27	//!   unchanged. Useful for the IDE's "ESC cancels paste" path.
    28	//! - **Last-write-wins**: writing the same cell twice in one transaction keeps
    29	//!   both ops in the list, and pass 2 applies them in order — so the final value
    30	//!   matches the last `put_*` for that cell.
    31	
    32	use std::cell::RefCell;
    33	use std::collections::HashMap;
    34	use std::sync::Arc;
    35	
    36	use ql_formula_syntax::{lex, parse};
    37	use ql_functions::FunctionRegistry;
    38	use ql_io::CellWireValue;
    39	use ql_oplog::{Op, OpLog};
    40	use ql_storage::Workbook;
    41	use ql_types::{ColId, RowId, SheetId, Value};
    42	use ql_udf::UdfWorker;
    43	
    44	use crate::env::{UdfCellDiagnostic, WorkbookEnv};
    45	use crate::plan::{bind_with_site, BindSite, ExprPlan};
    46	use crate::scalar::eval_scalar_with_registry;
    47	use crate::workbook_runtime::{validate_cell, RuntimeError};
    48	
    49	/// Phase 2A.6 audit H4: track the *kind* of op last buffered for each cell so
    50	/// `put_value` after `put_formula` (or vice versa) on the same cell can be
    51	/// rejected loudly at buffer time. Same-kind multi-writes (two `put_value`s,
    52	/// two `put_formula`s) are still allowed — the existing last-write-wins
    53	/// semantics handle them cleanly.
    54	#[derive(Copy, Clone, Debug, PartialEq, Eq)]
    55	enum OpKind {
    56	    Value,
    57	    Formula,
    58	}
    59	
    60	/// One pending operation in a transaction. Internal — the public API is the
    61	/// `put_value` / `put_formula` methods.
    62	enum PendingOp {
    63	    Value {
    64	        sheet: SheetId,
    65	        row: RowId,
    66	        col: ColId,
    67	        value: Value,
    68	    },
    69	    Formula {
    70	        sheet: SheetId,
    71	        row: RowId,
    72	        col: ColId,
    73	        text: Arc<str>,
    74	        plan: ExprPlan,
    75	    },
    76	}
    77	
    78	/// Batch writer for the workbook. Construct with `WorkbookTransaction::new` (or
    79	/// via `WorkbookRuntime::transaction`), buffer writes via `put_value` and
    80	/// `put_formula`, then call `commit` to apply them all.
    81	///
    82	/// The transaction holds a `&mut Workbook` for its entire lifetime — only one
    83	/// transaction can exist per workbook at a time (enforced by the borrow checker).
    84	///
    85	/// Phase 2A.3.b (2026-05-12): optional op-log attachment via
    86	/// `WorkbookTransaction::with_oplog` (or inherited from a runtime constructed
    87	/// via `WorkbookRuntime::with_oplog`). When attached, `commit` produces a
    88	/// single `Op::BatchCommit` containing one inner op per buffered write. Empty
    89	/// transactions (no buffered ops) emit nothing.
    90	pub struct WorkbookTransaction<'a> {
    91	    workbook: &'a mut Workbook,
    92	    registry: &'a FunctionRegistry,
    93	    ops: Vec<PendingOp>,
    94	    /// Phase 2A.6 audit H4: per-cell last-buffered op kind. Used to reject
    95	    /// mixed-kind writes (value+formula on the same cell within one tx) at
    96	    /// buffer time so the resulting workbook state is unambiguous.
    97	    cell_kinds: HashMap<(SheetId, RowId, ColId), OpKind>,
    98	    /// Phase 2A.3.b: optional op-log sink. `commit` emits a single
    99	    /// `BatchCommit` at the end of pass 2 when this is `Some` and there is
   100	    /// at least one buffered op.
   101	    oplog: Option<&'a mut OpLog>,
   102	    /// **6.4-3c (2026-05-29; CODEX-HIGH-2 audit fix):** borrowed handle to the
   103	    /// session's Python-UDF worker, inherited from the `WorkbookRuntime` via
   104	    /// `with_optional_oplog`. `None` for the bare `new`/`with_oplog`
   105	    /// constructors. Threaded into pass-2's eval env so a UDF committed through
   106	    /// a transaction COMPUTES instead of writing a permanent silent `#CALC!`
   107	    /// (this struct keeps no calcgraph, so a stale `#CALC!` here would NOT
   108	    /// self-heal). `None` (no worker) still yields a deterministic `#CALC!` at
   109	    /// the dispatch site — honest, never a panic.
   110	    udf_worker: Option<&'a RefCell<Box<dyn UdfWorker + Send>>>,
   111	    /// **6.4B (FF-2):** borrowed `UdfCellDiagnostic` collector, forwarded from the
   112	    /// `WorkbookRuntime` (which borrows the session's `udf_diagnostics`). Threaded
   113	    /// into pass-2's eval env so a `=MYUDF(..)` that fails (or has no worker) while
   114	    /// committing through THIS transaction records a structured diagnostic the
   115	    /// session drains into an `Event::CellDiagnostic` — symmetric with the
   116	    /// recompute / `set_formula` paths. `None` for the bare `new` / `with_oplog`
   117	    /// constructors (their UDF failures still yield the correct cell value, just no
   118	    /// diagnostic event). The standalone-transaction commit path was the one
   119	    /// value-computing eval site that previously dropped UDF diagnostics
   120	    /// (forward-risk: only test callers reach it today, but a future live commit
   121	    /// path would otherwise silently lose them).
   122	    udf_diagnostics: Option<&'a RefCell<Vec<UdfCellDiagnostic>>>,
   123	}
   124	
   125	impl<'a> WorkbookTransaction<'a> {
   126	    pub fn new(workbook: &'a mut Workbook, registry: &'a FunctionRegistry) -> Self {
   127	        Self {
   128	            workbook,
   129	            registry,
   130	            ops: Vec::new(),
   131	            cell_kinds: HashMap::new(),
   132	            oplog: None,
   133	            // 6.4-3c: bare constructor has no session, hence no worker. A UDF
   134	            // committed through it is `#CALC!` (no-worker, honest + visible).
   135	            udf_worker: None,
   136	            // 6.4B (FF-2): no session collector on the bare constructor.
   137	            udf_diagnostics: None,
   138	        }
   139	    }
   140	
   141	    /// Phase 2A.3.b: construct a transaction that records its commit as a
   142	    /// single `Op::BatchCommit` in the supplied op log. Useful when the
   143	    /// caller wants ad-hoc transactions outside an enclosing
   144	    /// `WorkbookRuntime::with_oplog`.
   145	    pub fn with_oplog(
   146	        workbook: &'a mut Workbook,
   147	        registry: &'a FunctionRegistry,
   148	        oplog: &'a mut OpLog,
   149	    ) -> Self {
   150	        Self {
   151	            workbook,
   152	            registry,
   153	            ops: Vec::new(),
   154	            cell_kinds: HashMap::new(),
   155	            oplog: Some(oplog),
   156	            // 6.4-3c: standalone op-log constructor, no session worker.
   157	            udf_worker: None,
   158	            // 6.4B (FF-2): standalone op-log constructor, no session collector.
   159	            udf_diagnostics: None,
   160	        }
   161	    }
   162	
   163	    /// Phase 2A.3.b: internal forwarding constructor used by
   164	    /// `WorkbookRuntime::transaction` to pass through the runtime's
   165	    /// (possibly absent) op-log handle via `Option::as_deref_mut`. Public
   166	    /// callers should prefer `new` or `with_oplog`.
   167	    ///
   168	    /// **6.4-3c (2026-05-29; CODEX-HIGH-2 audit fix):** also forwards the
   169	    /// runtime's (possibly absent) Python-UDF worker so UDFs committed through a
   170	    /// runtime transaction compute correctly instead of writing a permanent
   171	    /// silent `#CALC!`.
   172	    pub fn with_optional_oplog(
   173	        workbook: &'a mut Workbook,
   174	        registry: &'a FunctionRegistry,
   175	        oplog: Option<&'a mut OpLog>,
   176	        udf_worker: Option<&'a RefCell<Box<dyn UdfWorker + Send>>>,
   177	        // **6.4B (FF-2):** forward the runtime's (possibly absent) diagnostic
   178	        // collector so transaction-committed UDF failures emit a `CellDiagnostic`.
   179	        udf_diagnostics: Option<&'a RefCell<Vec<UdfCellDiagnostic>>>,
   180	    ) -> Self {
   181	        Self {
   182	            workbook,
   183	            registry,
   184	            ops: Vec::new(),
   185	            cell_kinds: HashMap::new(),
   186	            oplog,
   187	            udf_worker,
   188	            udf_diagnostics,
   189	        }
   190	    }
