  1233	/// **6.4-3d (2026-05-29; megaudit blocker G):** push a [`UdfCellDiagnostic`] for
  1234	/// the current formula cell into the env's per-recompute collector (a no-op when
  1235	/// the env carries no collector or no formula cell). Keyed by the formula's own
  1236	/// address (`env_formula_cell`), which the recompute / `set_formula` env sites
  1237	/// always set.
  1238	fn push_udf_cell_diagnostic<E: CellEnv + ?Sized>(env: &E, code: &'static str, message: String) {
  1239	    if let Some(addr) = env_formula_cell(env) {
  1240	        env.push_udf_diagnostic(crate::env::UdfCellDiagnostic {
  1241	            addr,
  1242	            code,
  1243	            message,
  1244	        });
  1245	    }
  1246	}
  1247	
  1248	/// **6.4-3d (2026-05-29; megaudit blocker G):** map a [`ql_udf::UdfError`] to a
  1249	/// stable diagnostic `code` + a human-readable `message`. Parallels
  1250	/// [`map_udf_error`] (which maps to the cell VALUE); this maps to the structured
  1251	/// `CellDiagnostic` detail so the IDE can show WHY a UDF failed (exit test 7).
  1252	fn udf_error_diagnostic(e: &ql_udf::UdfError) -> (&'static str, String) {
  1253	    use ql_udf::UdfError;
  1254	    match e {
  1255	        UdfError::Raised { exc_type, message } => ("udf_raised", format!("{exc_type}: {message}")),
  1256	        UdfError::Timeout(d) => (
  1257	            "udf_timeout",
  1258	            format!("UDF call exceeded its deadline ({d:?})"),
  1259	        ),
  1260	        UdfError::Cancelled => ("udf_cancelled", "UDF call cancelled".to_string()),
  1261	        UdfError::Handshake { expected, got } => (
  1262	            "udf_handshake",
  1263	            format!("worker handshake failed: protocol mismatch (engine {expected}, worker {got})"),
  1264	        ),
  1265	        UdfError::Protocol(m) => ("udf_protocol", format!("worker protocol violation: {m}")),
  1266	        UdfError::WorkerDied(m) => (
  1267	            "udf_worker_died",
  1268	            format!("Python worker died / transport broken: {m}"),
  1269	        ),
  1270	        // **6.4B (item I):** a cap breach is its own code so the IDE can say "grid
  1271	        // too large" rather than a generic codec error; the cell value is `#VALUE!`.
  1272	        UdfError::Codec(c) if is_grid_too_large(c) => (
  1273	            "udf_grid_too_large",
  1274	            format!("UDF grid exceeds a resource cap: {c}"),
  1275	        ),
  1276	        UdfError::Codec(c) => ("udf_codec", format!("UDF argument/return codec error: {c}")),
  1277	    }
  1278	}
  1279	
  1280	/// **6.4B (item I):** distinguish a grid cap breach ([`CodecError::GridTooManyCells`]
  1281	/// / [`CodecError::GridTooManyBytes`]) from a malformed-bytes codec error. Cap
  1282	/// breaches map to `#VALUE!` + `udf_grid_too_large`; other codec errors stay
  1283	/// `#CALC!` + `udf_codec`.
  1284	///
  1285	/// [`CodecError::GridTooManyCells`]: ql_udf::codec::CodecError::GridTooManyCells
  1286	/// [`CodecError::GridTooManyBytes`]: ql_udf::codec::CodecError::GridTooManyBytes
  1287	fn is_grid_too_large(c: &ql_udf::codec::CodecError) -> bool {
  1288	    matches!(
  1289	        c,
  1290	        ql_udf::codec::CodecError::GridTooManyCells { .. }
  1291	            | ql_udf::codec::CodecError::GridTooManyBytes { .. }
  1292	    )
  1293	}
  1294	
  1295	/// **6.4-3c (2026-05-29):** map a [`ql_udf::UdfError`] to a deterministic cell
  1296	/// error value. v1 is coarse: only `Timeout` → `#TIMEOUT!`; everything else
  1297	/// (`Raised`/`Cancelled`/`Handshake`/`Protocol`/`WorkerDied`/`Codec`) → `#CALC!`.
  1298	/// This maps only the cell VALUE; the structured `CellDiagnostic` that
  1299	/// distinguishes the variants (no-worker / raise / death — exit test 7's target)
