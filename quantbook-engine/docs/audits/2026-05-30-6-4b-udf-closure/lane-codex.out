  1112	    /// Surface an xlsx import report's fidelity caveats as `Warning`
  1113	    /// diagnostics (inc.2c-10). The import SUCCEEDS, but unsupported OOXML
  1114	    /// features (dropped), soft warnings, and formulas the engine couldn't
  1115	    /// recompute (Excel cached value preserved) are all reported as poll-able
  1116	    /// events — never silently dropped (No-Fallbacks). Called AFTER the
  1117	    /// `*self = from_workbook(..)` adoption (which resets `events`).
  1118	    fn push_xlsx_import_diagnostics(&mut self, report: &ql_io_xlsx::XlsxImportReport) {
  1119	        // The PRIMARY fidelity-loss channel: `scan_unsupported_features` records
  1120	        // dropped OOXML features (conditional formatting, data validation, merged
  1121	        // cells, hyperlinks, protection, comments, drawings, images, pivots,
  1122	        // macros, external links, hidden sheets) into `feature_inventory.counts`
  1123	        // — NOT into `report.unsupported` (which carries only per-occurrence
  1124	        // detail for a couple of cases). Under `UnsupportedPolicy::Permissive`
  1125	        // (the import default) those features are silently ignored on the wire,
  1126	        // so surfacing the inventory here is what keeps the No-Fallbacks promise.
  1127	        // Sorted by kind for deterministic event order (HashMap iteration order
  1128	        // is otherwise nondeterministic).
  1129	        let mut inventory: Vec<_> = report.feature_inventory.counts.iter().collect();
  1130	        inventory.sort_by_key(|(kind, _)| format!("{kind:?}"));
  1131	        for (kind, count) in inventory {
  1132	            self.events.push(Event::CellDiagnostic {
  1133	                diagnostic: Diagnostic {
  1134	                    addr: None,
  1135	                    severity: Severity::Warning,
  1136	                    code: "xlsx_unsupported_feature".to_string(),
  1137	                    message: format!(
  1138	                        "{kind:?} is not represented by the engine and was dropped on import \
  1139	                         ({count} occurrence(s))"
  1140	                    ),
  1141	                },
  1142	            });
  1143	        }
  1144	        // Per-occurrence unsupported records (location detail the inventory tally
  1145	        // lacks — e.g. an unregistered custom number format at a specific cell).
  1146	        for uf in &report.unsupported {
  1147	            self.events.push(Event::CellDiagnostic {
  1148	                diagnostic: Diagnostic {
  1149	                    addr: None,
  1150	                    severity: Severity::Warning,
  1151	                    code: "xlsx_unsupported_feature".to_string(),
  1152	                    message: format!("{:?} in {}: {}", uf.kind, uf.part, uf.detail),
  1153	                },
  1154	            });
  1155	        }
  1156	        for w in &report.warnings {
  1157	            self.events.push(Event::CellDiagnostic {
  1158	                diagnostic: Diagnostic {
  1159	                    addr: None,
  1160	                    severity: Severity::Warning,
  1161	                    code: "xlsx_import_warning".to_string(),
  1162	                    message: format!("{}: {}", w.location, w.message),
  1163	                },
  1164	            });
  1165	        }
  1166	        for f in &report.formula_failures {
