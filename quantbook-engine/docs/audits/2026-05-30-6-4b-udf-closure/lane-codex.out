  1013	/// **6.4-3c (2026-05-29):** marshal a UDF call's evaluated arguments into the
  1014	/// SINGLE `ArrayValue` the wire protocol carries (`ql_udf::CallPayload.args`).
  1015	/// The v1 shape rule (design §3 + the 6.4-3c plan; the worker receives one grid):
  1016	///   - N scalar args → a 1×N row grid (a single scalar arg → 1×1).
  1017	///   - exactly ONE grid arg → that arg's full grid (its native shape).
  1018	///   - mixed scalar+grid, OR ≥2 grid args → `Err(#VALUE!)` — these can't
  1019	///     be expressed in one rectangular grid; a richer args protocol (list-of-
  1020	///     grids) is deferred. The limitation is a VISIBLE `#VALUE!`, never silent.
  1021	///
  1022	/// **Classification is by RUNTIME shape, not plan shape** (CODEX-HIGH-1, 6.4-3c
  1023	/// 3-way audit). A "grid" arg is a range reference (`AggregateNameRef` /
  1024	/// `RangeRef` / `StructuredRef`), a literal array (`{1,2}`), OR a function call
  1025	/// that actually PRODUCES an array at runtime — a Unified-tier built-in (the
  1026	/// only built-in tier that can return `FunctionReturn::Array`, e.g.
  1027	/// `SEQUENCE(2,2)`) or a nested UDF that returns a grid. Those function args are
  1028	/// evaluated through [`eval_at_cell_boundary`] so their `Array` return is
  1029	/// preserved; without this they would fall to scalar eval, which collapses an
  1030	/// array to `#CALC!`, and the UDF would silently receive a 1×1 error grid
  1031	/// instead of the table the user wrote. Everything else (cell refs, literals,
  1032	/// arithmetic, and non-array built-ins INCLUDING `ROW`/`COLUMN` — `ReferenceAware`,
  1033	/// not `Unified` — which keep their implicit-intersection scalar semantics at a
  1034	/// UDF arg) is a scalar.
  1035	///
  1036	/// A `StructuredRef` whose `[@]` narrowing fails surfaces its error as `Err`.
  1037	///
  1038	/// **Error-valued args are forwarded** (Opus MED, 6.4-3c audit — intentional):
  1039	/// `=MYUDF(1/0)` packs `#DIV/0!` into the grid and sends it to Python, matching
  1040	/// Excel, where a UDF receives error values as arguments and may handle them
  1041	/// (e.g. an `IFERROR`-style UDF). It is NOT short-circuited to the error.
  1042	///
  1043	/// Range-shaped args reach here per the UDF's registered `ArgContext`: an
  1044	/// Aggregate-context UDF binds `=MYUDF(SomeRange)` to `AggregateNameRef`
  1045	/// (session.rs `register_function_with_aggregate_arg_context_admits_named_range_args`).
  1046	fn marshal_udf_args<E: CellEnv>(
  1047	    args: &[ExprPlan],
  1048	    env: &E,
  1049	    registry: &FunctionRegistry,
  1050	    cache: &dyn AggregateCache,
  1051	) -> Result<ArrayValue, ErrorValue> {
  1052	    // One evaluated argument: either a single value or a full grid, decided by
  1053	    // RUNTIME shape (see the fn doc — CODEX-HIGH-1 audit fix).
  1054	    enum Arg {
  1055	        Scalar(Value),
  1056	        Grid(ArrayValue),
  1057	    }
  1058	
  1059	    fn eval_arg<E: CellEnv>(
  1060	        a: &ExprPlan,
  1061	        env: &E,
  1062	        registry: &FunctionRegistry,
  1063	        cache: &dyn AggregateCache,
  1064	    ) -> Result<Arg, ErrorValue> {
  1065	        match a {
  1066	            ExprPlan::AggregateNameRef { range, .. } | ExprPlan::RangeRef { range } => {
  1067	                let (values, rows, cols) = env.read_range_with_shape(*range);
  1068	                Ok(Arg::Grid(
  1069	                    ArrayValue::new(rows as u32, cols as u32, values)
  1070	                        .map_err(|_| ErrorValue::Value)?,
  1071	                ))
  1072	            }
  1073	            ExprPlan::StructuredRef {
  1074	                resolved,
  1075	                is_this_row,
  1076	                ..
  1077	            } => {
  1078	                let range = narrow_structured_ref(*resolved, *is_this_row, env)?;
  1079	                let (values, rows, cols) = env.read_range_with_shape(range);
  1080	                Ok(Arg::Grid(
  1081	                    ArrayValue::new(rows as u32, cols as u32, values)
  1082	                        .map_err(|_| ErrorValue::Value)?,
  1083	                ))
  1084	            }
  1085	            ExprPlan::Array(rows) => {
  1086	                let row_count = rows.len() as u32;
  1087	                let col_count = rows.first().map(|r| r.len()).unwrap_or(0) as u32;
  1088	                let mut cells: Vec<Value> =
  1089	                    Vec::with_capacity((row_count as usize) * (col_count as usize));
  1090	                for row in rows {
  1091	                    for cell in row {
  1092	                        cells.push(eval_scalar_with_cache(cell, env, registry, cache));
  1093	                    }
  1094	                }
  1095	                Ok(Arg::Grid(
  1096	                    ArrayValue::new(row_count, col_count, cells).map_err(|_| ErrorValue::Value)?,
  1097	                ))
  1098	            }
  1099	            // Array-CAPABLE function: a Unified-tier built-in (the only built-in
  1100	            // tier that can return an Array) or a nested UDF. Evaluate at the
  1101	            // cell boundary so an Array return is preserved, not scalarized to
  1102	            // `#CALC!`. A scalar return (e.g. `SUM(..)`, or a UDF returning 1×1)
  1103	            // flows through as a scalar — no behavior change.
  1104	            ExprPlan::Function { name, .. }
  1105	                if matches!(
  1106	                    registry.lookup_any(name),
  1107	                    Some(ql_functions::RegisteredFn::Unified(_))
  1108	                ) || registry.udf_handle(name).is_some() =>
  1109	            {
  1110	                match eval_at_cell_boundary(a, env, registry, cache) {
  1111	                    EvalResult::Scalar(v) => Ok(Arg::Scalar(v)),
  1112	                    EvalResult::Array(av) => Ok(Arg::Grid(av)),
  1113	                }
  1114	            }
