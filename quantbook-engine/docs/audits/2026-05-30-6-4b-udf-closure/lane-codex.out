    90	/// A message from the reader thread to `call()`. A clean stdout EOF disconnects the
    91	/// channel (no message); a frame-decode failure is forwarded as `Error` so the
    92	/// caller can distinguish a torn stream from a clean shutdown.
    93	enum ReaderMsg {
    94	    Frame(Frame),
    95	    Error(String),
    96	}
    97	
    98	/// A live worker process + its stdin writer + the reader-thread channel.
    99	struct WorkerProcess {
   100	    child: Child,
   101	    stdin: ChildStdin,
   102	    rx: Receiver<ReaderMsg>,
   103	    reader: Option<JoinHandle<()>>,
   104	    /// The OS pid (also surfaced to the IDE for debugpy attach at 6.4-3d).
   105	    pid: u32,
   106	}
   107	
   108	impl Drop for WorkerProcess {
   109	    fn drop(&mut self) {
   110	        // Hard-stop the child and REAP it (no zombies). `wait()` returns promptly after
   111	        // `kill()` because it waits only on the DIRECT child (grandchildren are reparented
   112	        // to init, not waited here). NB: a child stuck in uninterruptible (`D`) kernel I/O
   113	        // won't die until it leaves `D`, so `wait()` is not strictly bounded — rare, and
   114	        // std offers no clean bounded wait; accepted for v1 (6.4-3b audit: drop-child-wait-unbounded).
   115	        let _ = self.child.kill();
   116	        let _ = self.child.wait();
   117	        // DETACH the reader thread — do NOT join it. If a UDF spawned a grandchild that
   118	        // inherited our stdout write-end, that pipe stays open after the direct child dies,
   119	        // so the reader's `read_frame` blocks forever; joining here would DEADLOCK the engine
   120	        // on the hard-cancel path (6.4-3b audit-fix: drop-join-deadlock-on-inherited-stdout).
   121	        // Dropping the `JoinHandle` detaches the thread; in the common case (no grandchild) the
   122	        // child's death closes the pipe → the reader hits EOF and exits on its own. A UDF that
   123	        // orphans a child can leak this one reader thread + fd until process exit; the proper
   124	        // fix (process-group/session kill so grandchildren die too) needs a `libc`/`nix` dep and
   125	        // is filed for 6.4-3c.
   126	        drop(self.reader.take());
   127	    }
   128	}
