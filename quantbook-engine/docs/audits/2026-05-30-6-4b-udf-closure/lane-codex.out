   246	            workbook,
   247	            eval_ctx,
   248	            formula_cell: None,
   249	            udf_worker: None,
   250	            udf_diagnostics: None,
   251	            // **6.4B (item H):** no op-budget by default; only the recompute pass
   252	            // sets one via `with_op_deadline`.
   253	            op_deadline: None,
   254	        }
   255	    }
