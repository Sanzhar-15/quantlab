   329	    fn read_cell(&self, sheet: SheetId, row: RowId, col: ColId) -> Value {
   330	        // Phase 2A.7 audit H6 (2026-05-12): out-of-bounds sheet now surfaces
   331	        // `Value::Error(ErrorValue::Ref)` — Excel's canonical `#REF!`. Prior
   332	        // behavior silently mapped missing-sheet to `Value::Blank`, which
   333	        // hid stale-sheet refs in saved formulas (e.g., a formula authored
   334	        // against Sheet3 in a workbook later truncated to 2 sheets). Two
   335	        // megaudit agents flagged the silent fallback. Within an existing
   336	        // sheet, missing cells still return `Blank` — that's correct Excel
   337	        // canon for "empty cell."
   338	        match self.workbook.sheet(sheet) {
   339	            Some(s) => s.read(row, col),
   340	            None => Value::Error(ErrorValue::Ref),
   341	        }
   342	    }
   343	
   344	    /// Phase 3.6 override: clamps the iteration to `Sheet::bounds` so a
   345	    /// `SUM(A:A)` named range with `end_row = RowId::MAX` reads only the
   346	    /// populated rows (typically a few hundred thousand at most on a
   347	    /// real sheet), not all 4 billion `RowId` slots. Without this clamp
   348	    /// AGG-3-04 would correctness-pass but AGG-3-03 (full-column-still-
   349	    /// usable) would hang at evaluation time.
   350	    fn read_range(&self, range: Range) -> Vec<Value> {
   351	        let Some(sheet) = self.workbook.sheet(range.sheet) else {
   352	            return vec![Value::Error(ErrorValue::Ref)];
   353	        };
   354	        let bounds = sheet.bounds();
   355	        // bounds extents are "one past max"; convert to inclusive bounds.
   356	        if bounds.row_extent == 0 || bounds.col_extent == 0 {
   357	            return Vec::new();
   358	        }
   359	        let max_row = bounds.row_extent - 1;
   360	        let max_col = bounds.col_extent - 1;
   361	        let end_row = range.end_row.min(max_row);
   362	        let end_col = range.end_col.min(max_col);
   363	        if range.start_row > end_row || range.start_col > end_col {
   364	            return Vec::new();
   365	        }
   366	        let mut out = Vec::with_capacity(
   367	            ((end_row - range.start_row + 1) as usize)
   368	                .saturating_mul((end_col - range.start_col + 1) as usize),
   369	        );
   370	        for row in range.start_row..=end_row {
   371	            for col in range.start_col..=end_col {
   372	                out.push(sheet.read(row, col));
   373	            }
   374	        }
   375	        out
   376	    }
   377	
   378	    /// W5-54 / W5-60: shape handling for explicit vs open-ended ranges.
   379	    ///
   380	    /// Two cases:
   381	    /// - **Open-ended** (whole-column / whole-row, end_row or end_col at
   382	    ///   `RowId::MAX` / `ColId::MAX`): clamp to sheet bounds. Shape and
   383	    ///   values reflect the populated subset. This is the W5-54 behavior
   384	    ///   for aggregate scans like `SUM(A:A)` over a sparse column.
   385	    /// - **Bounded explicit** (every coordinate < MAX): preserve the
   386	    ///   REQUESTED shape; pad out-of-bounds cells with `Value::Blank`.
   387	    ///   W5-60 fix per the W5-49→W5-58 mega-audit: shape-aware functions
   388	    ///   (INDEX / VLOOKUP / HLOOKUP / SUMIFS / SUMPRODUCT) rely on the
   389	    ///   shape matching the user's explicit range bounds. The W5-54
   390	    ///   clamp behavior produced `#REF!` for `INDEX(A1:B10, 10, 2)` when
   391	    ///   row 10 was blank because shape shrank to the populated subset.
   392	    fn read_range_with_shape(&self, range: Range) -> (Vec<Value>, usize, usize) {
   393	        let Some(sheet) = self.workbook.sheet(range.sheet) else {
   394	            return (vec![Value::Error(ErrorValue::Ref)], 1, 1);
   395	        };
   396	        let is_open_ended =
   397	            range.end_row == ql_types::RowId::MAX || range.end_col == ql_types::ColId::MAX;
   398	        if is_open_ended {
   399	            // Clamp to bounds (existing W5-54 behavior for SUM(A:A)
   400	            // and similar whole-column / whole-row aggregate scans).
   401	            let bounds = sheet.bounds();
   402	            if bounds.row_extent == 0 || bounds.col_extent == 0 {
   403	                return (Vec::new(), 0, 0);
   404	            }
   405	            let max_row = bounds.row_extent - 1;
   406	            let max_col = bounds.col_extent - 1;
   407	            let end_row = range.end_row.min(max_row);
   408	            let end_col = range.end_col.min(max_col);
   409	            if range.start_row > end_row || range.start_col > end_col {
   410	                return (Vec::new(), 0, 0);
   411	            }
   412	            let rows = (end_row - range.start_row + 1) as usize;
   413	            let cols = (end_col - range.start_col + 1) as usize;
   414	            let mut out = Vec::with_capacity(rows.saturating_mul(cols));
   415	            for row in range.start_row..=end_row {
   416	                for col in range.start_col..=end_col {
   417	                    out.push(sheet.read(row, col));
   418	                }
   419	            }
   420	            (out, rows, cols)
   421	        } else {
   422	            // Bounded explicit range: preserve requested shape; pad
   423	            // out-of-bounds cells with Blank. The user asked for
   424	            // exactly A1:B10; even if only A1:A5 is populated, the
   425	            // shape must remain 10×2 so INDEX / VLOOKUP /
   426	            // SUMIFS / SUMPRODUCT see the layout the user authored.
   427	            let rows = (range.end_row - range.start_row + 1) as usize;
   428	            let cols = (range.end_col - range.start_col + 1) as usize;
   429	            let mut out = Vec::with_capacity(rows.saturating_mul(cols));
   430	            for row in range.start_row..=range.end_row {
   431	                for col in range.start_col..=range.end_col {
   432	                    out.push(sheet.read(row, col));
   433	                }
   434	            }
   435	            (out, rows, cols)
   436	        }
   437	    }
