   127	/// Live-formula facade. Wraps a `&mut Workbook` + `&FunctionRegistry`.
   128	///
   129	/// Construct one per session of cell edits. Re-creating per call is cheap (the
   130	/// struct holds borrows, no heap state of its own).
   131	///
   132	/// Phase 2A.3.b (2026-05-12): optionally attach an `OpLog` via
   133	/// `WorkbookRuntime::with_oplog`. When attached, `set_value` and `set_formula`
   134	/// emit ops into the log in append-before-mutate order. `transaction()`
   135	/// re-borrows the op-log handle into the returned transaction so a single op
   136	/// log records both individual edits and batched commits cohesively.
   137	pub struct WorkbookRuntime<'a> {
   138	    workbook: &'a mut Workbook,
   139	    registry: &'a FunctionRegistry,
   140	    /// Optional op-log sink. When `Some`, all producer methods append before
   141	    /// mutating the workbook so a failing append leaves the workbook
   142	    /// unchanged. When `None`, the runtime behaves exactly as Phase 1 W5-10.
   143	    oplog: Option<&'a mut OpLog>,
   144	    /// Phase 2B.3 bind-plan cache. Lives for the runtime's lifetime;
   145	    /// successive `set_formula` and `recompute_all` calls hit the cache
   146	    /// for unchanged formula text under the same NameTable generation.
   147	    /// See `crate::plan_cache` module docs for the invalidation contract.
   148	    plan_cache: PlanCache,
   149	    /// Phase 3.1 (2026-05-12) optional calcgraph session. When `Some`,
   150	    /// every mutation method calls the corresponding hook on the
   151	    /// session AFTER the workbook mutation succeeds. Phase 3.1 hooks
   152	    /// are stubs (counter bumps + cell-index updates); Phase 3.3 wires
   153	    /// dirty propagation through the same surface. See
   154	    /// `crate::calcgraph_session` module docs for the ownership model.
   155	    graph: Option<&'a mut crate::CalcgraphSession>,
   156	    /// **W5-82 (Phase 4.5.D part 6):** parsed `FormatString` cache keyed
   157	    /// by `FormatId`. `read_display` populates on-demand from
   158	    /// `Workbook::formats()` lookup; `FormatTable::register_at` rejects
   159	    /// id→string mutations, so cache entries stay stable for the
   160	    /// runtime's lifetime. A new `RegisterFormat` op merely inserts a
   161	    /// new entry; no invalidation needed.
   162	    format_cache: std::collections::HashMap<FormatId, FormatString>,
   163	    /// **6.4-3c (2026-05-29):** borrowed handle to the session's out-of-process
   164	    /// Python-UDF worker, or `None` when no worker is configured (every
   165	    /// non-session constructor, plus a session that never called
   166	    /// `set_udf_worker`). Threaded into the value-computing env at the
   167	    /// `set_formula` / recompute sites (`with_formula_cell_and_worker`) so a
   168	    /// `=MYUDF(A1)` dispatches to the worker; the binding-only `validate` path
   169	    /// leaves it unused. The session owns the `RefCell<Box<dyn UdfWorker + Send>>`; the
   170	    /// runtime only borrows it (single-threaded — `RefCell` is `!Sync`).
   171	    udf_worker: Option<&'a RefCell<Box<dyn UdfWorker + Send>>>,
   172	    /// **6.4-3d (2026-05-29; megaudit blocker G):** borrowed per-recompute
   173	    /// collector for UDF-dispatch diagnostics, lent by the session alongside
   174	    /// `udf_worker`. Threaded into the value-computing env (recompute /
   175	    /// `set_formula`) so a failed `=MYUDF(..)` records WHY; `None` for every
   176	    /// non-session constructor (binding-only / standalone-transaction paths).
   177	    /// The session owns the `RefCell<Vec<_>>` and drains it after the runtime
   178	    /// borrow ends (single-threaded — `RefCell` is `!Sync`).
   179	    udf_diagnostics: Option<&'a RefCell<Vec<UdfCellDiagnostic>>>,
   180	    /// **6.4B (item H):** the operation-level UDF time-budget deadline for the
   181	    /// in-progress recompute pass. Armed by the session's recalc entry
   182	    /// ([`WorkbookSession::run_recalc`]) via [`arm_udf_op_deadline`] to
   183	    /// `Instant::now() + udf_op_budget` — only when a worker is attached — then
   184	    /// threaded into each per-cell recompute env via [`WorkbookEnv::with_op_deadline`].
   185	    /// `None` outside a worker-backed recompute pass (so non-UDF / no-worker
   186	    /// recompute is byte-for-byte unchanged, and direct `rt.recompute_*()` test
   187	    /// callers keep the per-call deadline only).
   188	    ///
   189	    /// [`arm_udf_op_deadline`]: WorkbookRuntime::arm_udf_op_deadline
   190	    op_deadline: Option<std::time::Instant>,
   191	}
