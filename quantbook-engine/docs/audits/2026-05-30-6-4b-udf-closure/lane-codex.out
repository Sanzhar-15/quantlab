   128	
   129	    schema = pa.schema(
   130	        _GRID_SCHEMA_FIELDS,
   131	        metadata={"rows": str(grid.rows), "cols": str(grid.cols)},
   132	    )
   133	    batch = pa.RecordBatch.from_arrays(
   134	        [
   135	            pa.array(kinds, pa.utf8()),
   136	            pa.array(nums, pa.float64()),
   137	            pa.array(strs, pa.utf8()),
   138	            pa.array(bools, pa.bool_()),
   139	            pa.array(errs, pa.utf8()),
   140	        ],
   141	        schema=schema,
   142	    )
   143	    sink = pa.BufferOutputStream()
   144	    with pa.ipc.new_stream(sink, schema) as writer:
   145	        writer.write_batch(batch)
