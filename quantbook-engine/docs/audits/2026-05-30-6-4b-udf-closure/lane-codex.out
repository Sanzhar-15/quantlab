     1	//! `EngineXlsxRecomputer` — the engine-layer implementation of
     2	//! [`ql_io_xlsx::XlsxRecomputer`] (Phase 6.1B inc.2c-10).
     3	//!
     4	//! `ql-io-xlsx` is pure I/O and cannot depend on `ql-exec` (that would form an
     5	//! `ql-exec → ql-io-xlsx → ql-exec` cycle, since `ql-exec` owns
     6	//! `WorkbookSession::import` which calls the importer). It therefore defines the
     7	//! `XlsxRecomputer` trait and the importer accepts an injected recomputer; this
     8	//! is the engine's implementation, wrapping [`WorkbookRuntime::recompute_all`].
     9	//!
    10	//! This is the inverse of the former `ql_io_xlsx::read::convert::
    11	//! recompute_loaded_workbook`, moved here verbatim when the dependency was
    12	//! inverted. It is **public** so `ql-io-xlsx`'s own tests can recompute through
    13	//! the real engine via their `ql-exec` dev-dependency
    14	//! (`import_xlsx_bytes(.., Some(&ql_exec::EngineXlsxRecomputer))`).
    15	
    16	use ql_functions::FunctionRegistry;
    17	use ql_io_xlsx::{FormulaImportFailure, XlsxImportReport, XlsxRecomputer};
    18	use ql_storage::Workbook;
    19	
    20	use crate::WorkbookRuntime;
    21	
    22	/// Engine-backed formula-recompute provider for xlsx import. Zero-sized.
    23	#[derive(Debug, Default, Clone, Copy)]
    24	pub struct EngineXlsxRecomputer;
    25	
    26	impl XlsxRecomputer for EngineXlsxRecomputer {
    27	    fn recompute_into(
    28	        &self,
    29	        mut wb: Workbook,
    30	        registry: &FunctionRegistry,
    31	        report: &mut XlsxImportReport,
    32	    ) -> Workbook {
    33	        // recompute_all evaluates every formula cell in topological order; per
    34	        // its contract it reports per-cell failures and does NOT abort on the
    35	        // first failure (BestEffort — the public-API Strict abort is decided by
    36	        // the importer after this returns, by inspecting `formula_failures`).
    37	        let result = {
    38	            let mut rt = WorkbookRuntime::new(&mut wb, registry);
    39	            rt.recompute_all()
    40	        };
    41	        // Translate STRUCTURAL failures (lex/parse/bind) into the import report.
    42	        // Evaluation errors that produce a `Value::Error` cell (e.g. `#DIV/0!`,
    43	        // `#N/A`) are normal cell values, NOT failures — `recompute_all` does not
    44	        // list them here.
    45	        for failure in result.failures.iter() {
    46	            report.formula_failures.push(FormulaImportFailure {
    47	                sheet: failure.sheet,
    48	                row: failure.row,
    49	                col: failure.col,
    50	                formula: failure.formula_text.to_string(),
    51	                reason: format!("{:?}", failure.error),
    52	            });
    53	        }
    54	        wb
    55	    }
    56	}
    55	/// without losing the workbook.
    56	///
    57	/// **6.4-4 megaudit note (UDF data-loss):** this builds a `WorkbookRuntime` with
    58	/// NO UDF worker and calls the HONEST `recompute_all` — so a `.qbook` carrying
    59	/// SAVED Python-UDF values, loaded through THIS function, would recompute those
    60	/// cells to `#CALC!` (the D2 data-loss the 6.4-3c megaudit closed). It is safe
    61	/// today because the product loads via `WorkbookSession::open`, which uses
    62	/// `recompute_all_preserving_saved_udf` to keep saved UDF values when no worker
    63	/// is present. Do NOT wire this standalone loader as the `.qbook` open path for a
    64	/// workbook that may contain UDF values without first injecting the worker (or
    65	/// switching to the preserving variant).
    66	pub fn load_workbook_and_recompute(
    67	    path: &Path,
    68	    registry: &FunctionRegistry,
    69	) -> Result<(Workbook, RecomputeResult), QbookError> {
    70	    let mut workbook = ql_io::load_workbook(path)?;
    71	    let recompute = {
    72	        let mut runtime = WorkbookRuntime::new(&mut workbook, registry);
    73	        runtime.recompute_all()
    74	    };
    75	    Ok((workbook, recompute))
    76	}
