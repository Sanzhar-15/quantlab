   260	    /// Phase 3.1 (2026-05-12): construct a runtime with BOTH an attached
   261	    /// op log and an attached calcgraph session. The combined-attachment
   262	    /// constructor mirrors the IDE pattern (open file → load oplog +
   263	    /// rebuild graph → hand both to the runtime per edit). Order of
   264	    /// operations per mutation: lex+parse+bind → op-log append → workbook
   265	    /// mutation → graph hook.
   266	    pub fn with_oplog_and_graph(
   267	        workbook: &'a mut Workbook,
   268	        registry: &'a FunctionRegistry,
   269	        oplog: &'a mut OpLog,
   270	        graph: &'a mut crate::CalcgraphSession,
   271	    ) -> Self {
   272	        Self {
   273	            workbook,
   274	            registry,
   275	            oplog: Some(oplog),
   276	            plan_cache: PlanCache::new(),
   277	            format_cache: std::collections::HashMap::new(),
   278	            graph: Some(graph),
   279	            udf_worker: None,
   280	            udf_diagnostics: None,
   281	            op_deadline: None,
   282	        }
   283	    }
   284	
   285	    /// **Phase 6.1B inc.2 (2026-05-26) — session-owned plan cache.**
   286	    /// Construct a runtime that takes ownership of a caller-supplied
   287	    /// `PlanCache` (instead of allocating a fresh one) AND attaches both
   288	    /// an op-log and a calcgraph session. The owning `WorkbookSession`
   289	    /// (`crate::session::WorkbookSession`) holds the long-lived
   290	    /// `PlanCache` and threads it through a per-edit runtime via this
   291	    /// constructor + [`into_plan_cache`], so the cache (and its
   292	    /// hit/miss stats) survive across edits even though the runtime
   293	    /// borrow window is reconstructed per command.
   294	    ///
   295	    /// This is the bottom-up realization of GAP-PS-09 / `docs/api/
   296	    /// session-api.md` §2.1 LOW-1: WorkbookSession owns
   297	    /// `Workbook + OpLog + CalcgraphSession + PlanCache + FunctionRegistry`
   298	    /// and constructs the per-edit `WorkbookRuntime` internally so no
   299	    /// borrow crosses an FFI boundary.
   300	    ///
   301	    /// Ownership-transfer (vs the borrow-a-`&mut PlanCache` shape the
   302	    /// design doc sketched) keeps every existing `self.plan_cache` call
   303	    /// site and the field type unchanged — `PlanCache: Default`, so the
   304	    /// session `mem::take`s its cache in, runs the edit, and recovers the
   305	    /// warmed cache via [`into_plan_cache`]. The `format_cache` is still
   306	    /// fresh per edit (a re-parse cost only; correctness unaffected) —
   307	    /// session-owning it is a later refinement.
   308	    ///
   309	    /// [`into_plan_cache`]: WorkbookRuntime::into_plan_cache
   310	    pub fn with_session_state(
   311	        workbook: &'a mut Workbook,
   312	        registry: &'a FunctionRegistry,
   313	        oplog: &'a mut OpLog,
   314	        graph: &'a mut crate::CalcgraphSession,
   315	        plan_cache: PlanCache,
   316	        // **6.4-3c (2026-05-29):** borrowed handle to the session's Python-UDF
   317	        // worker (`None` when none configured). Threaded into the eval env so
   318	        // `=MYUDF(A1)` dispatches; mirrors the `plan_cache` threading style.
   319	        udf_worker: Option<&'a RefCell<Box<dyn UdfWorker + Send>>>,
   320	        // **6.4-3d (2026-05-29; blocker G):** the per-recompute UDF-diagnostic
   321	        // collector, lent alongside the worker.
   322	        udf_diagnostics: Option<&'a RefCell<Vec<UdfCellDiagnostic>>>,
   323	    ) -> Self {
   324	        Self {
   325	            workbook,
   326	            registry,
   327	            oplog: Some(oplog),
   328	            plan_cache,
   329	            format_cache: std::collections::HashMap::new(),
   330	            graph: Some(graph),
   331	            udf_worker,
   332	            udf_diagnostics,
   333	            op_deadline: None,
   334	        }
   335	    }
   336	
   337	    /// **Phase 6.1B inc.2c-4 (2026-05-27) — `batch` detached-op-log path.**
   338	    /// Same as [`with_session_state`] but with the op-log **detached**
   339	    /// (`oplog = None`). Every mutator then updates the workbook AND
   340	    /// maintains the calcgraph session — the graph hooks fire on
   341	    /// `self.graph.is_some()`, independent of the op-log — but appends **no**
   342	    /// per-op entries (each producer gates its append on
   343	    /// `self.oplog.as_deref_mut()`).
   344	    ///
   345	    /// This is the load-bearing primitive for `WorkbookSession::batch`
   346	    /// (option (a), impl-plan §0): the session builds + appends ONE
   347	    /// `Op::BatchCommit` itself, then applies the buffered ops through this
   348	    /// graph-maintaining-but-silent runtime so the result is exactly one
   349	    /// op-log entry (one undo unit, §3.4) with the session graph kept live
   350	    /// (the tension `WorkbookTransaction` could not resolve — it maintains
   351	    /// no graph). The session's `PlanCache` is threaded through (recovered
   352	    /// via [`into_plan_cache`]) so the batch warms the same cache as
   353	    /// single edits.
   354	    ///
   355	    /// [`with_session_state`]: WorkbookRuntime::with_session_state
   356	    /// [`into_plan_cache`]: WorkbookRuntime::into_plan_cache
   357	    pub fn with_session_state_no_oplog(
   358	        workbook: &'a mut Workbook,
   359	        registry: &'a FunctionRegistry,
   360	        graph: &'a mut crate::CalcgraphSession,
   361	        plan_cache: PlanCache,
   362	        // **6.4-3c (2026-05-29):** see `with_session_state`.
   363	        udf_worker: Option<&'a RefCell<Box<dyn UdfWorker + Send>>>,
   364	        // **6.4-3d (2026-05-29; blocker G):** see `with_session_state`.
   365	        udf_diagnostics: Option<&'a RefCell<Vec<UdfCellDiagnostic>>>,
   366	    ) -> Self {
   367	        Self {
   368	            workbook,
   369	            registry,
   370	            oplog: None,
   371	            plan_cache,
   372	            format_cache: std::collections::HashMap::new(),
   373	            graph: Some(graph),
   374	            udf_worker,
   375	            udf_diagnostics,
   376	            op_deadline: None,
   377	        }
   378	    }
   379	
   380	    /// **Phase 6.1B inc.2 (2026-05-26).** Consume the runtime and return
   381	    /// its (now warmed) `PlanCache` so the owning session can retain it
   382	    /// for the next edit. Pairs with [`with_session_state`].
   383	    ///
   384	    /// [`with_session_state`]: WorkbookRuntime::with_session_state
   385	    /// **6.4B (item H):** arm the operation-level UDF budget deadline for the
   386	    /// recompute pass about to run through this runtime. Called by the session's
   387	    /// recalc entry with `Some(Instant::now() + budget)` when a worker is attached,
   388	    /// `None` otherwise. The per-cell recompute env-build site reads [`op_deadline`]
   389	    /// and threads it to the dispatch site via [`WorkbookEnv::with_op_deadline`].
   390	    ///
   391	    /// [`op_deadline`]: WorkbookRuntime::op_deadline
   392	    pub fn arm_udf_op_deadline(&mut self, deadline: Option<std::time::Instant>) {
   393	        self.op_deadline = deadline;
   394	    }
   395	
   396	    pub fn into_plan_cache(self) -> PlanCache {
   397	        self.plan_cache
   398	    }
   399	
   400	    /// Phase 2B.3: snapshot of cumulative bind-plan-cache observability
   401	    /// since this runtime was constructed. Includes hit count, miss
   402	    /// count, entry count, and convenience hit-rate.
   403	    pub fn cache_stats(&self) -> PlanCacheStats {
   404	        self.plan_cache.stats()
   405	    }
   406	}

