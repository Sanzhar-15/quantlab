  1156	/// **6.4-3c (2026-05-29):** dispatch ONE UDF call to the session-injected
  1157	/// out-of-process Python worker (reached via `env.udf_worker()`), mapping the
  1158	/// result / [`ql_udf::UdfError`] to a [`ql_functions::FunctionReturn`].
  1159	///
  1160	/// **Panic-free by contract:** every `UdfError` maps to a cell error value, so a
  1161	/// UDF failure can NEVER trip the recompute `FaultGuard` that seals the session
  1162	/// (6.1C M3 / design §5 — worker death is leaf I/O, a cell error, not an engine
  1163	/// fault). A registered UDF with NO worker configured is a deterministic
  1164	/// `#CALC!` (No-Fallbacks-honest: a visible error, never a silent no-op or panic).
  1165	///
  1166	/// The `RefCell` borrow is taken only here, AFTER `marshal_udf_args` finished
  1167	/// evaluating every arg — so a nested `=MYUDF(MYUDF2(A1))` released its inner
  1168	/// borrow before this outer one. The borrow is held across the single blocking
  1169	/// IPC round-trip, which never re-enters eval (the worker is a leaf).
  1170	fn dispatch_udf<E: CellEnv>(
  1171	    handle: u64,
  1172	    args_grid: ArrayValue,
  1173	    env: &E,
  1174	) -> ql_functions::FunctionReturn {
  1175	    use ql_functions::FunctionReturn;
  1176	    let Some(worker_cell) = env.udf_worker() else {
  1177	        // Registered, but no worker wired to this session → can't compute.
  1178	        // **6.4-3d (blocker G):** record WHY as a structured diagnostic
  1179	        // (additive — the cell value is still `#CALC!`); distinguishes
  1180	        // no-worker from a Python raise / worker death for the IDE.
  1181	        push_udf_cell_diagnostic(
  1182	            env,
  1183	            "udf_no_worker",
  1184	            "no Python worker is configured for this session".to_string(),
  1185	        );
  1186	        return FunctionReturn::Scalar(Value::Error(ErrorValue::Calc));
  1187	    };
  1188	    // **6.4B (item H):** operation-level budget gate. If this recompute pass has
  1189	    // already spent its UDF time budget, SKIP the call — a deterministic `#TIMEOUT!`
  1190	    // + `udf_budget_exhausted` diagnostic — rather than block the recalc thread for
  1191	    // another full per-call deadline (the N×30s stall). Otherwise the call's timeout
  1192	    // is clamped to the remaining budget so a mid-pass overrun is killed at the op
  1193	    // deadline (worker-kill IS the cancel under GIL-only Python), not 30s later.
  1194	    let Some(effective) = effective_udf_deadline(env.udf_op_deadline(), Instant::now()) else {
  1195	        push_udf_cell_diagnostic(
  1196	            env,
  1197	            "udf_budget_exhausted",
  1198	            "recompute UDF time budget exhausted before this cell; not dispatched".to_string(),
  1199	        );
  1200	        return FunctionReturn::Scalar(Value::Error(ErrorValue::Timeout));
  1201	    };
  1202	    let mut worker = worker_cell.borrow_mut();
  1203	    match worker.call(handle, &args_grid, effective) {
  1204	        Ok(grid) => {
  1205	            if grid.rows() == 1 && grid.cols() == 1 {
  1206	                // 1×1 result → a scalar cell value. `get(0,0)` on a grid we
  1207	                // just confirmed is 1×1 is always `Some`; a `None` here would
  1208	                // mean an internally-inconsistent `ArrayValue` from the worker
  1209	                // — surface it as a VISIBLE `#CALC!` (No-Fallbacks), NOT a
  1210	                // silent `Blank` (Opus LOW-1, 6.4-3c audit).
  1211	                FunctionReturn::Scalar(
  1212	                    grid.get(0, 0)
  1213	                        .cloned()
