   290	                        .iter()
   291	                        .map(|a| eval_scalar_with_cache(a, env, registry, cache))
   292	                        .collect();
   293	                    caf(&evaluated, env.eval_context())
   294	                }
   295	                Some(RegisteredFn::Unified(uf)) => {
   296	                    // **W5-100-AUDIT (Phase 4.7.G):** unified ABI path.
   297	                    // No production callers from `default_registry`
   298	                    // today; Phase 4.7.M/N register SEQUENCE / FILTER /
   299	                    // TRANSPOSE through this tier. The arg materialization
   300	                    // here is the minimum-viable shape: every plan arg
   301	                    // becomes a `FunctionArg::Scalar(eval)`, EXCEPT
   302	                    // `ExprPlan::Array` which becomes a `FunctionArg::Array`
   303	                    // and `ExprPlan::AggregateNameRef` which becomes a
   304	                    // `FunctionArg::Range`.
   305	                    use ql_functions::{FunctionArg, FunctionContext, FunctionReturn};
   306	                    let mut f_args: Vec<FunctionArg> = Vec::with_capacity(args.len());
   307	                    for a in args {
   308	                        match a {
   309	                            ExprPlan::AggregateNameRef { range, .. } => {
   310	                                let (values, rows, cols) = env.read_range_with_shape(*range);
   311	                                f_args.push(FunctionArg::Range { values, rows, cols });
   312	                            }
   313	                            // **W5-116 (Phase 4.8.G):** structured-ref same
   314	                            // shape as AggregateNameRef in unified-ABI
   315	                            // function arg position. 4.8.G.2: `[@Col]`
   316	                            // narrows resolved to single row.
   317	                            ExprPlan::StructuredRef {
   318	                                resolved,
   319	                                is_this_row,
   320	                                ..

