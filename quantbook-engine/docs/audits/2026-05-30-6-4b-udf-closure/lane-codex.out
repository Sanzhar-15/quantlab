  1224	            // the cell error value (the value mapping is unchanged — still
  1225	            // `#TIMEOUT!`/`#CALC!`).
  1226	            let (code, message) = udf_error_diagnostic(&e);
  1227	            push_udf_cell_diagnostic(env, code, message);
  1228	            FunctionReturn::Scalar(Value::Error(map_udf_error(&e)))
