   760	/// `EvalResult::Scalar` for every plan shape that does NOT produce an
   761	/// array at the cell root, and `EvalResult::Array` ONLY for top-level
   762	/// `ExprPlan::Array` (Phase 4.7.J.1) and, in future, array-returning
   763	/// function calls (Phase 4.7.M for SEQUENCE; 4.7.N for FILTER/TRANSPOSE).
   764	///
   765	/// **Contract divergence from `eval_scalar_with_cache`:** the scalar
   766	/// evaluator treats `ExprPlan::Array(_)` as array-in-scalar-context and
   767	/// returns `Value::Error(ErrorValue::Calc)` per design § 6.3. This is
   768	/// the correct semantics ANYWHERE an array surfaces inside an arithmetic
   769	/// or comparison context — and it stays unchanged.
   770	///
   771	/// At the CELL boundary, however, an array result is a SPILL request,
   772	/// not an error. The runtime's spill-writeback path (Phase 4.7.J.2)
   773	/// pattern-matches on `EvalResult::Array(_)` and materializes the
   774	/// array into per-cell computed-overlay writes. By keeping THIS
   775	/// function the only path that returns `EvalResult::Array`, every
   776	/// non-cell-boundary call site continues to produce `#CALC!` for
   777	/// arrays — preserving the scalar-context contract.
   778	///
   779	/// **What about nested array results inside expressions?** Per § 3.3,
   780	/// array literals at non-root positions are parser-rejected, and binder
   781	/// validation forbids non-literal cell-plans inside `ExprPlan::Array`.
   782	/// So at the cell boundary, only the OUTERMOST plan node can be an
   783	/// `Array`. Any deeper subtree is normal scalar-producing code.
   784	///
   785	/// **Materialization detail.** Each cell-plan inside an
   786	/// `ExprPlan::Array` is a literal (Number / Bool / String / Error) per
   787	/// binder rules. We still route the per-cell evaluation through
   788	/// `eval_scalar_with_cache` for uniformity — there's no shortcut here,
   789	/// since the literal-only restriction is a binder-side invariant and
   790	/// the evaluator stays plan-shape-agnostic.
   791	///
   792	/// **`ArrayValue::new` invariants.** The binder rejects
   793	/// `ExprPlan::Array(vec![])` (`BindError::EmptyArrayLiteral`) and
   794	/// `ExprPlan::Array(vec![vec![]])` likewise, AND row-arity mismatch
   795	/// (`BindError::ArrayRowArityMismatch`). So when we reach this code,
   796	/// `rows.len() >= 1`, every row has the same `>= 1` width, and the
   797	/// flattened `cells` vec satisfies `len == rows.len() * cols`.
   798	/// `ArrayValue::new` therefore CANNOT fail here (the only error case
   799	/// is `CellCountMismatch`). We assert via `expect` rather than building
   800	/// a fallback path; per the no-fallbacks rule, a binder regression
   801	/// should panic loudly, not silently produce `#CALC!`.
   802	pub fn eval_at_cell_boundary<E: CellEnv>(
   803	    plan: &ExprPlan,
   804	    env: &E,
   805	    registry: &FunctionRegistry,
   806	    cache: &dyn AggregateCache,
   807	) -> EvalResult {
   808	    match plan {
   809	        ExprPlan::Array(rows) => {
   810	            // Binder invariants (see doc comment): rows non-empty,
   811	            // first row determines column count, every row matches.
   812	            let array_rows = rows.len() as u32;
   813	            let array_cols = rows[0].len() as u32;
   814	            let mut cells: Vec<Value> = Vec::with_capacity(rows.len() * rows[0].len());
   815	            for row in rows {
   816	                for cell_plan in row {
   817	                    cells.push(eval_scalar_with_cache(cell_plan, env, registry, cache));
   818	                }
   819	            }
   820	            // `ArrayShapeError::CellCountMismatch` is unreachable from this
   821	            // code path: binder enforces `EmptyArrayLiteral` rejection,
   822	            // `ArrayRowArityMismatch` rejection, and `ArrayCellNotLiteral`
   823	            // rejection — so the input `ExprPlan::Array(rows)` satisfies
   824	            // `rows.len() >= 1`, all rows have equal width `>= 1`, and
   825	            // every cell-plan is a literal. The flatten above pushes
   826	            // exactly `rows.len() * rows[0].len()` cells. If this
   827	            // `expect` ever fires, EITHER the binder validation was
   828	            // bypassed (e.g. a direct `ExprPlan::Array(...)` constructor
   829	            // call in tests/host code), OR `ArrayValue::new` gained a
   830	            // new error variant. Both are upstream bugs — surface
   831	            // loudly per CLAUDE.md no-fallbacks rule.
   832	            let array = ArrayValue::new(array_rows, array_cols, cells).expect(
   833	                "eval_at_cell_boundary: ArrayValue::new failed — \
   834	                 binder validation should make CellCountMismatch \
   835	                 unreachable; ExprPlan::Array constructed directly \
   836	                 (bypassing binder) is the most likely cause",
   837	            );
   838	            EvalResult::Array(array)
   839	        }
   840	        // **W5-106 (Phase 4.7.M)**: top-level array-returning function
   841	        // call. If the plan is `ExprPlan::Function` AND the registered
   842	        // function is a Unified-tier callable (the only tier that can
   843	        // return `FunctionReturn::Array`), dispatch HERE so an Array
   844	        // return surfaces as `EvalResult::Array` for the spill writeback
   845	        // path. Scalar returns flow through normally.
   846	        //
   847	        // Functions on non-Unified tiers (Scalar / RangeAware /
   848	        // ContextAware) always return `Value` and can never produce an
   849	        // Array; they take the scalar fallthrough below.
   850	        ExprPlan::Function { name, args }
   851	            if matches!(
   852	                registry.lookup_any(name),
   853	                Some(ql_functions::RegisteredFn::Unified(_))
   854	            ) =>
   855	        {
   856	            // Pull out the unified fn pointer. Unwrap is safe — the
   857	            // guard above just matched it.
   858	            let uf = match registry.lookup_any(name) {
   859	                Some(ql_functions::RegisteredFn::Unified(f)) => *f,
   860	                _ => unreachable!(
   861	                    "eval_at_cell_boundary: registry contract violated \
   862	                     between guard and re-lookup"
   863	                ),
   864	            };
   865	            // Materialize args into `FunctionArg`. Mirrors the scalar
   866	            // dispatch path's arg construction (scalar.rs ~258-310):
   867	            //   - `AggregateNameRef` → `FunctionArg::Range`.
   868	            //   - `StructuredRef`     → `FunctionArg::Range` (narrowed).
   869	            //   - `ExprPlan::Array`   → `FunctionArg::Array`.
   870	            //   - Everything else     → `FunctionArg::Scalar(eval)`.
   871	            use ql_functions::{FunctionArg, FunctionContext, FunctionReturn};
   872	            let mut f_args: Vec<FunctionArg> = Vec::with_capacity(args.len());
   873	            for a in args {
   874	                match a {
   875	                    ExprPlan::AggregateNameRef { range, .. } => {
   876	                        let (values, rows, cols) = env.read_range_with_shape(*range);
   877	                        f_args.push(FunctionArg::Range { values, rows, cols });
   878	                    }
   879	                    // **MEGAUDIT fix (2026-05-29; Codex-A HIGH / Opus-marshal
   880	                    // MED):** the scalar Unified arm (scalar.rs:280-295) reads a
   881	                    // `StructuredRef` as a `Range`, but this boundary arm was
   882	                    // missing it — a `StructuredRef` fell to the `other` arm and
   883	                    // was scalar-evaluated. That mis-fed `=TRANSPOSE(Table[Col])`
   884	                    // (typed directly AND, after the 6.4-3c audit-fix routed
   885	                    // array-capable UDF args through here, as a UDF arg). Mirror
   886	                    // the scalar path: narrow `[@Col]`, then read the range.
   887	                    ExprPlan::StructuredRef {
   888	                        resolved,
   889	                        is_this_row,
   890	                        ..
   891	                    } => match narrow_structured_ref(*resolved, *is_this_row, env) {
   892	                        Ok(range) => {
   893	                            let (values, rows, cols) = env.read_range_with_shape(range);
   894	                            f_args.push(FunctionArg::Range { values, rows, cols });
   895	                        }
   896	                        Err(ev) => f_args.push(FunctionArg::Scalar(Value::Error(ev))),
   897	                    },
   898	                    ExprPlan::Array(rows) => {
   899	                        let row_count = rows.len() as u32;
   900	                        let col_count = rows.first().map(|r| r.len()).unwrap_or(0) as u32;
   901	                        let mut cells: Vec<Value> =
   902	                            Vec::with_capacity((row_count * col_count) as usize);
   903	                        for row in rows {
   904	                            for cell in row {
   905	                                cells.push(eval_scalar_with_cache(cell, env, registry, cache));
   906	                            }
   907	                        }
   908	                        let av = ArrayValue::new(row_count, col_count, cells)
   909	                            .expect("ExprPlan::Array passed binder validation; shape intact");
   910	                        f_args.push(FunctionArg::Array(av));
   911	                    }
   912	                    other => {
   913	                        f_args.push(FunctionArg::Scalar(eval_scalar_with_cache(
   914	                            other, env, registry, cache,
   915	                        )));
   916	                    }
   917	                }
   918	            }
   919	            let ctx = FunctionContext::new(env.eval_context());
   920	            match uf(&f_args, &ctx) {
   921	                FunctionReturn::Scalar(v) => EvalResult::Scalar(v),
   922	                FunctionReturn::Array(a) => EvalResult::Array(a),
   923	            }
   924	        }
   925	        // **W5-RT-1 (RT-V1-01) / HIGH-E + Step 1.1 S1-HIGH-B closures:** at
   926	        // the cell boundary, ROW/COLUMN with a single multi-cell range or
   927	        // array arg returns `#CALC!` instead of silently truncating to
   928	        // top-left. In modern Excel-compatible workbooks `=ROW(A1:A5)`
   929	        // typed at the cell root spills `{1;2;3;4;5}`; until v1 of the
   930	        // spill path lands, an explicit error is the correct stance —
   931	        // silent scalar truncation would be a wrong-result regression.
   932	        //
   933	        // Scalar context (e.g. `=ROW(A1:A5)+0` as a sub-expression) is
   934	        // unaffected — the per-fn impl returns top-left there, matching
   935	        // Excel pre-365 implicit-intersection semantics.
   936	        //
   937	        // **S1-HIGH-B (Codex):** the initial Step 1 guard checked only
   938	        // RangeRef / AggregateNameRef / Array; `ROW(Sales[Qty])` bypassed
   939	        // it because StructuredRef takes a different plan shape. Step
   940	        // 1.1 closure adds the StructuredRef branch, narrowing first via
   941	        // `narrow_structured_ref` so `Sales[@Qty]` (single-cell after
   942	        // `[@]` narrowing) is NOT rejected while `Sales[Qty]` (full
   943	        // column) IS rejected when multi-cell.
   944	        ExprPlan::Function { name, args }
   945	            if args.len() == 1
   946	                && matches!(name.as_ref(), "ROW" | "COLUMN")
   947	                && matches!(
   948	                    registry.lookup_any(name),
   949	                    Some(ql_functions::RegisteredFn::ReferenceAware(_, _))
   950	                ) =>
   951	        {
   952	            let multi_cell = match &args[0] {
   953	                ExprPlan::RangeRef { range } => {
   954	                    range.start_row != range.end_row || range.start_col != range.end_col
   955	                }
   956	                ExprPlan::AggregateNameRef { range, .. } => {
   957	                    range.start_row != range.end_row || range.start_col != range.end_col
   958	                }
   959	                ExprPlan::StructuredRef {
   960	                    resolved,
   961	                    is_this_row,
   962	                    ..
   963	                } => match narrow_structured_ref(*resolved, *is_this_row, env) {
   964	                    Ok(range) => {
   965	                        range.start_row != range.end_row || range.start_col != range.end_col
   966	                    }
   967	                    // Narrowing-error case (e.g., formula cell outside
   968	                    // the table's data range) — defer to scalar eval to
   969	                    // surface the error normally; not multi-cell.
   970	                    Err(_) => false,
   971	                },
   972	                ExprPlan::Array(rows) => {
   973	                    rows.len() != 1 || rows.first().map(|r| r.len()).unwrap_or(0) != 1
   974	                }
   975	                _ => false,
   976	            };
   977	            if multi_cell {
   978	                return EvalResult::Scalar(Value::Error(ErrorValue::Calc));
   979	            }
   980	            EvalResult::Scalar(eval_scalar_with_cache(plan, env, registry, cache))
   981	        }
   982	        // **6.4-3c (2026-05-29):** top-level UDF call. A UDF can return an N×M
   983	        // grid (the wedge — a Python function producing a table); at the cell
   984	        // boundary that must surface as `EvalResult::Array` so the existing
   985	        // `write_spill` writeback (recompute.rs) spills it, NOT collapse to
   986	        // `#CALC!` (the ROW/COLUMN wrong-result lesson above). Mutually
   987	        // exclusive with the Unified / ROW-COLUMN guards by construction:
   988	        // `udf_handle` is `Some` ONLY for UDFs, and those guards' `lookup_any`
   989	        // returns `None` for a UDF (a name is never both a built-in and a UDF —
   990	        // `register_udf`'s Conflict check enforces it). Must precede `_`.
   991	        // (Opus LOW-3, 6.4-3c audit: that invariant relies on every built-in in
   992	        // `fns` having metadata, which `default_registry`'s boot-time assert
   993	        // guarantees; a hand-built registry that inserts a `fns` entry WITHOUT
   994	        // metadata and then `register_udf`s the same name could populate both
   995	        // tables — there the built-in guards still win, so no wrong result, but
   996	        // the exclusivity is construction-dependent, not structural.)
   997	        ExprPlan::Function { name, args } if registry.udf_handle(name).is_some() => {
   998	            let handle = registry
   999	                .udf_handle(name)
  1000	                .expect("guard above matched udf_handle(name).is_some()");
  1001	            match marshal_udf_args(args, env, registry, cache) {
  1002	                Ok(grid) => match dispatch_udf(handle.0, grid, env) {
  1003	                    ql_functions::FunctionReturn::Scalar(v) => EvalResult::Scalar(v),
  1004	                    ql_functions::FunctionReturn::Array(a) => EvalResult::Array(a),
  1005	                },
  1006	                Err(ev) => EvalResult::Scalar(Value::Error(ev)),
  1007	            }
  1008	        }
  1009	        _ => EvalResult::Scalar(eval_scalar_with_cache(plan, env, registry, cache)),
  1010	    }
  1011	}
