    38	/// `udf_raised`, `message` carries `"{exc_type}: {message}"`.
    39	#[derive(Clone, Debug, PartialEq)]
    40	pub struct UdfCellDiagnostic {
    41	    /// The formula cell the failing UDF lives in.
