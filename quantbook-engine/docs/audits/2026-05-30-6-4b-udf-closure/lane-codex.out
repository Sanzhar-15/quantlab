   205	# ---- CALL / RETURN payloads ----------------------------------------------
   206	
   207	def decode_call(payload):
   208	    """Decode a CALL payload → ``(handle, call_id, args_grid)``."""
   209	    if len(payload) < 16:
   210	        raise ValueError("CALL payload header truncated (need 16 bytes, got %d)" % len(payload))
