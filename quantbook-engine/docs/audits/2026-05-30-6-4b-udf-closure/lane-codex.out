   706	        let buf = write_ipc(&schema, vec![kind, num, text, boolean, err]);
   707	        let e = decode_grid(&buf).unwrap_err();
   708	        assert!(
   709	            matches!(e, CodecError::BadErrorSigil(ref s) if s == "#NOT_A_REAL_SIGIL!"),
   710	            "got {e:?}"
   711	        );
   712	    }
   713	
   714	    /// **6.4-3a audit-fix (shape metadata — previously untested):** missing
   715	    /// `rows`/`cols` metadata, non-u32 metadata, and a metadata-vs-cell-count
   716	    /// mismatch must all error.
   717	    #[test]
   718	    fn decode_rejects_bad_shape_metadata() {
   719	        // (a) missing metadata entirely.
   720	        let fields: Vec<Field> = EXPECTED_FIELDS
   721	            .iter()
   722	            .map(|(n, dt, nl)| Field::new(*n, dt.clone(), *nl))
   723	            .collect();
   724	        let no_md = Arc::new(Schema::new(fields)); // no .with_metadata
   725	        let cols0: Vec<ArrayRef> = vec![
   726	            Arc::new(StringArray::from(vec!["blank"])),
   727	            Arc::new(Float64Array::from(vec![None as Option<f64>])),
   728	            Arc::new(StringArray::from(vec![None as Option<&str>])),
   729	            Arc::new(BooleanArray::from(vec![None as Option<bool>])),
   730	            Arc::new(StringArray::from(vec![None as Option<&str>])),
   731	        ];
   732	        let buf = write_ipc(&no_md, cols0);
   733	        assert!(
   734	            matches!(decode_grid(&buf).unwrap_err(), CodecError::MissingShape(_)),
   735	            "missing metadata must be MissingShape"
   736	        );
   737	
   738	        // (b) non-u32 metadata.
   739	        let bad_md = {
   740	            let fields: Vec<Field> = EXPECTED_FIELDS
   741	                .iter()
   742	                .map(|(n, dt, nl)| Field::new(*n, dt.clone(), *nl))
   743	                .collect();
   744	            Arc::new(Schema::new(fields).with_metadata(HashMap::from([
   745	                ("rows".into(), "abc".into()),
   746	                ("cols".into(), "1".into()),
   747	            ])))
   748	        };
   749	        let cols1: Vec<ArrayRef> = vec![
   750	            Arc::new(StringArray::from(vec!["blank"])),
   751	            Arc::new(Float64Array::from(vec![None as Option<f64>])),
   752	            Arc::new(StringArray::from(vec![None as Option<&str>])),
   753	            Arc::new(BooleanArray::from(vec![None as Option<bool>])),
   754	            Arc::new(StringArray::from(vec![None as Option<&str>])),
   755	        ];
   756	        let buf = write_ipc(&bad_md, cols1);
   757	        assert!(
   758	            matches!(decode_grid(&buf).unwrap_err(), CodecError::BadShape { .. }),
   759	            "non-u32 metadata must be BadShape"
   760	        );
   761	
   762	        // (c) metadata says 2×2 (=4 cells) but the batch has 1 row.
   763	        let mismatch = Arc::new(grid_schema(2, 2));
   764	        let cols2: Vec<ArrayRef> = vec![
   765	            Arc::new(StringArray::from(vec!["blank"])),
   766	            Arc::new(Float64Array::from(vec![None as Option<f64>])),
   767	            Arc::new(StringArray::from(vec![None as Option<&str>])),
   768	            Arc::new(BooleanArray::from(vec![None as Option<bool>])),
   769	            Arc::new(StringArray::from(vec![None as Option<&str>])),
   770	        ];
   771	        let buf = write_ipc(&mismatch, cols2);
   772	        assert!(
   773	            matches!(decode_grid(&buf).unwrap_err(), CodecError::ShapeMismatch(_)),
   774	            "cell-count mismatch must be ShapeMismatch"
   775	        );
   776	    }
   777	
   778	    /// **6.4-3a audit-fix (extra-batches-dropped):** a stream with more than one
   779	    /// record batch must be rejected, matching the "exactly one" doc contract.
   780	    #[test]
   781	    fn decode_rejects_trailing_batch() {
   782	        let schema = Arc::new(grid_schema(1, 1));
   783	        let make_cols = || -> Vec<ArrayRef> {
   784	            vec![
   785	                Arc::new(StringArray::from(vec!["blank"])),
   786	                Arc::new(Float64Array::from(vec![None as Option<f64>])),
   787	                Arc::new(StringArray::from(vec![None as Option<&str>])),
   788	                Arc::new(BooleanArray::from(vec![None as Option<bool>])),
   789	                Arc::new(StringArray::from(vec![None as Option<&str>])),
   790	            ]
   791	        };
   792	        let mut buf = Vec::new();
   793	        {
   794	            let mut w = StreamWriter::try_new(&mut buf, &schema).unwrap();
   795	            w.write(&RecordBatch::try_new(schema.clone(), make_cols()).unwrap())
   796	                .unwrap();
   797	            w.write(&RecordBatch::try_new(schema.clone(), make_cols()).unwrap())
   798	                .unwrap();
   799	            w.finish().unwrap();
   800	        }
   801	        assert!(
   802	            matches!(decode_grid(&buf).unwrap_err(), CodecError::TrailingBatch),
   803	            "two batches must be TrailingBatch"
   804	        );
   805	    }
   806	
   807	    #[test]
   808	    fn decode_rejects_empty_stream() {
   809	        // A schema-only stream (no batches) → Empty.
   810	        let schema = Arc::new(grid_schema(0, 0));
   811	        let mut buf = Vec::new();
   812	        {
   813	            let mut w = StreamWriter::try_new(&mut buf, &schema).unwrap();
   814	            w.finish().unwrap();
   815	        }
   816	        assert!(matches!(decode_grid(&buf).unwrap_err(), CodecError::Empty));
   817	    }
   818	
   819	    // ---- 6.4B (item I): grid resource caps ----
   820	
   821	    /// `encode_grid_capped` rejects a grid whose cell count exceeds the cap BEFORE
   822	    /// building Arrow buffers (a tiny cap stands in for the 5M default so the test
   823	    /// allocates nothing large).
   824	    #[test]
   825	    fn encode_rejects_grid_over_cell_cap() {
   826	        let grid = ArrayValue::new(2, 2, vec![Value::Number(1.0); 4]).unwrap();
   827	        let err = encode_grid_capped(&grid, 3, MAX_GRID_BYTES).unwrap_err();
   828	        assert!(
   829	            matches!(err, CodecError::GridTooManyCells { cells: 4, max: 3 }),
   830	            "got {err:?}"
   831	        );
   832	        // At the cap it still encodes.
   833	        assert!(encode_grid_capped(&grid, 4, MAX_GRID_BYTES).is_ok());
   834	    }
   835	
   836	    /// `decode_grid_capped` rejects an over-cap grid BEFORE the cell-vec allocation.
   837	    #[test]
   838	    fn decode_rejects_grid_over_cell_cap() {
   839	        let grid = ArrayValue::new(2, 2, vec![Value::Number(7.0); 4]).unwrap();
   840	        let bytes = encode_grid(&grid).expect("encode (under default cap)");
   841	        let err = decode_grid_capped(&bytes, 3, MAX_GRID_BYTES).unwrap_err();
   842	        assert!(
   843	            matches!(err, CodecError::GridTooManyCells { cells: 4, max: 3 }),
   844	            "got {err:?}"
   845	        );
   846	        // At the cap it round-trips.
   847	        let back = decode_grid_capped(&bytes, 4, MAX_GRID_BYTES).expect("decode at cap");
   848	        assert_eq!(back.rows(), 2);
   849	        assert_eq!(back.cols(), 2);
   850	    }
   851	
   852	    /// `encode_grid_capped` rejects a grid whose ENCODED bytes exceed the byte cap
   853	    /// even when its cell count is under the cell cap (few cells, large strings).
   854	    #[test]
   855	    fn encode_rejects_grid_over_byte_cap() {
   856	        let big = "x".repeat(4096);
   857	        let grid = ArrayValue::new(1, 1, vec![Value::Text(Arc::from(big.as_str()))]).unwrap();
   858	        let err = encode_grid_capped(&grid, MAX_GRID_CELLS, 64).unwrap_err();
   859	        assert!(
   860	            matches!(err, CodecError::GridTooManyBytes { max: 64, .. }),
   861	            "got {err:?}"
   862	        );
   863	    }
   864	
   865	    /// `decode_grid_capped` rejects an over-cap input buffer up front (defense in
   866	    /// depth beyond the transport frame cap).
   867	    #[test]
   868	    fn decode_rejects_input_over_byte_cap() {
   869	        let grid = ArrayValue::new(1, 1, vec![Value::Number(1.0)]).unwrap();
   870	        let bytes = encode_grid(&grid).expect("encode");
   871	        let err = decode_grid_capped(&bytes, MAX_GRID_CELLS, 8).unwrap_err();
   872	        assert!(
   873	            matches!(err, CodecError::GridTooManyBytes { max: 8, .. }),
   874	            "got {err:?}"
   875	        );
   876	    }
   877	}

