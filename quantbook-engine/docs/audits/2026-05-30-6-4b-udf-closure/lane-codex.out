   119	                    "UDF returned a non-finite number (%r); only finite numbers are supported" % cell
   120	                )
   121	            kinds.append("number"); nums.append(n); strs.append(None); bools.append(None); errs.append(None)
   122	        elif isinstance(cell, str):
   123	            kinds.append("text"); nums.append(None); strs.append(cell); bools.append(None); errs.append(None)
   124	        elif isinstance(cell, Err):
   125	            kinds.append("error"); nums.append(None); strs.append(None); bools.append(None); errs.append(cell.sigil)
