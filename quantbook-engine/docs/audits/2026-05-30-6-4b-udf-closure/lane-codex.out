   100	
   101	def encode_grid(grid):
   102	    """Encode a `Grid` to Arrow IPC stream bytes (matching `ql-udf::codec::encode_grid`)."""
   103	    kinds, nums, strs, bools, errs = [], [], [], [], []
   104	    for cell in grid.cells:
   105	        if cell is None:
   106	            kinds.append("blank"); nums.append(None); strs.append(None); bools.append(None); errs.append(None)
   107	        elif isinstance(cell, bool):
   108	            # NB: bool is a subclass of int — check it BEFORE the numeric branch.
   109	            kinds.append("bool"); nums.append(None); strs.append(None); bools.append(cell); errs.append(None)
   110	        elif isinstance(cell, (int, float)):
   111	            # The engine's Value::Number invariant is "always finite"; the Rust decoder REJECTS
   112	            # NaN/Inf. Reject here at the source so a UDF returning a non-finite number (or a
   113	            # huge int that overflows float() to inf) surfaces a comprehensible RAISE rather than
   114	            # a cryptic codec error from the far side (6.4-3b audit-fix: python-encode-grid-
   115	            # accepts-nan-inf-cryptic-engine-error).
   116	            n = float(cell)
