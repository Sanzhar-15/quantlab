     1	//! Scalar evaluator — `eval_scalar(plan, env) -> Value`.
     2	//!
     3	//! Per-cell evaluation path. Used for:
     4	//! - Single-cell formulas (`=A1+B1` in cell C1).
     5	//! - Per-cell fallback inside a FormulaRegion when SIMD isn't applicable (text, error,
     6	//!   mixed types, non-arithmetic ops, division — see lower.rs H5 routing).
     7	//! - Tests, which is most of the W4-1 coverage.
     8	//!
     9	//! The SIMD hot path for OG-02 lives in `simd.rs` and bypasses this entirely —
    10	//! it consumes Arrow Float64Array slices directly via `multiversion`-dispatched
    11	//! kernels.
    12	//!
    13	//! ## Excel binary arithmetic semantics (Phase 2A.9 audit M1 — lenient coercion)
    14	//!
    15	//! For binary operators `+ - * / ^`:
    16	//! - If either operand is an `Error`, propagate that error (left operand wins).
    17	//! - Coerce both operands to f64 via `to_number_lenient` (Number → self;
    18	//!   Bool → 0/1; Blank → 0; Text that parses as a number → that number; Text
    19	//!   that doesn't parse → `#VALUE!`; Error → propagate). Phase 2A.9 audit M1
    20	//!   replaced the prior strict path that rejected ALL text.
    21	//! - Apply the f64 op. Sanitize result via `sanitize_f64` (NaN/Inf → `#NUM!`).
    22	//! - Special cases (Phase 2A.9 audit M3 / 2A.13 audit M3 companion):
    23	//!   - Division by zero → `#DIV/0!`.
    24	//!   - Negative base ^ non-integer exponent → `#NUM!`.
    25	//!   - `0^0` → `#NUM!`.
    26	//!   - `0^-n` (n > 0) → `#DIV/0!` (mathematically `1/0^n`).
    27	//!
    28	//! For `&` (concat): coerce both to text via `to_text_for_formula`; concat. Errors
    29	//! propagate.
    30	//!
    31	//! Comparison operators (`=`, `<>`, `<`, `>`, `<=`, `>=`) follow Excel-canon
    32	//! cross-type ordering (Phase 2A.9 audit M2): same-type pairs compare per
    33	//! their natural ordering; mixed-type pairs use type rank
    34	//! (`Number < Text < Boolean`). `Blank` coerces to `0` vs Number and `""`
    35	//! vs Text; for `Blank vs Boolean` the type-rank fallthrough applies (Blank
    36	//! ranks as Number, so `Blank < TRUE`). See `compare_values_excel`.
    37	//!
    38	//! Unary `-x` negates; `+x` no-ops; `x%` divides by 100.
    39	
    40	use std::time::{Duration, Instant};
    41	
    42	use ql_formula_syntax::Operator;
    43	use ql_functions::FunctionRegistry;
    44	use ql_types::{coercion, ArrayValue, ErrorValue, Value};
    45	
    46	use crate::aggregate_cache::{AggregateCache, NoAggregateCache};
    47	use crate::env::CellEnv;
    48	use crate::eval_result::EvalResult;
    49	use crate::plan::ExprPlan;
    50	
    51	/// **6.4-3c (2026-05-29):** deadline bounding ONE blocking UDF call. The call
    52	/// runs inline on the synchronous recalc thread (Model A, design §1), so this is
    53	/// the maximum a single hung/slow UDF can stall recompute before
    54	/// [`ql_udf::UdfWorker`] kills the worker and the cell becomes `#TIMEOUT!`.
    55	/// v1 uses one session-wide constant; per-function / [`CancelPolicy`]-driven
    56	/// deadlines are deferred. Lives here (the sole consumer is [`dispatch_udf`])
    57	/// rather than on the session.
    58	///
    59	/// **Aggregate-stall caveat (Codex MED-2 / Opus MED-3, 6.4-3c audit):** this is
    60	/// PER-CALL. A single `recalc_all` over N hung/slow UDF cells can block the
    61	/// synchronous recalc thread — and the napi session `Mutex` it holds — for up to
    62	/// `30s × N`, stalling every other JS call on that session. No deadlock (the
    63	/// worker IPC is a separate process and never re-acquires the session lock), but
    64	/// the aggregate stall is unbounded. An operation-level recalc budget / cancel
    65	/// check is FILED-FORWARD for 6.4-3d alongside per-function deadlines.
    66	const UDF_CALL_DEADLINE: Duration = Duration::from_secs(30);
    67	
    68	/// **6.4B (item H):** operation-level UDF time budget for ONE recompute pass.
    69	/// Without it, a pass touching N slow UDF cells could block the recalc thread for
    70	/// up to N × [`UDF_CALL_DEADLINE`] (the "N×30s mutex stall" — design §H/I). The
    71	/// recompute pass arms a deadline `Instant::now() + UDF_OP_BUDGET` once at the
    72	/// start (only when a worker is attached); [`effective_udf_deadline`] then clamps
    73	/// each call to the remaining budget and, once spent, skips the worker entirely
    74	/// (a deterministic `#TIMEOUT!` + `udf_budget_exhausted`). 120s = 4 × the per-call
    75	/// deadline: room for several genuinely-slow UDFs without an unbounded stall.
    76	///
    77	/// A session-level override (`WorkbookSession::set_udf_op_budget`) exists for
    78	/// tests; it is not yet bound over napi (a follow-up — per-function deadlines +
    79	/// host configurability are filed for 6.4B/later).
    80	pub(crate) const UDF_OP_BUDGET: Duration = Duration::from_secs(120);
    81	
    82	/// **6.4B (item H):** the effective timeout for ONE UDF call given the optional
    83	/// operation-level budget deadline `op_deadline` and the current instant `now`.
    84	///
    85	/// - `None` budget (single-cell `set_formula`, tests, no recompute pass) →
    86	///   `Some(UDF_CALL_DEADLINE)`: the per-call deadline alone, exactly as before.
    87	/// - budget present and still open → `Some(min(UDF_CALL_DEADLINE, remaining))`.
    88	/// - budget present and `now >= op_deadline` → `None`: **exhausted**, the caller
    89	///   must NOT dispatch (skip → `#TIMEOUT!` + `udf_budget_exhausted`).
    90	///
    91	/// Pure (no clock read of its own) so the clamp/exhaustion logic is unit-testable
    92	/// with synthetic instants.
    93	fn effective_udf_deadline(op_deadline: Option<Instant>, now: Instant) -> Option<Duration> {
    94	    match op_deadline {
    95	        None => Some(UDF_CALL_DEADLINE),
    96	        // `checked_duration_since` is `None` when `now` is later than the deadline;
    97	        // a zero remaining (now == deadline) is also treated as exhausted.
    98	        Some(dl) => match dl.checked_duration_since(now) {
    99	            Some(remaining) if !remaining.is_zero() => Some(remaining.min(UDF_CALL_DEADLINE)),
   100	            _ => None,
   101	        },
   102	    }
   103	}
   104	
   105	/// Evaluate an `ExprPlan` against `env` to produce a `Value`. Total function — never
   106	/// panics on Excel semantics (NaN, div-by-zero, etc.). Panics only on internal
   107	/// programmer errors (e.g. malformed ExprPlan that bind() couldn't produce).
   108	///
   109	/// `Function` variants return `#NAME?` (`ErrorValue::Name`). To dispatch through a
   110	/// registry, use `eval_scalar_with_registry` instead.
   111	pub fn eval_scalar<E: CellEnv>(plan: &ExprPlan, env: &E) -> Value {
   112	    match plan {
   113	        ExprPlan::Number(n) => Value::number(*n),
   114	        ExprPlan::Bool(b) => Value::Boolean(*b),
   115	        ExprPlan::String(s) => Value::Text(s.clone()),
   116	        ExprPlan::CellRef {
   117	            sheet, row, col, ..
   118	        } => env.read_cell(*sheet, *row, *col),
   119	        ExprPlan::Binary { op, lhs, rhs } => {
   120	            let l = eval_scalar(lhs, env);
   121	            let r = eval_scalar(rhs, env);
   122	            eval_binary(*op, l, r)
   123	        }
   124	        ExprPlan::Unary { op, operand } => {
   125	            let v = eval_scalar(operand, env);
   126	            eval_unary(*op, v)
   127	        }
   128	        ExprPlan::Function { .. } => Value::Error(ErrorValue::Name),
   129	        // **Legacy no-registry path only.** Phase 3.6 / W5-39 added
   130	        // real aggregate-over-named-range evaluation, but ONLY in
   131	        // `eval_scalar_with_cache` (the cache-enabled entry point).
   132	        // This older `eval_scalar` function is kept for tests + the
   133	        // SIMD per-cell fallback path; it has no registry handle
   134	        // and intentionally surfaces `#CALC!` for any aggregate-
   135	        // named-range reference. Callers that want actual aggregate
   136	        // semantics must go through `eval_scalar_with_registry` or
   137	        // `eval_scalar_with_cache`.
   138	        ExprPlan::AggregateNameRef { .. } => Value::Error(ErrorValue::Calc),
   139	        // **W5-RT-1 (RT-V1-01):** literal range refs only reach reference-
   140	        // aware functions; in this no-registry path there's no dispatcher
   141	        // to consume them. Mirrors the `AggregateNameRef` precedent.
   142	        ExprPlan::RangeRef { .. } => Value::Error(ErrorValue::Calc),
   143	        // **W5-99 (Phase 4.7.F):** error literal — return the error
   144	        // value directly. Used by `=#REF!` formulas and error literals
   145	        // inside array cells.
   146	        ExprPlan::Error(ev) => Value::Error(*ev),
   147	        // **W5-99 (Phase 4.7.F):** array literal in scalar context.
   148	        // Per design § 6.3 (Codex HIGH-2 fix): array-in-scalar-context
   149	        // surfaces as `#CALC!`. This applies to the cell-boundary
   150	        // ALSO until the runtime spill path lands in W5-102 / 4.7.J;
   151	        // for now, even array literals at the cell root produce
   152	        // `#CALC!`. The spill path will route around this by detecting
   153	        // `ExprPlan::Array` at the cell-boundary BEFORE calling
   154	        // `eval_scalar_*` and materializing an `ArrayValue` instead.
   155	        ExprPlan::Array(_) => Value::Error(ErrorValue::Calc),
   156	        // **W5-115 (Phase 4.8.F):** structured-ref in scalar context.
   157	        // No-registry path: the legacy `eval_scalar` doesn't have access
   158	        // to a `WorkbookEnv` with the formula cell, so `[@Col]` narrowing
   159	        // can't fire here. Surface #CALC! (matches AggregateNameRef
   160	        // precedent — callers needing actual semantics use
   161	        // `eval_scalar_with_cache` which DOES narrow).
   162	        ExprPlan::StructuredRef { .. } => Value::Error(ErrorValue::Calc),
   163	    }
   164	}
   165	
   166	/// Like `eval_scalar` but dispatches `Function` variants through a `FunctionRegistry`.
   167	/// Unknown function names return `#NAME?`. Args are evaluated left-to-right with this
   168	/// same function (recursive); error-args propagate naturally through the registered
   169	/// function's logic.
   170	pub fn eval_scalar_with_registry<E: CellEnv>(
   171	    plan: &ExprPlan,
   172	    env: &E,
   173	    registry: &FunctionRegistry,
   174	) -> Value {
   175	    // Phase 3.6: legacy entry point — no aggregate cache. Wraps the cached
   176	    // path with `NoAggregateCache` (zero-cost no-op impl). Callers that
   177	    // have a session-owned cache should call `eval_scalar_with_cache`.
   178	    eval_scalar_with_cache(plan, env, registry, &NoAggregateCache)
   179	}
   180	
   181	/// **Phase 3.6 (2026-05-12) — W5-39, AGG-3-01..04 entry point.** Like
   182	/// `eval_scalar_with_registry` but consults `cache` for aggregate-over-
   183	/// range evaluations. When the Function branch detects an aggregate fn
   184	/// with an `AggregateNameRef` arg, it:
   185	///
   186	/// 1. Looks up `(range, function_name)` in `cache`. Hit → returns the
   187	///    cached value without re-scanning the range.
   188	/// 2. Miss → materializes the range via `CellEnv::read_range`, calls
   189	///    the aggregator, stores the result in `cache`, returns it.
   190	///
   191	/// The cache is invalidated externally (via `CalcgraphSession::
   192	/// mark_dirty_from_cell_write` → `InMemAggregateCache::invalidate_at`)
   193	/// when a cell inside any cached range is written. The evaluator itself
   194	/// never invalidates — it only reads + stores.
   195	///
   196	/// Pass `&NoAggregateCache` for the legacy "always recompute" behavior.
   197	pub fn eval_scalar_with_cache<E: CellEnv>(
   198	    plan: &ExprPlan,
   199	    env: &E,
   200	    registry: &FunctionRegistry,
   201	    cache: &dyn AggregateCache,
   202	) -> Value {
   203	    match plan {
   204	        ExprPlan::Number(n) => Value::number(*n),
   205	        ExprPlan::Bool(b) => Value::Boolean(*b),
   206	        ExprPlan::String(s) => Value::Text(s.clone()),
   207	        ExprPlan::CellRef {
   208	            sheet, row, col, ..
   209	        } => env.read_cell(*sheet, *row, *col),
   210	        ExprPlan::Binary { op, lhs, rhs } => {
   211	            let l = eval_scalar_with_cache(lhs, env, registry, cache);
   212	            let r = eval_scalar_with_cache(rhs, env, registry, cache);
   213	            eval_binary(*op, l, r)
   214	        }
   215	        ExprPlan::Unary { op, operand } => {
   216	            let v = eval_scalar_with_cache(operand, env, registry, cache);
   217	            eval_unary(*op, v)
   218	        }
   219	        ExprPlan::Function { name, args } => {
   220	            // **W5-100-AUDIT (Phase 4.7.G Sonnet closure):** dispatch
   221	            // via `lookup_any` and match on `RegisteredFn` — one
   222	            // HashMap lookup, one match. Pre-W5-100 the dispatcher
   223	            // called `lookup_range_aware` → `lookup_context_aware` →
   224	            // `lookup` in sequence (three separate HashMap lookups).
   225	            // The unified registry storage (W5-96) made the migration
   226	            // mechanical; doing it here lands the dispatch shape
   227	            // needed for 4.7.J spill routing.
   228	            use ql_functions::RegisteredFn;
   229	            match registry.lookup_any(name) {
   230	                Some(RegisteredFn::RangeAware(raf)) => {
   231	                    // W5-53 (GAP-F-05 closure): range-aware functions
   232	                    // like SUMIF need per-arg range-vs-scalar metadata
   233	                    // that the scalar `&[Value]` contract can't carry.
   234	                    // Build `Vec<FnArg>` with the correct variant per
   235	                    // arg (`AggregateNameRef` → `Range(read_range)`,
   236	                    // everything else → `Scalar(eval)`).
   237	                    //
   238	                    // W5-100 known gap: `ExprPlan::Array` args in
   239	                    // range-aware functions (SUMIF / VLOOKUP / etc.)
   240	                    // currently fall into the `Scalar(eval)` branch
   241	                    // and produce `#CALC!`. Array-as-range-arg for
   242	                    // range-aware functions is Phase 4.7+ work; for
   243	                    // v1 only aggregate-context (scalar SUM/AVERAGE)
   244	                    // arrays are supported per design § 6.3.
   245	                    use ql_functions::FnArg;
   246	                    let mut fn_args: Vec<FnArg> = Vec::with_capacity(args.len());
   247	                    for a in args {
   248	                        match a {
   249	                            ExprPlan::AggregateNameRef { range, .. } => {
   250	                                // W5-54: shape-aware Range so VLOOKUP /
   251	                                // HLOOKUP / INDEX can address by (row,
   252	                                // col). SUMIF / COUNTIF ignore shape.
   253	                                let (values, rows, cols) = env.read_range_with_shape(*range);
   254	                                fn_args.push(FnArg::Range { values, rows, cols });
   255	                            }
   256	                            // **W5-116/117 (Phase 4.8.G + G.2):** structured-ref
   257	                            // in range-aware function arg position. `[@Col]`
   258	                            // narrows the resolved range to a single row at
   259	                            // the formula's own cell (env.formula_cell()).
   260	                            ExprPlan::StructuredRef {
   261	                                resolved,
   262	                                is_this_row,
   263	                                ..
   264	                            } => {
   265	                                let r = narrow_structured_ref(*resolved, *is_this_row, env);
   266	                                match r {
   267	                                    Ok(range) => {
   268	                                        let (values, rows, cols) = env.read_range_with_shape(range);
   269	                                        fn_args.push(FnArg::Range { values, rows, cols });
   270	                                    }
   271	                                    Err(ev) => fn_args.push(FnArg::Scalar(Value::Error(ev))),
   272	                                }
   273	                            }
   274	                            other => {
   275	                                fn_args.push(FnArg::Scalar(eval_scalar_with_cache(
   276	                                    other, env, registry, cache,
   277	                                )));
   278	                            }
   279	                        }
   280	                    }
   281	                    raf(&fn_args)
   282	                }
   283	                Some(RegisteredFn::ContextAware(caf)) => {
   284	                    // **W5-69 (Phase 4.5.A.0):** context-aware functions
   285	                    // (DATE, NOW, TODAY, WEEKDAY, ...) take an extra
   286	                    // `&EvalContext` arg. Args evaluated left-to-right
   287	                    // exactly like the scalar path; only the function
   288	                    // signature differs.
