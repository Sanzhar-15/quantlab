   193	impl<'a> WorkbookRuntime<'a> {
   194	    pub fn new(workbook: &'a mut Workbook, registry: &'a FunctionRegistry) -> Self {
   195	        Self {
   196	            workbook,
   197	            registry,
   198	            oplog: None,
   199	            plan_cache: PlanCache::new(),
   200	            format_cache: std::collections::HashMap::new(),
   201	            graph: None,
   202	            udf_worker: None,
   203	            udf_diagnostics: None,
   204	            op_deadline: None,
   205	        }
   206	    }
   207	
   208	    /// Phase 2A.3.b: construct a runtime that records every mutation to the
   209	    /// supplied `OpLog`. Producer-replay equivalence: replaying the resulting
   210	    /// log against a fresh workbook (then calling `recompute_all` to
   211	    /// materialize formula values) reproduces the same observable state.
   212	    ///
   213	    /// See module docs for the documented limitations: `set_value(Value::Blank)`
   214	    /// emits no `PutValue` (CellWireValue lacks a Blank variant in 2A.3.b);
   215	    /// NaN/Inf in number values fail serde_json serialization and surface as
   216	    /// `RuntimeError::OpLog`.
   217	    pub fn with_oplog(
   218	        workbook: &'a mut Workbook,
   219	        registry: &'a FunctionRegistry,
   220	        oplog: &'a mut OpLog,
   221	    ) -> Self {
   222	        Self {
   223	            workbook,
   224	            registry,
   225	            oplog: Some(oplog),
   226	            plan_cache: PlanCache::new(),
   227	            format_cache: std::collections::HashMap::new(),
   228	            graph: None,
   229	            udf_worker: None,
   230	            udf_diagnostics: None,
   231	            op_deadline: None,
   232	        }
   233	    }
   234	
   235	    /// Phase 3.1 (2026-05-12): construct a runtime that fires calcgraph
   236	    /// mutation hooks on every producer method. Phase 3.1 hooks are
   237	    /// stubs (counter bumps + cell-index updates) — they accumulate
   238	    /// state that Phase 3.3 will turn into real dirty propagation and
   239	    /// edge updates. Today's recompute_all still walks formulas in
   240	    /// HashMap order; Phase 3.4 replaces it with a Tarjan-SCC-scheduled
   241	    /// graph walk.
   242	    pub fn with_graph(
   243	        workbook: &'a mut Workbook,
   244	        registry: &'a FunctionRegistry,
   245	        graph: &'a mut crate::CalcgraphSession,
   246	    ) -> Self {
   247	        Self {
   248	            workbook,
   249	            registry,
   250	            oplog: None,
   251	            plan_cache: PlanCache::new(),
   252	            format_cache: std::collections::HashMap::new(),
   253	            graph: Some(graph),
   254	            udf_worker: None,
   255	            udf_diagnostics: None,
   256	            op_deadline: None,
   257	        }
   258	    }
