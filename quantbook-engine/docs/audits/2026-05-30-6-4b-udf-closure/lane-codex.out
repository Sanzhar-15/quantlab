   581	/// **W5-117 (Phase 4.8.G.2):** narrow a `StructuredRef::resolved` range
   582	/// to a single row for `[@Col]` forms. For non-`[@]` forms, returns the
   583	/// range unchanged. For `[@]` forms, requires the formula's cell to be
   584	/// inside the range's row span; if outside (e.g., `[@Qty]` typed in a
   585	/// cell below the table), returns `#VALUE!` per Excel canon.
   586	///
   587	/// Cases:
   588	/// - `is_this_row == false` → return `resolved` as-is.
   589	/// - `is_this_row == true` + `env.formula_cell()` is `Some(addr)` with
   590	///   `addr.row` ∈ `[resolved.start_row, resolved.end_row]` → narrow to
   591	///   `(addr.row, addr.row, resolved.start_col, resolved.end_col)`.
   592	/// - `is_this_row == true` + cell missing or out of range → `#VALUE!`.
   593	fn narrow_structured_ref<E: CellEnv + ?Sized>(
   594	    resolved: ql_types::Range,
   595	    is_this_row: bool,
   596	    env: &E,
   597	) -> Result<ql_types::Range, ErrorValue> {
   598	    if !is_this_row {
   599	        return Ok(resolved);
   600	    }
   601	    // is_this_row: need cell context for the row.
   602	    let cell = env_formula_cell(env).ok_or(ErrorValue::Value)?;
   603	    if cell.row < resolved.start_row || cell.row > resolved.end_row {
   604	        return Err(ErrorValue::Value);
   605	    }
   606	    Ok(ql_types::Range::new(
   607	        resolved.sheet,
   608	        cell.row,
   609	        resolved.start_col,
   610	        cell.row,
   611	        resolved.end_col,
   612	    ))
   613	}
   614	
   615	/// **W5-RT-1 (RT-V1-01):** eager materializer for reference-aware fns
   616	/// using `ArgContract::Eager`. Each `ExprPlan` arg becomes a `RefArg`
   617	/// variant per its plan shape; `Value::Error(_)` results from eval
   618	/// surface as `RefArg::Error(ev)` for per-fn error-class propagation
   619	/// (HIGH-F closure).
   620	///
   621	/// Coordinate-only path for `AggregateNameRef`/`RangeRef`/`StructuredRef`:
   622	/// no `read_range_with_shape` call — ROWS/COLUMNS need dimensions, not
   623	/// values, and `WorkbookEnv::read_range_with_shape` clamps to populated
   624	/// bounds (env.rs:222) which would give wrong dimensions for
   625	/// `ROWS(A:A)`. Values stay empty in v1; if a future iterating
   626	/// reference-aware fn needs them, it can lazily call `read_range`.
   627	///
   628	/// **Step 1.1 / S1-HIGH-E note (volatile-asymmetry under dep-suppress):**
   629	/// the fall-through `other` arm eagerly evaluates `ExprPlan::Function`
   630	/// args via `eval_scalar_with_cache`. For dep-suppressed reference-aware
   631	/// fns (ROW / COLUMN / ROWS / COLUMNS / ISREF — see
   632	/// [`crate::calcgraph_session::is_address_only_reference_fn`]), the
   633	/// walker's shape-aware policy (Step 1.1 / S1-HIGH-A closure) recurses
   634	/// into Function arg subtrees via `walk_plan_for_address_only_deps`'s
   635	/// fall-through. So volatile / value deps inside the fn-arg subtree DO
   636	/// register, the formula IS marked volatile when needed, and recomputes
   637	/// on cycles. The eager-eval of e.g. `ROW(NOW())` produces a Value that
   638	/// the per-fn impl coerces to `#VALUE!` (Number isn't a reference);
   639	/// wasted CPU per recompute is the acceptable v1 cost. If a future
   640	/// Eager-contract reference-aware fn actually consumed the
   641	/// Function-arg's value to inform its result, revisit this trade-off.
   642	fn materialize_ref_arg_eager<E: CellEnv>(
   643	    plan: &ExprPlan,
   644	    env: &E,
   645	    registry: &FunctionRegistry,
   646	    cache: &dyn AggregateCache,
   647	) -> ql_functions::RefArg {
   648	    use ql_functions::RefArg;
   649	    match plan {
   650	        ExprPlan::CellRef {
   651	            sheet, row, col, ..
   652	        } => {
   653	            // **W5-RT-3.1 (S3-HIGH-1 closure — reverts S2-HIGH-2):** emit
   654	            // `RefArg::Reference { address }` from coordinates alone — DO
   655	            // NOT read the cell's value here. The S2-HIGH-2 closure added
   656	            // `env.read_cell` + error-coercion to surface missing-sheet
   657	            // errors as `RefArg::Error`. That regressed `ISFORMULA(A1)`
   658	            // when A1 holds a literal `#N/A` (returns `#N/A` instead of
   659	            // FALSE) and any future fn that legitimately reads cells
   660	            // with error values. The architecturally-correct shape — per
   661	            // both Step 3 audits — is for the materializer to carry only
   662	            // the address; per-fn impls call `read_cell` /
   663	            // `is_formula_at` / `formula_text_at` directly when they
   664	            // need the value. Missing-sheet errors are caught at bind
   665	            // time (`BindError::UnknownSheet`); the runtime-stale-sheet
   666	            // case S2-HIGH-2 worried about isn't reachable today (no
   667	            // `delete_sheet` API) and a future deletion path will need
   668	            // separate handling anyway.
   669	            RefArg::Reference {
   670	                address: ql_types::Address::new(*sheet, *row, *col),
   671	            }
   672	        }
   673	        ExprPlan::AggregateNameRef { range, .. } => RefArg::Range {
   674	            range: *range,
   675	            values: vec![],
   676	        },
   677	        ExprPlan::RangeRef { range } => RefArg::Range {
   678	            range: *range,
   679	            values: vec![],
   680	        },
   681	        ExprPlan::StructuredRef {
   682	            resolved,
   683	            is_this_row,
   684	            ..
   685	        } => match narrow_structured_ref(*resolved, *is_this_row, env) {
   686	            Ok(range) => RefArg::Range {
   687	                range,
   688	                values: vec![],
   689	            },
   690	            Err(ev) => RefArg::Error(ev),
   691	        },
   692	        ExprPlan::Array(rows) => {
   693	            // Materialize cells into an ArrayValue (mirrors the
   694	            // Unified-tier path at scalar.rs ~273-294).
   695	            let row_count = rows.len() as u32;
   696	            let col_count = rows.first().map(|r| r.len()).unwrap_or(0) as u32;
   697	            let mut cells: Vec<Value> = Vec::with_capacity((row_count * col_count) as usize);
   698	            for row in rows {
   699	                for cell in row {
   700	                    cells.push(eval_scalar_with_cache(cell, env, registry, cache));
   701	                }
   702	            }
   703	            let av = ArrayValue::new(row_count, col_count, cells)
   704	                .expect("ExprPlan::Array passed binder validation; shape intact");
   705	            RefArg::Array(av)
   706	        }
   707	        ExprPlan::Error(ev) => RefArg::Error(*ev),
   708	        other => {
   709	            let v = eval_scalar_with_cache(other, env, registry, cache);
   710	            match v {
   711	                Value::Error(ev) => RefArg::Error(ev),
   712	                ok => RefArg::Scalar(ok),
   713	            }
   714	        }
   715	    }
   716	}
   717	
   718	/// **W5-RT-1 (RT-V1-01):** lazy materializer for reference-aware fns
   719	/// using `ArgContract::LazyShape`. The arg's `ExprPlan` shape is
   720	/// translated to a `PlanKind` without any evaluation — no
   721	/// `eval_scalar_with_cache` call, no aggregate cache touch, no
   722	/// volatile-fn re-firing. ISREF uses this path (HIGH-B closure).
   723	fn materialize_ref_arg_lazy(plan: &ExprPlan) -> ql_functions::RefArg {
   724	    use ql_functions::{PlanKind, RefArg};
   725	    let kind = match plan {
   726	        ExprPlan::CellRef { .. } => PlanKind::CellRef,
   727	        ExprPlan::AggregateNameRef { .. }
   728	        | ExprPlan::RangeRef { .. }
   729	        | ExprPlan::StructuredRef { .. } => PlanKind::RangeRef,
   730	        // No reference-returning fns in v1 — see design § 1 out-of-scope
   731	        // ("Reference-returning fns (OFFSET-class)"). `returns_reference`
   732	        // stays false; ISREF on a function call returns FALSE accordingly.
   733	        ExprPlan::Function { .. } => PlanKind::Function {
   734	            returns_reference: false,
   735	        },
   736	        ExprPlan::Number(_)
   737	        | ExprPlan::Bool(_)
   738	        | ExprPlan::String(_)
   739	        | ExprPlan::Array(_)
   740	        | ExprPlan::Binary { .. }
   741	        | ExprPlan::Unary { .. } => PlanKind::Literal,
   742	        ExprPlan::Error(_) => PlanKind::Error,
   743	    };
   744	    RefArg::Shape(kind)
   745	}
   746	
   747	/// **W5-117 (Phase 4.8.G.2):** access the formula cell from an env if
   748	/// the env carries one. CellEnv doesn't expose this; we downcast to the
   749	/// concrete `WorkbookEnv` type. Other CellEnv impls (MapEnv in tests)
   750	/// always return None.
   751	fn env_formula_cell<E: CellEnv + ?Sized>(env: &E) -> Option<ql_types::Address> {
   752	    // Downcast trick — only WorkbookEnv carries a formula_cell. Since
   753	    // CellEnv is a trait without `Any`-supertrait, we use a separate
   754	    // accessor: callers wrapping a WorkbookEnv have type info at the
   755	    // construction site, but inside the generic eval path we don't.
   756	    // For now expose the cell via a no-op trait method; only WorkbookEnv
   757	    // overrides it.
   758	    env.formula_cell_for_sref()
   759	}
