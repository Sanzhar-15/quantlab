  1301	/// [`push_udf_cell_diagnostic`] (6.4-3d, megaudit blocker G).
  1302	fn map_udf_error(e: &ql_udf::UdfError) -> ErrorValue {
  1303	    match e {
  1304	        ql_udf::UdfError::Timeout(_) => ErrorValue::Timeout,
  1305	        // **6.4B (item I):** a grid breaching the cell/byte cap is a sizing error
  1306	        // in the UDF's args or result → `#VALUE!`, distinct from the generic codec
  1307	        // `#CALC!`. (Paired with the `udf_grid_too_large` diagnostic below.)
  1308	        ql_udf::UdfError::Codec(c) if is_grid_too_large(c) => ErrorValue::Value,
  1309	        // Adding a new `UdfError` variant? Reconsider this wildcard before it
  1310	        // silently maps to `#CALC!` — a future variant (e.g. a memory-limit
  1311	        // breach) may warrant a distinct cell value. The companion
  1312	        // `udf_error_diagnostic` IS exhaustive (no wildcard), so a new variant is
  1313	        // a compile error THERE — that break is the prompt to revisit this arm.
  1314	        _ => ErrorValue::Calc,
  1315	    }
  1316	}
  1317	
  1318	fn eval_binary(op: Operator, lhs: Value, rhs: Value) -> Value {
  1319	    // Error propagation comes first — Excel's left-error-wins rule.
  1320	    if let Value::Error(e) = lhs {
  1321	        return Value::Error(e);
  1322	    }
  1323	    if let Value::Error(e) = rhs {
  1324	        return Value::Error(e);
  1325	    }

