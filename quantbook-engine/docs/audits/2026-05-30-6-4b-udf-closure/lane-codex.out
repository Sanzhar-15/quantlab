  5110	    /// **6.4-3d (2026-05-29):** attach an out-of-process Python-UDF worker to
  5111	    /// this session, built from `config` (a trusted-workspace `ProcessWorker`).
  5112	    /// The worker is spawned + handshaked EAGERLY here (fail-loud) so a missing
  5113	    /// interpreter / protocol mismatch surfaces NOW as a clear error, not later
  5114	    /// as a silent `#CALC!` on the first `=MYUDF(..)`. After injecting, the IDE
  5115	    /// should call `recalcAll` so existing UDF cells pick up the worker — a UDF
  5116	    /// cell computed before injection is a clean `#CALC!` that `recalcDirty`
  5117	    /// will NOT heal (see engine `WorkbookSession::set_udf_worker`). Calling
  5118	    /// again REPLACES the worker (the prior one is dropped → its child killed).
  5119	    ///
  5120	    /// **Errors (Appendix A):**
  5121	    /// - `[worker_spawn_failed]` — the interpreter could not be launched / the
  5122	    ///   worker died during startup (python not found, import error, …).
  5123	    /// - `[worker_handshake]` — the worker reported an incompatible protocol
  5124	    ///   version.
  5125	    /// - `[bad_argument]` — `handshakeTimeoutMs` is negative / non-finite / above
  5126	    ///   the 10-minute cap.
  5127	    /// - `[invalid_state]` — session is not `Ready` (New / Closed / Faulted); the
  5128	    ///   just-spawned worker is dropped (its child killed) without being attached.
  5129	    /// - `[session_busy]` — a long operation is in progress.
  5130	    ///
  5131	    /// **Trust:** the IDE MUST gate this call on workspace trust — spawning a
  5132	    /// worker runs arbitrary workspace Python. The engine has no workspace
  5133	    /// concept, so the trust gate lives in the IDE (`worker_untrusted_workspace`
  5134	    /// is an IDE-side code, never emitted here).
  5135	    #[napi(js_name = "setUdfWorker")]
  5136	    pub fn set_udf_worker(&self, config: PythonWorkerConfigJson) -> Result<()> {
  5137	        let mut cfg = ql_udf::PythonWorkerConfig::new(&config.python);
  5138	        if let Some(module) = config.module {
  5139	            cfg.module = module;
  5140	        }
  5141	        if let Some(paths) = config.pythonpath {
  5142	            for p in paths {
  5143	                cfg = cfg.with_pythonpath(p);
  5144	            }
  5145	        }
  5146	        if let Some(udf_module) = config.udf_module {
  5147	            cfg = cfg.with_udf_module(udf_module);
  5148	        }
  5149	        if let Some(ms) = config.handshake_timeout_ms {
  5150	            // **6.4-3d audit-fix (LOW):** require a non-negative finite value AND
  5151	            // cap it (10 min) so a huge `f64` cannot saturate `as u64` into an
  5152	            // effectively-unbounded handshake wait. The inclusive-range
  5153	            // `!contains` rejects NaN/Inf (neither is `>= 0.0`) as well as a
  5154	            // negative or above-cap value in one expression. Fractional ms
  5155	            // truncate (harmless).
  5156	            // (6.4-3d Step 5: rewritten from the `ms < 0.0 || ms > MAX` form to
  5157	            // satisfy clippy `manual_range_contains` under rust 1.95's stricter
  5158	            // `deny(clippy::all)`; behavior-identical.)
  5159	            const MAX_HANDSHAKE_MS: f64 = 600_000.0;
  5160	            if !(0.0..=MAX_HANDSHAKE_MS).contains(&ms) {
  5161	                return Err(bad_argument_error(format!(
  5162	                    "setUdfWorker: handshakeTimeoutMs must be a finite number in [0, {MAX_HANDSHAKE_MS}] ms"
  5163	                )));
  5164	            }
  5165	            cfg.handshake_timeout = std::time::Duration::from_millis(ms as u64);
  5166	        }
  5167	        // Spawn + handshake EAGERLY (outside the session lock — the spawn is a
  5168	        // process op) so a failure is reported here, not deferred to first call.
  5169	        // **NOTE (audit MED, filed for IDE Step 5):** this is a SYNCHRONOUS napi
  5170	        // method and blocks the calling JS thread for up to the handshake timeout
  5171	        // — the IDE MUST call it off the UI/main thread.
  5172	        let mut worker = ql_udf::ProcessWorker::new(cfg);
  5173	        worker.ensure_started().map_err(udf_spawn_error_to_napi)?;
  5174	        // **6.4-3d audit-fix (HIGH-3):** inject UNDER the lock via the
  5175	        // lifecycle-gated setter — a Closed/Faulted/New/Busy session rejects with
  5176	        // `[invalid_state]`/`[session_busy]` and the just-spawned `worker` drops
  5177	        // here (its child killed + reaped), closing the inject-vs-close race.
  5178	        self.inner
  5179	            .lock()
  5180	            .set_udf_worker_checked(Box::new(worker))
  5181	            .map_err(engine_error_to_napi)?;
  5182	        Ok(())
  5183	    }
