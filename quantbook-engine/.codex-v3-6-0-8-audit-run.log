   330	//
   331	// **V2.3 mocha test compatibility**: the existing Display strings
   332	// remain intact AFTER the prefix, so substring-match tests like
   333	// `/invalid WebSocket URL/` still match `"[websocket_invalid_url]
   334	// invalid WebSocket URL: ..."`. No test breakage expected.
   335	//
   336	// **Why not napi-rs `Error::with_code`?**: napi-rs 3.9.0's `Error`
   337	// uses `Status: enum` (no `Status::Custom(String)`). The standard
   338	// status codes don't map to our error variants. Prefix-encoding
   339	// in the message is the canonical workaround documented across the
   340	// napi-rs ecosystem until a future custom-code API lands.
   341	
   342	/// Map a [`CollabSessionError`] to a napi [`Error`] with a kind-
   343	/// prefixed message. The kind comes from
   344	/// [`CollabSessionError::kind`]; for `Transport(inner)` it
   345	/// transparently passes through the inner kind (e.g.
   346	/// `"transport_closed"` instead of `"session_transport"`).
   347	fn collab_session_error_to_napi(e: CollabSessionError) -> Error {
   348	    Error::from_reason(format!("[{}] {e}", e.kind()))
   349	}
   350	
   351	/// **Phase 5.7 V3.6.0.8.3 D6 (2026-05-25)** -- helper for the
   352	/// [`CollabSession::workbook_snapshot_delta`] fullRebuildRequired
   353	/// / empty-delta paths.  Single source of truth for the "empty
   354	/// arrays, just version + bool" shape; keeps the algorithm body
   355	/// reading sequentially.
   356	fn empty_delta(version: Buffer, full_rebuild_required: bool) -> WorkbookSnapshotDeltaJson {
   357	    WorkbookSnapshotDeltaJson {
   358	        changed_cells: Vec::new(),
   359	        removed_cells: Vec::new(),
   360	        sheets_changed: Vec::new(),
   361	        sheets_removed: Vec::new(),
   362	        formats_added: Vec::new(),
   363	        version,
   364	        full_rebuild_required,
   365	    }
   366	}
   367	
   368	/// **Phase 5.7 V3.6.0.8.3 D6 (2026-05-25)** -- classify a single op
   369	/// for [`CollabSession::workbook_snapshot_delta`]'s delta walk.
   370	///
   371	/// Sets `has_rename = true` on any `Op::RenameSheet | RenameTable |
   372	/// RenameColumn`; the caller's break-on-rename short-circuit takes
   373	/// effect after this returns.  Otherwise extracts the cell coord,
   374	/// sheet removal, or format registration into the appropriate
   375	/// output collection.
   376	///
   377	/// Recurses into `Op::BatchCommit` to handle nested cell ops (mirrors
   378	/// the V3.4.0.X HIGH-1 closure on `collect_cache_effects`).
   379	///
   380	/// Non-cell-keyed, non-rename, non-format ops (e.g., `SetName`,
   381	/// `AddSheet`, `MoveSheet`, `CreateTable`, `DropTable`, etc.) are
   382	/// silently skipped here.  V3.6.0.8.3 scope: their effects don't
   383	/// emit in this delta surface (would require sheets_changed or new
   384	/// surface fields; deferred to V3.6.0.8.4+).
   385	fn classify_delta_op(
   386	    op: &Op,
   387	    has_rename: &mut bool,
   388	    changed_cells: &mut std::collections::HashSet<(u16, u32, u32)>,
   389	    removed_sheets: &mut Vec<u16>,
   390	    new_formats: &mut Vec<ql_storage::FormatId>,
   391	) {
   392	    match op {
   393	        Op::PutValue { sheet, row, col, .. }
   394	        | Op::PutFormula { sheet, row, col, .. }
   395	        | Op::ClearFormula { sheet, row, col }
   396	        | Op::SetCellFormat { sheet, row, col, .. } => {
   397	            changed_cells.insert((*sheet, *row, *col));
   398	        }
   399	        Op::RenameSheet { .. } | Op::RenameTable { .. } | Op::RenameColumn { .. } => {
   400	            *has_rename = true;
   401	        }
   402	        Op::RemoveSheet { id } => {
   403	            removed_sheets.push(*id);
   404	        }
   405	        Op::RegisterFormat { id, .. } => {
   406	            new_formats.push(id.clone().to_storage());
   407	        }
   408	        Op::BatchCommit { ops } => {
   409	            for inner in ops {
   410	                classify_delta_op(
   411	                    inner,
   412	                    has_rename,
   413	                    changed_cells,
   414	                    removed_sheets,
   415	                    new_formats,
   416	                );
   417	                if *has_rename {
   418	                    return;
   419	                }
   420	            }
   421	        }
   422	        // Other ops (SetName / AddSheet / MoveSheet / CreateTable /
   423	        // DropTable / SetDateSystem / SetLocale / SetReferenceMode)
   424	        // are silently skipped: they don't emit in V3.6.0.8.3's
   425	        // delta surface (their effects are workbook-metadata-level,
   426	        // not per-cell).  V3.6.0.8.4+ may grow `sheets_changed` or
   427	        // workbook-metadata fields to cover them.
   428	        _ => {}
   429	    }
   430	}

