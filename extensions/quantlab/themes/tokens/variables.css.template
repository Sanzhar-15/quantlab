  --button-bg-active: #7e22ce;
}

[data-accent="orange"] {
  --accent-primary-rgb: 255, 115, 49;
  --accent-primary-hover-rgb: 255, 136, 85;
  --accent-primary-active-rgb: 229, 103, 44;
  --color-brand: #FF7331;
  --color-brand-hover: #FF8855;
  --color-brand-active: #E5672C;
  --color-on-brand: #1A0A00;
}

[data-accent="red"] {
  --accent-primary-rgb: 239, 68, 68;
  --accent-primary-hover-rgb: 220, 38, 38;
  --accent-primary-active-rgb: 185, 28, 28;
  --color-brand: #ef4444;
  --color-brand-hover: #dc2626;
  --color-brand-active: #b91c1c;
  --color-on-brand: #FFFFFF;
  /* Button bg overrides: -600 base (4.82:1 AA w/ white), -500 hover (lighter feedback) */
  --button-bg: #dc2626;
  --button-bg-hover: #ef4444;
  --button-bg-active: #b91c1c;
}

/* ===================
 * COLOR PALETTE VARIANTS
 * =================== */
[data-theme="dark"][data-palette="warm"] {
  /* Stronger halation compensation for darker warm surfaces */
  --rf-grad: -40;

  /* Surfaces — warm charcoal (orange-tinted, hue ~18deg) */
  --color-bg: #0D0B0A;
  --color-surface: #1C1916;
  --color-surface-hover: #231E1B;
  --color-inset: #090807;
  --color-overlay: #050404;

  /* Gray scale — must track surfaces for consistency */
  --color-gray-700: #2E2824;
  --color-gray-800: #1C1916;
  --color-gray-900: #0D0B0A;
  --color-gray-925: #090807;
  --color-gray-950: #050404;

  /* Structural */
  --color-border: #2E2824;
  --color-disabled-bg: #1A1715;
  --color-selection: #5C3520;

  /* Shell chrome — darker tint for glassmorphic sidebars */
  --sidebar-bg-collapsed: rgba(13, 11, 10, 0.85);
  --sidebar-bg-expanded: rgba(13, 11, 10, 0.85);
}

/* ===================
 * FONT SIZE VARIANTS
 * =================== */
[data-font-size="small"] {
  --font-size-base: 14px;
}

[data-font-size="medium"] {
  --font-size-base: 16px;
}

[data-font-size="large"] {
  --font-size-base: 18px;
}

html {
  font-size: var(--font-size-base);
}

/* ===================
 * COMPACT MODE
 * =================== */
.compact,
[data-compact="true"] {
  --spacing-unit: 0.75;
}

/* ===================
 * REDUCE MOTION
 * =================== */
.reduce-motion *,
.reduce-motion *::before,
.reduce-motion *::after,
[data-reduce-motion="true"] *,
[data-reduce-motion="true"] *::before,
[data-reduce-motion="true"] *::after {
  animation-duration: 0.01ms !important;
  animation-iteration-count: 1 !important;
  transition-duration: 0.01ms !important;
}

/* OS prefers-reduced-motion deliberately NOT used here.
   The in-app toggle controls reduce-motion via .reduce-motion / [data-reduce-motion="true"] above. */

/* ===================
 * ANIMATIONS TOGGLE
 * Decorative only — transitions preserved so hover/expand/collapse still work.
 * =================== */
[data-animations-off="true"] *,
[data-animations-off="true"] *::before,
[data-animations-off="true"] *::after {
  animation-duration: 0.01ms !important;
  animation-iteration-count: 1 !important;
  /* transition-duration intentionally NOT zeroed */
}

/* ===================
 * DATA UPDATE FLASH
 * =================== */
@keyframes flash-update {
  0% { background-color: rgba(var(--accent-primary-rgb), 0.15); }
  100% { background-color: transparent; }
}

.animate-flash-update {
  animation: flash-update var(--highlight-duration, 1000ms) ease-out;
}
