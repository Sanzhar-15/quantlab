# Wave J-b (R17, 2026-06-20) -- packaging ignore list. Read by `vsce package` / `ovsx publish` for a standalone
# VSIX AND by the fork's product build: build/lib/extensions.ts fromLocalNormal packages the files listed by
# vsce.listFiles, which applies this file (F-DESK-PACK F-PACK-5/6). See PUBLISHING.md for the blockers that
# still gate a standalone publish (native engine binary, "private" flag, PNG icon).

# TypeScript sources + tests (the VSIX ships compiled out/ + dist/ only)
src/**
test/**
**/*.ts
**/*.map

# Compiled tests must not ship (only the runtime out/src is needed; main = ./out/src/extension)
out/test/**
out/**/test/**
out/**/*.test.js

# Webview SOURCES -- the shipped bundle is dist/webview/** (built by esbuild)
webview/**

# Python scratch (tests, bytecode caches, virtualenvs)
python/**/tests/**
python/**/__pycache__/**
python/**/.venv/**
**/.pytest_cache/**

# Build configuration + scripts (not shipped)
tsconfig.json
tsconfig.*.json
.eslintrc.json
esbuild-quantbook-webviews.mjs
esbuild-webview.mjs

# Repo + session scratch (never shipped)
.gitignore
.vscode/**
.codex-*
.commit-*
.demo-*
*.out

# Maintainer docs, not for extension users
PUBLISHING.md
PLAN.md
docs/**
