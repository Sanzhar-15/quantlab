        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.parquet"
          },
          {
            "filenamePattern": "*.xlsx"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "quantlab.visualiseSpecView",
        "displayName": "Visualise Spec",
        "selector": [
