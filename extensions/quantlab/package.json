            "filenamePattern": "*.py"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "quantlab.actionView",
        "displayName": "%view.actionEditor.title%",
        "selector": [
          {
            "filenamePattern": "*.py"
          },
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.parquet"
          },
          {
            "filenamePattern": "*.xlsx"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "quantlab.tradeView",
        "displayName": "%view.tradeEditor.title%",
        "selector": [
          {
            "filenamePattern": "*.py"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "quantlab.statsView",
