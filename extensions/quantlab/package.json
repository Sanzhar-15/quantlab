        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.parquet"
          },
          {
            "filenamePattern": "*.xlsx"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "quantlab.visualiseView",
