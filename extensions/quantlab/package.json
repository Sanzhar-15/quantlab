{
  "name": "quantlab",
  "publisher": "quantlab",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.108.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The reactive Quantbook kernel runs arbitrary workspace Python and is gated behind workspace trust. Other features work in Restricted Mode."
    }
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webviews:quantbook": "node ./esbuild-quantbook-webviews.mjs",
    "watch:webviews:quantbook": "node ./esbuild-quantbook-webviews.mjs --watch",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && node node_modules/mocha/bin/mocha.js 'out/test/qviz*.test.js' 'out/test/quantbook*.test.js' --ui tdd --timeout 10000 --require source-map-support/register --require out/test/helpers/mocha-setup.js",
    "test:all": "npm run compile && node node_modules/mocha/bin/mocha.js 'out/test/**/*.test.js' 'out/src/test/**/*.test.js' --ui tdd --timeout 10000 --require source-map-support/register --require out/test/helpers/mocha-setup.js",
    "test:py": "QUANTLAB_REQUIRE_FIXTURES=1 python -m pytest python/qviz/tests/ -q",
    "test:py:dev": "python -m pytest python/qviz/tests/ -q"
  },
  "activationEvents": [
    "onStartupFinished",
    "onNotebook:quantlab-reactive-notebook"
  ],
