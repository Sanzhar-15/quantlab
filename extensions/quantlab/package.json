    "menus": {
      "accountsMenu": [
        {
          "command": "quantlab.signIn",
          "when": "!deltaplus.authenticated",
          "group": "navigation"
        },
        {
          "command": "quantlab.signOut",
          "when": "deltaplus.authenticated",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "quantlab.switchToChart",
          "when": "view == quantlab.dataView && viewItem == quantlab.data.serverSymbol",
          "group": "navigation@1"
        },
        {
          "command": "quantlab.switchToAction",
          "when": "view == quantlab.dataView && viewItem == quantlab.data.serverSymbol",
          "group": "navigation@2"
        },
        {
          "command": "quantlab.switchToStats",
          "when": "view == quantlab.dataView && viewItem == quantlab.data.serverSymbol",
          "group": "navigation@3"
        },
        {
          "command": "quantlab.switchToChart",
          "when": "view == quantlab.dataView && viewItem == quantlab.data.symbol",
          "group": "navigation@1"
        },
        {
          "command": "quantlab.switchToAction",
          "when": "view == quantlab.dataView && viewItem == quantlab.data.symbol",
          "group": "navigation@2"
        },
        {
          "command": "quantlab.switchToStats",
          "when": "view == quantlab.dataView && viewItem == quantlab.data.symbol",
          "group": "navigation@3"
        },
        {
          "command": "quantlab.viewSession",
          "when": "view == quantlab.tradeView && viewItem == activeSession",
          "group": "inline@1"
        },
        {
          "command": "quantlab.viewSession",
          "when": "view == quantlab.tradeView && viewItem == activeSessionPaused",
          "group": "inline@1"
        },
        {
          "command": "quantlab.pauseSession",
          "when": "view == quantlab.tradeView && viewItem == activeSession",
          "group": "inline@2"
        },
        {
          "command": "quantlab.resumeSession",
          "when": "view == quantlab.tradeView && viewItem == activeSessionPaused",
          "group": "inline@2"
        },
        {
          "command": "quantlab.stopSession",
          "when": "view == quantlab.tradeView && viewItem == activeSession",
          "group": "inline@3"
        },
        {
          "command": "quantlab.stopSession",
          "when": "view == quantlab.tradeView && viewItem == activeSessionPaused",
          "group": "inline@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "quantlab.openAsChart",
          "when": "resourceLangId == python",
          "group": "1_open@10"
        },
        {
          "command": "quantlab.openAsAction",
          "when": "resourceLangId == python",
          "group": "1_open@11"
        },
        {
          "command": "quantlab.openAsTrade",
          "when": "resourceLangId == python",
          "group": "1_open@12"
        },
        {
          "command": "quantlab.switchToVisualise",
          "when": "resourceExtname =~ /\\.(csv|parquet|xlsx)$/i",
          "group": "1_open@10"
        },
        {
          "command": "quantlab.openDataAction",
          "when": "resourceExtname =~ /\\.(csv|parquet|xlsx)$/i",
          "group": "1_open@11"
        }
      ],
      "explorer/context": [
        {
          "command": "quantlab.switchToVisualise",
          "when": "resourceExtname =~ /\\.(csv|parquet|xlsx)$/i",
          "group": "navigation@10"
        },
        {
          "command": "quantlab.openDataAction",
          "when": "resourceExtname =~ /\\.(csv|parquet|xlsx)$/i",
          "group": "navigation@11"
        }
      ]
    },
    "keybindings": [
      {
        "command": "quantlab.switchToChart",
        "key": "ctrl+q c",
        "mac": "ctrl+q c",
        "when": "editorTextFocus"
      },
      {
        "command": "quantlab.switchToAction",
        "key": "ctrl+q a",
        "mac": "ctrl+q a",
        "when": "editorTextFocus"
      },
      {
        "command": "quantlab.switchToTrade",
        "key": "ctrl+q t",
        "mac": "ctrl+q t",
        "when": "editorTextFocus"
      },
      {
        "command": "quantlab.switchToEditor",
        "key": "ctrl+q e",
        "mac": "ctrl+q e",
        "when": "editorTextFocus"
      },
      {
        "command": "quantlab.switchToEditor",
        "key": "escape",
        "when": "editorTextFocus && quantlab.currentView != editor"
      },
      {
        "command": "quantlab.openAsChart",
        "key": "ctrl+q shift+c",
        "mac": "ctrl+q shift+c",
        "when": "editorTextFocus"
      },
      {
        "command": "quantlab.openAsAction",
        "key": "ctrl+q shift+a",
        "mac": "ctrl+q shift+a",
        "when": "editorTextFocus"
      },
      {
        "command": "quantlab.openAsTrade",
        "key": "ctrl+q shift+t",
        "mac": "ctrl+q shift+t",
        "when": "editorTextFocus"
      },
      {
        "command": "quantlab.switchToVisualise",
        "key": "ctrl+q v",
        "mac": "ctrl+q v",
        "when": "quantlab.isDataFile"
      },
      {
        "command": "quantlab.openDataAction",
        "key": "ctrl+q s",
        "mac": "ctrl+q s",
        "when": "quantlab.isDataFile"
      },
      {
        "command": "quantlab.switchToDataEditor",
        "key": "ctrl+q e",
        "mac": "ctrl+q e",
        "when": "quantlab.isDataFile"
      },
      {
        "command": "quantlab.toggleHistoryDropdown",
        "key": "ctrl+q h",
        "mac": "ctrl+q h"
      },
      {
        "command": "quantlab.focusDataPanel",
        "key": "ctrl+q 1",
        "mac": "ctrl+q 1"
      },
      {
        "command": "quantlab.focusResourcesPanel",
        "key": "ctrl+q 2",
        "mac": "ctrl+q 2"
      },
      {
        "command": "quantlab.focusHistoryPanel",
        "key": "ctrl+q 3",
        "mac": "ctrl+q 3"
      },
      {
        "command": "quantlab.focusTradePanel",
        "key": "ctrl+q 4",
        "mac": "ctrl+q 4"
      },
      {
        "command": "quantlab.killSwitch",
        "key": "ctrl+q k",
        "mac": "ctrl+q k",
        "when": "quantlab.currentView == trade"
      }
    ],
    "configuration": {
      "title": "Quantlab Trading",
      "properties": {
        "quantlab.pythonPath": {
          "type": "string",
          "scope": "machine-overridable",
          "default": "",
          "description": "Path to the Python interpreter for the qviz daemon (visualisation). When empty, Quantlab falls through to python.defaultInterpreterPath, then to ~/.quantlab/venv/bin/python. Setting an explicit path that does not resolve to an executable file fails loudly (does not silently fall through)."
        },
        "quantlab.trading.accounts": {
          "type": "array",
          "default": [],
          "description": "Broker account configurations for trading sessions.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "broker": {
                "type": "string",
                "enum": [
                  "alpaca",
                  "mock"
                ],
                "default": "mock"
              },
              "type": {
                "type": "string",
                "enum": [
                  "paper",
                  "live"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "broker",
              "type"
            ]
          }
        },
        "quantlab.trading.killSwitchPolicy": {
          "type": "string",
          "enum": [
            "flatten",
            "cancelOnly",
            "custom"
          ],
          "default": "flatten",
          "description": "Kill Switch policy to execute in Trade view."
        },
        "quantlab.trading.killSwitchCustomActions": {
          "type": "array",
          "default": [],
          "description": "Custom Kill Switch actions to execute when policy is custom."
        },
        "quantlab.trading.requireBacktest": {
          "type": "boolean",
          "default": false,
          "description": "Require a completed backtest before live trading."
        },
        "quantlab.trading.requirePaperTrading": {
          "type": "boolean",
          "default": false,
          "description": "Require a completed paper trading session before live trading."
        },
        "quantlab.trading.requireRiskReview": {
          "type": "boolean",
          "default": false,
          "description": "Require risk review confirmation before live trading."
        },
        "quantlab.trading.dailyLossLimit": {
          "type": "number",
          "default": 1000,
          "description": "Daily loss limit in USD (Decision L74). Set 0 to disable."
        },
        "quantlab.trading.dailyLossLimitPercent": {
          "type": "number",
          "default": 0.02,
          "minimum": 0,
          "maximum": 1,
          "description": "Daily loss limit as fraction of equity (Decision L74: 2%). Takes precedence over USD limit when set."
        },
        "quantlab.trading.maxDrawdownPercent": {
          "type": "number",
          "default": 0.05,
          "minimum": 0,
          "maximum": 1,
          "description": "Maximum drawdown as fraction of equity (Decision L74: 5%)."
        },
        "quantlab.trading.consecutiveLossLimit": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum consecutive losing trades before automatic halt (Decision L74: 3)."
        },
        "quantlab.trading.maxExposure": {
          "type": "number",
          "default": 100000,
          "description": "Maximum total exposure in USD. Set 0 to disable."
        },
        "quantlab.trading.maxPositionSize": {
          "type": "number",
          "default": 0,
          "description": "Maximum position size (shares). Set 0 to disable."
        },
        "quantlab.trading.maxOpenOrders": {
          "type": "number",
          "default": 10,
          "description": "Maximum open orders across sessions. Set 0 to disable."
        },
        "quantlab.notifications.showJobComplete": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when backtests complete."
        },
        "quantlab.notifications.showJobFailed": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when backtests fail."
        },
        "quantlab.notifications.showTradeExecuted": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when trades are executed."
        },
        "quantlab.notifications.showRiskAlerts": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications for risk alerts."
        },
        "quantlab.notifications.showSessionStatus": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when sessions start, pause, or stop."
        },
        "quantlab.notifications.soundEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable notification sounds."
        },
        "quantlab.notifications.soundVolume": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1,
          "description": "Notification sound volume (0-1)."
        },
        "quantlab.notifications.playFillSound": {
          "type": "boolean",
          "default": false,
          "description": "Play a sound when trades are executed."
        },
        "quantlab.notifications.playAlertSound": {
          "type": "boolean",
          "default": false,
          "description": "Play a sound for risk alerts."
        },
        "quantlab.notifications.playCompleteSound": {
          "type": "boolean",
          "default": false,
          "description": "Play a sound when backtests complete."
        },
        "quantlab.accessibility.reducedMotion": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "description": "Reduce motion in Quantlab views."
        }
      }
    },
    "authentication": [
      {
        "id": "deltaplus",
        "label": "Delta Plus"
      }
    ]
  },
  "configurationDefaults": {
    "workbench.colorCustomizations": {
