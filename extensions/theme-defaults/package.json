{
  "name": "theme-defaults",
  "displayName": "%displayName%",
  "description": "%description%",
  "categories": [
    "Themes"
  ],
  "version": "1.0.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "*"
  },
  "contributes": {
    "themes": [
      {
        "id": "Quantlab Dark",
        "label": "%deltaPlusDarkThemeLabel%",
        "uiTheme": "vs-dark",
        "path": "./themes/delta_plus_dark.json"
      },
      {
        "id": "Quantlab Light",
        "label": "%deltaPlusLightThemeLabel%",
        "uiTheme": "vs",
        "path": "./themes/delta_plus_light.json"
      },
      {
        "id": "Default High Contrast",
        "label": "%deltaPlusHcThemeLabel%",
        "uiTheme": "hc-black",
        "path": "./themes/delta_plus_hc.json"
      }
    ],
    "iconThemes": [
      {
        "id": "vs-minimal",
        "label": "%minimalIconThemeLabel%",
        "path": "./fileicons/vs_minimal-icon-theme.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  }
}
