# Quantlab identity (single source of truth)
APP_NAME=Quantlab
APPLICATION_NAME=quantlab

# Linux identity
LINUX_ICON_NAME=quantlab
URL_PROTOCOL=quantlab

# Data dirs
DATA_FOLDER_NAME=.quantlab
SERVER_APPLICATION_NAME=quantlab-server
SERVER_DATA_FOLDER_NAME=.quantlab-server
TUNNEL_APPLICATION_NAME=quantlab-tunnel

# macOS identity (valid reverse-domain; unsigned builds are fine)
DARWIN_BUNDLE_IDENTIFIER=com.sanzhar15.quantlab

# Windows identity (placeholder; good enough for base)
WIN32_APP_USER_MODEL_ID=Sanzhar15.Quantlab

# Version strategy (BASE decision)
# Recommended for base: inherit upstream version to avoid extension compatibility issues.
VERSION_STRATEGY=inherit_upstream

# Network surface policy (BASE decision)
MARKETPLACE_PROVIDER=open-vsx
ALLOW_MICROSOFT_UPDATE_ENDPOINTS=0
ALLOW_TELEMETRY_DEFAULT=0

# Product links (must not be microsoft.com)
HOMEPAGE_URL=https://github.com/Sanzhar-15/quantlab
ISSUES_URL=https://github.com/Sanzhar-15/quantlab/issues
PRIVACY_URL=https://github.com/Sanzhar-15/quantlab/blob/main/docs/privacy.md
LICENSE_URL=https://github.com/Sanzhar-15/quantlab/blob/main/LICENSE
